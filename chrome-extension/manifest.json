{
  "manifest_version": 3,
  "name": "SportHub — Cào tin cộng đồng",
  "version": "1.0.0",
  "description": "Gửi bài tuyển vãng lai từ Facebook group về SportHub để AI tự động bóc tách và hiển thị trên feed Matchmaking.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://sporthub-dn.id.vn/*",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SportHub — Cấu hình"
  }
}

