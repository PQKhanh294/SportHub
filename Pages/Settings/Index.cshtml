@page
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model SportHub.Pages.Settings.IndexModel
@{
    ViewData["Title"] = Localizer["SettingsTitle"];
}

<section class="max-w-3xl mx-auto space-y-8">
    <div>
        <h1 class="text-4xl font-black tracking-tight">@Localizer["SettingsTitle"]</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-2">@Localizer["SettingsDesc"]</p>
    </div>

    <div class="grid grid-cols-1 gap-6">
        <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 shadow-sm overflow-hidden relative">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h3 class="text-lg font-bold">@Localizer["ThemeTitle"]</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["ThemeDesc"]</p>
                </div>
                <span class="material-symbols-outlined text-primary text-3xl">contrast</span>
            </div>

            <div class="grid grid-cols-2 gap-4">
                @* Light *@
                <form method="post" asp-page-handler="SetTheme">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="theme" value="light" />
                    <button type="submit" class="w-full p-4 rounded-md border-2 transition-all flex flex-col items-center gap-3 @(Model.CurrentTheme == "light" ? "border-primary bg-primary/5 ring-4 ring-primary/10" : "border-slate-100 dark:border-slate-800 hover:border-slate-200")">
                        <div class="size-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center">
                            <span class="material-symbols-outlined">light_mode</span>
                        </div>
                        <span class="font-bold">@Localizer["LightMode"]</span>
                        @if (Model.CurrentTheme == "light")
                        { <span class="px-2 py-0.5 bg-primary text-white text-[10px] font-bold rounded-md uppercase tracking-wider">@Localizer["Active"]</span> }
                    </button>
                </form>

                @* Dark Level 1 *@
                <form method="post" asp-page-handler="SetTheme">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="theme" value="dark" />
                    <button type="submit" class="w-full p-4 rounded-md border-2 transition-all flex flex-col items-center gap-3 @(Model.CurrentTheme == "dark" ? "border-primary bg-primary/5 ring-4 ring-primary/10" : "border-slate-100 dark:border-slate-800 hover:border-slate-200")">
                        <div class="size-12 rounded-full bg-slate-800 text-slate-300 flex items-center justify-center border border-slate-700">
                            <span class="material-symbols-outlined">dark_mode</span>
                        </div>
                        <span class="font-bold">Tối</span>
                        <span class="text-xs text-slate-500">#111621</span>
                        @if (Model.CurrentTheme == "dark")
                        { <span class="px-2 py-0.5 bg-primary text-white text-[10px] font-bold rounded-md uppercase tracking-wider">@Localizer["Active"]</span> }
                    </button>
                </form>

                @* Dark Level 2 *@
                <form method="post" asp-page-handler="SetTheme">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="theme" value="dark-2" />
                    <button type="submit" class="w-full p-4 rounded-md border-2 transition-all flex flex-col items-center gap-3 @(Model.CurrentTheme == "dark-2" ? "border-primary bg-primary/5 ring-4 ring-primary/10" : "border-slate-100 dark:border-slate-800 hover:border-slate-200")">
                        <div class="size-12 rounded-full flex items-center justify-center border border-slate-700" style="background-color:#090e1a;color:#94a3b8">
                            <span class="material-symbols-outlined">nights_stay</span>
                        </div>
                        <span class="font-bold">Tối hơn</span>
                        <span class="text-xs text-slate-500">#06090f</span>
                        @if (Model.CurrentTheme == "dark-2")
                        { <span class="px-2 py-0.5 bg-primary text-white text-[10px] font-bold rounded-md uppercase tracking-wider">@Localizer["Active"]</span> }
                    </button>
                </form>

                @* Dark Level 3 AMOLED *@
                <form method="post" asp-page-handler="SetTheme">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="theme" value="dark-3" />
                    <button type="submit" class="w-full p-4 rounded-md border-2 transition-all flex flex-col items-center gap-3 @(Model.CurrentTheme == "dark-3" ? "border-primary bg-primary/5 ring-4 ring-primary/10" : "border-slate-100 dark:border-slate-800 hover:border-slate-200")">
                        <div class="size-12 rounded-full flex items-center justify-center border border-slate-700" style="background-color:#000;color:#64748b">
                            <span class="material-symbols-outlined">brightness_2</span>
                        </div>
                        <span class="font-bold">Đen AMOLED</span>
                        <span class="text-xs text-slate-500">#000000</span>
                        @if (Model.CurrentTheme == "dark-3")
                        { <span class="px-2 py-0.5 bg-primary text-white text-[10px] font-bold rounded-md uppercase tracking-wider">@Localizer["Active"]</span> }
                    </button>
                </form>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h3 class="text-lg font-bold">@Localizer["LangTitle"]</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["LangDesc"]</p>
                </div>
                <span class="material-symbols-outlined text-primary text-3xl">language</span>
            </div>

            <div class="space-y-3">
                <form method="post" asp-page-handler="SetLanguage">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="vi-VN" />
                    <button type="submit" class="w-full flex items-center justify-between p-4 rounded-md border-2 transition-all @(Model.CurrentLanguage == "vi-VN" ? "border-primary bg-primary/5" : "border-slate-100 dark:border-slate-800 hover:border-slate-200")">
                        <div class="flex items-center gap-4">
                            <span class="flex size-10 items-center justify-center rounded-full bg-primary/10 text-sm font-black text-primary">VN</span>
                            <div class="text-left">
                                <p class="font-bold">Tiếng Việt</p>
                                <p class="text-xs text-slate-500">Tiếng Việt (Việt Nam)</p>
                            </div>
                        </div>
                        @if (Model.CurrentLanguage == "vi-VN")
                        {
                            <span class="material-symbols-outlined text-primary font-bold">check_circle</span>
                        }
                    </button>
                </form>

                <form method="post" asp-page-handler="SetLanguage">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="en-US" />
                    <button type="submit" class="w-full flex items-center justify-between p-4 rounded-md border-2 transition-all @(Model.CurrentLanguage == "en-US" ? "border-primary bg-primary/5" : "border-slate-100 dark:border-slate-800 hover:border-slate-200")">
                        <div class="flex items-center gap-4">
                            <span class="flex size-10 items-center justify-center rounded-full bg-primary/10 text-sm font-black text-primary">US</span>
                            <div class="text-left">
                                <p class="font-bold">English</p>
                                <p class="text-xs text-slate-500">English (United States)</p>
                            </div>
                        </div>
                        @if (Model.CurrentLanguage == "en-US")
                        {
                            <span class="material-symbols-outlined text-primary font-bold">check_circle</span>
                        }
                    </button>
                </form>
            </div>
        </div>

        @if (Model.IsAuthenticated)
        {
            <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-lg font-bold">@Localizer["NotifyTitle"]</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["NotifyDesc"]</p>
                    </div>
                    <span class="material-symbols-outlined text-primary text-3xl">notifications</span>
                </div>

                <form method="post" asp-page-handler="SetEmailPreferences" id="emailPrefsForm" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <label class="flex items-center gap-3 p-4 rounded-md border-2 border-slate-100 dark:border-slate-800 cursor-pointer hover:border-slate-200 dark:hover:border-slate-700 transition-colors">
                        <input type="checkbox" id="notifyByEmailMaster" name="notifyByEmail" value="true" @(Model.NotifyByEmail ? "checked" : "")
                               class="w-5 h-5 rounded accent-primary shrink-0" />
                        <span class="font-semibold text-sm">@Localizer["NotifyEmailLabel"]</span>
                    </label>

                    <div id="emailSubPrefs" class="pl-4 space-y-3 @(Model.NotifyByEmail ? "" : "opacity-40")">
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wide mb-1.5">@Localizer["NotifyGroupWallet"]</p>
                            <div class="space-y-1.5">
                                <label class="flex items-center gap-3 p-2.5 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                    <input type="checkbox" name="notifyWalletCredit" value="true" @(Model.NotifyWalletCredit ? "checked" : "") class="email-sub-pref w-4 h-4 rounded accent-primary shrink-0" />
                                    <span class="text-sm">@Localizer["NotifyWalletCreditLabel"]</span>
                                </label>
                                <label class="flex items-center gap-3 p-2.5 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                    <input type="checkbox" name="notifyPromoCode" value="true" @(Model.NotifyPromoCode ? "checked" : "") class="email-sub-pref w-4 h-4 rounded accent-primary shrink-0" />
                                    <span class="text-sm">@Localizer["NotifyPromoCodeLabel"]</span>
                                </label>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wide mb-1.5">@Localizer["NotifyGroupMatch"]</p>
                            <div class="space-y-1.5">
                                <label class="flex items-center gap-3 p-2.5 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                    <input type="checkbox" name="notifyMatchApproved" value="true" @(Model.NotifyMatchApproved ? "checked" : "") class="email-sub-pref w-4 h-4 rounded accent-primary shrink-0" />
                                    <span class="text-sm">@Localizer["NotifyMatchApprovedLabel"]</span>
                                </label>
                                <label class="flex items-center gap-3 p-2.5 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                    <input type="checkbox" name="notifyMatchJoinRequest" value="true" @(Model.NotifyMatchJoinRequest ? "checked" : "") class="email-sub-pref w-4 h-4 rounded accent-primary shrink-0" />
                                    <span class="text-sm">@Localizer["NotifyMatchJoinRequestLabel"]</span>
                                </label>
                                <label class="flex items-center gap-3 p-2.5 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                    <input type="checkbox" name="notifyMatchCancelled" value="true" @(Model.NotifyMatchCancelled ? "checked" : "") class="email-sub-pref w-4 h-4 rounded accent-primary shrink-0" />
                                    <span class="text-sm">@Localizer["NotifyMatchCancelledLabel"]</span>
                                </label>
                                <label class="flex items-center gap-3 p-2.5 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                    <input type="checkbox" name="notifyMatchReminder" value="true" @(Model.NotifyMatchReminder ? "checked" : "") class="email-sub-pref w-4 h-4 rounded accent-primary shrink-0" />
                                    <span class="text-sm">@Localizer["NotifyMatchReminderLabel"]</span>
                                </label>
                                <label class="flex items-center gap-3 p-2.5 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                    <input type="checkbox" name="notifyPaymentReminder" value="true" @(Model.NotifyPaymentReminder ? "checked" : "") class="email-sub-pref w-4 h-4 rounded accent-primary shrink-0" />
                                    <span class="text-sm">@Localizer["NotifyPaymentReminderLabel"]</span>
                                </label>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wide mb-1.5">@Localizer["NotifyGroupDigest"]</p>
                            <label class="flex items-center gap-3 p-2.5 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors">
                                <input type="checkbox" name="notifyDailyDigest" value="true" @(Model.NotifyDailyDigest ? "checked" : "") class="email-sub-pref w-4 h-4 rounded accent-primary shrink-0" />
                                <span class="text-sm">@Localizer["NotifyDailyDigestLabel"]</span>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="px-5 py-2 bg-primary text-white rounded-md text-sm font-bold hover:bg-primary/90 transition-colors">
                        @Localizer["NotifySaveBtn"]
                    </button>
                </form>
            </div>

            <!-- Quyền riêng tư -->
            <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-lg font-bold">@Localizer["PrivacyTitle"]</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["PrivacyDesc"]</p>
                    </div>
                    <span class="material-symbols-outlined text-primary text-3xl">shield_person</span>
                </div>

                <form method="post" asp-page-handler="SetContactPrivacy" id="privacyForm">
                    @Html.AntiForgeryToken()
                    <label class="flex items-center gap-3 p-4 rounded-md border-2 border-slate-100 dark:border-slate-800 cursor-pointer hover:border-slate-200 dark:hover:border-slate-700 transition-colors">
                        <input type="checkbox" name="showContactToTeammates" value="true" @(Model.ShowContactToTeammates ? "checked" : "")
                               onchange="document.getElementById('privacyForm').submit()"
                               class="w-5 h-5 rounded accent-primary shrink-0" />
                        <span class="font-semibold text-sm">@Localizer["PrivacyContactLabel"]</span>
                    </label>
                </form>
            </div>

            <!-- Trợ giúp -->
            <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-lg font-bold">@Localizer["HelpTitle"]</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["HelpDesc"]</p>
                    </div>
                    <span class="material-symbols-outlined text-primary text-3xl">help</span>
                </div>
                <button type="button" onclick="SportHubTour.restart()"
                        class="w-full flex items-center justify-between p-4 rounded-md border-2 border-slate-100 dark:border-slate-800 hover:border-slate-200 dark:hover:border-slate-700 transition-all">
                    <span class="font-semibold text-sm">@Localizer["HelpRestartTour"]</span>
                    <span class="material-symbols-outlined text-primary">play_circle</span>
                </button>
            </div>

            <!-- Bảo mật tài khoản -->
            <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-lg font-bold">@Localizer["SecurityTitle"]</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["SecurityDesc"]</p>
                    </div>
                    <span class="material-symbols-outlined text-primary text-3xl">lock</span>
                </div>

                @if (TempData["PasswordSuccess"] != null)
                {
                    <div class="mb-4 p-3 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-md text-emerald-700 dark:text-emerald-400 text-sm font-medium">
                        @TempData["PasswordSuccess"]
                    </div>
                }
                @if (TempData["PasswordError"] != null)
                {
                    <div class="mb-4 p-3 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-md text-rose-700 dark:text-rose-400 text-sm font-medium">
                        @TempData["PasswordError"]
                    </div>
                }

                @if (Model.HasPassword)
                {
                    <form method="post" asp-page-handler="ChangePassword" class="space-y-3">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1 block">@Localizer["CurrentPassword"]</label>
                            <div class="relative">
                                <input type="password" id="stCurrentPwd" asp-for="PasswordInput.CurrentPassword" class="w-full rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 pr-10 text-sm" />
                                <button type="button" onclick="toggleSettingsPassword('stCurrentPwd', 'stEyeCurrent')"
                                        class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                                    <span id="stEyeCurrent" class="material-symbols-outlined text-lg">visibility</span>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1 block">@Localizer["NewPassword"]</label>
                            <div class="relative">
                                <input type="password" id="stNewPwd" asp-for="PasswordInput.NewPassword" class="w-full rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 pr-10 text-sm" />
                                <button type="button" onclick="toggleSettingsPassword('stNewPwd', 'stEyeNew')"
                                        class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                                    <span id="stEyeNew" class="material-symbols-outlined text-lg">visibility</span>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1 block">@Localizer["ConfirmNewPassword"]</label>
                            <div class="relative">
                                <input type="password" id="stConfirmPwd" asp-for="PasswordInput.ConfirmPassword" class="w-full rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 pr-10 text-sm" />
                                <button type="button" onclick="toggleSettingsPassword('stConfirmPwd', 'stEyeConfirm')"
                                        class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
                                    <span id="stEyeConfirm" class="material-symbols-outlined text-lg">visibility</span>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="px-5 py-2 bg-primary hover:bg-primary/90 text-white rounded-md text-sm font-semibold transition-colors">
                            @Localizer["ChangePasswordBtn"]
                        </button>
                    </form>
                }
                else
                {
                    <p class="text-sm text-slate-400">@Localizer["OAuthOnlyNote"]</p>
                }
            </div>
        }
    </div>

    <div class="text-center pt-4">
        <p class="text-xs text-slate-400 font-medium tracking-widest uppercase">SportHub v1.0.0 - 2026</p>
    </div>
</section>

@section Scripts {
    <script>
        function toggleSettingsPassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            icon.textContent = isHidden ? 'visibility_off' : 'visibility';
        }

        (function () {
            const master = document.getElementById('notifyByEmailMaster');
            const subWrap = document.getElementById('emailSubPrefs');
            if (!master || !subWrap) return;
            function syncSubPrefs() {
                // Chỉ làm mờ + khoá tương tác bằng trực quan — KHÔNG dùng thuộc tính
                // disabled, vì input bị disabled sẽ không được submit cùng form, làm
                // mất trạng thái đã lưu trước đó của từng tuỳ chọn con khi tắt tổng.
                const on = master.checked;
                subWrap.classList.toggle('opacity-40', !on);
                subWrap.style.pointerEvents = on ? '' : 'none';
            }
            master.addEventListener('change', syncSubPrefs);
            syncSubPrefs();
        })();
    </script>
}
