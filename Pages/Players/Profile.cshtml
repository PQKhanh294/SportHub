@page "{id:int}"
@model SportHub.Pages.Players.ProfileModel
@{
    ViewData["Title"] = Model.Profile?.FullName ?? "Hồ sơ người chơi";
}

<section class="max-w-3xl mx-auto space-y-6">
    <a asp-page="/Players/Index" class="inline-flex items-center gap-1 text-sm text-primary font-semibold hover:underline">
        <span class="material-symbols-outlined text-base">arrow_back</span> Cộng đồng người chơi
    </a>

    @if (Model.Profile == null)
    {
        <p class="text-slate-500">Không tìm thấy người dùng.</p>
    }
    else
    {
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md p-6 shadow-sm">
            <div class="flex items-center gap-4">
                <img src="@Model.Profile.AvatarUrl" alt="@Model.Profile.FullName" class="size-20 rounded-full object-cover flex-shrink-0" />
                <div class="min-w-0">
                    <h1 class="text-2xl font-black tracking-tight truncate">@Model.Profile.FullName</h1>
                    <div class="flex flex-wrap gap-2 mt-1">
                        <span class="px-2 py-0.5 bg-primary/10 text-primary text-xs font-semibold rounded-md">@Model.Profile.SkillLevel</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Profile.FavoriteSport))
                        {
                            <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-semibold rounded-md">@Model.Profile.FavoriteSport</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.DefaultAddress))
                    {
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">location_on</span> @Model.Profile.DefaultAddress
                        </p>
                    }
                </div>
            </div>

            @if (Model.Profile.IsSelf)
            {
                <a asp-page="/Profile/Index" class="mt-4 inline-block text-xs font-semibold text-primary hover:underline">Đây là hồ sơ của bạn — Vào trang quản lý tài khoản</a>
            }

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-5 pt-5 border-t border-slate-100 dark:border-slate-800 text-center">
                <div>
                    <p class="text-xl font-black">@Model.Profile.TotalMatches</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Trận đã chơi</p>
                </div>
                <div>
                    <p class="text-xl font-black">@Model.HostRating.StarDisplay</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Đánh giá host (@Model.HostRating.ReviewCount)</p>
                </div>
                <div>
                    <p class="text-xl font-black">@Model.PlayerRating.StarDisplay</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Đánh giá người chơi (@Model.PlayerRating.ReviewCount)</p>
                </div>
                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.Profile.Phone))
                    {
                        <p class="text-sm font-bold">@Model.Profile.Phone</p>
                    }
                    else
                    {
                        <p class="text-sm text-slate-400">Ẩn</p>
                    }
                    <p class="text-xs text-slate-500 dark:text-slate-400">Số điện thoại</p>
                </div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md p-6 shadow-sm">
            <h2 class="font-bold text-lg mb-4">Đánh giá gần đây</h2>
            @if (!Model.PublicReviews.Any())
            {
                <p class="text-sm text-slate-500 dark:text-slate-400">Chưa có đánh giá nào.</p>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var review in Model.PublicReviews)
                    {
                        <div class="border-b border-slate-100 dark:border-slate-800 pb-3 last:border-0">
                            <div class="flex items-center justify-between">
                                <span class="font-semibold text-sm">@review.ReviewerName</span>
                                <span class="text-xs text-slate-400">@review.MatchDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <p class="text-xs text-primary font-semibold mt-0.5">@review.AverageScore.ToString("F1") ★ — @review.MatchTitle</p>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="text-sm text-slate-600 dark:text-slate-300 mt-1">@review.Comment</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</section>
