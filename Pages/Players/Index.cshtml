@page
@model SportHub.Pages.Players.IndexModel
@using System.Globalization
@{
    var isEn = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isEn ? "Player Community" : "Cộng đồng người chơi";
    var totalPages = (int)Math.Ceiling(Model.TotalCount / 12.0);
}

<section class="space-y-6">
    <div class="flex items-end justify-between gap-4 flex-wrap">
        <div>
            <h1 class="text-3xl font-black tracking-tight">@(isEn ? "Player Community" : "Cộng đồng người chơi")</h1>
            <p class="text-slate-500 dark:text-slate-400">@(isEn ? "Find compatible players to connect and join matches." : "Tìm người chơi phù hợp để kết nối và tham gia trận.")</p>
        </div>
        <a asp-page="/Matchmaking/Index" class="px-4 py-2 rounded-md bg-primary text-white text-sm font-bold hover:bg-primary/90">@(isEn ? "Find Matches" : "Tìm trận đấu")</a>
    </div>

    <!-- Filter bar -->
    <form method="get" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md p-4 shadow-sm">
        <input type="hidden" name="PageNumber" value="1" />
        <div class="flex flex-wrap gap-3 items-end">
            <div class="flex-1 min-w-[160px]">
                <label class="block text-xs font-semibold text-slate-500 mb-1 uppercase">@(isEn ? "Sport" : "Môn thể thao")</label>
                <select name="SportFilter" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm py-2 focus:border-primary focus:ring-1 focus:ring-primary">
                    <option value="">@(isEn ? "All sports" : "Tất cả môn")</option>
                    @foreach (var sport in Model.SportOptions)
                    {
                        <option value="@sport" selected="@(Model.SportFilter == sport)">@sport</option>
                    }
                </select>
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-semibold text-slate-500 mb-1 uppercase">@(isEn ? "Location" : "Địa chỉ khu vực")</label>
                <input type="text" name="LocationFilter" value="@Model.LocationFilter"
                       placeholder="@(isEn ? "District, ward, city..." : "Quận, phường, tỉnh thành...")"
                       class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm py-2 focus:border-primary focus:ring-1 focus:ring-primary" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="px-4 py-2 bg-primary text-white rounded-md text-sm font-semibold hover:bg-primary/90 transition-colors">@(isEn ? "Filter" : "Lọc")</button>
                @if (!string.IsNullOrWhiteSpace(Model.SportFilter) || !string.IsNullOrWhiteSpace(Model.LocationFilter))
                {
                    <a asp-page="/Players/Index" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-md text-sm font-semibold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">@(isEn ? "Clear filters" : "Xóa lọc")</a>
                }
            </div>
        </div>
        @if (Model.TotalCount > 0)
        {
            <p class="text-xs text-slate-400 mt-2">@(isEn ? $"Found {Model.TotalCount} players" : $"Tìm thấy {Model.TotalCount} người chơi")</p>
        }
    </form>

    @if (!Model.Players.Any())
    {
        <div class="text-center py-20 text-slate-500">
            <span class="material-symbols-outlined text-5xl mb-4 block">group</span>
            <p class="text-lg font-semibold">@(isEn ? "No players found" : "Không tìm thấy người chơi")</p>
            <p class="text-sm mt-1">@(isEn ? "Try adjusting the filters or complete your profile!" : "Thử điều chỉnh bộ lọc hoặc hoàn thiện hồ sơ của bạn!")</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
            @foreach (var player in Model.Players)
            {
                <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md p-5 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-4 mb-3">
                        <img class="size-16 rounded-full object-cover flex-shrink-0" src="@player.AvatarUrl" alt="@player.FullName" />
                        <div class="min-w-0">
                            <h3 class="font-bold text-slate-900 dark:text-white truncate">@player.FullName</h3>
                            <p class="text-sm text-slate-500 dark:text-slate-400">@player.SkillLevel</p>
                            @if (!string.IsNullOrWhiteSpace(player.FavoriteSport))
                            {
                                <span class="inline-block mt-0.5 px-2 py-0.5 bg-primary/10 text-primary text-xs font-semibold rounded-md">@player.FavoriteSport</span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(player.DefaultAddress))
                    {
                        <div class="flex items-start gap-1.5 mb-3 text-xs text-slate-500 dark:text-slate-400">
                            <span class="material-symbols-outlined text-[14px] flex-shrink-0 mt-px text-primary">location_on</span>
                            <span class="line-clamp-2">@player.DefaultAddress</span>
                        </div>
                    }
                    <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-800 pt-3">
                        <div class="text-xs text-slate-500 dark:text-slate-400 space-y-0.5">
                            <div>
                                <span class="material-symbols-outlined text-[13px] align-middle">sports_tennis</span>
                                @player.TotalMatches @(isEn ? "matches played" : "trận đã chơi")
                            </div>
                            @if (player.Phone != null)
                            {
                                <div>
                                    <span class="material-symbols-outlined text-[13px] align-middle">phone</span>
                                    @player.Phone
                                </div>
                            }
                        </div>
                        <a asp-page="/Players/Profile" asp-route-id="@player.UserId" class="px-3 py-1.5 bg-primary/10 hover:bg-primary/20 text-primary rounded-md text-xs font-bold transition-colors">
                            @(isEn ? "View profile" : "Xem hồ sơ")
                        </a>
                    </div>
                </article>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="flex items-center justify-center gap-1 mt-4 flex-wrap">
                @if (Model.PageNumber > 1)
                {
                    <a asp-page="/Players/Index" asp-route-PageNumber="@(Model.PageNumber - 1)"
                       asp-route-SportFilter="@Model.SportFilter" asp-route-LocationFilter="@Model.LocationFilter"
                       class="px-3 py-1.5 rounded-md border border-slate-200 dark:border-slate-700 text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                        @(isEn ? "← Prev" : "← Trước")
                    </a>
                }
                @for (var p = Math.Max(1, Model.PageNumber - 2); p <= Math.Min(totalPages, Model.PageNumber + 2); p++)
                {
                    if (p == Model.PageNumber)
                    {
                        <span class="px-3 py-1.5 rounded-md bg-primary text-white text-sm font-bold">@p</span>
                    }
                    else
                    {
                        <a asp-page="/Players/Index" asp-route-PageNumber="@p"
                           asp-route-SportFilter="@Model.SportFilter" asp-route-LocationFilter="@Model.LocationFilter"
                           class="px-3 py-1.5 rounded-md border border-slate-200 dark:border-slate-700 text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                            @p
                        </a>
                    }
                }
                @if (Model.PageNumber < totalPages)
                {
                    <a asp-page="/Players/Index" asp-route-PageNumber="@(Model.PageNumber + 1)"
                       asp-route-SportFilter="@Model.SportFilter" asp-route-LocationFilter="@Model.LocationFilter"
                       class="px-3 py-1.5 rounded-md border border-slate-200 dark:border-slate-700 text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                        @(isEn ? "Next →" : "Tiếp →")
                    </a>
                }
                <span class="text-xs text-slate-400 ml-2">@(isEn ? $"Page {Model.PageNumber} of {totalPages}" : $"Trang {Model.PageNumber} / {totalPages}")</span>
            </div>
        }
    }
</section>
