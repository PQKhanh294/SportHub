@page
@model SportHub.Pages.Players.IndexModel
@{
    ViewData["Title"] = "Players";
}

<section class="space-y-6">
    <div class="flex items-end justify-between gap-4 flex-wrap">
        <div>
            <h1 class="text-4xl font-black tracking-tight">Suggested Players</h1>
            <p class="text-slate-500 dark:text-slate-400">Players with high compatibility for your next match.</p>
        </div>
        <a asp-page="/Matchmaking/Index" class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-bold hover:bg-primary/90">Back to matchmaking</a>
    </div>

    @if (!Model.Players.Any())
    {
        <div class="text-center py-20 text-slate-500">
            <span class="material-symbols-outlined text-5xl mb-4 block">group</span>
            <p class="text-lg font-semibold">No players found</p>
            <p class="text-sm mt-1">Be the first to complete your profile!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
            @foreach (var player in Model.Players)
            {
                <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center gap-4 mb-4">
                        <img class="size-16 rounded-full object-cover" src="@player.AvatarUrl" alt="@player.FullName" />
                        <div>
                            <h3 class="font-bold text-slate-900 dark:text-white">@player.FullName</h3>
                            <p class="text-sm text-slate-500 dark:text-slate-400">@player.SkillLevel</p>
                        </div>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500 dark:text-slate-400">
                            <span class="material-symbols-outlined text-xs align-middle">sports_tennis</span>
                            @player.TotalMatches matches played
                        </span>
                        <a asp-page="/Matchmaking/Create" class="px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary rounded-lg text-sm font-bold transition-colors">
                            Invite
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</section>
