@page
@model SportHub.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Cộng đồng người chơi";
    ViewData["ActivePage"] = "Community";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-black text-slate-900 dark:text-white">Cộng đồng người chơi</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Tìm kiếm và kết bạn với những người chung đam mê thể thao.</p>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm mb-8">
        <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-5 gap-4">
            <!-- Keyword -->
            <div class="lg:col-span-2">
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Tìm kiếm</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="material-symbols-outlined text-slate-400">search</span>
                    </span>
                    <input type="text" name="Keyword" value="@Model.Keyword" placeholder="Tên hoặc Email..."
                           class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary text-sm dark:text-white transition-all" />
                </div>
            </div>

            <!-- Skill Level -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Trình độ</label>
                <select name="SkillLevel" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary text-sm dark:text-white transition-all">
                    <option value="">Tất cả</option>
                    <option value="Beginner" selected="@(Model.SkillLevel == "Beginner")">Beginner</option>
                    <option value="Intermediate" selected="@(Model.SkillLevel == "Intermediate")">Intermediate</option>
                    <option value="Advanced" selected="@(Model.SkillLevel == "Advanced")">Advanced</option>
                    <option value="Professional" selected="@(Model.SkillLevel == "Professional")">Professional</option>
                </select>
            </div>

            <!-- Sort By -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Sắp xếp</label>
                <select name="SortBy" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-primary focus:border-primary text-sm dark:text-white transition-all">
                    <option value="newest" selected="@(Model.SortBy == "newest")">Mới nhất</option>
                    @if (Model.HasLocation)
                    {
                        <option value="distance" selected="@(Model.SortBy == "distance")">Gần tôi nhất</option>
                    }
                </select>
            </div>

            <!-- Submit -->
            <div class="flex items-end">
                <button type="submit" class="w-full py-2.5 px-4 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl transition-all shadow-md flex justify-center items-center gap-2">
                    <span class="material-symbols-outlined text-sm">filter_list</span>
                    Lọc
                </button>
            </div>
        </div>
    </form>

    <!-- Users Grid -->
    @if (!Model.Users.Any())
    {
        <div class="text-center py-20 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 border-dashed">
            <span class="material-symbols-outlined text-6xl text-slate-300 dark:text-slate-600 block mb-4">group_off</span>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Không tìm thấy ai</h3>
            <p class="text-slate-500 dark:text-slate-400 max-w-sm mx-auto">Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm để xem thêm nhiều người chơi khác.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var user in Model.Users)
            {
                var avatarUrl = string.IsNullOrWhiteSpace(user.AvatarUrl)
                    ? "/images/avatar-default.png"
                    : user.AvatarUrl;

                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm hover:shadow-md transition-shadow group flex flex-col relative overflow-hidden">
                    <div class="flex gap-4 items-start mb-4">
                        <a href="/Users/Profile/@user.UserId" class="flex-shrink-0">
                            <img src="@avatarUrl" alt="@user.FullName" class="size-16 rounded-full object-cover border-2 border-slate-100 dark:border-slate-700" />
                        </a>
                        <div class="min-w-0 flex-1">
                            <a href="/Users/Profile/@user.UserId" class="text-lg font-bold text-slate-900 dark:text-white truncate block hover:text-primary transition-colors">
                                @user.FullName
                            </a>
                            <div class="flex items-center gap-1 text-xs text-slate-500 mt-1">
                                <span class="material-symbols-outlined text-[14px]">military_tech</span>
                                <span>@user.SkillLevel</span>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2 mb-6">
                        <div class="flex justify-between items-center text-sm">
                            <span class="text-slate-500">Môn thể thao:</span>
                            <span class="font-semibold text-slate-700 dark:text-slate-300">@user.FavoriteSport</span>
                        </div>
                        @if (user.DistanceKm.HasValue)
                        {
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-slate-500">Khoảng cách:</span>
                                <span class="font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[14px] text-primary">near_me</span>
                                    @(user.DistanceKm.Value < 1 ? "< 1 km" : $"{user.DistanceKm.Value:F1} km")
                                </span>
                            </div>
                        }
                    </div>

                    <div class="mt-auto">
                        @if (user.RelationStatus == "None")
                        {
                            <form method="post" asp-page="/Users/Profile" asp-route-id="@user.UserId" asp-page-handler="AddFriend" class="w-full">
                                <button type="submit" class="w-full py-2 bg-slate-100 dark:bg-slate-800 hover:bg-primary hover:text-white text-slate-700 dark:text-slate-300 font-semibold rounded-xl transition-colors flex items-center justify-center gap-2 text-sm group-hover:bg-primary/10 group-hover:text-primary">
                                    <span class="material-symbols-outlined text-[18px]">person_add</span>
                                    Kết bạn
                                </button>
                            </form>
                        }
                        else if (user.RelationStatus == "Sent")
                        {
                            <button disabled class="w-full py-2 bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-500 font-semibold rounded-xl flex items-center justify-center gap-2 text-sm cursor-not-allowed border border-amber-200 dark:border-amber-800/50">
                                <span class="material-symbols-outlined text-[18px]">schedule</span>
                                Đã gửi lời mời
                            </button>
                        }
                        else if (user.RelationStatus == "Received")
                        {
                            <a href="/Users/Friends" class="w-full py-2 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-500 font-semibold rounded-xl flex items-center justify-center gap-2 text-sm hover:bg-emerald-100 dark:hover:bg-emerald-900/40 transition-colors border border-emerald-200 dark:border-emerald-800/50">
                                <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
                                Trả lời lời mời
                            </a>
                        }
                        else if (user.RelationStatus == "Friend")
                        {
                            <a href="/Messages/Index?userId=@user.UserId" class="w-full py-2 bg-primary text-white font-semibold rounded-xl flex items-center justify-center gap-2 text-sm hover:bg-primary/90 transition-colors shadow-sm">
                                <span class="material-symbols-outlined text-[18px]">chat</span>
                                Nhắn tin
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
