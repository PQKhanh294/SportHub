<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sport Hub</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary":          "#50A5B1",
                        "accent":           "#F1600D",
                        "navy":             "#1A265A",
                        "background-light": "#f5f4f0",
                        "background-dark":  "#0d1520",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg": "1rem",
                        "xl": "1.5rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 min-h-screen relative overflow-x-hidden">
    <div class="fixed inset-0 z-0">
        <video class="w-full h-full object-cover" autoplay muted loop playsinline preload="auto">
            <source src="/videos/SPORTHUB_EXE201.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-navy/60 backdrop-blur-[1px]"></div>
    </div>

    <header class="relative z-20 p-6 lg:p-10 flex items-center">
        <a asp-page="/Index" class="flex items-center gap-2 group">
            <img src="/images/logo sporthub.png" alt="Sport Hub" class="h-9 w-9 object-contain" />
            <span class="text-xl font-black text-white tracking-tighter uppercase">Sport Hub</span>
        </a>
    </header>

    <main class="relative z-10 flex items-center justify-center min-h-[calc(100vh-140px)] p-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="fixed top-20 right-4 z-50 bg-emerald-500 text-white px-5 py-2 rounded-xl shadow-lg" id="toast-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="fixed top-20 right-4 z-50 bg-red-500 text-white px-5 py-2 rounded-xl shadow-lg" id="toast-error">@TempData["ErrorMessage"]</div>
        }
        @RenderBody()
    </main>

    <footer class="relative z-10 p-8 text-center">
        <p class="text-xs text-white/50 font-medium uppercase tracking-widest">© @DateTime.Now.Year Sport Hub. All rights reserved.</p>
    </footer>

    <script>
        ['toast-success', 'toast-error'].forEach(id => {
            const el = document.getElementById(id);
            if (el) setTimeout(() => el.remove(), 3000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
