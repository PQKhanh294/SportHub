<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sport Hub</title>

    <!--
    ================================================================
    SPORT HUB — SHARED LAYOUT
    Nguồn thiết kế: Stitch MCP (project 17073324636926099521)
    Quy tắc: HTML5 + Tailwind CSS CDN + Vanilla JS ONLY (NO React/Vue)
    ================================================================
    -->

    <!-- Tailwind CSS CDN với plugins chính thức -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts: Inter (font chính của thiết kế) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Material Symbols Outlined (icon library của thiết kế) -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind Custom Config — Màu chủ đạo từ thiết kế Stitch -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary":            "#2560e9",  /* Màu brand chính */
                        "background-light":   "#f6f6f8",
                        "background-dark":    "#111621",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg":      "1rem",
                        "xl":      "1.5rem",
                        "full":    "9999px"
                    },
                },
            },
        }
    </script>

    <!-- Site CSS (scrollbar & badge utilities) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Theme Check Script (trước khi render body để tránh flash) -->
    <script>
        (function() {
            const theme = document.cookie.split('; ').find(row => row.startsWith('theme='))?.split('=')[1] || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    @* Cho phép từng trang thêm CSS riêng *@
    @await RenderSectionAsync("Styles", required: false)

    <!-- Google Tag Manager -->
    <script>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-W8LPQJT7');</script>
    <!-- End Google Tag Manager -->
</head>

@using System.Security.Claims
@inject SportHub.Services.Interfaces.IUserService UserService
@inject SportHub.Services.Interfaces.INotificationService NotificationService

@{
    string? currentUserAvatar = null;
    var unreadNotificationCount = 0;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    if (isAuthenticated)
    {
        var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userIdClaim, out var currentUserId) && currentUserId > 0)
        {
            var currentUser = await UserService.GetUserByIdAsync(currentUserId);
            currentUserAvatar = currentUser?.AvatarUrl;
            unreadNotificationCount = await NotificationService.GetUnreadCountAsync(currentUserId);
        }
    }
}

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 font-display">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W8LPQJT7"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
<!-- ================================================================
     NAVBAR — Thanh điều hướng cố định trên đầu
     ================================================================ -->
<header class="sticky top-0 z-50 w-full bg-white/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

            <!-- Logo -->
            <div class="flex items-center gap-2">
                <div class="text-primary">
                    <span class="material-symbols-outlined text-3xl">sports_tennis</span>
                </div>
                <a asp-page="/Index" class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Sport Hub</a>
            </div>

            <!-- Navigation Links (Desktop) -->
            <nav class="hidden md:flex items-center space-x-8">
                <a asp-page="/Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Home" ? "text-primary font-semibold border-b-2 border-primary pb-1" : "text-slate-600 dark:text-slate-400 hover:text-primary") text-sm font-medium transition-colors">
                    Trang chủ
                </a>
                <a asp-page="/Matchmaking/Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Matchmaking" ? "text-primary font-semibold border-b-2 border-primary pb-1" : "text-slate-600 dark:text-slate-400 hover:text-primary") text-sm font-medium transition-colors">
                    Ghép cặp
                </a>
                <a asp-page="/Courts/Search"
                   class="@(ViewData["ActivePage"]?.ToString() == "SearchCourts" ? "text-primary font-semibold border-b-2 border-primary pb-1" : "text-slate-600 dark:text-slate-400 hover:text-primary") text-sm font-medium transition-colors">
                    Tìm sân
                </a>
                <a asp-page="/Users/Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Community" ? "text-primary font-semibold border-b-2 border-primary pb-1" : "text-slate-600 dark:text-slate-400 hover:text-primary") text-sm font-medium transition-colors">
                    Cộng đồng
                </a>
                <a asp-page="/Bookings/MyBookings"
                   class="@(ViewData["ActivePage"]?.ToString() == "Bookings" ? "text-primary font-semibold border-b-2 border-primary pb-1" : "text-slate-600 dark:text-slate-400 hover:text-primary") text-sm font-medium transition-colors">
                    Lịch đặt
                </a>
                <a asp-page="/Profile/Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Profile" ? "text-primary font-semibold border-b-2 border-primary pb-1" : "text-slate-600 dark:text-slate-400 hover:text-primary") text-sm font-medium transition-colors">
                    Cá nhân
                </a>
                <a asp-page="/Settings/Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Settings" ? "text-primary font-semibold border-b-2 border-primary pb-1" : "text-slate-600 dark:text-slate-400 hover:text-primary") text-sm font-medium transition-colors">
                    Cài đặt
                </a>
            </nav>

            <!-- User Actions -->
            <div class="flex items-center gap-4">
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Friends -->
                    <a asp-page="/Users/Friends" class="hidden md:flex p-2 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors items-center" title="Bạn bè">
                        <span class="material-symbols-outlined">group</span>
                    </a>
                    
                    <!-- Chat -->
                    <a asp-page="/Messages/Index" class="hidden md:flex p-2 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors items-center" title="Tin nhắn">
                        <span class="material-symbols-outlined">chat</span>
                    </a>
                }

                <!-- Notification Bell -->
                <a asp-page="/Notifications/Index" class="relative p-2 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors flex items-center" title="Thông báo">
                    <span class="material-symbols-outlined">notifications</span>
                    <span id="notification-badge"
                          class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 flex items-center justify-center rounded-full bg-rose-500 text-white text-[10px] font-bold leading-none @(unreadNotificationCount > 0 ? "" : "hidden")">
                        @(unreadNotificationCount > 9 ? "9+" : unreadNotificationCount.ToString())
                    </span>
                </a>

                <!-- Avatar người dùng hiện tại -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex items-center gap-2">
                        <a asp-page="/Profile/Index" class="size-10 rounded-full bg-primary/10 border-2 border-primary/20 overflow-hidden block">
                            <img class="w-full h-full object-cover"
                                 src="@(string.IsNullOrWhiteSpace(currentUserAvatar) ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(User.Identity?.Name ?? "Sport Hub")}&background=E2E8F0&color=1E293B" : currentUserAvatar)"
                                 onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=Sport+Hub&background=E2E8F0&color=1E293B';"
                                 alt="@User.Identity.Name" />
                        </a>
                        <form method="post" asp-page="/Auth/Logout">
                            <button type="submit" class="text-sm font-semibold text-slate-600 hover:text-primary transition-colors">
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <a asp-page="/Auth/Login"
                           class="text-sm font-semibold text-slate-600 hover:text-primary transition-colors">
                            Đăng nhập
                        </a>
                        <a asp-page="/Auth/Register"
                           class="bg-primary hover:bg-primary/90 text-white text-sm font-bold py-2 px-4 rounded-lg transition-all">
                            Đăng ký
                        </a>
                    </div>
                }

                <!-- Hamburger Mobile -->
                <button id="mobile-menu-btn" class="md:hidden p-2 text-slate-600 dark:text-slate-400 hover:bg-slate-100 rounded-full">
                    <span class="material-symbols-outlined">menu</span>
                </button>
            </div>

        </div>

        <!-- Mobile Nav Dropdown -->
        <div id="mobile-menu" class="hidden md:hidden pb-4">
            <nav class="flex flex-col space-y-1 pt-2">
                <a asp-page="/Index" class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Trang chủ</a>
                <a asp-page="/Matchmaking/Index" class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Ghép cặp</a>
                <a asp-page="/Courts/Search" class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Tìm sân</a>
                <a asp-page="/Users/Index" class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Cộng đồng</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Users/Friends" class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Bạn bè</a>
                    <a asp-page="/Messages/Index" class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Tin nhắn</a>
                }
                <a asp-page="/Bookings/MyBookings" class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Lịch đặt</a>
                <a asp-page="/Profile/Index" class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Cá nhân</a>
                <a asp-page="/Settings/Index" class="px-3 py-2 text-sm font-medium rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">Cài đặt</a>
            </nav>
        </div>

    </div>
</header>

<!-- ================================================================
     MAIN CONTENT — Từng trang Razor sẽ render vào đây
     ================================================================ -->
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    @* Toast Notifications (TempData) *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="fixed top-20 right-4 z-50 bg-emerald-500 text-white px-6 py-3 rounded-xl shadow-lg flex items-center gap-2 animate-pulse" id="toast-success">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="fixed top-20 right-4 z-50 bg-red-500 text-white px-6 py-3 rounded-xl shadow-lg flex items-center gap-2" id="toast-error">
            <span class="material-symbols-outlined">error</span>
            @TempData["ErrorMessage"]
        </div>
    }

    @RenderBody()
</main>

<!-- ================================================================
     FOOTER — Trích xuất 1:1 từ Stitch MCP Home Page
     ================================================================ -->
<footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <div class="flex flex-col md:flex-row justify-between items-center gap-8">

            <!-- Logo -->
            <div class="flex items-center gap-2">
                <div class="text-primary">
                    <span class="material-symbols-outlined text-3xl">sports_tennis</span>
                </div>
                <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Sport Hub</span>
            </div>

            <!-- Footer Links -->
            <div class="flex flex-wrap justify-center gap-8 text-sm font-medium text-slate-500 dark:text-slate-400">
                <a class="hover:text-primary transition-colors" href="#">Về chúng tôi</a>
                <a class="hover:text-primary transition-colors" href="#">Quy tắc cộng đồng</a>
                <a class="hover:text-primary transition-colors" href="#">Chính sách bảo mật</a>
                <a class="hover:text-primary transition-colors" href="#">Điều khoản sử dụng</a>
                <a class="hover:text-primary transition-colors" href="#">Hỗ trợ</a>
            </div>

            <!-- Social Icons -->
            <div class="flex gap-4">
                <a class="size-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-primary hover:text-white transition-all" href="#">
                    <span class="material-symbols-outlined">share</span>
                </a>
                <a class="size-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-primary hover:text-white transition-all" href="#">
                    <span class="material-symbols-outlined">chat</span>
                </a>
            </div>

        </div>

        <!-- Copyright -->
        <div class="mt-8 pt-8 border-t border-slate-100 dark:border-slate-800 text-center text-slate-400 text-xs">
            &copy; @DateTime.Now.Year Sport Hub. Bản quyền thuộc về đội ngũ phát triển.
        </div>

    </div>
</footer>

<!-- ================================================================
     VANILLA JS — Mobile menu toggle + Toast auto-dismiss
     ================================================================ -->
<script>
    // Mobile menu toggle
    const btn  = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
        btn.addEventListener('click', () => menu.classList.toggle('hidden'));
    }

    // Auto-dismiss toast sau 3 giây
    ['toast-success', 'toast-error'].forEach(id => {
        const el = document.getElementById(id);
        if (el) setTimeout(() => el.remove(), 3000);
    });
</script>

<!-- Global Toast Notification Container -->
<div id="toast-container" class="fixed top-24 right-4 z-[9999] flex flex-col gap-2 pointer-events-none w-80 sm:w-96">
</div>

<script>
    function showToast(title, message, linkUrl, type) {
        const container = document.getElementById('toast-container');
        if (!container) return;
        
        let icon = "notifications";
        let color = "bg-primary";
        if (type === "Chat") {
            icon = "chat";
            color = "bg-indigo-500";
        } else if (title.includes("kết bạn")) {
            icon = "person_add";
            color = "bg-emerald-500";
        }
        
        const toastId = "toast-" + Date.now();
        const html = `
            <div id="${toastId}" class="pointer-events-auto max-w-sm w-full bg-white dark:bg-slate-800 shadow-lg rounded-xl pointer-events-auto flex ring-1 ring-black ring-opacity-5 overflow-hidden transition-all duration-300 translate-y-4 opacity-0 transform">
                <div class="w-2 flex ${color}"></div>
                <div class="flex-1 p-4">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <span class="material-symbols-outlined text-slate-400 dark:text-slate-500">${icon}</span>
                        </div>
                        <div class="ml-3 w-0 flex-1 pt-0.5">
                            <p class="text-sm font-semibold text-slate-900 dark:text-white">
                                ${title}
                            </p>
                            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400 line-clamp-2">
                                ${message}
                            </p>
                            ${linkUrl ? `<a href="${linkUrl}" class="mt-2 text-xs font-semibold text-primary hover:underline block">Xem chi tiết</a>` : ''}
                        </div>
                        <div class="ml-4 flex-shrink-0 flex">
                            <button onclick="document.getElementById('${toastId}').remove()" class="bg-transparent rounded-md inline-flex text-slate-400 hover:text-slate-500 focus:outline-none">
                                <span class="sr-only">Close</span>
                                <span class="material-symbols-outlined text-xl">close</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        container.insertAdjacentHTML('beforeend', html);
        const el = document.getElementById(toastId);
        
        // Animate in
        setTimeout(() => {
            el.classList.remove('translate-y-4', 'opacity-0');
        }, 50);
        
        // Auto remove after 5 seconds
        setTimeout(() => {
            if (document.getElementById(toastId)) {
                el.classList.add('opacity-0', 'translate-x-full');
                setTimeout(() => el.remove(), 300);
            }
        }, 5000);
    }
    
    // Listen to global events
    window.addEventListener('sporthub:notification', function(e) {
        const payload = e.detail;
        if (payload) {
            showToast(payload.title, payload.message, payload.linkUrl, payload.type);
            
            // Nếu có âm thanh
            try {
                const audio = new Audio('/sounds/notification.mp3');
                audio.play().catch(e => {}); // Bỏ qua nếu browser block autoplay
            } catch (err) {}
        }
    });
</script>

@if (isAuthenticated)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        (function () {
            const badgeEl = document.getElementById('notification-badge');

            function setUnreadCount(count) {
                const n = Number(count) || 0;
                if (!badgeEl) return;
                if (n <= 0) {
                    badgeEl.classList.add('hidden');
                    badgeEl.textContent = '';
                    return;
                }
                badgeEl.classList.remove('hidden');
                badgeEl.textContent = n > 9 ? '9+' : String(n);
            }

            if (!window.signalR) return;

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/notifications')
                .withAutomaticReconnect()
                .build();

            connection.on('notification_received', function (payload) {
                if (payload && payload.unreadCount != null) {
                    setUnreadCount(payload.unreadCount);
                }
                if (payload && payload.type === 'Chat') {
                    if (window.location.pathname.toLowerCase().includes('/messages')) {
                        const urlParams = new URLSearchParams(window.location.search);
                        // Extract senderId from linkUrl if possible, or just skip toast if on chat page
                        const linkUrl = payload.linkUrl || '';
                        if (linkUrl.includes(urlParams.get('userId'))) {
                            return; // Đang chat với người này rồi thì không hiện toast nữa
                        }
                    }
                }
                window.dispatchEvent(new CustomEvent('sporthub:notification', { detail: payload }));
            });

            connection.on('notifications_read', function (payload) {
                if (payload && payload.unreadCount != null) {
                    setUnreadCount(payload.unreadCount);
                } else {
                    setUnreadCount(0);
                }
            });

            connection.start().catch(function (err) {
                console.warn('Notification realtime disabled:', err);
            });
        })();
    </script>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
