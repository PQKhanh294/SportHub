<script src="~/js/sporthub-ux.js" asp-append-version="true"></script>
<script>
(function() {
    var LIGHT_AV = '/images/avatar-default.png';
    var DARK_AV  = '/images/avatar-default-dark.png';

    function syncDefaultAvatars() {
        var isDark = document.documentElement.classList.contains('dark');
        var target = isDark ? DARK_AV : LIGHT_AV;
        var other  = isDark ? LIGHT_AV : DARK_AV;
        document.querySelectorAll('img').forEach(function(img) {
            var s = img.getAttribute('src') || '';
            if (s === LIGHT_AV || s === DARK_AV) {
                if (s !== target) img.src = target;
            }
            // also fix onerror handlers pointing to the default
            if ((img.src === window.location.origin + LIGHT_AV || img.src === window.location.origin + DARK_AV)) {
                if (img.src !== window.location.origin + target) img.src = target;
            }
        });
    }

    // Run immediately after DOM is ready (avatars already in page)
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncDefaultAvatars);
    } else {
        syncDefaultAvatars();
    }

    // Watch for dark class / data-theme change (theme toggle)
    new MutationObserver(syncDefaultAvatars).observe(
        document.documentElement,
        { attributes: true, attributeFilter: ['class', 'data-theme'] }
    );

    // Also watch for dynamically added avatars (chat, SignalR messages, etc.)
    new MutationObserver(function(mutations) {
        var needsSync = false;
        mutations.forEach(function(m) {
            m.addedNodes.forEach(function(n) {
                if (n.nodeType === 1) {
                    if (n.tagName === 'IMG') needsSync = true;
                    else if (n.querySelector && n.querySelector('img')) needsSync = true;
                }
            });
        });
        if (needsSync) syncDefaultAvatars();
    }).observe(document.body || document.documentElement, { childList: true, subtree: true });
})();
</script>

@* ================================================================
   MOBILE BOTTOM NAVIGATION — lg:hidden
   ================================================================ *@
<nav id="mobile-bottom-nav" class="fixed bottom-0 left-0 right-0 z-40 lg:hidden bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800">
    <div class="flex items-center justify-around h-14 max-w-lg mx-auto">
        @{
            var bnActivePage = ViewData["ActivePage"]?.ToString() ?? "";
        }
        <!-- Home -->
        <a asp-page="/Index" class="flex flex-col items-center gap-0.5 px-4 min-w-[52px] @(bnActivePage == "Home" ? "text-primary" : "text-slate-400 dark:text-slate-500")">
            <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' @(bnActivePage == "Home" ? "1" : "0")">home</span>
            <span class="text-[10px] font-semibold">@navHome</span>
        </a>
        <!-- Matchmaking -->
        <a asp-page="/Matchmaking/Index" id="bn-matchmaking" class="flex flex-col items-center gap-0.5 px-4 min-w-[52px] @(bnActivePage == "Matchmaking" ? "text-primary" : "text-slate-400 dark:text-slate-500")">
            <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' @(bnActivePage == "Matchmaking" ? "1" : "0")">sports</span>
            <span class="text-[10px] font-semibold">@navMatchmaking</span>
        </a>
        @if (isAuthenticated)
        {
            <!-- Messages -->
            <a asp-page="/Messages/Index" class="relative flex flex-col items-center gap-0.5 px-4 min-w-[52px] @(bnActivePage == "Messages" ? "text-primary" : "text-slate-400 dark:text-slate-500")">
                <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' @(bnActivePage == "Messages" ? "1" : "0")">chat_bubble</span>
                <span id="bn-chat-badge" class="absolute top-0 right-2 min-w-[16px] h-4 px-1 flex items-center justify-center rounded-full bg-accent text-white text-[9px] font-bold leading-none @(unreadChatCount > 0 ? "" : "hidden")">@(unreadChatCount > 9 ? "9+" : unreadChatCount.ToString())</span>
                <span class="text-[10px] font-semibold">@navMessages</span>
            </a>
            <!-- Friends -->
            <a asp-page="/Users/Friends" class="flex flex-col items-center gap-0.5 px-4 min-w-[52px] @(bnActivePage == "Friends" ? "text-primary" : "text-slate-400 dark:text-slate-500")">
                <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' @(bnActivePage == "Friends" ? "1" : "0")">group</span>
                <span class="text-[10px] font-semibold">@navFriends</span>
            </a>
        }
        <!-- More -->
        <button onclick="openMoreSheet()" id="bn-more" class="flex flex-col items-center gap-0.5 px-4 min-w-[52px] text-slate-400 dark:text-slate-500 bg-transparent border-none cursor-pointer">
            <span class="material-symbols-outlined text-[24px]">more_horiz</span>
            <span class="text-[10px] font-semibold">@navMore</span>
        </button>
    </div>
</nav>

@* More Sheet (slide-up) *@
<div id="more-sheet-overlay" class="fixed inset-0 z-50 lg:hidden hidden bg-black/40 backdrop-blur-sm" onclick="closeMoreSheet()">
</div>
<div id="more-sheet" class="fixed bottom-0 left-0 right-0 z-50 lg:hidden bg-white dark:bg-slate-900 rounded-t-2xl shadow-2xl transform translate-y-full transition-transform duration-300 ease-out" style="padding-bottom: env(safe-area-inset-bottom, 16px)">
    <!-- Handle bar -->
    <div class="flex justify-center pt-3 pb-2">
        <div class="w-10 h-1 bg-slate-300 dark:bg-slate-600 rounded-full"></div>
    </div>
    @if (isAuthenticated)
    {
        <!-- User info row -->
        <div class="flex items-center gap-3 px-5 pb-4 border-b border-slate-100 dark:border-slate-800">
            <img class="w-11 h-11 rounded-full object-cover ring-2 ring-primary/30"
                 src="@(string.IsNullOrWhiteSpace(currentUserAvatar) ? "/images/avatar-default.png" : currentUserAvatar)"
                 onerror="this.onerror=null;this.src='/images/avatar-default.png';" alt="Avatar" />
            <div class="flex-1 min-w-0">
                <p class="text-sm font-bold text-slate-900 dark:text-white truncate">@(User.Identity?.Name ?? "Người dùng")</p>
                @if (currentPlanKey != null && currentPlanKey != "Free")
                {
                    <span class="text-xs font-semibold text-primary">@currentPlanKey</span>
                }
            </div>
            <a href="/Wallet" onclick="closeMoreSheet()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-bold">
                <span class="material-symbols-outlined text-sm">account_balance_wallet</span>
                @currentWalletBalance.ToString("N0") xu
            </a>
        </div>
        <div class="py-2 px-2">
            <a href="/Profile" onclick="closeMoreSheet()" class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                <span class="material-symbols-outlined text-primary">person</span>
                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">@navProfile</span>
            </a>
            <a href="/Users/Index" onclick="closeMoreSheet()" class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                <span class="material-symbols-outlined text-slate-400">groups</span>
                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">@navCommunity</span>
            </a>
            <a href="/Matchmaking/Create" onclick="closeMoreSheet()" class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                <span class="material-symbols-outlined text-accent">add_circle</span>
                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">@createMatchText</span>
            </a>
            <a href="/Subscription" onclick="closeMoreSheet()" class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                <span class="material-symbols-outlined text-amber-500">workspace_premium</span>
                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Gói đăng ký</span>
            </a>
            <a href="/Settings" onclick="closeMoreSheet()" class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                <span class="material-symbols-outlined text-slate-400">settings</span>
                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">@navSettings</span>
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a href="/Admin" onclick="closeMoreSheet()" class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-accent/5 transition-colors">
                    <span class="material-symbols-outlined text-accent">admin_panel_settings</span>
                    <span class="text-sm font-medium text-accent">Admin</span>
                </a>
            }
            <div class="border-t border-slate-100 dark:border-slate-800 mt-1 pt-1">
                <form method="post" asp-page="/Auth/Logout">
                    <button type="submit" class="w-full flex items-center gap-3 px-4 py-3 rounded-md hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors">
                        <span class="material-symbols-outlined text-rose-500">logout</span>
                        <span class="text-sm font-medium text-rose-600">@logoutText</span>
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="px-5 py-4 flex flex-col gap-3">
            <a asp-page="/Auth/Login" onclick="closeMoreSheet()" class="block text-center py-3 rounded-md border border-slate-300 dark:border-slate-600 text-sm font-semibold text-slate-700 dark:text-slate-300">@loginText</a>
            <a asp-page="/Auth/Register" onclick="closeMoreSheet()" class="block text-center py-3 rounded-md bg-primary text-white text-sm font-semibold">@registerText</a>
        </div>
    }
</div>
<script>
function openMoreSheet() {
    document.getElementById('more-sheet-overlay').classList.remove('hidden');
    requestAnimationFrame(function() {
        document.getElementById('more-sheet').style.transform = 'translateY(0)';
    });
}
function closeMoreSheet() {
    document.getElementById('more-sheet').style.transform = 'translateY(100%)';
    setTimeout(function() {
        document.getElementById('more-sheet-overlay').classList.add('hidden');
    }, 300);
}
// Sync chat badge on bottom nav
window._origSetChatBadge = window.setChatBadge;
window.setChatBadge = function(n) {
    if (window._origSetChatBadge) window._origSetChatBadge(n);
    var bn = document.getElementById('bn-chat-badge');
    if (!bn) return;
    if (n > 0) { bn.textContent = n > 9 ? '9+' : String(n); bn.classList.remove('hidden'); }
    else { bn.classList.add('hidden'); }
};

// ---- Draggable floating buttons ----
(function() {
    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
    var EDGE_MARGIN = 20;
    var FAB_GAP = 10;
    var PANEL_H = 490; // panel height — used to clamp vertical offset so panel fits on screen

    // Apply resting position.
    // Panel is always BESIDE the FAB (row layout), never above/below.
    // side='left'  → flex-direction:row         → FAB left,  panel RIGHT of FAB
    // side='right' → flex-direction:row-reverse  → FAB right, panel LEFT  of FAB
    // vhalf='top'  → align-items:flex-start, top:offset  → tops  of FAB & panel align
    // vhalf='bottom'→ align-items:flex-end,  bottom:offset→ bottoms of FAB & panel align
    function applyRestPos(wrap, snap) {
        // DOM order: [panel, FAB]
        // row         → panel LEFT,  FAB RIGHT  → use for RIGHT-side snap (FAB hugs right edge)
        // row-reverse → FAB  LEFT,  panel RIGHT → use for LEFT-side  snap (FAB hugs left edge)
        if (snap.side === 'left') {
            wrap.style.setProperty('right', 'auto', 'important');
            wrap.style.left = EDGE_MARGIN + 'px';
            wrap.style.flexDirection = 'row-reverse'; // FAB left, panel extends RIGHT
        } else {
            wrap.style.left = '';
            wrap.style.setProperty('right', EDGE_MARGIN + 'px', 'important');
            wrap.style.flexDirection = 'row';         // panel left, FAB at right edge
        }
        if (snap.vhalf === 'top') {
            wrap.style.top = snap.offset + 'px';
            wrap.style.setProperty('bottom', 'auto', 'important');
            wrap.style.alignItems = 'flex-start';
        } else {
            wrap.style.top = '';
            wrap.style.setProperty('bottom', snap.offset + 'px', 'important');
            wrap.style.alignItems = 'flex-end';
        }
    }

    // Compute snap target from FAB's current screen position.
    // Always uses fab.getBoundingClientRect() — immune to whether panel is open.
    function computeSnap(fab) {
        var r = fab.getBoundingClientRect();
        var W = window.innerWidth, H = window.innerHeight;
        var side  = (r.left + r.width  / 2 < W / 2) ? 'left' : 'right';
        var vhalf = (r.top  + r.height / 2 < H / 2) ? 'top'  : 'bottom';
        // Clamp offset so the 490px panel never clips top/bottom edges
        var maxOffset = Math.max(H - PANEL_H - 4, EDGE_MARGIN);
        var offset = (vhalf === 'top')
            ? clamp(r.top, EDGE_MARGIN, maxOffset)
            : clamp(H - r.bottom, EDGE_MARGIN, maxOffset);
        return { side: side, vhalf: vhalf, offset: offset };
    }

    function makeFloatingDraggable(wrap, fab, storageKey, partnerId, partnerKey) {
        if (!wrap || !fab) return;
        var dragging = false, didMove = false;
        var startCX, startCY, startLeft, startTop;
        var THRESHOLD = 6;

        // During drag: position wrap by left+top anchored to FAB's top-left corner.
        // flex-direction:row keeps FAB as the leftmost element during drag.

        function resetToDefault() {
            localStorage.removeItem(storageKey);
            wrap._userDragged = false;
            wrap.style.left = '';
            wrap.style.top = '';
            wrap.style.flexDirection = 'row';
            wrap.style.alignItems = 'flex-end';
            // Restore bottom anchor; let updateRightSidebarState set the correct right value
            wrap.style.setProperty('bottom', '24px', 'important');
            if (typeof window.updateRightSidebarState === 'function') window.updateRightSidebarState();
        }

        // After snap, push partner FAB away vertically if they overlap
        function preventOverlap() {
            var partner = partnerId ? document.getElementById(partnerId) : null;
            if (!partner) return;
            setTimeout(function() {
                var r1 = fab.getBoundingClientRect();
                var pFab = partner.querySelector('[id$="-fab"],[id$="-fab-btn"]') || partner;
                var r2 = pFab.getBoundingClientRect();
                var sameSide = Math.abs((r1.left + r1.right) / 2 - (r2.left + r2.right) / 2) < 60;
                if (!sameSide) return;
                var overlap = Math.min(r1.bottom, r2.bottom) - Math.max(r1.top, r2.top);
                if (overlap < FAB_GAP) return;
                var newBottom = (r1.top <= r2.top)
                    ? clamp(window.innerHeight - r1.bottom - r2.height - FAB_GAP, EDGE_MARGIN, window.innerHeight - r2.height - EDGE_MARGIN)
                    : clamp(window.innerHeight - r1.top + FAB_GAP, EDGE_MARGIN, window.innerHeight - r2.height - EDGE_MARGIN);
                partner.style.setProperty('bottom', newBottom + 'px', 'important');
                partner.style.top = '';
                partner.style.alignItems = 'flex-end';
                try {
                    var ps = JSON.parse(localStorage.getItem(partnerKey) || 'null');
                    if (ps) { ps.offset = newBottom; ps.vhalf = 'bottom'; localStorage.setItem(partnerKey, JSON.stringify(ps)); }
                } catch(e) {}
            }, 430);
        }

        function onStart(cx, cy) {
            // Freeze transitions without repositioning (avoids jump if panel is open)
            wrap.classList.add('fab-dragging');
            var r = fab.getBoundingClientRect();
            startCX = cx; startCY = cy;
            startLeft = r.left; startTop = r.top;
            dragging = true; didMove = false;
            document.body.style.userSelect = 'none';
        }

        function onMove(cx, cy) {
            if (!dragging) return;
            var dx = cx - startCX, dy = cy - startCY;
            if (!didMove && (Math.abs(dx) > THRESHOLD || Math.abs(dy) > THRESHOLD)) {
                didMove = true;
                // First confirmed drag: close panel, switch to left+top anchored to FAB
                var p = wrap.querySelector('[id$="-panel"]');
                if (p) p.style.display = 'none';
                wrap.style.flexDirection = 'row'; // panel hidden → wrap shrinks to FAB size
                wrap.style.alignItems = 'flex-start';
                wrap.style.setProperty('right', 'auto', 'important');
                wrap.style.setProperty('bottom', 'auto', 'important');
                wrap.style.left = startLeft + 'px';
                wrap.style.top  = startTop  + 'px';
            }
            if (!didMove) return;
            wrap.style.left = clamp(startLeft + dx, EDGE_MARGIN, window.innerWidth  - fab.offsetWidth  - EDGE_MARGIN) + 'px';
            wrap.style.top  = clamp(startTop  + dy, EDGE_MARGIN, window.innerHeight - fab.offsetHeight - EDGE_MARGIN) + 'px';
        }

        function onEnd() {
            if (!dragging) return;
            dragging = false;
            document.body.style.userSelect = '';
            if (!didMove) { wrap.classList.remove('fab-dragging'); return; }

            wrap._userDragged = true;
            var snap = computeSnap(fab);

            if (snap.side === 'right') {
                // Animate FAB sliding to right edge via left-transition, then switch to right-positioning
                var targetLeft = window.innerWidth - fab.offsetWidth - EDGE_MARGIN;
                wrap.classList.remove('fab-dragging');
                wrap.style.left = targetLeft + 'px';
                var done = false;
                var finalize = function() {
                    if (done) return; done = true;
                    wrap.removeEventListener('transitionend', onTrans);
                    wrap.classList.add('fab-dragging');
                    applyRestPos(wrap, snap);
                    requestAnimationFrame(function() { wrap.classList.remove('fab-dragging'); });
                };
                var onTrans = function(e) { if (e.propertyName === 'left') finalize(); };
                wrap.addEventListener('transitionend', onTrans);
                setTimeout(finalize, 400);
            } else {
                wrap.classList.remove('fab-dragging');
                applyRestPos(wrap, snap);
            }

            preventOverlap();
            try { localStorage.setItem(storageKey, JSON.stringify(snap)); } catch(e) {}
        }

        // Restore saved position on page load (new format uses vhalf, not vdir)
        try {
            var saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
            if (saved && saved.side && saved.vhalf && typeof saved.offset === 'number') {
                wrap.classList.add('fab-dragging');
                applyRestPos(wrap, saved);
                wrap._userDragged = true;
                requestAnimationFrame(function() { wrap.classList.remove('fab-dragging'); });
            }
        } catch(e) {}

        // Touch events
        fab.addEventListener('touchstart', function(e) {
            var t = e.touches[0]; onStart(t.clientX, t.clientY);
        }, { passive: true });
        document.addEventListener('touchmove', function(e) {
            if (!dragging) return;
            e.preventDefault();
            var t = e.touches[0]; onMove(t.clientX, t.clientY);
        }, { passive: false });
        document.addEventListener('touchend', function() { onEnd(); });

        // Mouse events
        fab.addEventListener('mousedown', function(e) {
            if (e.button !== 0) return; onStart(e.clientX, e.clientY); e.preventDefault();
        });
        document.addEventListener('mousemove', function(e) { if (dragging) onMove(e.clientX, e.clientY); });
        document.addEventListener('mouseup', function() { onEnd(); });

        // Block click when this was a drag not a tap
        fab.addEventListener('click', function(e) {
            if (didMove) { e.stopImmediatePropagation(); didMove = false; }
        }, true);

        fab.style.cursor = 'grab';
    }

    document.addEventListener('DOMContentLoaded', function() {
        makeFloatingDraggable(
            document.getElementById('ai-chat-wrap'), document.getElementById('ai-fab'),
            'sh_ai_fab_pos', 'chat-popup-wrap', 'sh_chat_fab_pos'
        );
        makeFloatingDraggable(
            document.getElementById('chat-popup-wrap'), document.getElementById('chat-fab-btn'),
            'sh_chat_fab_pos', 'ai-chat-wrap', 'sh_ai_fab_pos'
        );
    });
})();
</script>
<script>
// Mobile: keep AI panel above the on-screen keyboard using visualViewport API
(function () {
    if (!window.visualViewport) return;
    var panel = document.getElementById('ai-panel');
    if (!panel) return;
    var BASE_BOTTOM = 148, _adjusting = false;

    function adjust() {
        if (window.innerWidth >= 1024) return;
        if (panel.style.display !== 'flex') { panel.style.bottom = ''; return; }
        var kbH = Math.max(0, window.innerHeight - window.visualViewport.height - window.visualViewport.offsetTop);
        _adjusting = true;
        panel.style.bottom = (kbH > 80 ? kbH + 8 : BASE_BOTTOM) + 'px';
        _adjusting = false;
    }

    window.visualViewport.addEventListener('resize', adjust);
    window.visualViewport.addEventListener('scroll', adjust);

    // Fire adjust when panel visibility changes (handles keyboard-already-open case)
    new MutationObserver(function () {
        if (_adjusting) return;
        adjust();
    }).observe(panel, { attributeFilter: ['style'] });
})();
</script>
<script>
// Mobile: keep AI sidebar (fullscreen) header above the on-screen keyboard using visualViewport API
(function () {
    if (!window.visualViewport) return;
    var sidebar = document.getElementById('ai-sidebar');
    if (!sidebar) return;

    function adjust() {
        if (window.innerWidth >= 1024 || !sidebar.classList.contains('open')) {
            sidebar.style.top = ''; sidebar.style.height = ''; sidebar.style.bottom = '';
            return;
        }
        var vv = window.visualViewport;
        sidebar.style.top = vv.offsetTop + 'px';
        sidebar.style.height = vv.height + 'px';
        sidebar.style.bottom = 'auto';
    }

    window.visualViewport.addEventListener('resize', adjust);
    window.visualViewport.addEventListener('scroll', adjust);

    // Fire adjust when sidebar open/close toggles (handles keyboard-already-open case)
    new MutationObserver(adjust).observe(sidebar, { attributeFilter: ['class'] });
})();
</script>
</body>
</html>
