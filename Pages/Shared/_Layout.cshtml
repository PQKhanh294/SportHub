<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sport Hub</title>
    <link rel="icon" type="image/png" href="/images/LOGO SPORTHUB 2.png" />
    @if (Context.Request.Path.StartsWithSegments("/Admin"))
    {
        <!-- Prevent browser auto-translate on admin pages (always English) -->
        <meta name="google" content="notranslate" />
    }

    <!--
    ================================================================
    SPORT HUB — SHARED LAYOUT
    Nguồn thiết kế: Stitch MCP (project 17073324636926099521)
    Quy tắc: HTML5 + Tailwind CSS CDN + Vanilla JS ONLY (NO React/Vue)
    ================================================================
    -->

    <!-- Tailwind CSS CDN với plugins chính thức -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts: Inter (font chính của thiết kế) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- Material Symbols Outlined (icon library của thiết kế) -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind Custom Config — Màu chủ đạo từ thiết kế Stitch -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary":            "#50A5B1",  /* Teal Refresh — màu brand chính */
                        "accent":             "#F1600D",  /* Cam đỏ thể thao */
                        "navy":               "#1A265A",  /* Navy đậm */
                        "background-light":   "#f5f4f0",  /* Warm off-white */
                        "background-dark":    "#0d1520",  /* Navy tối */
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"],
                        "sport":   ["Barlow Condensed", "Inter", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.5rem",
                        "lg":      "1rem",
                        "xl":      "1.5rem",
                        "full":    "9999px"
                    },
                },
            },
        }
    </script>

    <!-- Site CSS (scrollbar & badge utilities) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Theme Check Script (trước khi render body để tránh flash) -->
    <script>
        (function() {
            const theme = document.cookie.split('; ').find(row => row.startsWith('theme='))?.split('=')[1] || 'light';
            const el = document.documentElement;
            if (theme === 'dark' || theme === 'dark-2' || theme === 'dark-3') {
                el.classList.add('dark');
            } else {
                el.classList.remove('dark');
            }
            el.setAttribute('data-theme', theme);
        })();
    </script>
    <style>
    /* Dark Level 2 — Đậm hơn */
    [data-theme="dark-2"] body                      { background-color: #06090f !important; }
    [data-theme="dark-2"] header                    { background-color: rgba(6,9,15,0.92) !important; }
    [data-theme="dark-2"] footer                    { background-color: #06090f !important; }
    [data-theme="dark-2"] .dark\:bg-slate-900       { background-color: #090e1a !important; }
    [data-theme="dark-2"] .dark\:bg-slate-800       { background-color: #0e1524 !important; }
    [data-theme="dark-2"] .dark\:border-slate-800   { border-color: #121c30 !important; }

    /* Dark Level 3 — AMOLED / Đen tuyệt đối */
    [data-theme="dark-3"] body                      { background-color: #000000 !important; }
    [data-theme="dark-3"] header                    { background-color: rgba(0,0,0,0.95) !important; }
    [data-theme="dark-3"] footer                    { background-color: #000000 !important; }
    [data-theme="dark-3"] .dark\:bg-slate-900       { background-color: #080808 !important; }
    [data-theme="dark-3"] .dark\:bg-slate-800       { background-color: #101010 !important; }
    [data-theme="dark-3"] .dark\:border-slate-800   { border-color: #1a1a1a !important; }

    /* Logo footer — nảy như quả bóng khi hover/chạm vào */
    @@keyframes sh-logo-ball-bounce {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        25%      { transform: translateY(-7px) rotate(-18deg); }
        50%      { transform: translateY(0) rotate(0deg); }
        75%      { transform: translateY(-3px) rotate(18deg); }
    }
    .footer-logo-ball { cursor: pointer; transition: transform 0.15s ease; }
    .footer-logo-ball:hover,
    .footer-logo-ball:active { animation: sh-logo-ball-bounce 0.6s ease-in-out infinite; }
    </style>

    @* Cho phép từng trang thêm CSS riêng *@
    @await RenderSectionAsync("Styles", required: false)

    <!-- Google Tag Manager -->
    <script>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-W8LPQJT7');</script>
    <!-- End Google Tag Manager -->
</head>

@using System.Globalization
@using System.Security.Claims
@inject SportHub.Services.Interfaces.IUserService UserService
@inject SportHub.Services.Interfaces.INotificationService NotificationService
@inject SportHub.Services.Interfaces.IWalletService WalletService
@inject SportHub.Services.Interfaces.ISubscriptionService SubscriptionService

@{
    string? currentUserAvatar = null;
    var unreadNotificationCount = 0;
    var unreadChatCount = 0;
    decimal currentWalletBalance = 0m;
    string? currentPlanKey = null;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var showProfileBanner = false;
    var redirectToProfile = false;
    var showProfileModal = false;
    var isFirstLogin = false;
    var redirectToBanned = false;
    if (isAuthenticated)
    {
        var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userIdClaim, out var currentUserId) && currentUserId > 0)
        {
            var currentUser = await UserService.GetUserByIdAsync(currentUserId);
            currentUserAvatar = currentUser?.AvatarUrl;
            unreadNotificationCount = await NotificationService.GetUnreadCountAsync(currentUserId);
            unreadChatCount = await NotificationService.GetUnreadChatCountAsync(currentUserId);
            currentWalletBalance = currentUser?.WalletBalance ?? 0m;
            var activeSub = await SubscriptionService.GetActiveSubscriptionAsync(currentUserId);
            currentPlanKey = activeSub?.PlanKey;

            // Ban enforcement redirect (JS redirect để tránh lỗi "section not rendered")
            if (currentUser?.IsBanned == true && (currentUser.BanEndAt == null || currentUser.BanEndAt > DateTime.UtcNow))
            {
                var path = Context.Request.Path.Value ?? "";
                if (!path.StartsWith("/Account/Banned", StringComparison.OrdinalIgnoreCase) &&
                    !path.StartsWith("/Auth/Logout", StringComparison.OrdinalIgnoreCase))
                {
                    redirectToBanned = true;
                }
            }

            isFirstLogin = currentUser?.LoginCount <= 1;

            // Profile completion: popup ngay từ lần đầu (môn + trình độ là điều kiện join trận)
            if (currentUser != null)
            {
                var isComplete = await UserService.IsProfileCompleteAsync(currentUserId);
                var path = Context.Request.Path.Value ?? "";
                var isExemptPath = path.StartsWith("/Profile", StringComparison.OrdinalIgnoreCase)
                    || path.StartsWith("/Account", StringComparison.OrdinalIgnoreCase)
                    || path.StartsWith("/Auth", StringComparison.OrdinalIgnoreCase)
                    || path.StartsWith("/Onboarding", StringComparison.OrdinalIgnoreCase)
                    || path.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase)
                    || path.StartsWith("/api", StringComparison.OrdinalIgnoreCase);
                if (!isComplete)
                {
                    showProfileModal = !isExemptPath && !redirectToBanned;
                    if (currentUser.LoginCount >= 5)
                    {
                        showProfileBanner = true;
                        // Force redirect mỗi mốc 5 lần login (5, 10, 15...) — nhưng CHỈ 1 LẦN cho mỗi mốc,
                        // không phải mỗi lần chuyển trang trong cả phiên (đó là bug cũ khiến user bị kẹt,
                        // không rời được trang Hồ sơ). Cookie phiên (không set hạn) ghi lại mốc LoginCount
                        // đã redirect rồi — còn nguyên giá trị đó thì không redirect lại nữa.
                        const string redirectCookieName = "sp_profile_nudge_lc";
                        var alreadyRedirectedThisMilestone = Context.Request.Cookies[redirectCookieName] == currentUser.LoginCount.ToString();
                        if (currentUser.LoginCount % 5 == 0 && !isExemptPath && !alreadyRedirectedThisMilestone)
                        {
                            redirectToProfile = true;
                            showProfileBanner = false;
                            showProfileModal = false;
                            Context.Response.Cookies.Append(redirectCookieName, currentUser.LoginCount.ToString());
                        }
                    }
                }
            }
        }
    }

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);
    var navHome = isEnglish ? "Home" : "Trang chủ";
    var navMatchmaking = isEnglish ? "Matchmaking" : "Ghép trận";
    var navCommunity = isEnglish ? "Community" : "Cộng đồng";
    var navProfile = isEnglish ? "Profile" : "Cá nhân";
    var navSettings = isEnglish ? "Settings" : "Cài đặt";
    var navFriends = isEnglish ? "Friends" : "Bạn bè";
    var navMessages = isEnglish ? "Messages" : "Tin nhắn";
    var navNotifications = isEnglish ? "Notifications" : "Thông báo";
    var navMore = isEnglish ? "More" : "Thêm";
    var createMatchText = isEnglish ? "Create match" : "Tạo trận đấu";
    var findMatchText = isEnglish ? "Find match now" : "Tìm trận ngay";
    var loginText = isEnglish ? "Log in" : "Đăng nhập";
    var registerText = isEnglish ? "Register" : "Đăng ký";
    var logoutText = isEnglish ? "Log out" : "Đăng xuất";
    var openMenuText = isEnglish ? "Open menu" : "Mở menu";
    var upgradeText = isEnglish ? "Upgrade" : "Nâng cấp";
    var footerAbout = isEnglish ? "About us" : "Về chúng tôi";
    var footerRules = isEnglish ? "Community rules" : "Quy tắc cộng đồng";
    var footerPrivacy = isEnglish ? "Privacy policy" : "Chính sách bảo mật";
    var footerTerms = isEnglish ? "Terms of use" : "Điều khoản sử dụng";
    var footerSupport = isEnglish ? "Support" : "Hỗ trợ";
    var footerCopyright = isEnglish ? "All rights reserved by the development team." : "Bản quyền thuộc về đội ngũ phát triển.";
    var toastDetailText = isEnglish ? "View details" : "Xem chi tiết";
    var aiSubtitleText = isEnglish ? "AI Assistant" : "Trợ lý hỗ trợ";
    var msgDeletedText = isEnglish ? "Message deleted" : "Tin nhắn đã bị xóa";
    var msgInputPlaceholder = isEnglish ? "Type a message..." : "Nhập tin nhắn...";
    var aiInputPlaceholder = isEnglish ? "Ask a question..." : "Nhập câu hỏi...";
    var pinMsgText = isEnglish ? "Pin message" : "Ghim tin nhắn";
    var deleteMsgText = isEnglish ? "Delete message" : "Xóa tin nhắn";
    var reportMsgText = isEnglish ? "Report" : "Báo cáo";
    var reportMsgModalTitle = isEnglish ? "Report message" : "Báo cáo tin nhắn";
    var reportReasonPlaceholder = isEnglish ? "Reason (optional)..." : "Lý do (không bắt buộc)...";
    var cancelText = isEnglish ? "Cancel" : "Hủy";
    var currentActivePage = ViewData["ActivePage"]?.ToString() ?? "";
}

<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 font-display page-@(currentActivePage.ToLower()) @(Context.Request.Path.StartsWithSegments("/Admin") ? "sp-admin" : "")">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W8LPQJT7"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
<!-- ================================================================
     NAVBAR — Teal Refresh design
     ================================================================ -->
<header class="sticky top-0 z-50 w-full bg-white/95 dark:bg-background-dark/95 backdrop-blur-md shadow-sm border-b border-slate-100 dark:border-slate-800/60">
    <!-- Teal top accent bar -->
    <div class="h-[3px] bg-gradient-to-r from-primary via-primary/60 to-accent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-15 py-2.5">

            <!-- Logo -->
            <a asp-page="/Index" class="flex items-center gap-2 shrink-0">
                <img src="/images/LOGO SPORTHUB 2.png" alt="Sport Hub" class="h-9 w-9 object-contain" />
                <span class="font-sport text-xl font-bold tracking-widest uppercase text-navy dark:text-white hidden sm:block">SportHub</span>
            </a>

            <!-- Navigation Links (Desktop) — pill style -->
            <nav class="hidden lg:flex items-center gap-1">
                @{
                    var activePage = ViewData["ActivePage"]?.ToString() ?? "";
                    var navItems = new[] {
                        (navHome,        "/Index",            "Home"),
                        (navMatchmaking, "/Matchmaking/Index","Matchmaking"),
                        (navCommunity,   "/Users/Index",      "Community"),
                    };
                }
                @foreach (var (label, url, key) in navItems)
                {
                    var isActive = activePage == key;
                    <a href="@url" id="@(key == "Matchmaking" ? "nav-matchmaking-desktop" : null)"
                       class="px-3.5 py-1.5 rounded-full text-sm font-medium transition-all @(isActive ? "bg-primary/10 text-primary font-semibold" : "text-slate-600 dark:text-slate-400 hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800/60")">
                        @label
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin/Index"
                       class="px-3.5 py-1.5 rounded-full text-sm font-medium transition-all @(activePage == "Admin" ? "bg-accent/10 text-accent font-semibold" : "text-accent/80 hover:text-accent hover:bg-accent/10") flex items-center gap-1">
                        <span class="material-symbols-outlined text-base">admin_panel_settings</span>
                        Admin
                    </a>
                }
            </nav>

            <!-- Right Actions -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <!-- Tạo trận button -->
                <a asp-page="/Matchmaking/Create" id="nav-create-match"
                   class="hidden xl:inline-flex items-center gap-1.5 rounded-md bg-accent px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-accent/90 hover:shadow-md transition-all active:scale-95">
                    <span class="material-symbols-outlined text-base">add</span>
                    @createMatchText
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Wallet pill -->
                    <a href="/Wallet" id="nav-wallet-btn"
                       class="hidden md:flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-primary/8 border border-primary/20 hover:border-primary hover:bg-primary/15 text-primary text-sm font-bold transition-all"
                       title="Ví SportHub">
                        <span class="material-symbols-outlined text-sm">account_balance_wallet</span>
                        <span id="nav-wallet-balance">@currentWalletBalance.ToString("N0") xu</span>
                    </a>

                    <!-- Subscription badge -->
                    @if (currentPlanKey == null || currentPlanKey == "Free")
                    {
                        <a href="/Subscription"
                           class="hidden md:flex items-center gap-1 px-2.5 py-1.5 rounded-md border border-primary/30 text-primary text-xs font-bold hover:bg-primary hover:text-white transition-all"
                           title="@upgradeText">
                            <span class="material-symbols-outlined text-sm">workspace_premium</span>
                            <span class="hidden lg:inline">@upgradeText</span>
                        </a>
                    }
                    else
                    {
                        <a href="/Subscription"
                           class="hidden md:flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-bold transition-all @(currentPlanKey == "Club" ? "bg-amber-100 text-amber-700 hover:bg-amber-200" : currentPlanKey == "Pro" ? "bg-purple-100 text-purple-700 hover:bg-purple-200" : "bg-primary/10 text-primary hover:bg-primary/20")"
                           title="Gói @currentPlanKey">
                            <span class="material-symbols-outlined text-sm">workspace_premium</span>
                            @currentPlanKey
                        </a>
                    }

                    <!-- Icon actions -->
                    <a asp-page="/Users/Friends" class="p-2 text-slate-500 dark:text-slate-400 hover:text-primary hover:bg-primary/10 rounded-full transition-all hidden md:flex" title="@navFriends">
                        <span class="material-symbols-outlined text-[22px]">group</span>
                    </a>

                    <a asp-page="/Messages/Index" class="relative p-2 text-slate-500 dark:text-slate-400 hover:text-primary hover:bg-primary/10 rounded-full transition-all hidden md:flex" title="@navMessages">
                        <span class="material-symbols-outlined text-[22px]">chat_bubble</span>
                        <span id="chat-badge"
                              class="absolute top-0.5 right-0.5 min-w-[16px] h-4 px-1 flex items-center justify-center rounded-full bg-accent text-white text-[9px] font-bold leading-none @(unreadChatCount > 0 ? "" : "hidden")">
                            @(unreadChatCount > 9 ? "9+" : unreadChatCount.ToString())
                        </span>
                    </a>
                }

                <button type="button" id="nav-help-btn" onclick="SportHubTour.restart()"
                        class="p-2 text-slate-500 dark:text-slate-400 hover:text-primary hover:bg-primary/10 rounded-full transition-all flex"
                        title="Xem hướng dẫn trang này">
                    <span class="material-symbols-outlined text-[22px]">help</span>
                </button>

                <a asp-page="/Notifications/Index" id="nav-notif-btn" class="relative p-2 text-slate-500 dark:text-slate-400 hover:text-primary hover:bg-primary/10 rounded-full transition-all flex" title="@navNotifications">
                    <span class="material-symbols-outlined text-[22px]">notifications</span>
                    <span id="notification-badge"
                          class="absolute top-0.5 right-0.5 min-w-[16px] h-4 px-1 flex items-center justify-center rounded-full bg-accent text-white text-[9px] font-bold leading-none @(unreadNotificationCount > 0 ? "" : "hidden")">
                        @(unreadNotificationCount > 9 ? "9+" : unreadNotificationCount.ToString())
                    </span>
                </a>

                <!-- Avatar + logout -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="relative group">
                        <a asp-page="/Profile/Index" id="nav-avatar" class="block relative">
                            <img class="w-9 h-9 rounded-full object-cover ring-2 ring-primary/30 hover:ring-primary transition-all"
                                 src="@(string.IsNullOrWhiteSpace(currentUserAvatar) ? "/images/avatar-default.png" : currentUserAvatar)"
                                 onerror="this.onerror=null;this.src='/images/avatar-default.png';"
                                 alt="@(User.Identity?.Name ?? "Avatar")" />
                            @if (currentPlanKey == "Pro")
                            {
                                <span class="absolute -bottom-0.5 -right-0.5 bg-purple-600 text-white text-[8px] font-black px-1 rounded-full leading-tight z-10">PRO</span>
                            }
                            else if (currentPlanKey == "Club")
                            {
                                <span class="absolute -bottom-0.5 -right-0.5 bg-amber-500 text-white text-[8px] font-black px-1 rounded-full leading-tight z-10">CLUB</span>
                            }
                            else if (currentPlanKey == "Starter")
                            {
                                <span class="absolute -bottom-0.5 -right-0.5 bg-primary text-white text-[8px] font-black px-1 rounded-full leading-tight z-10">S+</span>
                            }
                        </a>
                        <!-- Dropdown on hover -->
                        <div class="absolute right-0 top-full mt-2 w-44 bg-white dark:bg-slate-900 rounded-md shadow-lg border border-slate-200 dark:border-slate-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                            <a href="/Profile" class="flex items-center gap-2 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-t-xl">
                                <span class="material-symbols-outlined text-sm text-primary">person</span> @navProfile
                            </a>
                            <a href="/Settings" class="flex items-center gap-2 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800">
                                <span class="material-symbols-outlined text-sm text-slate-400">settings</span> @navSettings
                            </a>
                            <a href="/Wallet" class="flex items-center gap-2 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800">
                                <span class="material-symbols-outlined text-sm text-primary">account_balance_wallet</span> Ví
                            </a>
                            <button type="button" onclick="SportHubTour.restart()" class="w-full flex items-center justify-start text-left gap-2 px-4 py-3 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800">
                                <span class="material-symbols-outlined text-sm text-slate-400">help</span> Xem lại hướng dẫn
                            </button>
                            <div class="border-t border-slate-100 dark:border-slate-800">
                                <form method="post" asp-page="/Auth/Logout">
                                    <button type="submit" class="w-full flex items-center gap-2 px-4 py-3 text-sm text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-900/20 rounded-b-xl transition-colors">
                                        <span class="material-symbols-outlined text-sm">logout</span> @logoutText
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-page="/Auth/Login" class="h-9 px-3 sm:px-4 flex items-center justify-center text-xs sm:text-sm font-semibold border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:border-primary hover:text-primary rounded-md transition-all">@loginText</a>
                    <a asp-page="/Auth/Register" class="h-9 px-3 sm:px-4 flex items-center justify-center bg-primary hover:bg-primary/90 text-white text-xs sm:text-sm font-bold rounded-md transition-all shadow-sm">@registerText</a>
                }

                <!-- Hamburger Mobile — hidden, replaced by bottom nav -->
                <button id="mobile-menu-btn" class="hidden" aria-label="@openMenuText"></button>
            </div>
        </div>

        <!-- Mobile Nav Dropdown — replaced by bottom nav; kept only for wallet balance JS ref -->
        <div id="mobile-menu" class="hidden" style="display:none!important">
            <div class="pt-3 pb-2">
                <a asp-page="/Matchmaking/Create" class="flex items-center justify-center gap-2 rounded-md bg-accent px-4 py-3 text-sm font-black text-white shadow-sm mb-3">
                    <span class="material-symbols-outlined text-lg">add</span>
                    @createMatchText
                </a>
            </div>
            <nav class="flex flex-col space-y-0.5">
                <a asp-page="/Index" class="px-4 py-2.5 text-sm font-medium rounded-md hover:bg-primary/10 hover:text-primary transition-colors @(activePage == "Home" ? "bg-primary/10 text-primary font-semibold" : "text-slate-700 dark:text-slate-300")">@navHome</a>
                <a asp-page="/Matchmaking/Index" id="nav-matchmaking" class="px-4 py-2.5 text-sm font-medium rounded-md hover:bg-primary/10 hover:text-primary transition-colors @(activePage == "Matchmaking" ? "bg-primary/10 text-primary font-semibold" : "text-slate-700 dark:text-slate-300")">@navMatchmaking</a>
                <a asp-page="/Users/Index" class="px-4 py-2.5 text-sm font-medium rounded-md hover:bg-primary/10 hover:text-primary transition-colors @(activePage == "Community" ? "bg-primary/10 text-primary font-semibold" : "text-slate-700 dark:text-slate-300")">@navCommunity</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
