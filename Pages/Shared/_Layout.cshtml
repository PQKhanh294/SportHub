<script>
// Sync sidebar badges with _AdminNav badges
(function() {
    function syncBadge(from, to) {
        var src = document.getElementById(from);
        var dst = document.getElementById(to);
        if (!src || !dst) return;
        var observer = new MutationObserver(function() {
            dst.textContent = src.textContent;
            src.classList.contains('hidden') ? dst.classList.add('hidden') : dst.classList.remove('hidden');
        });
        observer.observe(src, { childList: true, attributes: true, attributeFilter: ['class'] });
    }
    document.addEventListener('DOMContentLoaded', function() {
        syncBadge('admin-badge-payments', 'sb-badge-payments');
        syncBadge('admin-badge-reports',  'sb-badge-reports');
    });
})();

// Shared AI Insight loader for all admin pages
function _fmtInsight(raw) {
    if (!raw) return '';
    var t = raw.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    // headings ##
    t = t.replace(/^## (.+)$/gm, '<div style="font-weight:700;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--color-primary,#2563eb);margin-top:10px;margin-bottom:3px">$1</div>');
    // bold **text**
    t = t.replace(/\*\*(.+?)\*\*/g, '<strong style="font-weight:700;color:inherit">$1</strong>');
    // italic *text*
    t = t.replace(/\*(.+?)\*/g, '<em>$1</em>');
    // bullet lines
    t = t.replace(/^[-•] (.+)$/gm, '<div style="display:flex;gap:6px;align-items:flex-start;margin-bottom:3px"><span style="color:var(--color-primary,#2563eb);flex-shrink:0;margin-top:1px">▸</span><span>$1</span></div>');
    // double newline = paragraph break
    t = t.replace(/\n\n+/g, '<div style="height:6px"></div>');
    // single newline
    t = t.replace(/\n/g, '<br>');
    return t;
}
window.loadAiInsight = function(section, p1, p2, p3, p4) {
    var el = document.getElementById('ai-insight-' + section);
    if (!el) return;
    if (!el.classList.contains('hidden')) { el.classList.add('hidden'); return; }
    el.classList.remove('hidden');
    el.innerHTML = '<span style="opacity:0.5;font-style:italic">Đang phân tích...</span>';
    var url = '/api/admin-insight?section=' + encodeURIComponent(section)
        + '&p1=' + encodeURIComponent(p1 || '')
        + '&p2=' + encodeURIComponent(p2 || '')
        + '&p3=' + encodeURIComponent(p3 || '')
        + '&p4=' + encodeURIComponent(p4 || '');
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(d) { el.innerHTML = d ? _fmtInsight(d.insight || 'Không có dữ liệu.') : '<span style="color:#ef4444">Lỗi khi phân tích.</span>'; })
        .catch(function() { el.innerHTML = '<span style="color:#ef4444">Không thể kết nối AI.</span>'; });
};
</script>
}
