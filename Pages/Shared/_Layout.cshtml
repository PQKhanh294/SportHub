<script>
(function () {
    var aiHistory  = [];
    var aiMessages = [];  // [{r:'u'|'a', t:'text', img?:true}]
    var pendingImage = null; // {base64, mimeType, name, dataUrl}
    var aiExpanded = false;
    window.aiSending = false;
    var SIDEBAR_W  = 480;
    var CHAT_KEY   = 'sh_ai_@(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "0")';
    var PERSIST_KEY = 'sh_ai_persist';

    // ---- Persistence ----
    function isPersist() { return localStorage.getItem(PERSIST_KEY) !== 'false'; }

    function updatePersistIcons() {
        var fill = isPersist() ? "'FILL' 1, 'wght' 600" : "'FILL' 0, 'wght' 400";
        ['popup','full'].forEach(function(m) {
            var el = document.getElementById('ai-persist-icon-' + m);
            if (el) el.style.fontVariationSettings = fill;
        });
    }

    function saveChat() {
        if (!isPersist()) return;
        try { localStorage.setItem(CHAT_KEY, JSON.stringify(aiMessages.slice(-50))); } catch(e) {}
    }

    function showWelcome() {
        appendMsg('ai-messages-popup', 'ai', 'Xin chào! Tôi có thể giúp bạn về trận đấu, thanh toán, hoặc bất kỳ câu hỏi nào về SportHub 🏃');
        appendMsg('ai-messages-full',  'ai', 'Xin chào! Tôi có thể giúp bạn về trận đấu, thanh toán, hoặc bất kỳ câu hỏi nào về SportHub 🏃');
    }

    function loadChat() {
        try {
            var s = localStorage.getItem(CHAT_KEY);
            if (!s) { showWelcome(); return; }
            var msgs = JSON.parse(s);
            if (!msgs || !msgs.length) { showWelcome(); return; }
            msgs.forEach(function(m) {
                var role = m.r === 'u' ? 'user' : 'ai';
                appendMsg('ai-messages-popup', role, m.t);
                appendMsg('ai-messages-full',  role, m.t);
                aiHistory.push({ role: m.r === 'u' ? 'user' : 'assistant', content: m.t });
            });
            aiMessages = msgs;
        } catch(e) { showWelcome(); }
    }

    window.togglePersist = function () {
        var newVal = !isPersist();
        localStorage.setItem(PERSIST_KEY, newVal ? 'true' : 'false');
        if (!newVal) localStorage.removeItem(CHAT_KEY);
        updatePersistIcons();
    };

    window.clearAiChat = function () {
        if (!confirm('Xóa toàn bộ cuộc trò chuyện?')) return;
        aiHistory = []; aiMessages = [];
        localStorage.removeItem(CHAT_KEY);
        ['popup','full'].forEach(function(m) {
            var c = document.getElementById('ai-messages-' + m);
            if (c) c.innerHTML = '';
        });
        showWelcome();
    };

    // ---- Image upload ----
    window.handleImageSelect = function (input) {
        var file = input.files[0];
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) { alert('Ảnh quá lớn, tối đa 5MB'); input.value = ''; return; }
        var reader = new FileReader();
        reader.onload = function (e) {
            pendingImage = { base64: e.target.result.split(',')[1], mimeType: file.type, name: file.name, dataUrl: e.target.result };
            ['popup','full'].forEach(function(m) {
                var thumb = document.getElementById('ai-img-thumb-' + m);
                var name  = document.getElementById('ai-img-name-' + m);
                var prev  = document.getElementById('ai-img-preview-' + m);
                if (thumb) thumb.src = e.target.result;
                if (name)  name.textContent = file.name;
                if (prev)  prev.style.display = 'block';
            });
        };
        reader.readAsDataURL(file);
        input.value = '';
    };

    window.clearPendingImage = function () {
        pendingImage = null;
        ['popup','full'].forEach(function(m) {
            var prev = document.getElementById('ai-img-preview-' + m);
            if (prev) prev.style.display = 'none';
        });
    };

    // ---- Mode toggles ----
    function syncMessages(from, to) {
        var src = document.getElementById('ai-messages-' + from);
        var dst = document.getElementById('ai-messages-' + to);
        if (src && dst) { dst.innerHTML = src.innerHTML; dst.scrollTop = dst.scrollHeight; }
    }

    window.toggleAiChat = function () {
        if (window.innerWidth < 1024) {
            if (aiExpanded) { window.closeAiSidebar(); } else { window.expandAiChat(); }
            return;
        }
        var panel = document.getElementById('ai-panel');
        var open  = panel.style.display === 'flex';
        panel.style.display = open ? 'none' : 'flex';
        if (!open) setTimeout(function(){ document.getElementById('ai-input-popup').focus(); }, 50);
        window.updateRightSidebarState();
    };

    window.expandAiChat = function () {
        if (aiExpanded) return;
        aiExpanded = true;
        window._aiSidebarOpen = true;
        syncMessages('popup', 'full');
        document.getElementById('ai-panel').style.display = 'none';
        document.getElementById('ai-sidebar').classList.add('open');
        window.updateRightSidebarState();
        setTimeout(function(){ document.getElementById('ai-input-full').focus(); }, 350);
    };

    window.shrinkAiChat = function () {
        if (!aiExpanded) return;
        aiExpanded = false;
        window._aiSidebarOpen = false;
        syncMessages('full', 'popup');
        document.getElementById('ai-sidebar').classList.remove('open');
        window.updateRightSidebarState();
        setTimeout(function(){
            document.getElementById('ai-panel').style.display = 'flex';
            document.getElementById('ai-input-popup').focus();
            window.updateRightSidebarState();
        }, 320);
    };

    window.closeAiSidebar = function () {
        if (!aiExpanded) return;
        aiExpanded = false;
        window._aiSidebarOpen = false;
        document.getElementById('ai-sidebar').classList.remove('open');
        window.updateRightSidebarState();
    };

    function setSendingState(sending) {
        window.aiSending = sending;
        ['popup','full'].forEach(function(m) {
            var btn = document.getElementById('ai-send-' + m);
            var inp = document.getElementById('ai-input-' + m);
            if (btn) { btn.disabled = sending; btn.style.opacity = sending ? '0.5' : '1'; btn.style.cursor = sending ? 'not-allowed' : 'pointer'; }
            if (inp) inp.disabled = sending;
        });
    }

    // ---- Send ----
    window.sendAiMsg = async function (mode) {
        if (window.aiSending) return;
        var inputId = mode === 'full' ? 'ai-input-full' : 'ai-input-popup';
        var msgsId  = mode === 'full' ? 'ai-messages-full' : 'ai-messages-popup';
        var input   = document.getElementById(inputId);
        var msg     = input.value.trim();
        if (!msg && !pendingImage) return;
        input.value = '';
        setSendingState(true);

        var imgBase64  = pendingImage ? pendingImage.base64   : null;
        var imgMime    = pendingImage ? pendingImage.mimeType : null;
        var imgDataUrl = pendingImage ? pendingImage.dataUrl  : null;
        clearPendingImage();

        if (imgDataUrl) {
            appendMsgWithImage(msgsId, msg, imgDataUrl);
        } else {
            appendMsg(msgsId, 'user', msg);
        }
        var tid = 'typing-' + Date.now();
        appendTyping(msgsId, tid);

        try {
            var res = await fetch('/api/ai/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    message: msg || 'Hãy xem và mô tả ảnh này liên quan đến thể thao nếu có',
                    history: aiHistory.slice(-10),
                    imageBase64: imgBase64,
                    imageMimeType: imgMime
                })
            });
            var data = await res.json();
            document.getElementById(tid)?.remove();
            var reply = data.reply || 'Xin lỗi, có lỗi xảy ra.';
            appendMsg(msgsId, 'ai', reply);
            if (data.matches && data.matches.length > 0) appendMatchCards(msgsId, data.matches);
            var userText = msg || '[ảnh]';
            aiHistory.push({ role: 'user', content: userText });
            aiHistory.push({ role: 'assistant', content: reply });
            aiMessages.push({ r: 'u', t: userText, img: !!imgBase64 });
            aiMessages.push({ r: 'a', t: reply });
            saveChat();
        } catch {
            document.getElementById(tid)?.remove();
            appendMsg(msgsId, 'ai', 'Không thể kết nối. Vui lòng thử lại.');
        }
        setSendingState(false);
        document.getElementById(inputId).focus();
    };

    // ---- Render helpers ----
    function appendMsg(cId, role, text) {
        var c = document.getElementById(cId);
        if (!c) return;
        var safe = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>').replace(/\n/g,'<br>');
        var html = role === 'user'
            ? '<div style="display:flex;justify-content:flex-end"><div style="background:#50A5B1;color:white;border-radius:6px;padding:10px 14px;font-size:13px;max-width:85%">' + safe + '</div></div>'
            : '<div style="display:flex;gap:8px"><div style="width:28px;height:28px;border-radius:50%;background:rgba(37,96,233,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px"><img src="/images/LOGO SPORTHUB 2.png" style="width:16px;height:16px;object-fit:contain"/></div><div style="background:#f1f5f9;border-radius:6px;padding:10px 14px;font-size:13px;max-width:85%;color:#334155">' + safe + '</div></div>';
        c.insertAdjacentHTML('beforeend', html);
        c.scrollTop = c.scrollHeight;
    }

    function appendMsgWithImage(cId, text, dataUrl) {
        var c = document.getElementById(cId);
        if (!c) return;
        var safeText = text ? '<div style="font-size:13px;margin-top:4px">' + text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</div>' : '';
        c.insertAdjacentHTML('beforeend',
            '<div style="display:flex;justify-content:flex-end"><div style="background:#50A5B1;color:white;border-radius:6px;padding:8px 10px;max-width:85%">'
            + '<img src="' + dataUrl + '" style="max-width:180px;max-height:120px;border-radius:6px;display:block"/>'
            + safeText + '</div></div>');
        c.scrollTop = c.scrollHeight;
    }

    var sportIcon   = {'Cầu lông':'🏸','Bóng đá':'⚽','Bóng rổ':'🏀','Bóng bàn':'🏓','Tennis':'🎾','Pickleball':'🏓','Volleyball':'🏐'};
    var statusLabel = {'Open':'Đang mở','Full':'Đã đầy','InProgress':'Đang diễn ra'};
    var statusColor = {'Open':'#16a34a','Full':'#dc2626','InProgress':'#50A5B1'};

    function appendMatchCards(cId, matches) {
        var c = document.getElementById(cId);
        var scroll = '<div style="display:flex;gap:10px;overflow-x:auto;padding:4px 0 8px;scrollbar-width:thin">';
        matches.forEach(function(m) {
            var icon   = sportIcon[m.matchType] || '🏃';
            var sLabel = statusLabel[m.status]  || m.status;
            var sColor = statusColor[m.status]  || '#64748b';
            var roleBadge = m.isHost
                ? '<span style="font-size:10px;background:#eff6ff;color:#50A5B1;border-radius:999px;padding:2px 8px;font-weight:600">Chủ kèo</span>'
                : m.isJoined ? '<span style="font-size:10px;background:#f0fdf4;color:#16a34a;border-radius:999px;padding:2px 8px;font-weight:600">Đã tham gia</span>' : '';
            var loc = m.location ? '<div style="font-size:11px;color:#64748b;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">📍 ' + m.location + '</div>' : '';
            var skill = m.skillRequired ? '<span style="font-size:10px;color:#64748b">· ' + m.skillRequired + '</span>' : '';
            var btnLabel = m.isHost ? 'Quản lý' : (m.isJoined ? 'Xem chi tiết' : 'Tham gia');
            scroll += '<div style="min-width:200px;max-width:220px;background:white;border:1px solid #e2e8f0;border-radius:6px;padding:12px;flex-shrink:0;box-shadow:0 1px 4px rgba(0,0,0,0.06)">'
                + '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px"><span style="font-size:18px">' + icon + '</span>' + roleBadge + '</div>'
                + '<div style="font-size:13px;font-weight:700;color:#0f172a;line-height:1.3;margin-bottom:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">' + m.title + '</div>'
                + '<div style="font-size:11px;color:#334155;margin-bottom:2px">📅 ' + m.dateDisplay + ' · ' + m.timeDisplay + '</div>'
                + '<div style="font-size:11px;color:#334155;margin-bottom:2px">👥 ' + m.currentParticipants + '/' + m.maxParticipants + ' ' + skill + '</div>'
                + loc
                + '<div style="font-size:10px;font-weight:600;margin:6px 0 8px"><span style="color:' + sColor + '">● ' + sLabel + '</span></div>'
                + '<a href="/Matchmaking/Details?id=' + m.matchId + '" style="display:block;text-align:center;padding:6px 0;background:#50A5B1;color:white;border-radius:6px;font-size:12px;font-weight:600;text-decoration:none">' + btnLabel + '</a>'
                + '</div>';
        });
        scroll += '</div>';
        c.insertAdjacentHTML('beforeend', scroll);
        c.scrollTop = c.scrollHeight;
    }

    function appendTyping(cId, id) {
        var c = document.getElementById(cId);
        c.insertAdjacentHTML('beforeend',
            '<div id="' + id + '" style="display:flex;gap:8px"><div style="width:28px;height:28px;border-radius:50%;background:rgba(37,96,233,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px"><img src="/images/LOGO SPORTHUB 2.png" style="width:16px;height:16px;object-fit:contain"/></div><div style="background:#f1f5f9;border-radius:16px 16px 16px 4px;padding:10px 14px;font-size:13px;color:#94a3b8;display:flex;gap:4px"><span style="animation:bounce 1s infinite 0ms">●</span><span style="animation:bounce 1s infinite 150ms">●</span><span style="animation:bounce 1s infinite 300ms">●</span></div></div>');
        c.scrollTop = c.scrollHeight;
    }

    // ---- Init ----
    updatePersistIcons();
    if (isPersist()) loadChat(); else showWelcome();
})();
</script>

