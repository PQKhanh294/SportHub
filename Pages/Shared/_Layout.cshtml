<!-- Global Toast Notification Container -->
<div id="toast-container" class="fixed top-24 right-4 z-[9999] flex flex-col gap-2 pointer-events-none w-80 sm:w-96">
</div>

<script>
    async function shareSite() {
        const shareData = {
            title: 'SportHub',
            text: 'Tham gia SportHub — nền tảng ghép trận & đặt sân thể thao!',
            url: window.location.origin
        };
        if (navigator.share) {
            try { await navigator.share(shareData); } catch (e) { /* user cancelled — im lặng */ }
            return;
        }
        try {
            await navigator.clipboard.writeText(shareData.url);
            showToast('Đã sao chép liên kết', 'Chia sẻ SportHub với bạn bè ngay!', null, 'System');
        } catch (e) {
            showToast('Không thể sao chép', shareData.url, null, 'System');
        }
    }

    var URGENT_NOTIF_TYPES = new Set(['RemainingFeeReminder', 'MatchJoinExpired', 'BookingCancelled', 'MatchPaymentRequired', 'MatchRemainingFeeRequired']);

    function showToast(title, message, linkUrl, type, notificationId) {
        const container = document.getElementById('toast-container');
        if (!container) return;

        let icon = "notifications";
        let color = "bg-primary";
        if (type === "Chat") {
            icon = "chat";
            color = "bg-indigo-500";
        } else if (title.includes("kết bạn")) {
            icon = "person_add";
            color = "bg-emerald-500";
        }
        const isUrgent = URGENT_NOTIF_TYPES.has(type);
        if (isUrgent) color = "bg-rose-500 animate-pulse";

        const markReadAttr = notificationId ? ` onclick="navigator.sendBeacon('/api/notifications/mark-read/${notificationId}')"` : '';
        const toastId = "toast-" + Date.now();
        const html = `
            <div id="${toastId}" class="pointer-events-auto max-w-sm w-full bg-white dark:bg-slate-800 shadow-lg rounded-md pointer-events-auto flex ring-1 ${isUrgent ? 'ring-rose-400' : 'ring-black ring-opacity-5'} overflow-hidden transition-all duration-300 translate-y-4 opacity-0 transform">
                <div class="w-2 flex ${color}"></div>
                <div class="flex-1 p-4">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <span class="material-symbols-outlined text-slate-400 dark:text-slate-500">${icon}</span>
                        </div>
                        <div class="ml-3 w-0 flex-1 pt-0.5">
                            <p class="text-sm font-semibold text-slate-900 dark:text-white">
                                ${title}
                            </p>
                            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400 line-clamp-2">
                                ${message}
                            </p>
                            ${linkUrl ? `<a href="${linkUrl}"${markReadAttr} class="mt-2 text-xs font-semibold text-primary hover:underline block">@toastDetailText</a>` : ''}
                        </div>
                        <div class="ml-4 flex-shrink-0 flex">
                            <button onclick="document.getElementById('${toastId}').remove()" class="bg-transparent rounded-md inline-flex text-slate-400 hover:text-slate-500 focus:outline-none">
                                <span class="sr-only">Close</span>
                                <span class="material-symbols-outlined text-xl">close</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        container.insertAdjacentHTML('beforeend', html);
        const el = document.getElementById(toastId);
        
        // Animate in
        setTimeout(() => {
            el.classList.remove('translate-y-4', 'opacity-0');
        }, 50);
        
        // Auto remove after 8 seconds
        setTimeout(() => {
            if (document.getElementById(toastId)) {
                el.classList.add('opacity-0', 'translate-x-full');
                setTimeout(() => el.remove(), 300);
            }
        }, 8000);
    }
    
    // Listen to global events
    window.addEventListener('sporthub:notification', function(e) {
        const payload = e.detail;
        if (payload) {
            showToast(payload.title, payload.message, payload.linkUrl, payload.type, payload.notificationId);

            // Cập nhật wallet balance trên nav khi nhận tiền vào ví
            if (payload.type === 'WalletCredit') {
                fetch('/api/wallet/balance').then(r => r.json()).then(data => {
                    const fmt = Number(data.balance).toLocaleString('vi-VN') + ' xu';
                    const desktop = document.getElementById('nav-wallet-balance');
                    const mobile  = document.getElementById('nav-wallet-balance-mobile');
                    if (desktop) desktop.textContent = fmt;
                    if (mobile)  mobile.textContent  = fmt;
                }).catch(() => {});
            }

            // Nếu có âm thanh
            try {
                const audio = new Audio('/sounds/notification.mp3');
                audio.play().catch(e => {}); // Bỏ qua nếu browser block autoplay
            } catch (err) {}
        }
    });
</script>
<script>
    // Auto-dismiss server-rendered TempData toasts
    ['toast-success', 'toast-error'].forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        setTimeout(() => {
            el.style.transition = 'opacity 0.4s';
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 400);
        }, 8000);
    });
</script>

@if (isAuthenticated)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        (function () {
            const badgeEl = document.getElementById('notification-badge');

            function setUnreadCount(count) {
                const n = Number(count) || 0;
                if (!badgeEl) return;
                if (n <= 0) {
                    badgeEl.classList.add('hidden');
                    badgeEl.textContent = '';
                    return;
                }
                badgeEl.classList.remove('hidden');
                badgeEl.textContent = n > 9 ? '9+' : String(n);
            }

            window.setChatBadge = function setChatBadge(n) {
                const badge = document.getElementById('chat-badge');
                if (!badge) return;
                if (n > 0) {
                    badge.textContent = n > 9 ? '9+' : String(n);
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            };

            if (!window.signalR) return;

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/notifications')
                .withAutomaticReconnect()
                .build();

            connection.on('notification_received', function (payload) {
                if (payload && payload.unreadCount != null) {
                    setUnreadCount(payload.unreadCount);
                }
                // Chat notifications are handled separately via ChatHub — skip toast/badge here
                if (payload && payload.type === 'Chat') return;
                window.dispatchEvent(new CustomEvent('sporthub:notification', { detail: payload }));
            });

            connection.on('notifications_read', function (payload) {
                if (payload && payload.unreadCount != null) {
                    setUnreadCount(payload.unreadCount);
                } else {
                    setUnreadCount(0);
                }
                window.dispatchEvent(new CustomEvent('sporthub:notifications_read', { detail: payload }));
            });

            // Init nav chat badge from actual unread message count (not notifications)
            fetch('/api/chat/unread-count').then(function(r){return r.json();}).then(function(d){
                if (d.count > 0) setChatBadge(d.count);
            }).catch(function(){});

            connection.on('admin_counts_update', function (payload) {
                window.dispatchEvent(new CustomEvent('sporthub:admin_counts', { detail: payload }));
            });

            // ── Wallet balance realtime ──────────────────────────────────────
            connection.on('WalletCredited', function (data) {
                var fmt = Number(data.newBalance).toLocaleString('vi-VN');
                var el  = document.getElementById('nav-wallet-balance');
                var elm = document.getElementById('nav-wallet-balance-mobile');
                if (el)  el.textContent  = fmt + ' xu';
                if (elm) elm.textContent = fmt + ' xu';
                // Also update wallet page balance display if open
                var walletEl = document.getElementById('wallet-balance-display');
                if (walletEl) walletEl.textContent = fmt;
                // Prepend new transaction row if wallet history list exists
                window.dispatchEvent(new CustomEvent('sporthub:wallet_credited', { detail: data }));
                // Flash toast
                _showWalletToast('+' + Number(data.amount).toLocaleString('vi-VN') + 'đ đã vào ví');
            });

            // ── Match payment confirmed by admin ────────────────────────────
            connection.on('MatchPaymentConfirmed', function (data) {
                window.dispatchEvent(new CustomEvent('sporthub:payment_confirmed', { detail: data }));
                _showWalletToast('Thanh toán trận đấu được xác nhận! Bạn đã vào trận.', 'emerald');
                // If on matchmaking page, reload after short delay to refresh card state
                if (location.pathname.startsWith('/Matchmaking') || location.pathname === '/') {
                    setTimeout(function() { location.reload(); }, 2000);
                }
            });

            connection.on('MatchPaymentRejected', function (data) {
                _showWalletToast('Thanh toán bị từ chối: ' + (data.reason || 'Liên hệ admin'), 'rose');
            });

            // ── Matchmaking real-time events ────────────────────────────────
            connection.on('match_join_request', function (data) {
                _showWalletToast((data.playerName || 'Someone') + ' wants to join your match!', 'primary');
                var pathMatch = location.pathname.match(/\/Matchmaking\/Details\/(\d+)/i);
                if (pathMatch && parseInt(pathMatch[1]) === data.matchId) {
                    setTimeout(function () { location.reload(); }, 1800);
                }
                window.dispatchEvent(new CustomEvent('sporthub:match_join_request', { detail: data }));
            });

            connection.on('match_join_approved', function (data) {
                _showWalletToast('You\'re approved! Pay now to secure your spot.', 'emerald');
                if (location.pathname.match(/\/Matchmaking/i)) {
                    setTimeout(function () { location.reload(); }, 2200);
                }
                window.dispatchEvent(new CustomEvent('sporthub:match_join_approved', { detail: data }));
            });

            connection.on('match_join_rejected', function (data) {
                _showWalletToast('Your join request was not approved.', 'rose');
                if (location.pathname.match(/\/Matchmaking/i)) {
                    setTimeout(function () { location.reload(); }, 2200);
                }
            });

            connection.on('match_participant_paid', function (data) {
                _showWalletToast((data.playerName || 'A player') + ' has paid and joined the match!', 'emerald');
                var pathMatch = location.pathname.match(/\/Matchmaking\/Details\/(\d+)/i);
                if (pathMatch && parseInt(pathMatch[1]) === data.matchId) {
                    setTimeout(function () { location.reload(); }, 1800);
                }
                window.dispatchEvent(new CustomEvent('sporthub:match_participant_paid', { detail: data }));
            });

            function _showWalletToast(msg, color) {
                color = color || 'primary';
                var colorMap = {
                    primary: 'bg-primary text-white',
                    emerald: 'bg-emerald-600 text-white',
                    rose:    'bg-rose-600 text-white'
                };
                var cls = colorMap[color] || colorMap.primary;
                var t = document.createElement('div');
                t.textContent = msg;
                t.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-[9999] px-5 py-2.5 rounded-full ' + cls + ' text-sm font-semibold shadow-xl transition-all duration-300 opacity-0';
                document.body.appendChild(t);
                requestAnimationFrame(function() { t.style.opacity = '1'; t.style.transform = 'translateX(-50%) translateY(-6px)'; });
                setTimeout(function() { t.style.opacity = '0'; setTimeout(function() { t.remove(); }, 400); }, 3000);
            }

            connection.start().catch(function (err) {
                console.warn('Notification realtime disabled:', err);
            });
        })();
    </script>
}

