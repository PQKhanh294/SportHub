            </div>
            <div style="display:flex;align-items:center;gap:6px;padding:8px 10px;border-top:1px solid #f1f5f9;flex-shrink:0" class="dark:!border-slate-800 dark:!bg-slate-900">
                <input type="file" id="chat-panel-file" accept="image/*" style="display:none" onchange="handleChatWidgetFile(this,'popup')" />
                <button onclick="document.getElementById('chat-panel-file').click()" style="width:30px;height:30px;border-radius:50%;background:#f1f5f9;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#64748b;flex-shrink:0" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'" title="Gửi ảnh">
                    <span class="material-symbols-outlined" style="font-size:16px">image</span>
                </button>
                <input id="chat-panel-input" type="text" maxlength="500" placeholder="@msgInputPlaceholder"
                    style="flex:1;font-size:13px;border-radius:6px;padding:7px 12px;background:#f1f5f9;border:none;outline:none;color:#0f172a"
                    class="dark:!bg-slate-800 dark:!text-white"
                    onpaste="handleChatWidgetPaste(event,'popup')"
                    oninput="cwInputKeyup('popup')"
                    onkeydown="if(event.key==='Enter')sendChatWidgetMsg('popup')" />
                <button onclick="sendChatWidgetMsg('popup')" style="width:32px;height:32px;border-radius:50%;background:#50A5B1;border:none;color:white;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0" onmouseover="this.style.background='#3d8a95'" onmouseout="this.style.background='#50A5B1'">
                    <span class="material-symbols-outlined" style="font-size:15px">send</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Report modal for popup widget -->
    <div id="cw-report-modal" style="display:none;position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;background:rgba(0,0,0,0.4)">
        <div style="background:white;border-radius:6px;box-shadow:0 25px 50px rgba(0,0,0,0.25);width:320px;max-width:90vw;overflow:hidden" class="dark:!bg-slate-900">
            <div style="padding:16px 20px 12px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between">
                <span style="font-size:14px;font-weight:700">@reportMsgModalTitle</span>
                <button onclick="document.getElementById('cw-report-modal').style.display='none'" style="background:none;border:none;cursor:pointer;color:#94a3b8;font-size:18px;line-height:1">✕</button>
            </div>
            <div id="cw-report-preview" style="padding:10px 20px;background:#f8fafc;font-size:12px;color:#64748b;font-style:italic;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></div>
            <div style="padding:12px 20px 16px">
                <textarea id="cw-report-reason" placeholder="@reportReasonPlaceholder" style="width:100%;box-sizing:border-box;background:#f1f5f9;border:none;border-radius:6px;padding:8px 12px;font-size:12px;resize:none;height:70px;outline:none;font-family:inherit"></textarea>
                <div style="display:flex;gap:8px;margin-top:10px">
                    <button onclick="document.getElementById('cw-report-modal').style.display='none'" style="flex:1;padding:8px;border-radius:6px;border:1px solid #e2e8f0;background:white;font-size:12px;font-weight:600;cursor:pointer">@cancelText</button>
                    <button onclick="cwSubmitReport()" style="flex:1;padding:8px;border-radius:6px;border:none;background:#ef4444;color:white;font-size:12px;font-weight:700;cursor:pointer">@reportMsgText</button>
                </div>
            </div>
        </div>
    </div>

    <!-- FAB button -->
    <button onclick="toggleChatWidget()" id="chat-fab-btn"
        style="width:56px;height:56px;border-radius:50%;background:#50A5B1;border:none;color:white;box-shadow:0 10px 25px rgba(80,165,177,0.4);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform 0.2s,background 0.2s;position:relative"
        onmouseover="this.style.transform='scale(1.1)';this.style.background='#3d8a95'" onmouseout="this.style.transform='scale(1)';this.style.background='#50A5B1'">
        <span class="material-symbols-outlined" style="font-size:26px">chat</span>
        <span id="chat-fab-badge" style="display:none;position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;padding:0 3px;border-radius:9999px;background:#ef4444;color:white;font-size:10px;font-weight:700;align-items:center;justify-content:center;line-height:1">0</span>
    </button>
</div>

<script>
(function () {
    var chatWidgetExpanded = false;
    var popupChatUserId = null;  // current open conversation (same for popup and sidebar)
    var pendingChatFile = null;  // {file, mode}
    var pendingChatMatch = null; // {matchId, title}
    var chatListLoaded = false;
    var chatHubConnection = null;
    var CHAT_SW_W = 400;

    // ---- SignalR connection ----
    async function getChatHubConn() {
        if (!chatHubConnection) {
            chatHubConnection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/chat')
                .withAutomaticReconnect()
                .build();

            chatHubConnection.on('ReceiveMessage', function (msg) {
                if (msg.senderID === popupChatUserId) {
                    appendChatWidgetMsg(msg, false);
                    // Auto mark-read since conversation is open
                    fetch('/api/chat/mark-read?userId=' + msg.senderID, { method: 'POST' }).catch(function(){});
                } else {
                    // Not the current conversation: update badge + list preview
                    incrementChatFabBadge(1);
                    // Also increment nav chat badge
                    var navBadge = document.getElementById('chat-badge');
                    if (navBadge) {
                        var cur = parseInt(navBadge.textContent) || 0;
                        setChatBadge(cur + 1);
                    }
                    updateChatWidgetListItem(msg.senderID, msg.content, msg.messageType);
                }
            });

            chatHubConnection.on('MessageSent', function (msg) {
                if (msg.receiverID === popupChatUserId) {
                    appendChatWidgetMsg(msg, true);
                }
            });

            chatHubConnection.on('UserTyping', function(senderId) {
                if (senderId === popupChatUserId) {
                    var ti = document.getElementById('cw-typing-indicator');
                    if (ti) { ti.style.display = 'flex'; var msgsEl = document.getElementById(chatWidgetExpanded ? 'chat-sw-msgs' : 'chat-panel-msgs'); if (msgsEl) msgsEl.scrollTop = msgsEl.scrollHeight; }
                }
            });
            chatHubConnection.on('UserStoppedTyping', function(senderId) {
                if (senderId === popupChatUserId) {
                    var ti = document.getElementById('cw-typing-indicator');
                    if (ti) ti.style.display = 'none';
                }
            });
            chatHubConnection.on('ReactionUpdated', function(payload) {
                updateChatWidgetReactions(payload.messageId, payload.reactions);
            });
            chatHubConnection.on('MessageDeleted', function(payload) {
                var row = document.querySelector('[data-cw-row="' + payload.messageId + '"]');
                if (row) {
                    // Remove action buttons entirely
                    var actWrap = row.querySelector('.cw-actions-wrap');
                    if (actWrap) actWrap.remove();
                    row.removeAttribute('onmouseenter');
                    row.removeAttribute('onmouseleave');
                    // Replace bubble content with placeholder
                    var bubble = row.querySelector('[data-cw-mid="' + payload.messageId + '"]');
                    if (bubble) {
                        bubble.style.cssText = 'padding:6px 12px;border-radius:6px;border:1px dashed #cbd5e1;background:#f8fafc;font-size:12px;color:#94a3b8;font-style:italic';
                        bubble.textContent = '@msgDeletedText';
                    }
                    // Hide react bar
                    var reactBar = row.querySelector('.cw-react-bar');
                    if (reactBar) reactBar.style.display = 'none';
                }
            });
            chatHubConnection.on('MessagePinned', function(payload) {
                var banner = document.getElementById('cw-pinned-banner');
                var text = document.getElementById('cw-pinned-text');
                if (!banner || !text) return;
                if (payload.isPinned) { text.textContent = payload.previewText; banner.style.display = 'flex'; banner.dataset.mid = payload.messageId; }
                else banner.style.display = 'none';
            });
            chatHubConnection.on('MessagesRead', function(payload) {
                if (payload.conversationWith === popupChatUserId) {
                    document.querySelectorAll('.cw-read-receipt').forEach(function(el) { el.textContent = '✓✓'; el.style.color = '#50A5B1'; });
                }
            });

            await chatHubConnection.start().catch(function (e) { console.warn('Chat widget hub:', e); });
        }
        return chatHubConnection;
    }

    // ---- FAB badge ----
    window.incrementChatFabBadge = function (n) {
        var badge = document.getElementById('chat-fab-badge');
        if (!badge) return;
        var cur = parseInt(badge.textContent) || 0;
        cur += (n || 1);
        badge.textContent = cur > 9 ? '9+' : String(cur);
        badge.style.display = 'flex';
    };

    function resetChatFabBadge() {
        var badge = document.getElementById('chat-fab-badge');
        if (badge) { badge.style.display = 'none'; badge.textContent = '0'; }
    }

    // ---- Init FAB badge from API ----
    fetch('/api/chat/unread-count').then(function (r) { return r.json(); }).then(function (d) {
        if (d.count > 0) {
            var badge = document.getElementById('chat-fab-badge');
            if (badge) { badge.textContent = d.count > 9 ? '9+' : String(d.count); badge.style.display = 'flex'; }
        }
    }).catch(function(){});

    // Init popup positions: chat FAB sits left of AI FAB
    window.updateRightSidebarState();

    // ---- Toggle popup ----
    window.toggleChatWidget = function () {
        var panel = document.getElementById('chat-panel');
        var isOpen = panel.style.display === 'flex';
        if (isOpen) {
            panel.style.display = 'none';
        } else {
            panel.style.display = 'flex';
            if (!chatListLoaded) loadChatList('popup');
            getChatHubConn();
        }
        window.updateRightSidebarState();
    };

    // ---- Load conversation list ----
    function loadChatList(mode) {
        chatListLoaded = true;
        var listEl = document.getElementById(mode === 'full' ? 'chat-sw-list' : 'chat-panel-list');
        if (!listEl) return;
        listEl.innerHTML = '<div style="padding:20px;text-align:center;color:#94a3b8;font-size:13px">Đang tải...</div>';
        fetch('/api/chat/conversations').then(function (r) { return r.json(); }).then(function (convs) {
            renderChatList(convs, mode);
        }).catch(function () {
            if (listEl) listEl.innerHTML = '<div style="padding:20px;text-align:center;color:#94a3b8;font-size:13px">Không thể tải danh sách.</div>';
        });
    }

    function renderChatList(convs, mode) {
        var listEl = document.getElementById(mode === 'full' ? 'chat-sw-list' : 'chat-panel-list');
        if (!listEl) return;
        if (!convs || !convs.length) {
            listEl.innerHTML = '<div style="padding:20px;text-align:center;color:#94a3b8;font-size:13px">Chưa có cuộc trò chuyện nào.</div>';
            return;
        }
        var html = '';
        convs.forEach(function (c) {
            var avatarHtml = c.avatarUrl
                ? '<img src="' + c.avatarUrl + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%" />'
                : '<span style="font-size:16px;font-weight:700;color:#64748b">' + (c.name ? c.name[0].toUpperCase() : '?') + '</span>';
            var badgeHtml = c.unreadCount > 0
                ? '<span id="cw-badge-' + c.userId + '" style="position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;padding:0 3px;border-radius:9999px;background:#ef4444;color:white;font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center;line-height:1">' + (c.unreadCount > 9 ? '9+' : c.unreadCount) + '</span>'
                : '<span id="cw-badge-' + c.userId + '" style="position:absolute;top:-4px;right:-4px;min-width:18px;height:18px;padding:0 3px;border-radius:9999px;background:#ef4444;color:white;font-size:9px;font-weight:700;display:none;align-items:center;justify-content:center;line-height:1">0</span>';
            var preview = c.lastMessage || '';
            html += '<div onclick="openChatWidgetWith(' + c.userId + ',\'' + escJs(c.name) + '\',\'' + escJs(c.avatarUrl || '') + '\',\'' + mode + '\')" '
                + 'id="cw-conv-' + c.userId + '" '
                + 'style="display:flex;align-items:center;gap:10px;padding:10px 8px;border-radius:6px;cursor:pointer;transition:background 0.15s" '
                + 'onmouseover="this.style.background=\'#f1f5f9\'" onmouseout="this.style.background=\'transparent\'">'
                + '<div style="position:relative;flex-shrink:0;width:44px;height:44px;border-radius:50%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;overflow:hidden">' + avatarHtml + badgeHtml + '</div>'
                + '<div style="flex:1;min-width:0">'
                + '<p style="font-size:13px;font-weight:700;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escHtml(c.name) + '</p>'
                + (preview ? '<p id="cw-preview-' + c.userId + '" style="font-size:11px;color:#94a3b8;margin:2px 0 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escHtml(preview) + '</p>' : '<p id="cw-preview-' + c.userId + '" style="display:none"></p>')
                + '</div></div>';
        });
        listEl.innerHTML = html;
    }

    function updateChatWidgetListItem(senderId, content, messageType) {
        var preview = document.getElementById('cw-preview-' + senderId);
        if (preview) {
            var text = messageType === 'Image' ? 'Đã gửi một ảnh' : messageType === 'MatchCard' ? 'Đã chia sẻ thẻ trận' : (content.length > 30 ? content.substring(0,30) + '…' : content);
            preview.textContent = text;
            preview.style.display = '';
        }
        var badge = document.getElementById('cw-badge-' + senderId);
        if (badge) {
            var cur = parseInt(badge.textContent) || 0;
            badge.textContent = cur >= 9 ? '9+' : String(cur + 1);
            badge.style.display = 'flex';
        }
    }

    // ---- Open chat with user ----
    window.openChatWidgetWith = async function (userId, name, avatarUrl, mode) {
        popupChatUserId = userId;
        resetChatFabBadge();

        // Update header
        var avatarHtml = avatarUrl
            ? '<img src="' + avatarUrl + '" style="width:28px;height:28px;border-radius:50%;object-fit:cover" />'
            : '<div style="width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:white">' + (name ? name[0].toUpperCase() : '?') + '</div>';

        var headerTitleEl = document.getElementById(mode === 'full' ? 'chat-sw-header-title' : 'chat-panel-header-title');
        if (headerTitleEl) headerTitleEl.innerHTML = '<div style="display:flex;align-items:center;gap:8px">' + avatarHtml + '<p style="font-size:13px;font-weight:600;color:white;margin:0">' + escHtml(name) + '</p></div>';

        var backBtn = document.getElementById(mode === 'full' ? 'chat-sw-back-btn' : 'chat-panel-back-btn');
        if (backBtn) backBtn.style.display = 'flex';

        // Show chat view, hide list
        var listEl = document.getElementById(mode === 'full' ? 'chat-sw-list' : 'chat-panel-list');
        var chatEl = document.getElementById(mode === 'full' ? 'chat-sw-chat' : 'chat-panel-chat');
        if (listEl) listEl.style.display = 'none';
        if (chatEl) { chatEl.style.display = 'flex'; chatEl.style.flexDirection = 'column'; }

        // Load history
        var msgsEl = document.getElementById(mode === 'full' ? 'chat-sw-msgs' : 'chat-panel-msgs');
        if (msgsEl) msgsEl.innerHTML = '<div style="text-align:center;color:#94a3b8;font-size:12px;padding:20px">Đang tải...</div>';

        try {
            var r = await fetch('/api/chat/history?userId=' + userId);
            var msgs = await r.json();
            if (msgsEl) {
                msgsEl.innerHTML = '';
                msgs.forEach(function (m) { appendChatWidgetMsgToEl(msgsEl, m, m.senderID !== userId); });
                msgsEl.scrollTop = msgsEl.scrollHeight;
            }
        } catch (e) {
            if (msgsEl) msgsEl.innerHTML = '<div style="text-align:center;color:#94a3b8;font-size:12px;padding:20px">Không thể tải tin nhắn.</div>';
        }

        // Mark conversation as read & sync all badges
        var badge = document.getElementById('cw-badge-' + userId);
        if (badge) badge.style.display = 'none';
        fetch('/api/chat/mark-read?userId=' + userId, { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                setChatBadge(d.count || 0);
                var fabBadge = document.getElementById('chat-fab-badge');
                if (fabBadge) {
                    if ((d.count || 0) > 0) { fabBadge.textContent = d.count > 9 ? '9+' : String(d.count); fabBadge.style.display = 'flex'; }
                    else { fabBadge.style.display = 'none'; fabBadge.textContent = '0'; }
                }
            }).catch(function(){});

        await getChatHubConn();
        var inputId = mode === 'full' ? 'chat-sw-input' : 'chat-panel-input';
        setTimeout(function () { var inp = document.getElementById(inputId); if (inp) inp.focus(); }, 100);
    };

    // ---- Back to list ----
    window.chatBackToList = function (mode) {
        popupChatUserId = null;
        var listEl = document.getElementById(mode === 'full' ? 'chat-sw-list' : 'chat-panel-list');
        var chatEl = document.getElementById(mode === 'full' ? 'chat-sw-chat' : 'chat-panel-chat');
        if (listEl) listEl.style.display = '';
        if (chatEl) chatEl.style.display = 'none';
        var backBtn = document.getElementById(mode === 'full' ? 'chat-sw-back-btn' : 'chat-panel-back-btn');
        if (backBtn) backBtn.style.display = 'none';
        var headerTitle = document.getElementById(mode === 'full' ? 'chat-sw-header-title' : 'chat-panel-header-title');
        if (headerTitle) headerTitle.innerHTML = '<p style="font-size:' + (mode === 'full' ? '14' : '13') + 'px;font-weight:600;color:white;margin:0">@navMessages</p>';
        clearChatWidgetImage(mode);
        clearChatWidgetMatch();
    };

    // ---- Expand/shrink ----
    window.expandChatWidget = function () {
        if (chatWidgetExpanded) return;
        chatWidgetExpanded = true;
        window._chatSidebarOpen = true;
        // Reset view state — prevents blank white from stale display:none after prior expand
        document.getElementById('chat-sw-list').style.display = '';
        document.getElementById('chat-sw-chat').style.display = 'none';
        loadChatList('full');
        if (popupChatUserId) {
            // Sync current chat to sidebar
            var panelMsgs = document.getElementById('chat-panel-msgs');
            var swMsgs = document.getElementById('chat-sw-msgs');
            if (panelMsgs && swMsgs) swMsgs.innerHTML = panelMsgs.innerHTML;
            // Show chat view in sidebar
            document.getElementById('chat-panel-list').style.display = 'none';
            document.getElementById('chat-sw-list').style.display = 'none';
            document.getElementById('chat-sw-chat').style.display = 'flex';
            document.getElementById('chat-sw-chat').style.flexDirection = 'column';
        }
        document.getElementById('chat-panel').style.display = 'none';
        document.getElementById('chat-sidebar-widget').classList.add('open');
        window.updateRightSidebarState();
        getChatHubConn();
        setTimeout(function () { var inp = document.getElementById('chat-sw-input'); if (inp) inp.focus(); }, 350);
    };

    window.shrinkChatWidget = function () {
        if (!chatWidgetExpanded) return;
        chatWidgetExpanded = false;
        window._chatSidebarOpen = false;
        document.getElementById('chat-sidebar-widget').classList.remove('open');
        window.updateRightSidebarState();
        setTimeout(function () {
            document.getElementById('chat-panel').style.display = 'flex';
        }, 320);
    };

    window.closeChatSidebar = function () {
        if (!chatWidgetExpanded) return;
        chatWidgetExpanded = false;
        window._chatSidebarOpen = false;
        document.getElementById('chat-sidebar-widget').classList.remove('open');
        window.updateRightSidebarState();
    };

    // ---- Typing state ----
    var cwTypingTimer = null;
    var cwIsTyping = false;
    var cwReplyToMessageId = null;

    window.cwInputKeyup = async function(mode) {
        var conn = chatHubConnection;
        if (!conn || !popupChatUserId) return;
        if (!cwIsTyping) { cwIsTyping = true; try { await conn.invoke('TypingStart', popupChatUserId); } catch{} }
        clearTimeout(cwTypingTimer);
        cwTypingTimer = setTimeout(async function() { cwIsTyping = false; try { await conn.invoke('TypingStop', popupChatUserId); } catch{} }, 1500);
    };

    window.cwCancelReply = function() {
        cwReplyToMessageId = null;
        var bar = document.getElementById('cw-reply-bar');
        if (bar) bar.style.display = 'none';
    };
    window.cwScrollToPinned = function() {
        var banner = document.getElementById('cw-pinned-banner');
        var mid = banner && banner.dataset.mid;
        if (!mid) return;
        var el = document.querySelector('[data-cw-mid="' + mid + '"]');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    // ---- Send message ----
    window.sendChatWidgetMsg = async function (mode) {
        if (!popupChatUserId) return;
        var inputId = mode === 'full' ? 'chat-sw-input' : 'chat-panel-input';
        var input = document.getElementById(inputId);
        var content = input ? input.value.trim() : '';

        var conn = await getChatHubConn();
        if (conn.state !== signalR.HubConnectionState.Connected) return;

        if (cwIsTyping) { cwIsTyping = false; clearTimeout(cwTypingTimer); try { await conn.invoke('TypingStop', popupChatUserId); } catch{} }

        // Match card takes priority
        if (pendingChatMatch) {
            await conn.invoke('SendMatchCard', popupChatUserId, pendingChatMatch.matchId).catch(console.error);
            clearChatWidgetMatch();
            if (input) { input.value = ''; input.focus(); }
            return;
        }

        // Image
        var fileInputId = mode === 'full' ? 'chat-sw-file' : 'chat-panel-file';
        var fileInput = document.getElementById(fileInputId);
        if (fileInput && fileInput._pendingFile) {
            await uploadAndSendChatImage(popupChatUserId, fileInput._pendingFile, mode);
            fileInput._pendingFile = null;
            clearChatWidgetImage(mode);
            if (input) { input.value = ''; input.focus(); }
            return;
        }

        if (!content) return;
        await conn.invoke('SendMessage', popupChatUserId, content, cwReplyToMessageId || null).catch(console.error);
        cwCancelReply();
        if (input) { input.value = ''; input.focus(); }
    };

    async function uploadAndSendChatImage(receiverId, file, mode) {
        var formData = new FormData();
        formData.append('file', file);
        try {
            var res = await fetch('/api/chat/upload-image', { method: 'POST', body: formData });
            if (!res.ok) { alert('Lỗi upload ảnh.'); return; }
            var data = await res.json();
            var conn = await getChatHubConn();
            await conn.invoke('SendImage', receiverId, data.url).catch(console.error);
        } catch (e) { console.error(e); }
    }

    // ---- Append message ----
    function appendChatWidgetMsg(msg, isMine) {
        var mode = chatWidgetExpanded ? 'full' : 'popup';
        var msgsEl = document.getElementById(mode === 'full' ? 'chat-sw-msgs' : 'chat-panel-msgs');
        if (!msgsEl) return;
        appendChatWidgetMsgToEl(msgsEl, msg, isMine);
    }

    function appendChatWidgetMsgToEl(msgsEl, msg, isMine) {
        var time = new Date(msg.createdAt);
        var timeStr = time.getHours().toString().padStart(2,'0') + ':' + time.getMinutes().toString().padStart(2,'0');
        var mid = msg.messageID || msg.messageId || 0;
        var deleted = msg.isDeleted;
        var replyHtml = '';
        if (msg.replyPreview) {
            replyHtml = '<div style="font-size:10px;color:' + (isMine?'rgba(255,255,255,0.7)':'#64748b') + ';background:rgba(0,0,0,0.08);border-radius:6px;padding:3px 8px;margin-bottom:5px;border-left:2px solid ' + (isMine?'rgba(255,255,255,0.5)':'#50A5B1') + ';overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'
                + '↩ ' + escHtml(msg.replyPreview.content || '') + '</div>';
        }
        var receiptHtml = isMine ? '<span class="cw-read-receipt" style="font-size:9px;margin-left:3px;opacity:0.7">' + (msg.isRead ? '✓✓' : '✓') + '</span>' : '';

        // Actions wrapper — round pill bên cạnh bubble, đồng bộ với main chat
        var emojiList = ['❤️','😆','😮','😢','😠','👍'];
        var emojiTypes = ['Heart','Laugh','Wow','Sad','Angry','Like'];
        var pickerAlign = isMine ? 'right:0' : 'left:0';
        var btnStyle = 'width:28px;height:28px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;background:none;padding:0';
        var actionsHtml = deleted ? '' :
            '<div class="cw-actions-wrap" style="position:relative;flex-shrink:0;align-self:center">'
            // Nút hành động: react + reply + more_vert
            + '<div class="cw-msg-actions" style="display:none;flex-direction:row;gap:2px;align-items:center;background:white;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,0.15);padding:3px 6px">'
            + '<button onclick="cwToggleReactPicker(' + mid + ')" style="' + btnStyle + '" title="Cảm xúc"><span style="font-size:14px">😊</span></button>'
            + '<button onclick="cwSetReply(' + mid + ',\'' + escHtml((msg.content||'').substring(0,60)) + '\')" style="' + btnStyle + '" title="Trả lời"><span class="material-symbols-outlined" style="font-size:14px;color:#64748b">reply</span></button>'
            + '<button onclick="cwToggleMsgMenu(' + mid + ')" style="' + btnStyle + '" title="Thêm"><span class="material-symbols-outlined" style="font-size:14px;color:#64748b">more_vert</span></button>'
            + '</div>'
            // Reaction picker (mở lên trên)
            + '<div class="cw-reaction-picker" style="display:none;position:absolute;bottom:100%;margin-bottom:4px;' + pickerAlign + ';background:white;border-radius:6px;box-shadow:0 2px 12px rgba(0,0,0,0.15);padding:4px 8px;flex-direction:row;gap:4px;z-index:11;white-space:nowrap" data-mid="' + mid + '">'
            + emojiList.map(function(e, i) { return '<button onclick="cwPickReaction(' + mid + ',\'' + emojiTypes[i] + '\')" style="background:none;border:none;cursor:pointer;font-size:18px;transition:transform 0.1s" onmouseover="this.style.transform=\'scale(1.3)\'" onmouseout="this.style.transform=\'\'">' + e + '</button>'; }).join('')
            + '</div>'
            // 3-dot dropdown menu (mở lên trên)
            + '<div class="cw-msg-menu" data-mid="' + mid + '" style="display:none;position:absolute;bottom:100%;margin-bottom:4px;' + pickerAlign + ';background:white;border-radius:6px;box-shadow:0 4px 16px rgba(0,0,0,0.15);padding:4px 0;min-width:160px;z-index:12">'
            + '<button onclick="cwPinMsg(' + mid + ')" style="width:100%;padding:8px 14px;text-align:left;border:none;background:none;cursor:pointer;font-size:13px;color:#0f172a;display:flex;align-items:center;gap:8px" onmouseover="this.style.background=\'#f8fafc\'" onmouseout="this.style.background=\'none\'"><span class="material-symbols-outlined" style="font-size:14px;color:#64748b">push_pin</span>@pinMsgText</button>'
            + (isMine
                ? '<button onclick="cwDeleteMsg(' + mid + ')" style="width:100%;padding:8px 14px;text-align:left;border:none;background:none;cursor:pointer;font-size:13px;color:#ef4444;display:flex;align-items:center;gap:8px" onmouseover="this.style.background=\'#fff5f5\'" onmouseout="this.style.background=\'none\'"><span class="material-symbols-outlined" style="font-size:14px">delete</span>@deleteMsgText</button>'
                : '<button onclick="cwReportMsg(' + mid + ',\'' + escHtml((msg.content||'').substring(0,80)) + '\')" style="width:100%;padding:8px 14px;text-align:left;border:none;background:none;cursor:pointer;font-size:13px;color:#ef4444;display:flex;align-items:center;gap:8px" onmouseover="this.style.background=\'#fff5f5\'" onmouseout="this.style.background=\'none\'"><span class="material-symbols-outlined" style="font-size:14px">flag</span>@reportMsgText</button>')
            + '</div>'
            + '</div>';

        // Bubble column — max-width trực tiếp trên flex item, không bọc thêm position:relative
        var bubbleContent = '';
        if (deleted) {
            bubbleContent = '<div style="padding:6px 12px;border-radius:6px;border:1px dashed #cbd5e1;background:#f8fafc;font-size:12px;color:#94a3b8;font-style:italic">@msgDeletedText</div>';
        } else if (msg.messageType === 'Image' && msg.imageUrl) {
            bubbleContent = replyHtml
                + '<img src="' + msg.imageUrl + '" data-cw-mid="' + mid + '" style="max-width:160px;border-radius:6px;cursor:pointer;display:block" onclick="window.open(this.src)" />'
                + '<div style="font-size:10px;margin:2px 0 0;opacity:0.6;text-align:' + (isMine?'right':'left') + '">' + timeStr + receiptHtml + '</div>'
                + '<div class="cw-react-bar" data-mid="' + mid + '" style="display:flex;flex-wrap:wrap;gap:3px;margin-top:3px"></div>';
        } else if (msg.messageType === 'MatchCard' && msg.matchCardJson) {
            bubbleContent = replyHtml
                + '<div data-cw-mid="' + mid + '">' + renderChatWidgetMatchCard(msg.matchCardJson, isMine) + '</div>'
                + '<div style="font-size:10px;margin:2px 0 0;opacity:0.6;text-align:' + (isMine?'right':'left') + '">' + timeStr + receiptHtml + '</div>'
                + '<div class="cw-react-bar" data-mid="' + mid + '" style="display:flex;flex-wrap:wrap;gap:3px;margin-top:3px"></div>';
        } else {
            bubbleContent = '<div style="padding:8px 12px;border-radius:6px;font-size:13px;word-break:break-word;'
                + (isMine?'background:#50A5B1;color:white':'background:#f1f5f9;color:#0f172a') + '" data-cw-mid="' + mid + '">'
                + replyHtml
                + escHtml(msg.content || '')
                + '<div style="font-size:10px;margin-top:3px;opacity:0.7;display:flex;align-items:center;justify-content:flex-end;gap:2px">' + timeStr + receiptHtml + '</div>'
                + '</div>'
                + '<div class="cw-react-bar" data-mid="' + mid + '" style="display:flex;flex-wrap:wrap;gap:3px;margin-top:3px;justify-content:' + (isMine?'flex-end':'flex-start') + '"></div>';
        }
        var bubbleCol = '<div style="max-width:65%;display:flex;flex-direction:column;align-items:' + (isMine?'flex-end':'flex-start') + '">' + bubbleContent + '</div>';

        // isMine → actions bên TRÁI, bubble bên PHẢI; đối phương → bubble bên TRÁI, actions bên PHẢI
        var rowContent = isMine ? (actionsHtml + bubbleCol) : (bubbleCol + actionsHtml);
        var html = '<div style="display:flex;justify-content:' + (isMine?'flex-end':'flex-start') + ';align-items:flex-end;gap:6px;margin-bottom:2px" data-cw-row="' + mid + '" onmouseenter="cwShowActions(' + mid + ')" onmouseleave="cwHideActions(' + mid + ')">'
            + rowContent + '</div>';
        msgsEl.insertAdjacentHTML('beforeend', html);
        msgsEl.scrollTop = msgsEl.scrollHeight;
    }

    window.cwShowActions = function(mid) {
        var row = document.querySelector('[data-cw-row="' + mid + '"]');
        if (!row) return;
        var actEl = row.querySelector('.cw-msg-actions');
        if (actEl) actEl.style.display = 'flex';
    };
    window.cwHideActions = function(mid) {
        var row = document.querySelector('[data-cw-row="' + mid + '"]');
        if (!row) return;
        var actEl = row.querySelector('.cw-msg-actions');
        if (actEl) actEl.style.display = 'none';
        var picker = row.querySelector('.cw-reaction-picker');
        if (picker) picker.style.display = 'none';
        var menu = row.querySelector('.cw-msg-menu');
        if (menu) menu.style.display = 'none';
    };
    window.cwToggleMsgMenu = function(mid) {
        var row = document.querySelector('[data-cw-row="' + mid + '"]');
        if (!row) return;
        var menu = row.querySelector('.cw-msg-menu');
        if (!menu) return;
        // Đóng tất cả menu khác trước
        document.querySelectorAll('.cw-msg-menu').forEach(function(m) {
            if (m !== menu) m.style.display = 'none';
        });
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    };
    window.cwPinMsg = async function(mid) {
        if (!popupChatUserId) return;
        var conn = await getChatHubConn();
        await conn.invoke('PinMessage', mid, popupChatUserId).catch(function(){});
        document.querySelectorAll('.cw-msg-menu').forEach(function(m) { m.style.display = 'none'; });
    };
    window.cwToggleReactPicker = function(mid, btn) {
        var row = document.querySelector('[data-cw-row="' + mid + '"]');
        if (!row) return;
        var picker = row.querySelector('.cw-reaction-picker');
        if (!picker) return;
        picker.style.display = picker.style.display === 'flex' ? 'none' : 'flex';
    };
    window.cwPickReaction = async function(mid, type) {
        if (!popupChatUserId) return;
        var conn = await getChatHubConn();
        await conn.invoke('ReactToMessage', mid, popupChatUserId, type).catch(()=>{});
        var row = document.querySelector('[data-cw-row="' + mid + '"]');
        if (row) { var picker = row.querySelector('.cw-reaction-picker'); if (picker) picker.style.display = 'none'; }
    };
    window.cwSetReply = function(mid, preview) {
        cwReplyToMessageId = mid;
        var bar = document.getElementById('cw-reply-bar');
        var text = document.getElementById('cw-reply-text');
        if (bar) bar.style.display = 'flex';
        if (text) text.textContent = preview;
    };
    window.cwDeleteMsg = async function(mid) {
        if (!confirm('Xóa tin nhắn này?')) return;
        var conn = await getChatHubConn();
        await conn.invoke('DeleteMessage', mid, popupChatUserId).catch(()=>{});
    };
    var cwReportMsgId = null;
    window.cwReportMsg = function(mid, preview) {
        cwReportMsgId = mid;
        var modal = document.getElementById('cw-report-modal');
        var prev = document.getElementById('cw-report-preview');
        if (prev) prev.textContent = preview;
        if (modal) modal.style.display = 'flex';
    };
    window.cwSubmitReport = async function() {
        if (!cwReportMsgId) return;
        var reason = (document.getElementById('cw-report-reason') || {}).value || '';
        try {
            await fetch('/api/chat/messages/' + cwReportMsgId + '/report', {
                method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ reason })
            });
        } catch {}
        cwReportMsgId = null;
        var modal = document.getElementById('cw-report-modal');
        if (modal) modal.style.display = 'none';
    };
    function updateChatWidgetReactions(messageId, reactions) {
        document.querySelectorAll('.cw-react-bar[data-mid="' + messageId + '"]').forEach(function(bar) {
            bar.innerHTML = '';
            var emojiMap = { Heart:'❤️', Laugh:'😆', Wow:'😮', Sad:'😢', Angry:'😠', Like:'👍' };
            Object.entries(reactions).forEach(function([type, users]) {
                if (!users.length) return;
                var btn = document.createElement('button');
                btn.style.cssText = 'background:white;border:1px solid #e2e8f0;border-radius:6px;padding:1px 6px;font-size:12px;cursor:pointer;display:flex;align-items:center;gap:2px';
                btn.innerHTML = (emojiMap[type]||'?') + '<span style="font-size:11px">' + users.length + '</span>';
                btn.onclick = function() { cwPickReaction(messageId, type); };
                bar.appendChild(btn);
            });
        });
    }

    function renderChatWidgetMatchCard(jsonStr, isMine) {
        try {
            var m = JSON.parse(jsonStr);
            var link = m.id ? '<a href="/Matchmaking/Details?id=' + m.id + '" style="display:block;text-align:center;background:#50A5B1;color:white;border-radius:8px;padding:5px;font-size:11px;font-weight:700;text-decoration:none;margin-top:6px">Xem chi tiết</a>' : '';
            var bg = isMine ? 'background:rgba(37,96,233,0.06)' : 'background:#f8fafc';
            return '<div style="border:1px solid ' + (isMine ? '#bfdbfe' : '#e2e8f0') + ';border-radius:6px;padding:10px;' + bg + '">'
                + '<div style="display:flex;align-items:center;gap:5px;margin-bottom:3px"><span class="material-symbols-outlined" style="font-size:13px;color:#50A5B1">sports</span><strong style="font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escHtml(m.title || m.type || '') + '</strong></div>'
                + '<p style="font-size:11px;color:#64748b;margin:0">📅 ' + (m.date || '') + ' · ' + (m.time || '') + '</p>'
                + (m.venue ? '<p style="font-size:11px;color:#64748b;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">📍 ' + escHtml(m.venue) + '</p>' : '')
                + '<p style="font-size:11px;color:#64748b;margin:0">👥 ' + (m.participants || 0) + '/' + (m.max || 0) + '</p>'
                + link + '</div>';
        } catch(e) { return '<div style="font-size:11px;color:#94a3b8;padding:8px">Thẻ trận</div>'; }
    }

    // ---- Image handling ----
    window.handleChatWidgetFile = function (input, mode) {
        var file = input.files[0];
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) { alert('Ảnh quá lớn. Tối đa 5MB.'); input.value = ''; return; }
        input._pendingFile = file;
        var reader = new FileReader();
        reader.onload = function (e) {
            var thumbId = mode === 'full' ? 'chat-sw-img-thumb' : 'chat-panel-img-thumb';
            var nameId  = mode === 'full' ? 'chat-sw-img-name'  : 'chat-panel-img-name';
            var prevId  = mode === 'full' ? 'chat-sw-img-preview' : 'chat-panel-img-preview';
            var matchId = mode === 'full' ? 'chat-sw-match-preview' : 'chat-panel-match-preview';
            var thumb = document.getElementById(thumbId); if (thumb) thumb.src = e.target.result;
            var nameEl = document.getElementById(nameId); if (nameEl) nameEl.textContent = file.name;
            var prevEl = document.getElementById(prevId); if (prevEl) prevEl.style.display = '';
            var matchEl = document.getElementById(matchId); if (matchEl) matchEl.style.display = 'none';
        };
        reader.readAsDataURL(file);
        input.value = '';
    };

    window.clearChatWidgetImage = function (mode) {
        var fileId = mode === 'full' ? 'chat-sw-file' : 'chat-panel-file';
        var prevId = mode === 'full' ? 'chat-sw-img-preview' : 'chat-panel-img-preview';
        var f = document.getElementById(fileId); if (f) f._pendingFile = null;
        var p = document.getElementById(prevId); if (p) p.style.display = 'none';
    };

    window.handleChatWidgetPaste = function (e, mode) {
        var items = e.clipboardData && e.clipboardData.items;
        if (!items) return;
        for (var i = 0; i < items.length; i++) {
            if (items[i].type.indexOf('image') !== -1) {
                e.preventDefault();
                var file = items[i].getAsFile();
                if (file) {
                    var fileInputId = mode === 'full' ? 'chat-sw-file' : 'chat-panel-file';
                    var fakeInput = document.getElementById(fileInputId);
                    if (fakeInput) {
                        fakeInput._pendingFile = file;
                        var reader = new FileReader();
                        reader.onload = function (ev) {
                            var thumbId = mode === 'full' ? 'chat-sw-img-thumb' : 'chat-panel-img-thumb';
                            var nameId  = mode === 'full' ? 'chat-sw-img-name'  : 'chat-panel-img-name';
                            var prevId  = mode === 'full' ? 'chat-sw-img-preview' : 'chat-panel-img-preview';
                            var thumb = document.getElementById(thumbId); if (thumb) thumb.src = ev.target.result;
                            var nameEl = document.getElementById(nameId); if (nameEl) nameEl.textContent = 'image_pasted.png';
                            var prevEl = document.getElementById(prevId); if (prevEl) prevEl.style.display = '';
                        };
                        reader.readAsDataURL(file);
                    }
                }
                break;
            }
        }
    };

    // ---- Match card drag & drop ----
    window.handleChatWidgetDrop = function (e, mode) {
        e.preventDefault();
        var matchJson = e.dataTransfer.getData('application/match-card');
        if (matchJson) {
            try {
                var match = JSON.parse(matchJson);
                if (!popupChatUserId) { alert('Hãy chọn người chat trước.'); return; }
                pendingChatMatch = { matchId: match.id, title: match.title || match.type };
                var titleId = mode === 'full' ? 'chat-sw-match-title' : 'chat-panel-match-title';
                var prevId  = mode === 'full' ? 'chat-sw-match-preview' : 'chat-panel-match-preview';
                var imgPrevId = mode === 'full' ? 'chat-sw-img-preview' : 'chat-panel-img-preview';
                var titleEl = document.getElementById(titleId); if (titleEl) titleEl.textContent = pendingChatMatch.title;
                var prevEl  = document.getElementById(prevId);  if (prevEl)  prevEl.style.display = '';
                var imgEl   = document.getElementById(imgPrevId); if (imgEl) imgEl.style.display = 'none';
            } catch(ex) {}
            return;
        }
        // Image file drop
        var files = e.dataTransfer.files;
        if (files && files.length > 0 && files[0].type.startsWith('image/')) {
            handleChatWidgetFile({ files: [files[0]], value: '' }, mode);
        }
    };

    window.clearChatWidgetMatch = function () {
        pendingChatMatch = null;
        ['chat-sw-match-preview','chat-panel-match-preview'].forEach(function (id) {
            var el = document.getElementById(id); if (el) el.style.display = 'none';
        });
    };

    // ---- Helpers ----
    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function escJs(s) {
        return String(s || '').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
    }
})();
</script>
}
