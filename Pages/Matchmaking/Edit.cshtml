@page "{id:int}"
@model SportHub.Pages.Matchmaking.EditModel
@{
    ViewData["Title"] = "Chỉnh sửa trận";
}

<section class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-3xl font-black tracking-tight">Chỉnh sửa thông tin trận</h1>
        <p class="text-slate-500 dark:text-slate-400">Cập nhật thông tin chi tiết trận đấu của bạn.</p>
    </div>

    <form method="post" class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 space-y-5 shadow-sm">
        <input asp-for="Input.MatchId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>

        <div>
            <label class="block text-sm font-semibold mb-2">Tên trận đấu</label>
            <input asp-for="Input.Title" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
            <span asp-validation-for="Input.Title" class="text-xs text-red-500"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold mb-2">Sân cầu lông (ID, tùy chọn)</label>
                <input asp-for="Input.CourtId" type="number" min="1" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.CourtId" class="text-xs text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Môn thể thao</label>
                <select asp-for="Input.SportId" asp-items="Model.SportOptions" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                    <option value="">Chọn môn</option>
                </select>
                <span asp-validation-for="Input.SportId" class="text-xs text-red-500"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold mb-2">Tên sân (tùy chọn)</label>
                <input asp-for="Input.CourtName" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.CourtName" class="text-xs text-red-500"></span>
            </div>
            <div class="relative">
                <label class="block text-sm font-semibold mb-2">Địa chỉ sân (tùy chọn)</label>
                <input asp-for="Input.CourtAddress" id="courtAddressInput" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" placeholder="Nhập địa chỉ sân" autocomplete="off" />
                <span asp-validation-for="Input.CourtAddress" class="text-xs text-red-500"></span>
                <div id="createLocationSuggestions" class="absolute top-full left-0 right-0 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg mt-1 max-h-40 overflow-y-auto hidden z-50 shadow-lg"></div>
                <input type="hidden" asp-for="Input.Latitude" id="courtLatitude" />
                <input type="hidden" asp-for="Input.Longitude" id="courtLongitude" />
                <p class="mt-1 text-[11px] text-amber-700 dark:text-amber-400">Gợi ý tự động có thể chỉ tới mức đường. Sau khi chọn, <strong>kéo ghim đỏ</strong> đúng cổng sân.</p>
            </div>
        </div>

        <div id="createMapContainer" class="hidden">
            <label class="block text-sm font-semibold mb-2">Ghim vị trí chính xác trên bản đồ</label>
            <p class="text-xs text-slate-500 mb-2">Kéo thả ghim đến đúng sân.</p>
            <div id="createMap" class="h-56 w-full rounded-lg border border-slate-200 dark:border-slate-800 mb-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-semibold mb-2">Ngày thi đấu</label>
                <input asp-for="Input.MatchDate" type="date" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.MatchDate" class="text-xs text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Giờ bắt đầu</label>
                <input asp-for="Input.StartTime" type="time" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.StartTime" class="text-xs text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Giờ kết thúc</label>
                <input asp-for="Input.EndTime" type="time" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.EndTime" class="text-xs text-red-500"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-semibold mb-2">Loại trận</label>
                <select asp-for="Input.MatchType" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                    <option value="Singles">Một kèo một</option>
                    <option value="Doubles">Đôi</option>
                    <option value="Mixed">Hỗn hợp</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Trình độ yêu cầu</label>
                <select asp-for="Input.SkillRequired" asp-items="Model.SkillOptions" data-original-value="@Model.Input.SkillRequired" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800"></select>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Số người tối đa</label>
                <input asp-for="Input.MaxParticipants" type="number" min="2" max="20" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.MaxParticipants" class="text-xs text-red-500"></span>
            </div>
        </div>

        <div>
            <label class="block text-sm font-semibold mb-2">Giá trị trận đấu (VND, tùy chọn)</label>
            <input asp-for="Input.PriceVnd" type="number" min="0" step="1000" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
            <span asp-validation-for="Input.PriceVnd" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label class="block text-sm font-semibold mb-2">Mô tả trận</label>
            <textarea asp-for="Input.Description" rows="3" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800" placeholder="Mô tả thêm về trận đấu..."></textarea>
        </div>

        <div class="flex gap-3 flex-wrap">
            <button type="submit" class="px-6 py-2.5 bg-primary text-white rounded-lg font-bold hover:bg-primary/90 transition-colors">Lưu thay đổi</button>
            <a asp-page="/Matchmaking/Details" asp-route-id="@Model.Input.MatchId" class="px-6 py-2.5 bg-slate-100 dark:bg-slate-800 rounded-lg font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">Quay lại</a>
            <button type="button"
                    onclick="openDeleteMatchModal()"
                    class="px-6 py-2.5 bg-rose-500 text-white rounded-lg font-bold hover:bg-rose-600 transition-colors inline-flex items-center gap-2">
                <span class="material-symbols-outlined text-base">delete</span>
                Xóa trận
            </button>
        </div>
    </form>

    <form id="editDeleteMatchForm" method="post" asp-page-handler="Delete" asp-route-id="@Model.Input.MatchId"></form>

    <div id="deleteMatchModal" class="hidden fixed inset-0 z-[1200]">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-[1px]" onclick="closeDeleteMatchModal()"></div>
        <div class="relative mx-auto mt-24 w-[92%] max-w-md rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-2xl p-6">
            <div class="flex items-start gap-3">
                <div class="size-10 rounded-full bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 flex items-center justify-center">
                    <span class="material-symbols-outlined">warning</span>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900 dark:text-white">Xóa trận đấu?</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
                        Hành động này không thể hoàn tác. Người chơi liên quan sẽ nhận thông báo trận bị hủy.
                    </p>
                </div>
            </div>
            <div class="mt-5 flex justify-end gap-2">
                <button type="button" onclick="closeDeleteMatchModal()"
                        class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold hover:bg-slate-200 dark:hover:bg-slate-700">
                    Hủy
                </button>
                <button type="button" onclick="confirmDeleteMatch()"
                        class="px-4 py-2 rounded-lg bg-rose-500 text-white font-bold hover:bg-rose-600">
                    Xóa ngay
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/location-picker.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sportSelect = document.querySelector('select[name="Input.SportId"]');
            const skillSelect = document.querySelector('select[name="Input.SkillRequired"]');
            
            const badmintonSkills = [
                { value: "Any", text: "Mọi trình độ" },
                { value: "Newbie", text: "Newbie" },
                { value: "Yếu", text: "Yếu" },
                { value: "Yếu+", text: "Yếu+" },
                { value: "TBY/TB-", text: "TBY/TB-" },
                { value: "Trung Bình", text: "Trung bình" },
                { value: "TB+/Khá", text: "TB+/Khá" }
            ];
            
            const defaultSkills = [
                { value: "Any", text: "Mọi trình độ" },
                { value: "Beginner", text: "Người mới (Beginner)" },
                { value: "Intermediate", text: "Trung bình (Intermediate)" },
                { value: "Advanced", text: "Nâng cao (Advanced)" },
                { value: "Professional", text: "Chuyên nghiệp (Professional)" }
            ];

            function updateSkillOptions() {
                const selectedSportText = sportSelect.options[sportSelect.selectedIndex]?.text || "";
                let options = defaultSkills;
                
                if (selectedSportText.includes("Cầu lông") || selectedSportText.includes("Badminton")) {
                    options = badmintonSkills;
                }
                
                const currentValue = skillSelect.getAttribute('data-original-value') || skillSelect.value;
                skillSelect.removeAttribute('data-original-value');
                skillSelect.innerHTML = '';
                
                options.forEach(opt => {
                    const option = document.createElement('option');
                    option.value = opt.value;
                    option.text = opt.text;
                    if (opt.value === currentValue) {
                        option.selected = true;
                    }
                    skillSelect.appendChild(option);
                });
            }

            if (sportSelect && skillSelect) {
                sportSelect.addEventListener('change', updateSkillOptions);
                // Initial update
                updateSkillOptions();
            }

            SportHubLocationPicker.init({
                addressInputId: 'courtAddressInput',
                latInputId: 'courtLatitude',
                lonInputId: 'courtLongitude',
                suggestionsId: 'createLocationSuggestions',
                mapContainerId: 'createMapContainer',
                mapId: 'createMap',
                searchUrl: '/geo/search'
            });
        });

        function openDeleteMatchModal() {
            document.getElementById('deleteMatchModal')?.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
        function closeDeleteMatchModal() {
            document.getElementById('deleteMatchModal')?.classList.add('hidden');
            document.body.style.overflow = '';
        }
        function confirmDeleteMatch() {
            document.getElementById('editDeleteMatchForm')?.submit();
        }
    </script>
}
