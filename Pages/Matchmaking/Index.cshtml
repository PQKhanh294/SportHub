    function updateSkillGuideTitle(sport) {
        var titleEl = document.getElementById('sg-modal-title');
        var tablePanel = document.getElementById('sg-table-panel');
        var otherPanel = document.getElementById('sg-other-panel');
        if (!titleEl) return;

        var sportEmoji = { 'Cầu Lông':'🏸', 'Pickleball':'🏓', 'Tennis':'🎾', 'Bóng đá':'⚽', 'Bóng bàn':'🏓' };
        var emoji = sportEmoji[sport] || '🏅';
        var name = sport || 'Thể thao';
        titleEl.textContent = emoji + ' Trình Độ ' + name;

        var data = sport && sport !== 'Cầu Lông' && sport !== '' ? skillGuideData[sport] : null;
        if (data && otherPanel) {
            var rows = data.map(function(r) {
                return '<tr><td class="sg-lv-cell" style="color:' + r.color + '">' + r.level + '</td>' +
                       '<td>' + r.desc + '</td><td class="sg-time-cell">' + r.ref + '</td></tr>';
            }).join('');
            otherPanel.innerHTML = '<table id="sg-skill-table" style="overflow:auto;display:table"><thead><tr>' +
                '<th style="width:110px">TRÌNH ĐỘ</th><th>CHI TIẾT</th><th style="width:130px">THAM KHẢO</th>' +
                '</tr></thead><tbody>' + rows + '</tbody></table>';
            // Switch to otherPanel, hide table tab panel
            document.querySelectorAll('.sg-tab').forEach(function(t) { t.classList.remove('active'); });
            document.querySelectorAll('.sg-panel').forEach(function(p) { p.classList.remove('active'); });
            otherPanel.classList.add('active');
            otherPanel.style.display = 'block';
            if (tablePanel) { tablePanel.classList.remove('active'); tablePanel.style.display = 'none'; }
            // Make the table-tab re-activate when clicked (restore normal flow)
            var tableTab = document.querySelector('.sg-tab[onclick*="table"]');
            if (tableTab) tableTab.onclick = function() { sgSwitchTabWithOther('table', this); };
        } else {
            // Cầu Lông: show sg-table-panel
            if (otherPanel) { otherPanel.classList.remove('active'); otherPanel.style.display = 'none'; }
            if (tablePanel) { tablePanel.style.display = ''; tablePanel.classList.add('active'); }
            document.querySelectorAll('.sg-tab').forEach(function(t, i) { t.classList.toggle('active', i === 0); });
        }
    }

    function sgSwitchTabWithOther(tab, btn) {
        // Same as sgSwitchTab but also hides sg-other-panel
        var otherPanel = document.getElementById('sg-other-panel');
        if (otherPanel) { otherPanel.classList.remove('active'); otherPanel.style.display = 'none'; }
        sgSwitchTab(tab, btn);
    }

    function sgSwitchTab(tab, btn) {
        document.querySelectorAll('.sg-tab').forEach(function(t) { t.classList.remove('active'); });
        document.querySelectorAll('.sg-panel').forEach(function(p) { p.classList.remove('active'); });
        btn.classList.add('active');
        var panel = document.getElementById('sg-' + tab + '-panel');
        if (panel) panel.classList.add('active');
    }

    async function sgAssessSkill() {
        var input = document.getElementById('sg-ai-input');
        var btn = document.getElementById('sg-ai-btn');
        var result = document.getElementById('sg-ai-result');
        if (!input || !input.value.trim()) return;
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px;animation:spin 1s linear infinite">progress_activity</span> Đang phân tích...';
        result.style.display = 'none';
        try {
            var resp = await fetch('/api/skill/assess', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ description: input.value.trim() })
            });
            var data = await resp.json();
            var html = (data.result || 'Không thể phân tích.').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br/>');
            result.innerHTML = html;
            result.style.display = 'block';
        } catch(e) {
            result.innerHTML = 'Có lỗi xảy ra, vui lòng thử lại.';
            result.style.display = 'block';
        }
        btn.disabled = false;
        btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:16px">psychology</span> Đánh giá trình độ của tôi';
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeSkillModal();
    });

