<!-- JavaScript for Filter Functionality -->
<script>
    // --- SKILL LEVEL MODAL (simple version) ---
    function closeSkillModal() {
        var m = document.getElementById('skillGuideModal');
        if (m) { m.style.display = 'none'; document.body.style.overflow = ''; }
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeSkillModal();
    });

    // --- SKILL LEVEL MODAL (old compat) ---
    window.openSkillGuide = function() {
        const modal = document.getElementById('skillGuideModal');
        if (modal) {
            modal.style.cssText = 'display:flex; position:fixed; top:0; left:0; right:0; bottom:0; z-index:9999; align-items:center; justify-content:center; padding:1rem;';
            document.body.style.overflow = 'hidden';
        }
    };
    window.closeSkillGuide = function() {
        const modal = document.getElementById('skillGuideModal');
        if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }
    };
    window.handleModalBackdropClick = function(e) {
        if (e.target === document.getElementById('skillGuideModal')) {
            closeSkillGuide();
        }
    };
    window.switchTab = function(tab) {
        const imgEl    = document.getElementById('skillContentImg');
        const tableEl  = document.getElementById('skillContentTable');
        const btnImg   = document.getElementById('tabImg');
        const btnTable = document.getElementById('tabTable');
        if (tab === 'img') {
            imgEl.style.display   = 'block';
            tableEl.style.display = 'none';
            btnImg.classList.add('bg-white','dark:bg-slate-900','shadow-sm','text-primary','border','border-primary/30');
            btnImg.classList.remove('text-slate-500');
            btnTable.classList.remove('bg-white','dark:bg-slate-900','shadow-sm','text-primary','border','border-primary/30');
            btnTable.classList.add('text-slate-500');
        } else {
            tableEl.style.display = 'block';
            imgEl.style.display   = 'none';
            btnTable.classList.add('bg-white','dark:bg-slate-900','shadow-sm','text-primary','border','border-primary/30');
            btnTable.classList.remove('text-slate-500');
            btnImg.classList.remove('bg-white','dark:bg-slate-900','shadow-sm','text-primary','border','border-primary/30');
            btnImg.classList.add('text-slate-500');
        }
    };
    // ESC key closes modal
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeSkillGuide();
    });

    // --- DYNAMIC SKILL OPTIONS ---
    const badmintonSkills = [
        { value: "Any",       text: "Tất cả trình độ" },
        { value: "Newbie",    text: "Newbie" },
        { value: "Yếu",      text: "Yếu" },
        { value: "Yếu+",     text: "Yếu+" },
        { value: "TBY/TB-",  text: "TBY / TB-" },
        { value: "Trung Bình", text: "Trung Bình" },
        { value: "TB+/Khá",  text: "TB+ / Khá" }
    ];

    const defaultSkills = [
        { value: "Any",          text: "Tất cả trình độ" },
        { value: "Beginner",     text: "Người mới (Beginner)" },
        { value: "Intermediate", text: "Trung bình (Intermediate)" },
        { value: "Advanced",     text: "Nâng cao (Advanced)" },
        { value: "Professional", text: "Chuyên nghiệp (Professional)" }
    ];

    function updateSkillOptions() {
        const sportSelect = document.querySelector('select[name="Sport"]');
        const skillSelect = document.getElementById('skillSelect');
        if (!sportSelect || !skillSelect) return;

        const selectedSport = sportSelect.value;
        const options = selectedSport === 'Cầu Lông' ? badmintonSkills : defaultSkills;

        const currentValue = skillSelect.value;
        skillSelect.innerHTML = '';
        options.forEach(opt => {
            const option = document.createElement('option');
            option.value = opt.value;
            option.text = opt.text;
            if (opt.value === currentValue) option.selected = true;
            skillSelect.appendChild(option);
        });
    }

    // --- DUAL SLIDER LOGIC ---
    function setupDualSlider(minRangeId, maxRangeId, progressId, minInputId, maxInputId, isTime = false) {
        const minRange = document.getElementById(minRangeId);
        const maxRange = document.getElementById(maxRangeId);
        const progress = document.getElementById(progressId);
        const minInput = document.getElementById(minInputId);
        const maxInput = document.getElementById(maxInputId);

        if (!minRange || !maxRange || !minInput || !maxInput) {
            console.warn(`Missing slider elements: ${minRangeId}, ${maxRangeId}, ${progressId}, ${minInputId}, ${maxInputId}`);
            return;
        }

        function updateProgress() {
            const minPercent = (minRange.value / minRange.max) * 100;
            const maxPercent = (maxRange.value / maxRange.max) * 100;
            if (progress) {
                progress.style.left = minPercent + "%";
                progress.style.width = (maxPercent - minPercent) + "%";
            }
        }

        function formatTime(minutes) {
            const h = Math.floor(minutes / 60);
            const m = minutes % 60;
            return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
        }

        function parseTime(timeStr) {
            if (!timeStr) return 0;
            const parts = timeStr.split(':');
            if (parts.length !== 2) return 0;
            const h = parseInt(parts[0]) || 0;
            const m = parseInt(parts[1]) || 0;
            return h * 60 + m;
        }

        // Slider change handlers
        minRange.addEventListener('input', function() {
            let minVal = parseInt(this.value);
            let maxVal = parseInt(maxRange.value);
            
            // Ensure min doesn't exceed max
            if (minVal > maxVal) {
                minVal = maxVal;
                this.value = minVal;
            }
            
            minInput.value = isTime ? formatTime(minVal) : minVal;
            updateProgress();
        });

        maxRange.addEventListener('input', function() {
            let minVal = parseInt(minRange.value);
            let maxVal = parseInt(this.value);
            
            // Ensure max doesn't go below min
            if (maxVal < minVal) {
                maxVal = minVal;
                this.value = maxVal;
            }
            
            maxInput.value = isTime ? formatTime(maxVal) : maxVal;
            updateProgress();
        });

        // Input field change handlers
        minInput.addEventListener('change', function() {
            let val = isTime ? parseTime(this.value) : parseInt(this.value) || 0;
            let maxVal = parseInt(maxRange.value);
            
            if (val > maxVal) {
                val = maxVal;
                this.value = isTime ? formatTime(val) : val;
            }
            
            minRange.value = val;
            updateProgress();
        });

        maxInput.addEventListener('change', function() {
            let val = isTime ? parseTime(this.value) : parseInt(this.value) || 0;
            let minVal = parseInt(minRange.value);
            
            if (val < minVal) {
                val = minVal;
                this.value = isTime ? formatTime(val) : val;
            }
            
            maxRange.value = val;
            updateProgress();
        });

        // Sync initial state
        if (isTime) {
            if (minInput.value) minRange.value = parseTime(minInput.value);
            else minInput.value = formatTime(0);
            
            if (maxInput.value) maxRange.value = parseTime(maxInput.value);
            else maxInput.value = formatTime(1440);
        } else {
            if (minInput.value) minRange.value = parseInt(minInput.value) || 0;
            if (maxInput.value) maxRange.value = parseInt(maxInput.value) || 0;
        }
        updateProgress();
    }

    function setupSingleSlider(rangeId, progressId, inputId) {
        const range = document.getElementById(rangeId);
        const progress = document.getElementById(progressId);
        const input = document.getElementById(inputId);
        if (!range || !progress || !input) return;

        const min = () => parseFloat(range.min);
        const max = () => parseFloat(range.max);

        function clamp(val) {
            if (isNaN(val)) return min();
            return Math.min(max(), Math.max(min(), val));
        }

        function updateProgress() {
            const val = parseFloat(range.value);
            const percent = ((val - min()) / (max() - min())) * 100;
            progress.style.left = '0%';
            progress.style.width = percent + '%';
        }

        range.addEventListener('input', function () {
            const val = clamp(parseFloat(this.value));
            this.value = val;
            input.value = val;
            updateProgress();
        });

        input.addEventListener('input', function () {
            const val = clamp(parseFloat(this.value));
            range.value = val;
            updateProgress();
        });

        input.addEventListener('change', function () {
            const val = clamp(parseFloat(this.value));
            this.value = val;
            range.value = val;
            updateProgress();
        });

        const initial = clamp(parseFloat(input.value) || parseFloat(range.value) || 10);
        input.value = initial;
        range.value = initial;
        updateProgress();
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Init Sliders
        setupDualSlider('timeMin', 'timeMax', 'timeProgress', 'timeFrom', 'timeTo', true);
        setupDualSlider('priceMin', 'priceMax', 'priceProgress', 'minPriceInput', 'maxPriceInput', false);
        setupSingleSlider('radiusSlider', 'radiusProgress', 'radiusInput');

        // Init Sport -> Skill sync
        const sportSelect = document.querySelector('select[name="Sport"]');
        if (sportSelect) {
            sportSelect.addEventListener('change', updateSkillOptions);
            updateSkillOptions();
        }

        // Location Persistence
        const citySelect = document.getElementById('citySelect');
        const districtSelect = document.getElementById('districtSelect');
        const savedCity = localStorage.getItem('sporthub_pref_city');
        const savedDistrict = localStorage.getItem('sporthub_pref_district');

        if (savedCity && citySelect) {
            citySelect.value = savedCity;
            citySelect.dispatchEvent(new Event('change'));
            if (savedDistrict && districtSelect) {
                setTimeout(() => { districtSelect.value = savedDistrict; }, 100);
            }
        }

        if (citySelect) citySelect.addEventListener('change', () => localStorage.setItem('sporthub_pref_city', citySelect.value));
        if (districtSelect) districtSelect.addEventListener('change', () => localStorage.setItem('sporthub_pref_district', districtSelect.value));

        // District Dropdown Sync
        const cityData = {
            'Đà Nẵng': ['Hải Châu', 'Thanh Khê', 'Liên Chiểu', 'Ngũ Hành Sơn', 'Sơn Trà', 'Cẩm Lệ', 'Hòa Vang'],
            'Hồ Chí Minh': ['Quận 1', 'Quận 3', 'Quận 4', 'Quận 5', 'Quận 7', 'Bình Thạnh', 'Thủ Đức', 'Gò Vấp'],
            'Hà Nội': ['Ba Đình', 'Hoàn Kiếm', 'Đống Đa', 'Thanh Xuân', 'Cầu Giấy', 'Hai Bà Trưng', 'Long Biên']
        };

        if (citySelect && districtSelect) {
            citySelect.addEventListener('change', function() {
                const city = this.value;
                districtSelect.innerHTML = '<option value="">Quận/Huyện</option>';
                if (cityData[city]) {
                    cityData[city].forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d;
                        opt.textContent = d;
                        districtSelect.appendChild(opt);
                    });
                }
            });
        }

        // Quick Location Function
        window.setQuickLocation = function(city, district) {
            if (citySelect) {
                citySelect.value = city;
                citySelect.dispatchEvent(new Event('change'));
                setTimeout(() => { if (districtSelect) districtSelect.value = district; }, 50);
            }
        };

        // Address Autocomplete
        const locationInput = document.getElementById('locationInput');
        const locationSuggestions = document.getElementById('locationSuggestions');
        let debounceTimer;

        if (locationInput && locationSuggestions) {
            locationInput.addEventListener('input', function() {
                const query = this.value.trim();
                clearTimeout(debounceTimer);
                if (query.length < 3) {
                    locationSuggestions.classList.add('hidden');
                    return;
                }
                debounceTimer = setTimeout(() => {
                    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=vn&addressdetails=1&limit=5`, {
                        headers: { 'Accept-Language': 'vi' }
                    })
                    .then(r => r.json())
                    .then(data => {
                        locationSuggestions.innerHTML = '';
                        if (data.length > 0) {
                            data.forEach(item => {
                                const div = document.createElement('div');
                                div.className = 'p-3 hover:bg-slate-100 dark:hover:bg-slate-700 cursor-pointer border-b border-slate-100 dark:border-slate-800 last:border-0 text-sm';
                                div.innerHTML = `<div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-base">location_on</span><span class="truncate font-medium">${item.display_name}</span></div>`;
                                div.onclick = () => { locationInput.value = item.display_name; locationSuggestions.classList.add('hidden'); };
                                locationSuggestions.appendChild(div);
                            });
                            locationSuggestions.classList.remove('hidden');
                        } else {
                            locationSuggestions.classList.add('hidden');
                        }
                    })
                    .catch(e => console.error(e));
                }, 500);
            });
            document.addEventListener('click', e => {
                if (!locationInput.contains(e.target) && !locationSuggestions.contains(e.target)) {
                    locationSuggestions.classList.add('hidden');
                }
            });
        }

        // --- DATE FILTER SHORTCUTS ---
        window.setQuickDate = function(offset) {
            const input = document.getElementById('matchDateInput');
            if (!input) return;
            const d = new Date();
            if (offset === 'weekend') {
                // Jump to next Saturday
                const day = d.getDay(); // 0=Sun, 6=Sat
                const daysUntilSat = day === 6 ? 0 : (6 - day);
                d.setDate(d.getDate() + daysUntilSat);
            } else {
                d.setDate(d.getDate() + offset);
            }
            const yyyy = d.getFullYear();
            const mm   = String(d.getMonth() + 1).padStart(2, '0');
            const dd   = String(d.getDate()).padStart(2, '0');
            input.value = `${yyyy}-${mm}-${dd}`;
        };

        window.clearDate = function() {
            const input = document.getElementById('matchDateInput');
            if (input) {
                input.value = '';
                // Resubmit form without date
                document.getElementById('filterForm').submit();
            }
        };

        // --- KHOẢNG CÁCH: GPS hoặc địa chỉ mặc định trong hồ sơ (OpenStreetMap Nominatim) ---
        const userDefaultAddress = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UserDefaultAddress ?? string.Empty));
        const userDefaultLat = @(Model.UserDefaultLatitude.HasValue ? Model.UserDefaultLatitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");
        const userDefaultLon = @(Model.UserDefaultLongitude.HasValue ? Model.UserDefaultLongitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null");

        function haversineDistance(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a =
                Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        function formatDistanceKm(distance) {
            return distance < 1
                ? `~${(distance * 1000).toFixed(0)}m`
                : `~${distance.toFixed(1)} km`;
        }

        const geocodeCache = new Map();

        async function geocodeAddress(address) {
            const key = (address || '').trim();
            if (!key || key.length < 3) return null;
            if (geocodeCache.has(key)) return geocodeCache.get(key);

            try {
                const response = await fetch(
                    `/geo/search?q=${encodeURIComponent(key)}&limit=1`,
                    { headers: { 'Accept': 'application/json' } }
                );
                if (!response.ok) {
                    geocodeCache.set(key, null);
                    return null;
                }
                const data = await response.json();
                const first = Array.isArray(data) ? data[0] : data;
                if (first && first.lat != null && first.lon != null) {
                    const coords = { lat: parseFloat(first.lat), lon: parseFloat(first.lon) };
                    geocodeCache.set(key, coords);
                    return coords;
                }
            } catch (e) {
                console.error('Geocode error:', e);
            }

            geocodeCache.set(key, null);
            return null;
        }

        async function geocodeVenue(venueAddress) {
            const query = (venueAddress || '').trim();
            if (!query || query === 'TBD Venue') return null;

            const variations = [
                query,
                query.split('-').slice(1).join('-').trim(),
                query.split('-')[0].trim()
            ];

            for (const v of variations) {
                if (!v || v.length < 3) continue;
                const coords = await geocodeAddress(v);
                if (coords) {
                    geocodeCache.set(query, coords);
                    return coords;
                }
            }
            geocodeCache.set(query, null);
            return null;
        }

        function setDistancePending() {
            document.querySelectorAll('.distance-text').forEach(el => {
                el.textContent = 'Đang tính...';
            });
        }

        function setDistanceUnavailable() {
            document.querySelectorAll('.distance-text').forEach(el => {
                if (el.textContent === 'Đang tính...') {
                    el.textContent = '—';
                }
            });
            const statusEl = document.getElementById('radiusLocationStatus');
            if (statusEl) {
                statusEl.textContent = 'Bật định vị hoặc cập nhật địa chỉ trong Hồ sơ';
            }
        }

        function updateRadiusStatus(sourceLabel) {
            const statusEl = document.getElementById('radiusLocationStatus');
            if (statusEl) statusEl.textContent = sourceLabel;
        }

        async function resolveUserOrigin() {
            // 1) GPS trình duyệt (ưu tiên — vị trí thực tế)
            if (navigator.geolocation) {
                try {
                    const position = await new Promise((resolve, reject) => {
                        navigator.geolocation.getCurrentPosition(resolve, reject, {
                            enableHighAccuracy: false,
                            timeout: 12000,
                            maximumAge: 600000
                        });
                    });
                    return {
                        lat: position.coords.latitude,
                        lon: position.coords.longitude,
                        source: 'Vị trí hiện tại (GPS)'
                    };
                } catch (e) {
                    console.warn('Geolocation denied or failed:', e.message);
                }
            }

            // 2) Tọa độ đã ghim trên bản đồ trong hồ sơ (chính xác nhất)
            if (userDefaultLat != null && userDefaultLon != null) {
                return {
                    lat: userDefaultLat,
                    lon: userDefaultLon,
                    source: 'Vị trí đã ghim (hồ sơ)'
                };
            }

            // 3) Địa chỉ mặc định trong hồ sơ (geocode)
            if (userDefaultAddress && userDefaultAddress.trim().length >= 3) {
                const coords = await geocodeAddress(userDefaultAddress.trim());
                if (coords) {
                    return {
                        lat: coords.lat,
                        lon: coords.lon,
                        source: 'Địa chỉ hồ sơ'
                    };
                }
            }

            return null;
        }

        async function updateMatchDistances(userLat, userLon) {
            const displays = document.querySelectorAll('.match-distance-display');
            const tasks = Array.from(displays).map(async (display) => {
                const matchCard = display.closest('.match-card-content');
                if (!matchCard) return;

                const distanceText = display.querySelector('.distance-text');
                let lat = parseFloat(matchCard.getAttribute('data-latitude'));
                let lon = parseFloat(matchCard.getAttribute('data-longitude'));

                if (isNaN(lat) || isNaN(lon)) {
                    const venueAddress = matchCard.getAttribute('data-venue-address') || '';
                    const coords = await geocodeVenue(venueAddress);
                    if (coords) {
                        lat = coords.lat;
                        lon = coords.lon;
                        matchCard.setAttribute('data-latitude', lat);
                        matchCard.setAttribute('data-longitude', lon);
                    }
                }

                if (!isNaN(lat) && !isNaN(lon)) {
                    const distance = haversineDistance(userLat, userLon, lat, lon);
                    distanceText.textContent = formatDistanceKm(distance);
                } else {
                    distanceText.textContent = '—';
                }
            });

            await Promise.all(tasks);
        }

        async function initializeDistanceFromUser() {
            const hasServerDistance = Array.from(document.querySelectorAll('.distance-text'))
                .some(el => (el.textContent || '').trim().startsWith('~'));

            if (!hasServerDistance) {
                setDistancePending();
            }

            const origin = await resolveUserOrigin();
            if (origin) {
                updateRadiusStatus(origin.source);
                await updateMatchDistances(origin.lat, origin.lon);
                return;
            }

            if (!hasServerDistance) {
                await updateMatchDistancesFromProfileOnly();
            }

            const stillPending = Array.from(document.querySelectorAll('.distance-text'))
                .some(el => el.textContent === 'Đang tính...');
            if (stillPending) {
                setDistanceUnavailable();
            }
        }

        async function updateMatchDistancesFromProfileOnly() {
            if (!userDefaultAddress || userDefaultAddress.trim().length < 3) return;
            const coords = await geocodeAddress(userDefaultAddress.trim());
            if (coords) {
                updateRadiusStatus('Địa chỉ hồ sơ');
                await updateMatchDistances(coords.lat, coords.lon);
            }
        }

        initializeDistanceFromUser();
    });
</script>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        let map;
        let matchMarkerLayer;
        const matchesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Matches));

        function toggleMapView() {
            const mapSec = document.getElementById('mapSection');
            if (mapSec) {
                mapSec.classList.toggle('hidden');
                if (!mapSec.classList.contains('hidden')) {
                    if (!map) {
                        initMap();
                    } else {
                        renderMapMarkers();
                        setTimeout(() => map.invalidateSize(), 100);
                    }
                }
            }
        }

        function syncCoordsFromRenderedCards() {
            const cards = document.querySelectorAll('.match-card-content[data-match-id]');
            cards.forEach(card => {
                const id = Number(card.getAttribute('data-match-id'));
                if (!Number.isFinite(id)) return;
                const lat = Number(card.getAttribute('data-latitude'));
                const lon = Number(card.getAttribute('data-longitude'));
                if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;

                const m = matchesData.find(x => Number(x.MatchId) === id);
                if (m) {
                    m.Latitude = lat;
                    m.Longitude = lon;
                }
            });
        }

        async function initMap() {
            if (map) return;
            
            // Default center: Da Nang
            let center = [16.0544, 108.2022];
            
            // Try to find first match with coordinates
            const firstCoordMatch = matchesData.find(m => Number.isFinite(Number(m.Latitude)) && Number.isFinite(Number(m.Longitude)));
            if (firstCoordMatch) {
                center = [Number(firstCoordMatch.Latitude), Number(firstCoordMatch.Longitude)];
            }

            map = L.map('matchMap').setView(center, 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);
            matchMarkerLayer = L.layerGroup().addTo(map);
            await renderMapMarkers();
            setTimeout(() => map.invalidateSize(), 200);
        }

        async function renderMapMarkers() {
            if (!map || !matchMarkerLayer) return;
            matchMarkerLayer.clearLayers();

            syncCoordsFromRenderedCards();

            const placedMarkers = [];
            const geocodeCache = new Map();

            function safeText(value, fallback = "N/A") {
                return (value ?? "").toString().trim() || fallback;
            }

            async function resolveCoordinatesForMap(match) {
                let lat = Number(match.Latitude);
                let lon = Number(match.Longitude);
                if (Number.isFinite(lat) && Number.isFinite(lon)) {
                    return { lat, lon };
                }

                const query = safeText(match.VenueAddress || match.Venue, "").trim();
                if (!query || query === "TBD Venue") return null;

                if (geocodeCache.has(query)) return geocodeCache.get(query);

                try {
                    const res = await fetch(`/geo/search?q=${encodeURIComponent(query)}&limit=1`, {
                        headers: { Accept: 'application/json' }
                    });
                    if (!res.ok) {
                        geocodeCache.set(query, null);
                        return null;
                    }
                    const data = await res.json();
                    const first = Array.isArray(data) ? data[0] : null;
                    if (!first || first.lat == null || first.lon == null) {
                        geocodeCache.set(query, null);
                        return null;
                    }
                    lat = Number(first.lat);
                    lon = Number(first.lon);
                    if (!Number.isFinite(lat) || !Number.isFinite(lon)) {
                        geocodeCache.set(query, null);
                        return null;
                    }
                    const coords = { lat, lon };
                    geocodeCache.set(query, coords);
                    match.Latitude = lat;
                    match.Longitude = lon;
                    return coords;
                } catch {
                    geocodeCache.set(query, null);
                    return null;
                }
            }

            // Add markers + compact info label above each marker
            for (const match of matchesData) {
                const coords = await resolveCoordinatesForMap(match);
                if (!coords) continue;
                const lat = coords.lat;
                const lon = coords.lon;

                const skillText = safeText(match.SkillRequired, "Mọi trình độ");
                const timeText = safeText(match.StartTime, "--:--");
                const priceText = safeText(match.PriceDisplay, "Chưa có giá");

                const marker = L.marker([lat, lon]).addTo(matchMarkerLayer);
                placedMarkers.push(marker);

                marker.bindTooltip(
                    `<div style="background:#2563eb;color:#fff;font-weight:700;font-size:11px;line-height:1.2;padding:6px 8px;border-radius:10px;box-shadow:0 4px 10px rgba(0,0,0,.18);white-space:nowrap;">
                        <div>${skillText}</div>
                        <div>🕒 ${timeText}</div>
                        <div>💰 ${priceText}</div>
                     </div>`,
                    {
                        permanent: true,
                        direction: "top",
                        offset: [0, -10],
                        opacity: 1,
                        className: "match-map-tooltip"
                    }
                );

                marker.bindPopup(`
                    <div class="p-2" style="min-width: 180px;">
                        <div class="font-bold text-sm mb-1">${safeText(match.Title, "Trận đấu")}</div>
                        <div class="text-[11px] text-slate-500 mb-1">Trình độ: <b>${skillText}</b></div>
                        <div class="text-[11px] text-slate-500 mb-1">Giờ: <b>${timeText}</b></div>
                        <div class="text-[11px] text-slate-500 mb-2">Giá: <b>${priceText}</b></div>
                        <div class="flex items-center gap-1 text-[10px] text-slate-500 mb-2">
                            <span class="material-symbols-outlined text-[12px]">location_on</span>
                            ${safeText(match.Venue, "Không rõ địa điểm")}
                        </div>
                        <a href="/Matchmaking/Details?id=${match.MatchId}" class="inline-block text-[10px] font-bold text-white bg-primary px-2 py-1 rounded hover:bg-primary/90 transition-colors">Chi tiết</a>
                    </div>
                `);
            }

            // Adjust view to fit all rendered markers
            if (placedMarkers.length > 1) {
                const group = L.featureGroup(placedMarkers);
                map.fitBounds(group.getBounds().pad(0.1));
            } else if (placedMarkers.length === 1) {
                map.setView(placedMarkers[0].getLatLng(), 14);
            } else {
                const mapContainer = document.getElementById('matchMap');
                if (mapContainer && !mapContainer.querySelector('.no-marker-msg')) {
                    const msg = document.createElement('div');
                    msg.className = 'no-marker-msg absolute top-3 left-1/2 -translate-x-1/2 z-[1000] px-3 py-1.5 rounded-lg bg-amber-100 text-amber-800 text-xs font-semibold shadow';
                    msg.textContent = 'Chưa có trận nào có địa chỉ/tọa độ hợp lệ để hiển thị ghim.';
                    mapContainer.appendChild(msg);
                }
            }
        }
    </script>
}
