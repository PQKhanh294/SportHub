            btnTable.classList.remove('bg-white','dark:bg-slate-900','shadow-sm','text-primary','border','border-primary/30');
            btnTable.classList.add('text-slate-500');
        } else {
            tableEl.style.display = 'block';
            imgEl.style.display   = 'none';
            btnTable.classList.add('bg-white','dark:bg-slate-900','shadow-sm','text-primary','border','border-primary/30');
            btnTable.classList.remove('text-slate-500');
            btnImg.classList.remove('bg-white','dark:bg-slate-900','shadow-sm','text-primary','border','border-primary/30');
            btnImg.classList.add('text-slate-500');
        }
    };
