@page "{id:int?}"
@model SportHub.Pages.Matchmaking.DetailsModel
@{
    ViewData["Title"] = "Match Details";
    var item = Model.Item;
}

@if (item == null)
{
    <section class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-10 text-center">
        <span class="material-symbols-outlined text-5xl text-slate-300 mb-3 block">search_off</span>
        <p class="text-slate-500 dark:text-slate-400 font-semibold">Không tìm thấy trận đấu.</p>
        <a asp-page="/Matchmaking/Index" class="mt-4 inline-block text-primary font-bold hover:underline">← Quay lại danh sách</a>
    </section>
}
else
{
<section class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Left column -->
    <div class="lg:col-span-8 space-y-6">

        <!-- Match header card -->
        <article class="bg-white dark:bg-slate-900 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="relative h-64">
                <img class="w-full h-full object-cover"
                     src="@item.CourtImageUrl"
                     alt="Match" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
                <div class="absolute bottom-5 left-5 text-white">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="px-3 py-1 bg-primary text-xs font-bold rounded-full">@item.MatchType</span>
                        @if (item.SportName.Contains("Cầu lông", StringComparison.OrdinalIgnoreCase) || item.SportName.Contains("Badminton", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="px-3 py-1 bg-amber-500 text-xs font-bold rounded-full flex items-center gap-1">
                                <span>🏸 Cầu lông</span>
                            </span>
                        }
                        @if (item.RequiresApproval)
                        {
                            <span class="px-3 py-1 bg-amber-500 text-xs font-bold rounded-full flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">verified_user</span>
                                Cần duyệt
                            </span>
                        }
                    </div>
                    <h1 class="text-3xl font-black">@item.Title</h1>
                </div>
            </div>
            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-3 text-sm">
                    <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                        <span class="material-symbols-outlined text-base text-primary">calendar_today</span>
                        <span><b>Ngày:</b> @item.DateText</span>
                    </div>
                    <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                        <span class="material-symbols-outlined text-base text-primary">schedule</span>
                        <span><b>Giờ:</b> @item.TimeText</span>
                    </div>
                    <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                        <span class="material-symbols-outlined text-base text-primary">location_on</span>
                        <span><b>Địa điểm:</b> @item.CourtName — @item.CourtAddress</span>
                    </div>
                    <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                        <span class="material-symbols-outlined text-base text-primary">military_tech</span>
                        <span><b>Trình độ:</b> @item.SkillRequired</span>
                    </div>
                    <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                        <span class="material-symbols-outlined text-base text-primary">group</span>
                        <span><b>Người tham gia:</b> @item.AcceptedParticipants.Count / @item.MaxParticipants</span>
                    </div>
                </div>
                <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-5 space-y-3">
                    <div>
                        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Chi phí tham gia</p>
                        <p class="text-2xl font-black text-primary">@item.PriceDisplay</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Còn trống</p>
                        <p class="text-xl font-bold @(item.SpotsLeft == 0 ? "text-rose-500" : "text-emerald-600")">
                            @(item.SpotsLeft == 0 ? "Đã đầy" : $"{item.SpotsLeft} chỗ")
                        </p>
                    </div>
                    <a href="/Users/Profile/@item.HostId" class="flex items-center gap-2 pt-2 border-t border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 p-2 rounded-lg transition-colors group">
                        <img class="size-7 rounded-full" src="@item.HostAvatar" alt="@item.HostName" />
                        <p class="text-sm text-slate-600 dark:text-slate-400">Host: <span class="font-semibold group-hover:text-primary transition-colors">@item.HostName</span></p>
                    </a>
                </div>
            </div>
        </article>

        <!-- Confirmed participants -->
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm p-6">
            <h2 class="font-bold text-lg mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">group</span>
                Người đã tham gia (@item.AcceptedParticipants.Count/@item.MaxParticipants)
            </h2>
            @if (!item.AcceptedParticipants.Any())
            {
                <p class="text-slate-400 text-sm">Chưa có người tham gia.</p>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    @foreach (var p in item.AcceptedParticipants)
                    {
                        <a href="/Users/Profile/@p.UserId" class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                            <img class="size-10 rounded-full object-cover flex-shrink-0" src="@p.AvatarUrl" alt="@p.FullName" />
                            <div>
                                <p class="font-semibold text-sm text-slate-900 dark:text-white group-hover:text-primary transition-colors">@p.FullName</p>
                                <p class="text-xs text-slate-500">@p.SkillLevel</p>
                            </div>
                            <span class="material-symbols-outlined text-emerald-500 ml-auto text-sm">check_circle</span>
                        </a>
                    }
                </div>
            }
        </div>

        <!-- Location Map -->
        @if (item.Latitude.HasValue && item.Longitude.HasValue)
        {
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm p-6">
                <h2 class="font-bold text-lg mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">map</span>
                    Bản đồ địa điểm
                </h2>
                <div id="matchDetailMap" class="h-64 w-full rounded-xl border border-slate-200 dark:border-slate-700" style="z-index: 10;"></div>
            </div>
        }

        <!-- HOST ONLY: Pending requests -->
        @if (item.IsOwner && item.PendingParticipants.Any())
        {
            <div class="bg-white dark:bg-slate-900 rounded-xl border-2 border-amber-400 shadow-sm p-6">
                <h2 class="font-bold text-lg mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-amber-500">pending_actions</span>
                    Yêu cầu chờ duyệt (@item.PendingParticipants.Count)
                </h2>
                <div class="space-y-4">
                    @foreach (var pending in item.PendingParticipants)
                    {
                        <div class="flex items-center gap-4 p-4 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800">
                            <a href="/Users/Profile/@pending.UserId" class="flex-shrink-0">
                                <img class="size-12 rounded-full object-cover" src="@pending.AvatarUrl" alt="@pending.FullName" />
                            </a>
                            <div class="flex-1 min-w-0">
                                <a href="/Users/Profile/@pending.UserId" class="font-bold text-slate-900 dark:text-white hover:text-primary transition-colors block">@pending.FullName</a>
                                <p class="text-xs text-slate-500">Trình độ: @pending.SkillLevel</p>
                                <p class="text-xs text-slate-400">Đăng ký lúc: @pending.JoinedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</p>
                            </div>
                            <div class="flex gap-2 flex-shrink-0">
                                <form method="post" asp-page-handler="Approve">
                                    <input type="hidden" name="id" value="@item.MatchId" />
                                    <input type="hidden" name="participantId" value="@pending.ParticipantId" />
                                    <button type="submit"
                                            class="px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-bold rounded-lg transition-colors flex items-center gap-1">
                                        <span class="material-symbols-outlined text-sm">check</span>
                                        Duyệt
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Reject">
                                    <input type="hidden" name="id" value="@item.MatchId" />
                                    <input type="hidden" name="participantId" value="@pending.ParticipantId" />
                                    <button type="submit"
                                            class="px-4 py-2 bg-rose-500 hover:bg-rose-600 text-white text-sm font-bold rounded-lg transition-colors flex items-center gap-1">
                                        <span class="material-symbols-outlined text-sm">close</span>
                                        Từ chối
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>

    <!-- Right sidebar -->
    <aside class="lg:col-span-4 space-y-6">
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm sticky top-24">

            <!-- Status badge for current user -->
            @if (item.IsJoined)
            {
                <div class="mb-5 p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-xl flex items-center gap-3">
                    <span class="material-symbols-outlined text-emerald-500">check_circle</span>
                    <div>
                        <p class="font-bold text-emerald-700 dark:text-emerald-400">Bạn đã tham gia!</p>
                        <p class="text-xs text-emerald-600 dark:text-emerald-500">Đã xác nhận</p>
                    </div>
                </div>
            }
            else if (item.IsPending)
            {
                <div class="mb-5 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl flex items-center gap-3">
                    <span class="material-symbols-outlined text-amber-500">hourglass_top</span>
                    <div>
                        <p class="font-bold text-amber-700 dark:text-amber-400">Đang chờ duyệt</p>
                        <p class="text-xs text-amber-600 dark:text-amber-500">Host sẽ duyệt trong 1 giờ. Quá hạn yêu cầu tự hủy.</p>
                    </div>
                </div>
            }
            else if (item.IsApproved)
            {
                var feeDeadline = item.PlayerFeeDeadline?.ToLocalTime();
                var minsLeft = feeDeadline.HasValue ? (int)(feeDeadline.Value - DateTime.Now).TotalMinutes : 0;
                var urgent = minsLeft < 15 && minsLeft >= 0;
                <div class="mb-5 p-4 @(urgent ? "bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800" : "bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800") rounded-xl">
                    <div class="flex items-center gap-3 mb-3">
                        <span class="material-symbols-outlined @(urgent ? "text-rose-500" : "text-amber-500")">payment</span>
                        <div>
                            <p class="font-bold @(urgent ? "text-rose-700 dark:text-rose-400" : "text-amber-700 dark:text-amber-400")">Được duyệt — Chờ thanh toán</p>
                            <p class="text-xs @(urgent ? "text-rose-600 dark:text-rose-500" : "text-amber-600 dark:text-amber-500")">
                                Thanh toán 5,000 VND trước
                                @(feeDeadline.HasValue ? feeDeadline.Value.ToString("HH:mm dd/MM") : "hết hạn")
                                @if (minsLeft > 0) { <span class="font-bold"> (còn @minsLeft phút)</span> }
                                else { <span class="font-bold text-rose-600"> (đã hết hạn)</span> }
                            </p>
                        </div>
                    </div>
                    <a asp-page="/Matchmaking/Payment" asp-route-matchId="@item.MatchId" asp-route-type="playerfee"
                       class="w-full py-2.5 px-4 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl text-sm flex items-center justify-center gap-2 transition-all">
                        <span class="material-symbols-outlined text-sm">qr_code_2</span>
                        Thanh toán 5,000 VND ngay
                    </a>
                </div>
            }

            <!-- Host deposit prompt -->
            @if (item.ShowHostDepositPrompt)
            {
                <div class="mb-4 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-300 dark:border-amber-700 rounded-xl">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-amber-500">lock</span>
                        <p class="font-bold text-amber-700 dark:text-amber-400">Trận chưa được đăng</p>
                    </div>
                    <p class="text-xs text-amber-600 dark:text-amber-500 mb-3">
                        Đặt cọc <span class="font-bold">@item.HostDepositAmount.ToString("N0") VND</span> để trận được đăng công khai.
                    </p>
                    <a asp-page="/Matchmaking/Payment" asp-route-matchId="@item.MatchId" asp-route-type="deposit"
                       class="w-full py-2.5 px-4 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl text-sm flex items-center justify-center gap-2 transition-all">
                        <span class="material-symbols-outlined text-sm">qr_code_2</span>
                        Đặt cọc ngay
                    </a>
                </div>
            }

            <!-- Host remaining fee prompt -->
            @if (item.ShowRemainingFeePrompt)
            {
                <div class="mb-4 p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-300 dark:border-rose-700 rounded-xl">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-rose-500">payments</span>
                        <p class="font-bold text-rose-700 dark:text-rose-400">Trận đã bắt đầu</p>
                    </div>
                    <p class="text-xs text-rose-600 dark:text-rose-500 mb-3">
                        Hoàn thành phí dịch vụ còn lại <span class="font-bold">@item.RemainingFeeAmount.ToString("N0") VND</span>.
                    </p>
                    <a asp-page="/Matchmaking/Payment" asp-route-matchId="@item.MatchId" asp-route-type="remaining"
                       class="w-full py-2.5 px-4 bg-rose-500 hover:bg-rose-600 text-white font-bold rounded-xl text-sm flex items-center justify-center gap-2 transition-all">
                        <span class="material-symbols-outlined text-sm">qr_code_2</span>
                        Thanh toán phí còn lại
                    </a>
                </div>
            }

            <!-- Action buttons -->
            @if (item.CanJoin)
            {
                <form method="post" asp-page-handler="Join">
                    <input type="hidden" name="id" value="@item.MatchId" />
                    <button type="submit"
                            class="w-full py-3 px-6 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl transition-all shadow-md flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined">sports</span>
                        Gửi yêu cầu tham gia
                    </button>
                    <p class="text-xs text-slate-500 text-center mt-2">
                        <span class="material-symbols-outlined text-xs align-middle">info</span>
                        Host duyệt xong bạn mới vào trận. Yêu cầu hết hạn sau 1 giờ nếu chưa duyệt.
                    </p>
                </form>
            }
            else if (item.IsJoined)
            {
                <form method="post" asp-page-handler="Leave" class="mt-2">
                    <input type="hidden" name="id" value="@item.MatchId" />
                    <button type="submit"
                            class="w-full py-2 px-6 bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-900/20 text-slate-600 dark:text-slate-400 hover:text-rose-500 font-semibold rounded-xl transition-all text-sm">
                        Rời khỏi trận
                    </button>
                </form>
            }
            else if (!item.IsPending)
            {
                <button type="button"
                        class="w-full py-3 px-6 bg-slate-100 dark:bg-slate-800 text-slate-400 font-bold rounded-xl cursor-not-allowed">
                    @(item.SpotsLeft == 0 ? "Đã đầy chỗ" : "Không thể tham gia")
                </button>
            }

            @if (item.IsOwner)
            {
                <a asp-page="/Matchmaking/Edit" asp-route-id="@item.MatchId"
                   class="mt-3 w-full py-2 px-4 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold rounded-xl transition-all text-sm flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">edit</span>
                    Chỉnh sửa trận
                </a>
                <form id="detailDeleteMatchForm" method="post" asp-page-handler="Delete" class="mt-2">
                    <input type="hidden" name="id" value="@item.MatchId" />
                    <button type="button"
                            onclick="openDeleteMatchModal('detailDeleteMatchForm')"
                            class="w-full py-2 px-4 bg-rose-500 hover:bg-rose-600 text-white font-semibold rounded-xl transition-all text-sm flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-sm">delete</span>
                        Xóa trận
                    </button>
                </form>
            }

            <a asp-page="/Matchmaking/Index"
               class="mt-3 w-full py-2 px-4 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 font-semibold rounded-xl transition-all text-sm flex items-center justify-center gap-2 text-slate-600 dark:text-slate-400">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                Về danh sách
            </a>
        </div>
    </aside>
</section>
}

@if (item != null && item.IsOwner)
{
    <div id="deleteMatchModal" class="hidden fixed inset-0 z-[1200]">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-[1px]" onclick="closeDeleteMatchModal()"></div>
        <div class="relative mx-auto mt-24 w-[92%] max-w-md rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-2xl p-6">
            <div class="flex items-start gap-3">
                <div class="size-10 rounded-full bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 flex items-center justify-center">
                    <span class="material-symbols-outlined">warning</span>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900 dark:text-white">Xóa trận đấu?</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
                        Thao tác này không thể hoàn tác. Người chơi đã tham gia sẽ nhận thông báo trận bị hủy.
                    </p>
                </div>
            </div>
            <div class="mt-5 flex justify-end gap-2">
                <button type="button" onclick="closeDeleteMatchModal()"
                        class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold hover:bg-slate-200 dark:hover:bg-slate-700">
                    Hủy
                </button>
                <button type="button" onclick="confirmDeleteMatch()"
                        class="px-4 py-2 rounded-lg bg-rose-500 text-white font-bold hover:bg-rose-600">
                    Xóa ngay
                </button>
            </div>
        </div>
    </div>

    <script>
        let deleteMatchFormId = '';
        function openDeleteMatchModal(formId) {
            deleteMatchFormId = formId;
            document.getElementById('deleteMatchModal')?.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
        function closeDeleteMatchModal() {
            document.getElementById('deleteMatchModal')?.classList.add('hidden');
            document.body.style.overflow = '';
        }
        function confirmDeleteMatch() {
            if (!deleteMatchFormId) return;
            const form = document.getElementById(deleteMatchFormId);
            if (form) form.submit();
        }
    </script>
}

@if (item != null && item.Latitude.HasValue && item.Longitude.HasValue)
{
    @section Scripts {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var lat = @item.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var lon = @item.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                var map = L.map('matchDetailMap').setView([lat, lon], 15);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors'
                }).addTo(map);
                L.marker([lat, lon])
                    .addTo(map)
                    .bindPopup('<b>@Html.Raw(item.Venue)</b>')
                    .openPopup();
            });
        </script>
    }
}
