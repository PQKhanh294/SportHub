@page
@model SportHub.Pages.Matchmaking.CreateModel
@{
    ViewData["Title"] = "Tạo trận đấu";
}

<section class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-3xl font-black tracking-tight">Tạo trận đấu mới</h1>
        <p class="text-slate-500 dark:text-slate-400">Đăng bài tuyên giao lưu để tìm người chơi phù hợp.</p>
    </div>

    <!-- Mode tabs -->
    <div class="flex gap-1 p-1 bg-slate-100 dark:bg-slate-800 rounded-lg w-fit">
        <button type="button" id="tabQuick" onclick="switchMode('quick')"
                class="px-4 py-1.5 rounded-md text-sm font-semibold transition-all bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm">
            ⚡ Nhanh
        </button>
        <button type="button" id="tabFull" onclick="switchMode('full')"
                class="px-4 py-1.5 rounded-md text-sm font-semibold transition-all text-slate-500 dark:text-slate-400 hover:text-slate-700">
            Đầy đủ
        </button>
    </div>

    <form method="post" id="createMatchForm" class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 space-y-5 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>

        <!-- ── QUICK MODE ──────────────────────────────────────────────── -->
        <div id="quickModeSection" class="hidden space-y-4 pb-2 border-b border-slate-100 dark:border-slate-800">
            <p class="text-xs text-slate-400">Điền thông tin cơ bản, phần còn lại sẽ tự động. Có thể chỉnh sau.</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold mb-2">Môn thể thao <span class="text-red-500">*</span></label>
                    <select id="quickSportSelect" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                        <option value="">Chọn môn</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-2">Số người tối đa</label>
                    <input id="quickMaxParticipants" type="number" min="2" max="20" value="4" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-semibold mb-2">Ngày thi đấu <span class="text-red-500">*</span></label>
                    <input id="quickDate" type="date" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-2">Giờ bắt đầu <span class="text-red-500">*</span></label>
                    <input id="quickTime" type="time" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" value="18:00" />
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-2">Giờ kết thúc</label>
                    <input id="quickEndTime" type="time" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" value="19:00" />
                </div>
            </div>
            <div class="relative">
                <label class="block text-sm font-semibold mb-2">Địa chỉ sân</label>
                <input id="quickAddress" type="text" autocomplete="off" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" placeholder="Tên sân hoặc địa chỉ" />
                <div id="quickLocationSuggestions" class="absolute top-full left-0 right-0 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md mt-1 max-h-52 overflow-y-auto hidden z-[1000] shadow-lg"></div>
                <input type="hidden" id="quickLatitude" />
                <input type="hidden" id="quickLongitude" />
                <div id="quickMapContainer" class="hidden mt-2">
                    <div id="quickMap" class="h-48 w-full rounded-md border border-slate-200 dark:border-slate-800"></div>
                </div>
            </div>
        </div>
        <!-- ── /QUICK MODE ─────────────────────────────────────────────── -->

        <div id="fullModeSection">
        <div>
            <label class="block text-sm font-semibold mb-2">Tên trận đấu</label>
            <input asp-for="Input.Title" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
            <span asp-validation-for="Input.Title" class="text-xs text-red-500"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="relative">
                <label class="block text-sm font-semibold mb-2">Tìm sân (tùy chọn)</label>
                <input id="courtSearchInput" type="text" autocomplete="off"
                       class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800"
                       placeholder="Gõ tên sân để tìm kiếm..." />
                <div id="courtSearchResults" class="absolute top-full left-0 right-0 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md mt-1 max-h-52 overflow-y-auto hidden z-[1000] shadow-lg"></div>
                <input asp-for="Input.CourtId" type="hidden" id="courtIdHidden" />
                <p id="courtSelectedLabel" class="hidden mt-1 text-xs text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                    <span class="material-symbols-outlined text-[13px]">check_circle</span>
                    <span id="courtSelectedName"></span>
                    <button type="button" onclick="clearCourtSelection()" class="ml-1 text-slate-400 hover:text-red-400 text-xs underline">Xóa</button>
                </p>
                <span asp-validation-for="Input.CourtId" class="text-xs text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Môn thể thao <span class="text-red-500">*</span></label>
                <select asp-for="Input.SportId" asp-items="Model.SportOptions" id="sportSelect" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800">
                    <option value="">Chọn môn</option>
                </select>
                <span asp-validation-for="Input.SportId" class="text-xs text-red-500"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold mb-2">Tên sân (tùy chọn)</label>
                <input asp-for="Input.CourtName" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" placeholder="Nhập tên sân/địa điểm" />
                <span asp-validation-for="Input.CourtName" class="text-xs text-red-500"></span>
                <div class="mt-3">
                    <label class="block text-sm font-semibold mb-2">Sân số (tùy chọn)</label>
                    <input asp-for="Input.CourtNumber" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" placeholder="VD: Sân 3" />
                    <span asp-validation-for="Input.CourtNumber" class="text-xs text-red-500"></span>
                </div>
            </div>
            <div class="relative">
                <label class="block text-sm font-semibold mb-2">Địa chỉ sân (tùy chọn)</label>
                <input asp-for="Input.CourtAddress" id="courtAddressInput" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" placeholder="Nhập địa chỉ sân" autocomplete="off" />
                <span asp-validation-for="Input.CourtAddress" class="text-xs text-red-500"></span>
                <div id="createLocationSuggestions" class="absolute top-full left-0 right-0 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md mt-1 max-h-52 overflow-y-auto hidden z-[1000] shadow-lg"></div>
                <input type="hidden" asp-for="Input.Latitude" id="courtLatitude" />
                <input type="hidden" asp-for="Input.Longitude" id="courtLongitude" />
                <p class="mt-1 text-[11px] text-amber-700 dark:text-amber-400">Gợi ý tự động có thể chỉ tới mức đường. Sau khi chọn, <strong>kéo ghim đỏ</strong> đúng cổng sân để khoảng cách chính xác.</p>
            </div>
        </div>

        <div id="createMapContainer" class="hidden">
            <label class="block text-sm font-semibold mb-2">Ghim vị trí chính xác trên bản đồ</label>
            <p class="text-xs text-slate-500 mb-2">Kéo thả ghim đến đúng sân — tọa độ này được dùng để tính khoảng cách.</p>
            <div id="createMap" class="h-56 w-full rounded-md border border-slate-200 dark:border-slate-800 mb-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-semibold mb-2">Ngày thi đấu</label>
                <input asp-for="Input.MatchDate" type="date" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.MatchDate" class="text-xs text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Giờ bắt đầu</label>
                <input asp-for="Input.StartTime" type="time" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.StartTime" class="text-xs text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Giờ kết thúc</label>
                <input asp-for="Input.EndTime" type="time" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.EndTime" class="text-xs text-red-500"></span>
            </div>
        </div>

        <!-- Loại trận (sport-specific) -->
        <div>
            <label class="block text-sm font-semibold mb-2">
                Loại trận <span class="text-red-500">*</span>
                <span id="sport-warn-matchtype" class="hidden text-amber-700 dark:text-amber-400 text-xs font-normal ml-1">⚠ Vui lòng chọn môn thể thao trước</span>
            </label>
            <select id="matchTypeSelect" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800">
            </select>
            <div id="matchTypeCheckboxes" class="hidden flex flex-wrap gap-2">
                @foreach (var mt in new[] { "Đơn Nam", "Đơn Nữ", "Đôi Nam", "Đôi Nữ", "Đôi Hỗn hợp" })
                {
                    <label class="flex items-center gap-1.5 text-sm cursor-pointer border border-slate-200 dark:border-slate-700 rounded-md px-3 py-1.5 hover:border-primary transition-colors" style="has-checked:border-primary">
                        <input type="checkbox" class="mt-type-cb" style="accent-color:#50A5B1" value="@mt" />
                        <span>@mt</span>
                    </label>
                }
            </div>
            <span id="matchtype-err" class="hidden text-xs text-red-500 mt-1">Vui lòng chọn ít nhất một loại trận.</span>
            <input type="hidden" name="Input.MatchType" id="matchTypeHidden" value="@Model.Input.MatchType" />
        </div>

        <!-- Trình độ yêu cầu (sport-specific) -->
        <div>
            <label class="block text-sm font-semibold mb-2">
                Trình độ yêu cầu
                <span id="sport-warn-skill" class="hidden text-amber-700 dark:text-amber-400 text-xs font-normal ml-1">⚠ Vui lòng chọn môn thể thao trước</span>
            </label>
            <select id="skillSelect" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800">
            </select>
            <!-- Cầu lông: Nam/Nữ checkbox groups -->
            <div id="skillBadmintonSection" class="hidden space-y-3 mt-1">
                @{
                    var badmintonSkills = new (string Label, string Val)[] {
                        ("Mọi trình độ", "Any"), ("Newbie", "Newbie"), ("Yếu", "Yếu"),
                        ("Yếu+", "Yếu+"), ("TBY/TB-", "TBY/TB-"), ("Trung Bình", "Trung Bình"), ("TB+/Khá", "TB+/Khá")
                    };
                }
                <div>
                    <p class="text-xs font-semibold text-slate-500 mb-2">Trình Nam</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var sk in badmintonSkills)
                        {
                            <label class="flex items-center gap-1.5 text-sm cursor-pointer border border-slate-200 dark:border-slate-700 rounded-md px-3 py-1.5 hover:border-primary transition-colors">
                                <input type="checkbox" class="skill-male-cb" style="accent-color:#50A5B1" value="@sk.Val" />
                                <span>@sk.Label</span>
                            </label>
                        }
                    </div>
                </div>
                <div>
                    <p class="text-xs font-semibold text-slate-500 mb-2">Trình Nữ</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var sk in badmintonSkills)
                        {
                            <label class="flex items-center gap-1.5 text-sm cursor-pointer border border-slate-200 dark:border-slate-700 rounded-md px-3 py-1.5 hover:border-primary transition-colors">
                                <input type="checkbox" class="skill-female-cb" style="accent-color:#50A5B1" value="@sk.Val" />
                                <span>@sk.Label</span>
                            </label>
                        }
                    </div>
                </div>
            </div>
            <input type="hidden" name="Input.SkillRequired" id="skillRequiredHidden" value="@Model.Input.SkillRequired" />
        </div>

        <!-- Số người + Phí -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold mb-2">Số người tối đa</label>
                <input asp-for="Input.MaxParticipants" type="number" min="2" max="20" id="maxParticipantsInput" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                <span asp-validation-for="Input.MaxParticipants" class="text-xs text-red-500"></span>
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-semibold mb-2">Tổng chi phí sân (xu, tùy chọn)</label>
                <input asp-for="Input.PriceVnd" type="number" min="0" step="1000" id="priceVndInput" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" placeholder="Ví dụ: 200000" />
                <span asp-validation-for="Input.PriceVnd" class="text-xs text-red-500"></span>
                <!-- Phí chia đều — chỉ hiện với Cầu lông -->
                <div id="splitFeeSection" class="hidden pt-1">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="splitFeeChk" style="accent-color:#50A5B1;width:16px;height:16px" />
                        <span class="text-sm font-medium">Phí chia đều <span class="font-normal text-slate-500">(tổng / số người)</span></span>
                    </label>
                    <p id="splitFeePreview" class="hidden text-xs text-primary mt-1 font-medium"></p>
                </div>
                <input type="hidden" name="Input.IsSplitFee" id="isSplitFeeHidden" value="false" />
            </div>
        </div>

        <div>
            <div class="flex items-center justify-between mb-2">
                <label class="block text-sm font-semibold">Mô tả trận</label>
                <button type="button" id="aiDescBtn" onclick="generateAiDesc()"
                        class="flex items-center gap-1 px-3 py-1 rounded-md bg-primary/10 hover:bg-primary/20 text-primary text-xs font-semibold transition-colors">
                    <span class="material-symbols-outlined text-[14px]">auto_awesome</span>
                    <span id="aiDescBtnText">Gợi ý AI</span>
                </button>
            </div>
            <textarea id="descriptionTextarea" asp-for="Input.Description" rows="3" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800" placeholder="Mô tả thêm về trận đấu..."></textarea>
        </div>

        <!-- Lặp lại hàng tuần (tùy chọn) -->
        <div class="border border-slate-200 dark:border-slate-700 rounded-md p-4 space-y-3">
            <label class="flex items-center gap-2.5 cursor-pointer">
                <input type="checkbox" id="isRecurringChk" style="accent-color:#50A5B1;width:16px;height:16px" />
                <span class="text-sm font-semibold">Lặp lại hàng tuần <span class="font-normal text-slate-500">(tùy chọn — trận này diễn ra định kỳ)</span></span>
            </label>
            <div id="recurringOptions" class="hidden space-y-3 pt-1">
                <div>
                    <p class="text-xs font-semibold text-slate-500 mb-2">Lặp lại vào các thứ:</p>
                    <div class="flex flex-wrap gap-2">
                        @{
                            var weekDays = new (string L, int D)[] {
                                ("CN", 0), ("T2", 1), ("T3", 2), ("T4", 3), ("T5", 4), ("T6", 5), ("T7", 6)
                            };
                        }
                        @foreach (var d in weekDays)
                        {
                            <label class="flex items-center gap-1.5 text-sm cursor-pointer border border-slate-200 dark:border-slate-700 rounded-md px-3 py-1.5 hover:border-primary transition-colors">
                                <input type="checkbox" class="recurring-day-cb" style="accent-color:#50A5B1" value="@d.D" />
                                <span class="font-medium">@d.L</span>
                            </label>
                        }
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Lặp đến ngày <span class="font-normal">(mặc định: 4 tuần)</span></label>
                    <input asp-for="Input.RecurringUntil" type="date" class="rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" />
                </div>
            </div>
            <input type="hidden" name="Input.IsRecurring" id="isRecurringHidden" value="false" />
            <input type="hidden" name="Input.RecurringDays" id="recurringDaysHidden" value="" />
        </div>

        <div class="pt-1">
            <label class="flex items-center gap-2.5 cursor-pointer select-none">
                <input type="checkbox" asp-for="Input.HostJoins" class="w-4 h-4 rounded border-slate-300 dark:border-slate-600" style="accent-color:#50A5B1" />
                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Tôi cũng sẽ tham gia trận này với tư cách người chơi</span>
            </label>
            <p class="text-xs text-slate-400 mt-1 ml-6.5">Bỏ chọn nếu bạn chỉ tạo và quản lý trận, không tham gia thi đấu.</p>
        </div>

        </div> <!-- /fullModeSection -->

        <div class="flex gap-3">
            <button type="submit" class="px-6 py-2.5 bg-primary text-white rounded-md font-bold hover:bg-primary/90">Tạo trận</button>
            <a asp-page="/Matchmaking/Index" class="px-6 py-2.5 bg-slate-100 dark:bg-slate-800 rounded-md font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">Quay lại</a>
        </div>
    </form>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/location-picker.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const sportSelect = document.getElementById('sportSelect');

        // ── Sport-specific data ─────────────────────────────────────────────
        const matchTypesBySport = {
            'Cầu lông':  null, // handled by checkboxes
            'Bóng đá':   ['5v5', '7v7', '11v11'],
            'Tennis':    ['Đơn (Singles)', 'Đôi (Doubles)'],
            'Bóng bàn':  ['Đơn', 'Đôi', 'Đồng đội'],
            'Pickleball':['Đơn', 'Đôi', 'Hỗn hợp'],
            'default':   ['Đơn', 'Đôi', 'Hỗn hợp']
        };

        const skillsBySport = {
            'Cầu lông': null, // handled by checkboxes
            'Pickleball': [
                { v: 'Any', t: 'Tất cả trình độ' }, { v: '2.0', t: '2.0 — Mới bắt đầu' },
                { v: '2.5', t: '2.5 — Biết cơ bản' }, { v: '3.0', t: '3.0 — Ổn định' },
                { v: '3.5', t: '3.5 — Trung bình khá' }, { v: '4.0', t: '4.0 — Khá' },
                { v: '4.5+', t: '4.5+ — Nâng cao / Thi đấu' }
            ],
            'Tennis': [
                { v: 'Any', t: 'Tất cả trình độ' }, { v: '1.0-2.0', t: '1.0-2.0 — Mới bắt đầu' },
                { v: '2.5-3.0', t: '2.5-3.0 — Biết cơ bản' }, { v: '3.5', t: '3.5 — Trung bình' },
                { v: '4.0', t: '4.0 — Khá' }, { v: '4.5', t: '4.5 — Tốt' },
                { v: '5.0+', t: '5.0+ — Chuyên nghiệp' }
            ],
            'Bóng đá': [
                { v: 'Any', t: 'Tất cả trình độ' }, { v: 'Phong trào', t: 'Phong trào' },
                { v: 'Trung bình', t: 'Trung bình' }, { v: 'Khá', t: 'Khá' },
                { v: 'Tốt', t: 'Tốt' }, { v: 'Chuyên nghiệp', t: 'Chuyên nghiệp' }
            ],
            'Bóng bàn': [
                { v: 'Any', t: 'Tất cả trình độ' }, { v: 'Mới', t: 'Mới bắt đầu' },
                { v: 'Cơ bản', t: 'Cơ bản' }, { v: 'Trung bình', t: 'Trung bình' },
                { v: 'Khá', t: 'Khá' }, { v: 'Nâng cao', t: 'Nâng cao / Thi đấu' }
            ],
            'default': [
                { v: 'Any', t: 'Tất cả trình độ' }, { v: 'Mới', t: 'Mới bắt đầu' },
                { v: 'Trung bình', t: 'Trung bình' }, { v: 'Khá', t: 'Khá' },
                { v: 'Nâng cao', t: 'Nâng cao' }
            ]
        };

        // ── UI element refs ─────────────────────────────────────────────────
        const matchTypeSelect      = document.getElementById('matchTypeSelect');
        const matchTypeCheckboxes  = document.getElementById('matchTypeCheckboxes');
        const matchTypeHidden      = document.getElementById('matchTypeHidden');
        const matchTypeErr         = document.getElementById('matchtype-err');
        const sportWarnMatchtype   = document.getElementById('sport-warn-matchtype');

        const skillSelect          = document.getElementById('skillSelect');
        const skillBadmintonSection= document.getElementById('skillBadmintonSection');
        const skillRequiredHidden  = document.getElementById('skillRequiredHidden');
        const sportWarnSkill       = document.getElementById('sport-warn-skill');

        const splitFeeSection      = document.getElementById('splitFeeSection');
        const splitFeeChk          = document.getElementById('splitFeeChk');
        const splitFeePreview      = document.getElementById('splitFeePreview');
        const isSplitFeeHidden     = document.getElementById('isSplitFeeHidden');
        const priceVndInput        = document.getElementById('priceVndInput');
        const maxParticipantsInput = document.getElementById('maxParticipantsInput');

        const isRecurringChk       = document.getElementById('isRecurringChk');
        const recurringOptions     = document.getElementById('recurringOptions');
        const isRecurringHidden    = document.getElementById('isRecurringHidden');
        const recurringDaysHidden  = document.getElementById('recurringDaysHidden');

        // ── Helpers ─────────────────────────────────────────────────────────
        function getSportName() {
            const opt = sportSelect.options[sportSelect.selectedIndex];
            return opt ? opt.text.trim() : '';
        }
        function isBadminton() { return getSportName().includes('Cầu lông'); }
        function sportSelected() { return sportSelect.value !== ''; }

        // ── MatchType update ─────────────────────────────────────────────────
        function updateMatchType() {
            const sport = getSportName();
            if (isBadminton()) {
                matchTypeSelect.classList.add('hidden');
                matchTypeCheckboxes.classList.remove('hidden');
            } else {
                matchTypeSelect.classList.remove('hidden');
                matchTypeCheckboxes.classList.add('hidden');
                const types = matchTypesBySport[sport] || matchTypesBySport['default'];
                const prev = matchTypeSelect.value;
                matchTypeSelect.innerHTML = '';
                types.forEach(t => {
                    const o = document.createElement('option');
                    o.value = t; o.text = t;
                    if (t === prev) o.selected = true;
                    matchTypeSelect.appendChild(o);
                });
                matchTypeHidden.value = matchTypeSelect.value;
            }
        }

        // ── Skill update ─────────────────────────────────────────────────────
        function updateSkill() {
            const sport = getSportName();
            if (isBadminton()) {
                skillSelect.classList.add('hidden');
                skillBadmintonSection.classList.remove('hidden');
            } else {
                skillSelect.classList.remove('hidden');
                skillBadmintonSection.classList.add('hidden');
                const skills = skillsBySport[sport] || skillsBySport['default'];
                const prev = skillSelect.value;
                skillSelect.innerHTML = '';
                skills.forEach(s => {
                    const o = document.createElement('option');
                    o.value = s.v; o.text = s.t;
                    if (s.v === prev) o.selected = true;
                    skillSelect.appendChild(o);
                });
                skillRequiredHidden.value = skillSelect.value;
            }
        }

        // ── Split fee ─────────────────────────────────────────────────────────
        function updateSplitFeeVisibility() {
            if (isBadminton()) {
                splitFeeSection.classList.remove('hidden');
            } else {
                splitFeeSection.classList.add('hidden');
                splitFeeChk.checked = false;
                isSplitFeeHidden.value = 'false';
                splitFeePreview.classList.add('hidden');
            }
        }

        function updateSplitFeePreview() {
            if (!splitFeeChk.checked) {
                splitFeePreview.classList.add('hidden');
                return;
            }
            const total = parseFloat(priceVndInput.value) || 0;
            const people = parseInt(maxParticipantsInput.value) || 1;
            if (total > 0 && people > 0) {
                const perPerson = Math.ceil(total / people);
                splitFeePreview.textContent = '≈ ' + perPerson.toLocaleString('vi-VN') + ' xu/người';
                splitFeePreview.classList.remove('hidden');
            } else {
                splitFeePreview.classList.add('hidden');
            }
        }

        // ── Sport change handler ──────────────────────────────────────────────
        sportSelect.addEventListener('change', function () {
            updateMatchType();
            updateSkill();
            updateSplitFeeVisibility();
            sportWarnMatchtype.classList.add('hidden');
            sportWarnSkill.classList.add('hidden');
        });

        // ── Validate sport selected before interacting ────────────────────────
        matchTypeSelect.addEventListener('focus', function () {
            if (!sportSelected()) sportWarnMatchtype.classList.remove('hidden');
        });
        matchTypeCheckboxes.addEventListener('click', function () {
            if (!sportSelected()) { sportWarnMatchtype.classList.remove('hidden'); return; }
        });
        skillSelect.addEventListener('focus', function () {
            if (!sportSelected()) sportWarnSkill.classList.remove('hidden');
        });
        skillBadmintonSection.addEventListener('click', function () {
            if (!sportSelected()) { sportWarnSkill.classList.remove('hidden'); return; }
        });

        // ── Checkbox styling (highlight selected) ────────────────────────────
        document.querySelectorAll('.mt-type-cb, .skill-male-cb, .skill-female-cb, .recurring-day-cb').forEach(function(cb) {
            cb.addEventListener('change', function() {
                const lbl = this.closest('label');
                if (lbl) lbl.style.borderColor = this.checked ? '#50A5B1' : '';
            });
        });

        // ── Split fee events ──────────────────────────────────────────────────
        splitFeeChk.addEventListener('change', function () {
            isSplitFeeHidden.value = this.checked ? 'true' : 'false';
            updateSplitFeePreview();
        });
        priceVndInput.addEventListener('input', updateSplitFeePreview);
        maxParticipantsInput.addEventListener('input', updateSplitFeePreview);

        // ── Recurring toggle ──────────────────────────────────────────────────
        isRecurringChk.addEventListener('change', function () {
            isRecurringHidden.value = this.checked ? 'true' : 'false';
            if (this.checked) {
                recurringOptions.classList.remove('hidden');
                // default RecurringUntil to 4 weeks from MatchDate
                const matchDateInput = document.querySelector('input[name="Input.MatchDate"]');
                const recurringUntilInput = document.querySelector('input[name="Input.RecurringUntil"]');
                if (matchDateInput && matchDateInput.value && recurringUntilInput && !recurringUntilInput.value) {
                    const d = new Date(matchDateInput.value);
                    d.setDate(d.getDate() + 28);
                    recurringUntilInput.value = d.toISOString().split('T')[0];
                }
            } else {
                recurringOptions.classList.add('hidden');
            }
        });

        // ── Form submit: populate hidden inputs ───────────────────────────────
        document.getElementById('createMatchForm').addEventListener('submit', function (e) {
            // Quick mode: populate full-form hidden fields from quick inputs
            if (currentMode === 'quick') {
                const qSport = document.getElementById('quickSportSelect').value;
                const qDate    = document.getElementById('quickDate').value;
                const qTime    = document.getElementById('quickTime').value;
                const qEndTime = document.getElementById('quickEndTime').value;
                const qMaxP    = document.getElementById('quickMaxParticipants').value;
                const qAddr    = document.getElementById('quickAddress').value;

                if (!qSport || !qDate || !qTime) {
                    e.preventDefault();
                    alert('Vui lòng điền đầy đủ: Môn thể thao, Ngày và Giờ bắt đầu.');
                    return;
                }

                // Sync to full form fields
                sportSelect.value = qSport;
                sportSelect.dispatchEvent(new Event('change'));

                const titleInput = document.querySelector('[name="Input.Title"]');
                const sportName = sportSelect.options[sportSelect.selectedIndex]?.text || 'Trận đấu';
                const dateParts = qDate.split('-');
                const dateDisplay = dateParts[2] + '/' + dateParts[1];
                if (titleInput && !titleInput.value) titleInput.value = `${sportName} ${dateDisplay}`;

                document.querySelector('[name="Input.MatchDate"]').value = qDate;
                document.querySelector('[name="Input.StartTime"]').value = qTime;
                document.querySelector('[name="Input.MaxParticipants"]').value = qMaxP || '4';

                if (qEndTime) {
                    document.querySelector('[name="Input.EndTime"]').value = qEndTime;
                } else {
                    // Fallback: StartTime + 1 hour
                    const [h, m] = qTime.split(':').map(Number);
                    const endH = String((h + 1) % 24).padStart(2, '0');
                    document.querySelector('[name="Input.EndTime"]').value = `${endH}:${m.toString().padStart(2, '0')}`;
                }

                if (qAddr) {
                    const addrInput = document.querySelector('[name="Input.CourtName"]');
                    if (addrInput && !addrInput.value) addrInput.value = qAddr;
                    const fullAddr = document.getElementById('courtAddressInput');
                    if (fullAddr && !fullAddr.value) fullAddr.value = qAddr;
                }
                const qLat = document.getElementById('quickLatitude').value;
                const qLon = document.getElementById('quickLongitude').value;
                if (qLat && qLon) {
                    document.getElementById('courtLatitude').value = qLat;
                    document.getElementById('courtLongitude').value = qLon;
                }

                // Quick mode: fields hidden in fullModeSection can't be interacted with by
                // the user, so set sensible defaults directly instead of validating checkboxes.
                if (isBadminton()) {
                    matchTypeHidden.value = 'Đôi Nam,Đôi Nữ';
                } else {
                    const types = matchTypesBySport[sportName] || matchTypesBySport['default'];
                    matchTypeHidden.value = types[0];
                }
                skillRequiredHidden.value = 'Any';

                // Skip full-form MatchType/SkillRequired validation below — already set above.
            } else {
                // MatchType
                if (isBadminton()) {
                    const checked = [...document.querySelectorAll('.mt-type-cb:checked')].map(c => c.value);
                    if (checked.length === 0) {
                        e.preventDefault();
                        matchTypeErr.classList.remove('hidden');
                        matchTypeCheckboxes.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return;
                    }
                    matchTypeErr.classList.add('hidden');
                    matchTypeHidden.value = checked.join(',');
                } else {
                    matchTypeHidden.value = matchTypeSelect.value;
                }

                // SkillRequired
                if (isBadminton()) {
                    const male   = [...document.querySelectorAll('.skill-male-cb:checked')].map(c => c.value);
                    const female = [...document.querySelectorAll('.skill-female-cb:checked')].map(c => c.value);
                    const parts  = [];
                    if (male.length > 0)   parts.push('Nam:' + male.join(','));
                    if (female.length > 0) parts.push('Nữ:' + female.join(','));
                    skillRequiredHidden.value = parts.length > 0 ? parts.join('|') : 'Any';
                } else {
                    skillRequiredHidden.value = skillSelect.value || 'Any';
                }
            }

            // RecurringDays
            if (isRecurringChk.checked) {
                const days = [...document.querySelectorAll('.recurring-day-cb:checked')].map(c => c.value);
                recurringDaysHidden.value = days.join(',');
            }
        });

        // ── Init ─────────────────────────────────────────────────────────────
        updateMatchType();
        updateSkill();
        updateSplitFeeVisibility();

        SportHubLocationPicker.init({
            addressInputId: 'courtAddressInput',
            latInputId: 'courtLatitude',
            lonInputId: 'courtLongitude',
            suggestionsId: 'createLocationSuggestions',
            mapContainerId: 'createMapContainer',
            mapId: 'createMap',
            searchUrl: '/geo/search'
        });

        SportHubLocationPicker.init({
            addressInputId: 'quickAddress',
            latInputId: 'quickLatitude',
            lonInputId: 'quickLongitude',
            suggestionsId: 'quickLocationSuggestions',
            mapContainerId: 'quickMapContainer',
            mapId: 'quickMap',
            searchUrl: '/geo/search'
        });

        // ── Court autocomplete ───────────────────────────────────────────────
        const courtSearchInput   = document.getElementById('courtSearchInput');
        const courtSearchResults = document.getElementById('courtSearchResults');
        const courtIdHidden      = document.getElementById('courtIdHidden');
        const courtSelectedLabel = document.getElementById('courtSelectedLabel');
        const courtSelectedName  = document.getElementById('courtSelectedName');
        const courtNameInput     = document.getElementById('Input_CourtName') || document.querySelector('[name="Input.CourtName"]');
        const courtAddressInput  = document.getElementById('courtAddressInput');

        let courtSearchTimer = null;
        courtSearchInput.addEventListener('input', function () {
            clearTimeout(courtSearchTimer);
            const q = this.value.trim();
            if (q.length < 2) { courtSearchResults.classList.add('hidden'); return; }
            const sportId = sportSelect.value || '';
            courtSearchTimer = setTimeout(async () => {
                const res = await fetch(`/api/courts/search?q=${encodeURIComponent(q)}&sportId=${sportId}`);
                const data = await res.json();
                courtSearchResults.innerHTML = '';
                if (!data.length) {
                    courtSearchResults.innerHTML = '<p class="px-3 py-2 text-xs text-slate-400">Không tìm thấy sân phù hợp.</p>';
                } else {
                    data.forEach(c => {
                        const div = document.createElement('div');
                        div.className = 'flex flex-col px-3 py-2.5 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700 border-b border-slate-100 dark:border-slate-700 last:border-0';
                        div.innerHTML = `<span class="font-semibold text-sm text-slate-900 dark:text-white">${c.name}</span><span class="text-xs text-slate-400">${c.venue}${c.address ? ' · ' + c.address : ''}</span>`;
                        div.addEventListener('click', () => selectCourt(c));
                        courtSearchResults.appendChild(div);
                    });
                }
                courtSearchResults.classList.remove('hidden');
            }, 280);
        });

        document.addEventListener('click', e => {
            if (!courtSearchInput.contains(e.target) && !courtSearchResults.contains(e.target))
                courtSearchResults.classList.add('hidden');
        });

        function selectCourt(c) {
            courtIdHidden.value = c.id;
            courtSearchInput.value = c.name + (c.venue ? ' — ' + c.venue : '');
            courtSelectedName.textContent = c.name + (c.venue ? ' (' + c.venue + ')' : '');
            courtSelectedLabel.classList.remove('hidden');
            if (courtNameInput && !courtNameInput.value) courtNameInput.value = c.name;
            if (courtAddressInput && !courtAddressInput.value && c.address) courtAddressInput.value = c.address;
            courtSearchResults.classList.add('hidden');
        }

        window.clearCourtSelection = function() {
            courtIdHidden.value = '';
            courtSearchInput.value = '';
            courtSelectedLabel.classList.add('hidden');
        };

        // ── Quick / Full mode switcher ────────────────────────────────────────
        const quickSection = document.getElementById('quickModeSection');
        const fullSection  = document.getElementById('fullModeSection');
        const tabQuick     = document.getElementById('tabQuick');
        const tabFull      = document.getElementById('tabFull');
        const quickSportEl = document.getElementById('quickSportSelect');

        // Populate quickSportSelect from the full sport options
        function syncQuickSportOptions() {
            quickSportEl.innerHTML = '<option value="">Chọn môn</option>';
            sportSelect.querySelectorAll('option').forEach(o => {
                if (o.value) quickSportEl.appendChild(o.cloneNode(true));
            });
        }
        syncQuickSportOptions();

        let currentMode = 'full';
        window.switchMode = function(mode) {
            currentMode = mode;
            if (mode === 'quick') {
                quickSection.classList.remove('hidden');
                fullSection.classList.add('hidden');
                tabQuick.classList.add('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-sm');
                tabQuick.classList.remove('text-slate-500', 'dark:text-slate-400');
                tabFull.classList.remove('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-sm');
                tabFull.classList.add('text-slate-500', 'dark:text-slate-400');
                // Default date = today
                const quickDate = document.getElementById('quickDate');
                if (!quickDate.value) quickDate.value = new Date().toISOString().split('T')[0];
            } else {
                quickSection.classList.add('hidden');
                fullSection.classList.remove('hidden');
                tabFull.classList.add('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-sm');
                tabFull.classList.remove('text-slate-500', 'dark:text-slate-400');
                tabQuick.classList.remove('bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-white', 'shadow-sm');
                tabQuick.classList.add('text-slate-500', 'dark:text-slate-400');
            }
        };

        // Default to quick mode on page load (matches the "Nhanh" tab's default active styling)
        switchMode('quick');
    });

    async function generateAiDesc() {
        const btn = document.getElementById('aiDescBtn');
        const btnText = document.getElementById('aiDescBtnText');
        const textarea = document.getElementById('descriptionTextarea');

        // Sport: read from visible select
        const sportEl = document.getElementById('sportSelect');
        const sportText = sportEl && sportEl.value ? (sportEl.options[sportEl.selectedIndex]?.text || '') : '';

        // MatchType: checkboxes (badminton) or select (other sports)
        let typeText = '';
        const mtCheckboxes = document.getElementById('matchTypeCheckboxes');
        if (mtCheckboxes && !mtCheckboxes.classList.contains('hidden')) {
            const checked = [...document.querySelectorAll('.mt-type-cb:checked')].map(c => c.value);
            typeText = checked.join(', ');
        } else {
            const typeEl = document.getElementById('matchTypeSelect');
            if (typeEl && typeEl.value) typeText = typeEl.options[typeEl.selectedIndex]?.text || '';
        }

        // Skill: badminton checkboxes or select
        let skillText = '';
        const skillBadmintonSec = document.getElementById('skillBadmintonSection');
        if (skillBadmintonSec && !skillBadmintonSec.classList.contains('hidden')) {
            const male = [...document.querySelectorAll('.skill-male-cb:checked')].map(c => c.value);
            const female = [...document.querySelectorAll('.skill-female-cb:checked')].map(c => c.value);
            const parts = [];
            if (male.length) parts.push('Nam ' + male.join('/'));
            if (female.length) parts.push('Nữ ' + female.join('/'));
            skillText = parts.join(', ') || 'Mọi trình độ';
        } else {
            const skillEl = document.getElementById('skillSelect');
            if (skillEl && skillEl.value) skillText = skillEl.options[skillEl.selectedIndex]?.text || '';
        }

        const dateVal = document.querySelector('[name="Input.MatchDate"]')?.value || '';

        if (!sportText) {
            alert('Vui lòng chọn môn thể thao trước khi gợi ý AI.');
            return;
        }

        btnText.textContent = 'Đang tạo...';
        btn.disabled = true;

        try {
            const params = new URLSearchParams({ sport: sportText, skill: skillText, type: typeText, date: dateVal });
            const res = await fetch('/api/chat/match-desc?' + params.toString());
            if (!res.ok) throw new Error('API error ' + res.status);
            const data = await res.json();
            if (data.description) {
                textarea.value = data.description;
            }
        } catch (e) {
            alert('Không thể tạo mô tả AI. Vui lòng thử lại.');
        } finally {
            btnText.textContent = 'Gợi ý AI';
            btn.disabled = false;
        }
    }
    </script>
}
