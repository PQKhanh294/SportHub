@page
@model SportHub.Pages.Matchmaking.ReviewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Đánh giá trận đấu";
    ViewData["ActivePage"] = "Matchmaking";

    IHtmlContent StarCriteria(string fieldName, string label, string icon, string hint)
    {
        var html = $@"<div class=""star-group"">
            <label class=""block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1"">
                <span class=""material-symbols-outlined text-sm align-middle text-primary"">{icon}</span>
                {label}
            </label>
            <p class=""text-xs text-slate-400 mb-2"">{hint}</p>
            <div class=""flex items-center gap-1"">
                <button type=""button"" class=""star-btn text-amber-400 hover:scale-110 transition-transform""><span class=""material-symbols-outlined text-2xl"" style=""font-variation-settings:'FILL' 1"">star</span></button>
                <button type=""button"" class=""star-btn text-amber-400 hover:scale-110 transition-transform""><span class=""material-symbols-outlined text-2xl"" style=""font-variation-settings:'FILL' 1"">star</span></button>
                <button type=""button"" class=""star-btn text-amber-400 hover:scale-110 transition-transform""><span class=""material-symbols-outlined text-2xl"" style=""font-variation-settings:'FILL' 1"">star</span></button>
                <button type=""button"" class=""star-btn text-amber-400 hover:scale-110 transition-transform""><span class=""material-symbols-outlined text-2xl"" style=""font-variation-settings:'FILL' 1"">star</span></button>
                <button type=""button"" class=""star-btn text-amber-400 hover:scale-110 transition-transform""><span class=""material-symbols-outlined text-2xl"" style=""font-variation-settings:'FILL' 1"">star</span></button>
                <span class=""star-label ml-2 text-sm font-semibold text-amber-500"">Xuất sắc</span>
            </div>
            <input type=""hidden"" name=""{fieldName}"" value=""5"" />
        </div>";
        return new HtmlString(html);
    }
}

<div class="max-w-xl mx-auto space-y-6 pb-16">
    <div>
        <a asp-page="/Matchmaking/Details" asp-route-id="@Model.MatchId"
           class="inline-flex items-center gap-1 text-sm text-primary font-semibold hover:underline mb-3">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Quay lại trận đấu
        </a>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white">Đánh giá trận đấu</h1>
        <p class="text-slate-500 text-sm mt-1">@Model.MatchTitle</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-xl text-emerald-700 dark:text-emerald-400 font-medium">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-xl text-rose-700 dark:text-rose-400 font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Mode == "player")
    {
        @if (!Model.CanReview)
        {
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-8 text-center">
                <span class="material-symbols-outlined text-5xl text-slate-300 mb-3 block">block</span>
                <p class="font-bold text-slate-700 dark:text-slate-300">Không thể đánh giá trận này.</p>
                <p class="text-sm text-slate-500 mt-1">Bạn đã đánh giá rồi, hoặc đã quá 7 ngày sau trận, hoặc bạn chưa tham gia trận này.</p>
            </div>
        }
        else
        {
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 space-y-6">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-2xl text-primary">star_rate</span>
                    <div>
                        <p class="font-bold text-slate-900 dark:text-white">Đánh giá buổi đánh</p>
                        <p class="text-sm text-slate-500">Host: @Model.TargetUserName</p>
                    </div>
                </div>

                <form method="post" asp-page-handler="Player">
                    <input type="hidden" asp-for="MatchId" />
                    <input type="hidden" asp-for="Mode" />
                    <input type="hidden" asp-for="PlayerInput.HasCost" value="@Model.PlayerInput.HasCost.ToString().ToLower()" />

                    <div class="space-y-5">
                        @StarCriteria("PlayerInput.ScoreOrganization", "Tổ chức & đúng giờ", "schedule", "Host tổ chức trận đúng giờ, thông tin rõ ràng")
                        @StarCriteria("PlayerInput.ScoreEquipment", "Chất lượng cầu & thiết bị", "sports_tennis", "Cầu mới, lưới chuẩn, sân sạch")
                        @StarCriteria("PlayerInput.ScoreAtmosphere", "Không khí thi đấu", "mood", "Tinh thần tốt, vui vẻ, thân thiện")
                        @StarCriteria("PlayerInput.ScoreHost", "Đánh giá host", "person_check", "Thái độ, cách xử lý và công bằng của host")
                        @if (Model.PlayerInput.HasCost)
                        {
                            @StarCriteria("PlayerInput.ScoreValueForMoney", "Giá trị so với chi phí", "payments", "Buổi đánh xứng đáng với số tiền bỏ ra")
                        }

                        <div>
                            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                                Nhận xét (tuỳ chọn)
                            </label>
                            <textarea asp-for="PlayerInput.Comment" rows="3" maxlength="500" placeholder="Chia sẻ cảm nhận của bạn..."
                                      class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary resize-none"></textarea>
                        </div>

                        <button type="submit"
                                class="w-full py-3 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl transition-colors flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-sm">send</span>
                            Gửi đánh giá
                        </button>
                    </div>
                </form>
            </div>
        }
    }
    else if (Model.Mode == "host")
    {
        @if (Model.TargetUserId.HasValue)
        {
            @* Rating specific player *@
            @if (!Model.CanReview)
            {
                <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-8 text-center">
                    <span class="material-symbols-outlined text-5xl text-slate-300 mb-3 block">block</span>
                    <p class="font-bold text-slate-700 dark:text-slate-300">Bạn đã đánh giá người chơi này rồi.</p>
                </div>
            }
            else
            {
                <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6 space-y-6">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-2xl text-primary">rate_review</span>
                        <div>
                            <p class="font-bold text-slate-900 dark:text-white">Đánh giá người chơi</p>
                            <p class="text-sm text-slate-500">@Model.TargetUserName</p>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="Host">
                        <input type="hidden" asp-for="MatchId" />
                        <input type="hidden" asp-for="Mode" />
                        <input type="hidden" name="targetUserId" value="@Model.TargetUserId" />

                        <div class="space-y-5">
                            @StarCriteria("HostInput.ScorePunctuality", "Đúng giờ", "schedule", "Đến đúng giờ, không làm trận trễ")
                            @StarCriteria("HostInput.ScoreSportsmanship", "Tinh thần thể thao", "emoji_events", "Chơi vui vẻ, fair play, tôn trọng đội bạn")
                            @StarCriteria("HostInput.ScoreSkillAccuracy", "Trình độ khớp khai báo", "fitness_center", "Chơi đúng level đã đăng ký")

                            <div>
                                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                                    Nhận xét (tuỳ chọn)
                                </label>
                                <textarea asp-for="HostInput.Comment" rows="3" maxlength="500" placeholder="Nhận xét về người chơi..."
                                          class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary resize-none"></textarea>
                            </div>

                            <button type="submit"
                                    class="w-full py-3 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl transition-colors flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-sm">send</span>
                                Gửi đánh giá
                            </button>
                        </div>
                    </form>
                </div>
            }
        }
        else
        {
            @* Show list of players to rate *@
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-6">
                <h2 class="font-bold text-slate-900 dark:text-white mb-4">Chọn người chơi để đánh giá</h2>
                @if (!Model.PlayersToRate.Any())
                {
                    <p class="text-slate-500 text-sm">Không có người chơi nào cần đánh giá.</p>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var player in Model.PlayersToRate)
                        {
                            <div class="flex items-center gap-3 p-3 rounded-xl border border-slate-100 dark:border-slate-800">
                                <img src="@(player.AvatarUrl ?? "/images/default-avatar.png")" alt=""
                                     class="w-10 h-10 rounded-full object-cover flex-shrink-0" />
                                <div class="flex-1 min-w-0">
                                    <p class="font-semibold text-slate-900 dark:text-white text-sm">@player.FullName</p>
                                </div>
                                @if (player.AlreadyRated)
                                {
                                    <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
                                        <span class="material-symbols-outlined text-sm">check_circle</span> Đã đánh giá
                                    </span>
                                }
                                else
                                {
                                    <a asp-page="/Matchmaking/Review"
                                       asp-route-matchId="@Model.MatchId"
                                       asp-route-mode="host"
                                       asp-route-targetUserId="@player.UserId"
                                       class="px-3 py-1.5 text-sm bg-primary text-white font-semibold rounded-lg hover:bg-primary/90 transition-colors">
                                        Đánh giá
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.star-group').forEach(group => {
            const stars = group.querySelectorAll('.star-btn');
            const input = group.querySelector('input[type=hidden]');
            let current = parseInt(input.value) || 5;

            function render(val) {
                stars.forEach((s, i) => {
                    s.classList.toggle('text-amber-400', i < val);
                    s.classList.toggle('text-slate-300', i >= val);
                    s.querySelector('.material-symbols-outlined').textContent = i < val ? 'star' : 'star';
                });
            }

            render(current);

            stars.forEach((s, i) => {
                s.addEventListener('mouseover', () => render(i + 1));
                s.addEventListener('mouseleave', () => render(current));
                s.addEventListener('click', () => {
                    current = i + 1;
                    input.value = current;
                    render(current);
                    const label = group.querySelector('.star-label');
                    if (label) {
                        const labels = ['', 'Rất tệ', 'Tệ', 'Bình thường', 'Tốt', 'Xuất sắc'];
                        label.textContent = labels[current];
                    }
                });
            });
        });
    </script>
}
