@page
@model SportHub.Pages.Subscription.IndexModel
@{
    ViewData["Title"] = "Gói đăng ký";
    Layout = "_Layout";

    string BadgeClass(string planKey) => planKey switch {
        "Starter" => "bg-blue-100 text-blue-700",
        "Pro"     => "bg-purple-100 text-purple-700",
        "Club"    => "bg-amber-100 text-amber-700",
        _         => "bg-slate-100 text-slate-600"
    };
    string CardBorder(string planKey) => planKey switch {
        "Pro"  => "border-purple-400 ring-2 ring-purple-300",
        "Club" => "border-amber-400 ring-2 ring-amber-300",
        _      => "border-slate-200 dark:border-slate-700"
    };
    string BtnClass(string planKey, bool isCurrent) {
        if (isCurrent) return "w-full py-2.5 rounded-md font-semibold border-2 border-slate-300 text-slate-500 cursor-default";
        return planKey switch {
            "Pro"   => "w-full py-2.5 rounded-md font-semibold bg-purple-600 hover:bg-purple-700 text-white transition-colors",
            "Club"  => "w-full py-2.5 rounded-md font-semibold bg-amber-500 hover:bg-amber-600 text-white transition-colors",
            "Starter" => "w-full py-2.5 rounded-md font-semibold bg-blue-600 hover:bg-blue-700 text-white transition-colors",
            _ => "w-full py-2.5 rounded-md font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors"
        };
    }

    string FormatPrice(decimal p) => p == 0 ? "Miễn phí" : p.ToString("N0") + " xu";
}

<div class="max-w-6xl mx-auto px-4 py-10">

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-6 p-4 rounded-md bg-green-50 border border-green-200 text-green-700 font-medium">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 p-4 rounded-md bg-red-50 border border-red-200 text-red-700 font-medium">@Model.ErrorMessage</div>
    }

    <div class="text-center mb-10">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Chọn gói phù hợp</h1>
        <p class="mt-2 text-slate-500 dark:text-slate-400">Nâng cấp để mở khóa toàn bộ tính năng SportHub</p>
    </div>

    @if (Model.CurrentPlan != null)
    {
        <div class="mb-8 p-4 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 flex flex-wrap gap-4 items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="px-3 py-1 rounded-md text-sm font-bold @BadgeClass(Model.CurrentPlan.PlanKey)">@Model.CurrentPlan.Name</span>
                @if (Model.ActiveSub != null)
                {
                    <span class="text-sm text-slate-500">Hết hạn: @Model.ActiveSub.EndAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                }
            </div>
            <div class="flex flex-wrap gap-4 text-sm text-slate-600 dark:text-slate-400">
                <span>Tham gia tháng: <strong>@Model.MonthlyJoinCount/@(Model.CurrentPlan.MonthlyJoinLimit == -1 ? "∞" : Model.CurrentPlan.MonthlyJoinLimit.ToString())</strong></span>
                <span>Tạo trận tháng: <strong>@Model.MonthlyCreateCount/@(Model.CurrentPlan.MonthlyCreateLimit == -1 ? "∞" : Model.CurrentPlan.MonthlyCreateLimit.ToString())</strong></span>
                @if (Model.RemainingCredits > 0)
                {
                    <span class="text-green-600 font-medium">Credit: @Model.RemainingCredits</span>
                }
                <span>Ví: <strong>@Model.WalletBalance.ToString("N0") xu</strong></span>
            </div>
        </div>
    }

    <!-- Pricing Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach (var plan in Model.Plans)
        {
            var isCurrent = Model.CurrentPlan?.PlanKey == plan.PlanKey;
            <div class="relative rounded-md border @CardBorder(plan.PlanKey) bg-white dark:bg-slate-900 p-6 flex flex-col gap-4 shadow-sm">
                @if (plan.PlanKey == "Pro")
                {
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-purple-600 text-white text-xs font-bold px-3 py-1 rounded-md">PHỔ BIẾN</div>
                }

                <!-- Plan Header -->
                <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-md text-xs font-bold @BadgeClass(plan.PlanKey) mb-2">@plan.Name</span>
                    <p class="text-sm text-slate-500 dark:text-slate-400">@plan.Description</p>
                </div>

                <!-- Pricing -->
                <div>
                    <div class="text-3xl font-extrabold text-slate-900 dark:text-white">@FormatPrice(plan.PriceMonthly)
                        @if (plan.PriceMonthly > 0) { <span class="text-base font-normal text-slate-400">/tháng</span> }
                    </div>
                    @if (plan.PriceQuarterly > 0)
                    {
                        <div class="text-xs text-slate-400 mt-1">hoặc @FormatPrice(plan.PriceQuarterly)/quý · @FormatPrice(plan.PriceAnnual > 0 ? plan.PriceAnnual : 0)/năm</div>
                    }
                </div>

                <!-- Features -->
                <ul class="space-y-2 text-sm flex-1">
                    <li class="flex gap-2 items-start">
                        <span class="text-green-500 font-bold shrink-0">✓</span>
                        <span>Tham gia: @(plan.MonthlyJoinLimit == -1 ? "Không giới hạn" : plan.MonthlyJoinLimit + " trận/tháng")</span>
                    </li>
                    <li class="flex gap-2 items-start">
                        <span class="text-green-500 font-bold shrink-0">✓</span>
                        <span>Tạo trận: @(plan.MonthlyCreateLimit == -1 ? "Không giới hạn" : plan.MonthlyCreateLimit + " trận/tháng")</span>
                    </li>
                    <li class="flex gap-2 items-start @(plan.CanSeePhoneNumber ? "" : "opacity-40")">
                        <span class="@(plan.CanSeePhoneNumber ? "text-green-500" : "text-slate-300") font-bold shrink-0">@(plan.CanSeePhoneNumber ? "✓" : "✗")</span>
                        <span>Xem số điện thoại</span>
                    </li>
                    <li class="flex gap-2 items-start @(plan.CanFilterByDistance ? "" : "opacity-40")">
                        <span class="@(plan.CanFilterByDistance ? "text-green-500" : "text-slate-300") font-bold shrink-0">@(plan.CanFilterByDistance ? "✓" : "✗")</span>
                        <span>Lọc theo khoảng cách</span>
                    </li>
                    <li class="flex gap-2 items-start @(plan.HasAiSuggestions ? "" : "opacity-40")">
                        <span class="@(plan.HasAiSuggestions ? "text-green-500" : "text-slate-300") font-bold shrink-0">@(plan.HasAiSuggestions ? "✓" : "✗")</span>
                        <span>AI gợi ý người chơi</span>
                    </li>
                    <li class="flex gap-2 items-start @(plan.HasDetailedStats ? "" : "opacity-40")">
                        <span class="@(plan.HasDetailedStats ? "text-green-500" : "text-slate-300") font-bold shrink-0">@(plan.HasDetailedStats ? "✓" : "✗")</span>
                        <span>Thống kê chi tiết</span>
                    </li>
                    <li class="flex gap-2 items-start @(plan.HasPriorityListing ? "" : "opacity-40")">
                        <span class="@(plan.HasPriorityListing ? "text-green-500" : "text-slate-300") font-bold shrink-0">@(plan.HasPriorityListing ? "✓" : "✗")</span>
                        <span>Ưu tiên hiển thị</span>
                    </li>
                    <li class="flex gap-2 items-start @(plan.HasVerifiedBadge ? "" : "opacity-40")">
                        <span class="@(plan.HasVerifiedBadge ? "text-green-500" : "text-slate-300") font-bold shrink-0">@(plan.HasVerifiedBadge ? "✓" : "✗")</span>
                        <span>Badge xác minh ✓</span>
                    </li>
                    <li class="flex gap-2 items-start @(plan.HasPlayerFeeExempt ? "" : "opacity-40")">
                        <span class="@(plan.HasPlayerFeeExempt ? "text-green-500" : "text-slate-300") font-bold shrink-0">@(plan.HasPlayerFeeExempt ? "✓" : "✗")</span>
                        <span>Miễn phí tham gia</span>
                    </li>
                </ul>

                <!-- CTA -->
                <div class="space-y-2 pt-2">
                    @if (isCurrent)
                    {
                        <button disabled class="@BtnClass(plan.PlanKey, true)">Gói hiện tại</button>
                    }
                    else if (plan.PlanKey == "Free")
                    {
                        <span class="block text-center text-sm text-slate-400">Gói mặc định</span>
                    }
                    else
                    {
                        <a href="/Subscription/Checkout?planKey=@plan.PlanKey&billing=Monthly" class="@BtnClass(plan.PlanKey, false) block text-center">
                            @(plan.PlanKey == "Pro" && !Model.HasUsedTrial ? "Thử 7 ngày miễn phí" : "Đăng ký ngay")
                        </a>
                        @if (plan.PlanKey == "Pro" && !Model.HasUsedTrial && !isCurrent)
                        {
                            <form method="post" asp-page-handler="Trial">
                                <button type="submit" class="w-full text-sm text-purple-600 hover:underline">Kích hoạt dùng thử ngay</button>
                            </form>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <!-- Credit Bundle -->
    <div class="mt-10 p-6 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 flex flex-col sm:flex-row gap-6 items-center justify-between shadow-sm">
        <div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Credit trận đấu</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Dành cho người dùng Free muốn tham gia thêm trận ngoài giới hạn tháng. <strong>5 credit = 20.000 xu</strong>, có hiệu lực 30 ngày.</p>
        </div>
        <a href="/Subscription/Checkout?planKey=Credit&billing=Bundle"
           class="shrink-0 px-6 py-2.5 rounded-md font-semibold bg-green-600 hover:bg-green-700 text-white transition-colors text-sm">
            Mua 5 Credit — 20.000 xu
        </a>
    </div>
</div>
