@page
@model SportHub.Pages.Info.CommunityModel
@{
    ViewData["Title"] = "Quy tắc cộng đồng";
}

<div class="max-w-3xl mx-auto py-10 px-4">
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white mb-2">Quy tắc cộng đồng</h1>
    <p class="text-slate-500 dark:text-slate-400 mb-8 text-sm">Để SportHub luôn là nơi vui vẻ và an toàn cho mọi người</p>

    <div class="space-y-4">
        @foreach (var (icon, color, title, desc) in new[] {
            ("handshake", "text-blue-500 bg-blue-50 dark:bg-blue-950/30", "Tôn trọng lẫn nhau", "Đối xử với mọi thành viên bằng sự tôn trọng, không phân biệt trình độ, giới tính hay tuổi tác. Thể thao là cầu nối, không phải rào cản."),
            ("schedule", "text-emerald-500 bg-emerald-50 dark:bg-emerald-950/30", "Đúng giờ và cam kết", "Khi đã tham gia một trận đấu, hãy có mặt đúng giờ. Nếu không thể tham gia, hủy sớm ít nhất 2 giờ trước để tránh ảnh hưởng đến người khác."),
            ("sports", "text-violet-500 bg-violet-50 dark:bg-violet-950/30", "Chơi đúng trình độ", "Khai báo trình độ thực của bạn khi tạo hồ sơ. Điều này giúp hệ thống ghép trận chính xác và đảm bảo trải nghiệm công bằng."),
            ("favorite", "text-rose-500 bg-rose-50 dark:bg-rose-950/30", "Tinh thần thể thao", "Chấp nhận thắng thua một cách văn minh. Không xúc phạm, không gây hấn. Mỗi trận đấu là cơ hội học hỏi và kết bạn."),
            ("chat", "text-amber-500 bg-amber-50 dark:bg-amber-950/30", "Giao tiếp văn minh", "Không gửi tin nhắn spam, quảng cáo hoặc nội dung không liên quan đến thể thao. Không sử dụng ngôn ngữ thô tục hoặc gây khó chịu."),
            ("verified_user", "text-teal-500 bg-teal-50 dark:bg-teal-950/30", "Thông tin chính xác", "Cung cấp thông tin trung thực về bản thân, địa điểm và thời gian. Tránh tạo nhiều tài khoản hoặc sử dụng danh tính giả mạo.")
        })
        {
            <div class="flex items-start gap-4 p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="w-11 h-11 rounded-xl @color flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined @icon.Replace("bg-", "text-")">@icon</span>
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 dark:text-white mb-1">@title</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">@desc</p>
                </div>
            </div>
        }
    </div>

    <div class="mt-8 p-5 rounded-2xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900">
        <div class="flex items-start gap-3">
            <span class="material-symbols-outlined text-rose-500 text-2xl shrink-0">warning</span>
            <div>
                <h3 class="font-bold text-rose-700 dark:text-rose-300 mb-1">Vi phạm sẽ bị xử lý</h3>
                <p class="text-sm text-rose-600 dark:text-rose-400">
                    Các vi phạm nghiêm trọng hoặc lặp lại có thể dẫn đến cảnh cáo, tạm khóa hoặc khóa tài khoản vĩnh viễn.
                    Mọi báo cáo sẽ được xem xét bởi đội ngũ quản trị viên của SportHub.
                </p>
            </div>
        </div>
    </div>
</div>
