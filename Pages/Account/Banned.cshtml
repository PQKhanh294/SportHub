@page
@model SportHub.Pages.Account.BannedModel
@{
    ViewData["Title"] = "Tài khoản bị tạm khóa";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tài khoản bị tạm khóa - SportHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white rounded-3xl shadow-2xl overflow-hidden">
        <div class="bg-gradient-to-r from-red-500 to-rose-600 px-8 py-10 text-center">
            <div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-white mb-2">Tài khoản bị tạm khóa</h1>
            <p class="text-red-100 text-sm">Tài khoản của bạn đã bị hạn chế bởi quản trị viên SportHub</p>
        </div>

        <div class="px-8 py-6 space-y-4">
            @if (Model.Ban != null)
            {
                <div class="bg-slate-50 rounded-2xl p-4 space-y-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500 font-medium">Loại khóa</span>
                        <span class="font-semibold text-slate-800">
                            @(Model.Ban.BanType switch {
                                "1day" => "1 ngày",
                                "7days" => "7 ngày",
                                "30days" => "30 ngày",
                                _ => "Vĩnh viễn"
                            })
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500 font-medium">Ngày khóa</span>
                        <span class="font-semibold text-slate-800">@Model.Ban.StartAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    @if (Model.Ban.EndAt.HasValue)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-slate-500 font-medium">Hết hạn</span>
                            <span class="font-semibold text-green-600">@Model.Ban.EndAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-slate-500 font-medium">Hết hạn</span>
                            <span class="font-semibold text-red-600">Vĩnh viễn</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Ban.Reason))
                    {
                        <div class="border-t border-slate-200 pt-3">
                            <p class="text-xs text-slate-400 font-medium mb-1">Lý do</p>
                            <p class="text-sm text-slate-700">@Model.Ban.Reason</p>
                        </div>
                    }
                    @if (Model.Ban.BannedByAdmin != null)
                    {
                        <div class="flex justify-between text-sm pt-1">
                            <span class="text-slate-500 font-medium">Admin xử lý</span>
                            <span class="font-semibold text-slate-800">@Model.Ban.BannedByAdmin.FullName</span>
                        </div>
                    }
                </div>
            }

            <p class="text-xs text-slate-400 text-center">
                Nếu bạn cho rằng đây là nhầm lẫn, hãy liên hệ bộ phận hỗ trợ SportHub.
            </p>

            <a href="/Auth/Logout" class="block w-full text-center px-6 py-3 bg-slate-800 hover:bg-slate-900 text-white font-semibold rounded-2xl transition-colors">
                Đăng xuất
            </a>
        </div>
    </div>
</body>
</html>
