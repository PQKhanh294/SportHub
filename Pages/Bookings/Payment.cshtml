@page
@model SportHub.Pages.Bookings.PaymentModel
@{
    ViewData["Title"] = "Thanh toán";
    var info = Model.PaymentInfo;
}

@if (info == null)
{
    <section class="rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 text-center">
        <p class="text-slate-500">Không tìm thấy thông tin booking.</p>
    </section>
    return;
}

<section class="max-w-4xl mx-auto space-y-6">

    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">Thanh toán booking</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-1">Mã booking <span class="font-bold text-primary">#@info.BookingID</span></p>
        </div>
        <a asp-page="/Bookings/MyBookings" class="flex items-center gap-1 text-sm font-semibold text-slate-600 dark:text-slate-400 hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span> Quay lại
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- ── Cột trái: Thông tin booking ─────────────────────────────────── -->
        <div class="lg:col-span-1 space-y-4">

            <!-- Tóm tắt đặt sân -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md overflow-hidden shadow-sm">
                @if (!string.IsNullOrWhiteSpace(info.CourtImageUrl))
                {
                    <img src="@info.CourtImageUrl" alt="@info.CourtName" class="w-full h-44 object-cover" />
                }
                <div class="p-5 space-y-3">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white">@info.CourtName</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">@info.VenueName</p>
                        <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">@info.Address</p>
                    </div>
                    <hr class="border-slate-100 dark:border-slate-800" />
                    <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
                        <li class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-base text-primary">sports</span>
                            <span>@info.SportName</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-base text-primary">calendar_today</span>
                            <span>@info.BookingDate.ToString("dddd, dd/MM/yyyy")</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-base text-primary">schedule</span>
                            <span>@info.TimeDisplay</span>
                        </li>
                    </ul>
                    <hr class="border-slate-100 dark:border-slate-800" />

                    <!-- Bảng giá -->
                    <div class="space-y-1.5 text-sm">
                        <div class="flex justify-between text-slate-500 dark:text-slate-400">
                            <span>Tạm tính</span>
                            <span>@info.TotalAmount.ToString("N0") xu</span>
                        </div>
                        @if (info.DiscountAmount > 0)
                        {
                            <div class="flex justify-between text-emerald-600 dark:text-emerald-400">
                                <span>Giảm giá</span>
                                <span>−@info.DiscountAmount.ToString("N0") xu</span>
                            </div>
                        }
                        <div class="flex justify-between font-bold text-base text-slate-900 dark:text-white pt-2 border-t border-slate-100 dark:border-slate-800">
                            <span>Tổng cộng</span>
                            <span class="text-primary text-lg">@info.FinalAmount.ToString("N0") xu</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Trạng thái -->
            <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-md p-4 flex items-start gap-3">
                <span class="material-symbols-outlined text-amber-500 mt-0.5">info</span>
                <div class="text-sm">
                    <p class="font-semibold text-amber-800 dark:text-amber-300">Chờ thanh toán</p>
                    <p class="text-amber-700 dark:text-amber-400 mt-0.5">Booking sẽ được xác nhận sau khi bạn hoàn tất thanh toán và nhấn xác nhận bên dưới.</p>
                </div>
            </div>
        </div>

        <!-- ── Cột phải: QR Code ────────────────────────────────────────────── -->
        <div class="lg:col-span-1 space-y-6">

            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md shadow-sm overflow-hidden flex flex-col relative group/card">
                <!-- Banner Header -->
                <div class="bg-gradient-to-r from-primary to-blue-600 px-6 py-5 text-center relative overflow-hidden">
                    <!-- Subtle pattern overlay -->
                    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white to-transparent mix-blend-overlay"></div>
                    <h2 class="text-white font-black text-xl flex items-center justify-center gap-2 relative z-10">
                        <span class="material-symbols-outlined text-2xl">qr_code_scanner</span>
                        Quét mã để thanh toán
                    </h2>
                    <p class="text-white/90 text-sm mt-1 relative z-10 font-medium">Hỗ trợ mọi ứng dụng ngân hàng & ví điện tử</p>
                </div>

                <div class="p-8 flex flex-col items-center">
                    <!-- QR Code Box with scanning effect style -->
                    <div class="relative w-64 h-64 p-3 bg-white border-2 border-dashed border-primary/40 rounded-md shadow-sm mb-6 flex items-center justify-center group">
                        <!-- Corner decorations -->
                        <div class="absolute top-0 left-0 w-6 h-6 border-t-4 border-l-4 border-primary rounded-tl-xl -translate-x-1.5 -translate-y-1.5 transition-transform group-hover:-translate-x-2 group-hover:-translate-y-2"></div>
                        <div class="absolute top-0 right-0 w-6 h-6 border-t-4 border-r-4 border-primary rounded-tr-xl translate-x-1.5 -translate-y-1.5 transition-transform group-hover:translate-x-2 group-hover:-translate-y-2"></div>
                        <div class="absolute bottom-0 left-0 w-6 h-6 border-b-4 border-l-4 border-primary rounded-bl-xl -translate-x-1.5 translate-y-1.5 transition-transform group-hover:-translate-x-2 group-hover:translate-y-2"></div>
                        <div class="absolute bottom-0 right-0 w-6 h-6 border-b-4 border-r-4 border-primary rounded-br-xl translate-x-1.5 translate-y-1.5 transition-transform group-hover:translate-x-2 group-hover:translate-y-2"></div>
                        
                        <img id="qr-image"
                             src="@info.QrCodeUrl"
                             alt="QR Thanh toán"
                             class="w-full h-full object-contain rounded-md transition-transform duration-500 group-hover:scale-[1.02]"
                             onerror="this.onerror=null; this.src='@info.VietQrPageUrl';" />
                    </div>

                    <!-- Total Amount Highlight -->
                    <div class="text-center mb-8 bg-slate-50 dark:bg-slate-800/50 w-full py-4 rounded-md border border-slate-100 dark:border-slate-800 transition-colors hover:border-primary/30">
                        <p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-1">Số tiền cần thanh toán</p>
                        <p class="text-3xl font-black text-primary tracking-tight">@info.FinalAmount.ToString("N0") <span class="text-lg font-bold text-slate-400 dark:text-slate-500">xu</span></p>
                    </div>

                    <!-- Bank Details -->
                    <div class="w-full space-y-2.5">
                        <div class="flex items-center justify-between p-3.5 rounded-md bg-slate-50 dark:bg-slate-800/50 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Ngân hàng</span>
                            <span class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                @info.BankId
                            </span>
                        </div>
                        
                        <div class="flex items-center justify-between p-3.5 rounded-md bg-slate-50 dark:bg-slate-800/50 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors group/row">
                            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Số tài khoản</span>
                            <div class="flex items-center gap-2">
                                <span id="account-no" class="font-bold text-lg text-slate-900 dark:text-white font-mono tracking-wide">@info.AccountNo</span>
                                <button type="button" onclick="copyText('@info.AccountNo', 'btn-copy-acc')" id="btn-copy-acc"
                                        class="text-slate-400 hover:text-primary transition-colors focus:text-primary p-1 rounded-md hover:bg-white dark:hover:bg-slate-700" title="Sao chép">
                                    <span class="material-symbols-outlined text-base block">content_copy</span>
                                </button>
                            </div>
                        </div>

                        <div class="flex items-center justify-between p-3.5 rounded-md bg-slate-50 dark:bg-slate-800/50 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Chủ tài khoản</span>
                            <span class="font-bold text-slate-900 dark:text-white uppercase tracking-wide">@info.AccountName</span>
                        </div>

                        <div class="flex items-start justify-between p-3.5 rounded-md bg-primary/5 dark:bg-primary/10 border border-primary/20 hover:border-primary/40 transition-colors group/row">
                            <span class="text-sm font-medium text-slate-700 dark:text-slate-300 shrink-0 mt-0.5">Nội dung CK</span>
                            <div class="flex items-start gap-2 text-right">
                                <span id="transfer-content" class="font-bold text-primary font-mono text-sm leading-relaxed break-all">@info.TransferContent</span>
                                <button type="button" onclick="copyText('@info.TransferContent', 'btn-copy-msg')" id="btn-copy-msg"
                                        class="text-primary hover:text-primary/80 transition-colors p-1 rounded-md hover:bg-white/50 dark:hover:bg-slate-800 shrink-0 mt-0.5" title="Sao chép">
                                    <span class="material-symbols-outlined text-base block">content_copy</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hướng dẫn -->
            <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/50 rounded-md p-5 backdrop-blur-sm">
                <p class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-xl">help</span>
                    Hướng dẫn thanh toán
                </p>
                <ol class="text-sm text-slate-600 dark:text-slate-400 space-y-2 list-none">
                    <li class="flex items-start gap-2">
                        <span class="flex-shrink-0 w-5 h-5 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs font-bold mt-0.5">1</span>
                        <span>Mở app ngân hàng hoặc ví điện tử (MoMo, ZaloPay...)</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="flex-shrink-0 w-5 h-5 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs font-bold mt-0.5">2</span>
                        <span>Quét mã QR bên trên (số tiền và nội dung đã được điền sẵn)</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="flex-shrink-0 w-5 h-5 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs font-bold mt-0.5">3</span>
                        <span>Nhấn nút <strong>"Xác nhận đã thanh toán"</strong> bên dưới sau khi chuyển tiền thành công</span>
                    </li>
                </ol>
            </div>

            <!-- Form Xác nhận -->
            <form method="post" asp-page-handler="Confirm" asp-route-bookingId="@info.BookingID" enctype="multipart/form-data" onsubmit="return handleConfirm(this)">
                
                <!-- Upload Biên Lai -->
                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md p-5 mb-6 shadow-sm">
                    <p class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Tải lên biên lai chuyển khoản <span class="text-red-500">*</span></p>
                    <p class="text-xs text-slate-500 mb-3">Vui lòng chụp màn hình giao dịch thành công và tải lên đây để chúng tôi xác nhận.</p>
                    
                    <div class="relative w-full h-32 border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-md hover:border-primary hover:bg-primary/5 transition-all flex flex-col items-center justify-center cursor-pointer bg-slate-50 dark:bg-slate-800/50 group" id="upload-zone" onclick="document.getElementById('receipt-upload').click()">
                        <span class="material-symbols-outlined text-3xl text-slate-400 group-hover:text-primary transition-colors mb-2" id="upload-icon">cloud_upload</span>
                        <span class="text-sm font-medium text-slate-600 dark:text-slate-400 group-hover:text-primary transition-colors" id="upload-text">Nhấn để chọn ảnh</span>
                        <input type="file" id="receipt-upload" name="ReceiptImage" accept="image/png, image/jpeg, image/jpg, image/gif" class="hidden" onchange="previewReceipt(this)" required />
                    </div>
                    
                    <div id="receipt-preview-container" class="hidden mt-3 relative rounded-md overflow-hidden border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900">
                        <img id="receipt-preview" src="" alt="Biên lai" class="w-full h-auto max-h-48 object-contain" />
                        <button type="button" class="absolute top-2 right-2 w-8 h-8 bg-black/60 text-white rounded-full flex items-center justify-center hover:bg-red-500 transition-colors shadow-sm backdrop-blur-sm" onclick="removeReceipt(event)">
                            <span class="material-symbols-outlined text-sm">close</span>
                        </button>
                    </div>
                </div>

                <!-- Nút xác nhận -->
                <button type="submit" id="btn-confirm"
                        class="w-full py-4 px-6 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 active:from-emerald-600 active:to-emerald-700 text-white rounded-md font-black text-lg flex items-center justify-center gap-3 transition-all shadow-[0_8px_30px_rgb(16_185_129_/_30%)] hover:shadow-[0_8px_30px_rgb(16_185_129_/_50%)] hover:-translate-y-1">
                    <span class="material-symbols-outlined text-2xl">check_circle</span>
                    Xác nhận đã thanh toán
                </button>
            </form>

            <p class="text-sm text-center text-slate-500 dark:text-slate-500 font-medium pb-4">
                Gặp sự cố? <a href="mailto:support@sporthub.vn" class="text-primary hover:underline">Liên hệ hỗ trợ</a>
            </p>
        </div>

    </div>
<!-- Overlay thành công (ẩn mặc định) -->
<div id="success-overlay" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden flex-col items-center justify-center">
    <div class="bg-white dark:bg-slate-900 p-8 rounded-md shadow-2xl flex flex-col items-center max-w-sm w-full mx-4 transform scale-95 opacity-0 transition-all duration-500" id="success-modal">
        <div class="w-20 h-20 bg-emerald-100 dark:bg-emerald-900/30 rounded-full flex items-center justify-center mb-6">
            <span class="material-symbols-outlined text-5xl text-emerald-500">check_circle</span>
        </div>
        <h3 class="text-2xl font-black text-slate-900 dark:text-white mb-2 text-center">Thanh toán thành công!</h3>
        <p class="text-slate-500 dark:text-slate-400 text-center mb-6 text-sm">Booking của bạn đã được xác nhận. Vui lòng đợi trong giây lát...</p>
        <div class="w-8 h-8 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
    </div>
</div>

@section Scripts {
<script>
    // Sao chép nội dung ra clipboard
    async function copyText(text, btnId) {
        try {
            await navigator.clipboard.writeText(text);
            const btn = document.getElementById(btnId);
            if (!btn) return;
            const icon = btn.querySelector('.material-symbols-outlined');
            icon.textContent = 'check';
            btn.classList.add('text-emerald-500');
            setTimeout(() => {
                icon.textContent = 'content_copy';
                btn.classList.remove('text-emerald-500');
            }, 2000);
        } catch {
            // fallback
        }
    }

    // Xem trước ảnh biên lai
    function previewReceipt(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('receipt-preview').src = e.target.result;
                document.getElementById('receipt-preview-container').classList.remove('hidden');
                document.getElementById('upload-zone').classList.add('hidden');
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Xóa ảnh đã chọn
    function removeReceipt(e) {
        e.stopPropagation();
        document.getElementById('receipt-upload').value = '';
        document.getElementById('receipt-preview-container').classList.add('hidden');
        document.getElementById('upload-zone').classList.remove('hidden');
    }

    // Gửi form qua AJAX và hiển thị animation thành công
    async function handleConfirm(form) {
        event.preventDefault(); // Ngăn submit thông thường
        
        const btn = document.getElementById('btn-confirm');
        btn.disabled = true;
        btn.innerHTML = '<div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin mr-2"></div>Đang xác nhận...';
        
        try {
            const formData = new FormData(form);
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                redirect: 'follow'
            });

            if (response.ok || response.redirected) {
                // Hiển thị Overlay thành công
                const overlay = document.getElementById('success-overlay');
                const modal = document.getElementById('success-modal');
                
                overlay.classList.remove('hidden');
                overlay.classList.add('flex');
                
                // Animation popup
                setTimeout(() => {
                    modal.classList.remove('scale-95', 'opacity-0');
                    modal.classList.add('scale-100', 'opacity-100');
                }, 50);

                // Chuyển hướng sau 2 giây
                setTimeout(() => {
                    window.location.href = response.url || '/Bookings/MyBookings';
                }, 2000);
            } else {
                alert('Có lỗi xảy ra, vui lòng thử lại sau.');
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined text-2xl">check_circle</span> Xác nhận đã thanh toán';
            }
        } catch (error) {
            console.error('Error submitting payment confirmation:', error);
            alert('Lỗi kết nối, vui lòng thử lại.');
            btn.disabled = false;
            btn.innerHTML = '<span class="material-symbols-outlined text-2xl">check_circle</span> Xác nhận đã thanh toán';
        }
        
        return false;
    }


</script>
}
