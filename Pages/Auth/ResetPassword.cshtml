@page
@model SportHub.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_AuthLayout";
}

<div class="w-full max-w-[420px] mx-auto relative z-10">
    <div class="bg-slate-900/75 backdrop-blur-xl rounded-md shadow-2xl overflow-hidden border border-white/10">
        <div class="h-1 bg-gradient-to-r from-primary to-accent"></div>

        @if (!Model.TokenValid)
        {
            <div class="px-8 py-10 text-center space-y-4">
                <div class="mx-auto w-14 h-14 rounded-full bg-rose-500/15 flex items-center justify-center">
                    <span class="material-symbols-outlined text-rose-400 text-3xl">error</span>
                </div>
                <h1 class="text-xl font-extrabold text-white">Liên kết không hợp lệ</h1>
                <p class="text-sm text-white/60">Liên kết đặt lại mật khẩu đã hết hạn hoặc không đúng. Vui lòng yêu cầu liên kết mới.</p>
                <a asp-page="/Auth/ForgotPassword" class="inline-block mt-2 text-sm font-bold text-primary hover:underline">Yêu cầu liên kết mới</a>
            </div>
        }
        else if (Model.ResetSuccess)
        {
            <div class="px-8 py-10 text-center space-y-4">
                <div class="mx-auto w-14 h-14 rounded-full bg-primary/15 flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-3xl">check_circle</span>
                </div>
                <h1 class="text-xl font-extrabold text-white">Đã đặt lại mật khẩu!</h1>
                <p class="text-sm text-white/60">Bạn có thể đăng nhập bằng mật khẩu mới ngay bây giờ.</p>
                <a asp-page="/Auth/Login" class="inline-block mt-2 px-6 py-2.5 bg-primary hover:bg-primary/90 text-white font-bold rounded-md shadow-md shadow-primary/30 transition-all">Đăng nhập ngay</a>
            </div>
        }
        else
        {
            <div class="px-8 pt-8 pb-3 text-center">
                <h1 class="text-2xl font-extrabold tracking-tight text-white">Đặt lại mật khẩu</h1>
                <p class="mt-1.5 text-sm text-white/60">Nhập mật khẩu mới cho tài khoản của bạn</p>
            </div>

            <form method="post" class="px-8 pb-8 pt-4 space-y-4">
                <div asp-validation-summary="ModelOnly" class="text-sm text-red-400 bg-red-950/40 border border-red-500/30 rounded-md px-3 py-2 empty:hidden"></div>

                <div>
                    <label class="block text-sm font-semibold text-white/80 mb-1.5">Mật khẩu mới</label>
                    <div class="relative">
                        <input asp-for="Input.NewPassword" id="newPasswordInput" type="password"
                               class="w-full h-11 px-4 pr-11 rounded-md border border-white/15 bg-white/10 text-white placeholder:text-white/35 focus:outline-none focus:border-primary transition-colors"
                               placeholder="••••••••" />
                        <button type="button" onclick="toggleResetPassword('newPasswordInput', 'eyeIconNew')"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-white/40 hover:text-white/80 transition-colors">
                            <span id="eyeIconNew" class="material-symbols-outlined text-xl">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="text-xs text-red-400"></span>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-white/80 mb-1.5">Xác nhận mật khẩu mới</label>
                    <div class="relative">
                        <input asp-for="Input.ConfirmPassword" id="confirmNewPasswordInput" type="password"
                               class="w-full h-11 px-4 pr-11 rounded-md border border-white/15 bg-white/10 text-white placeholder:text-white/35 focus:outline-none focus:border-primary transition-colors"
                               placeholder="••••••••" />
                        <button type="button" onclick="toggleResetPassword('confirmNewPasswordInput', 'eyeIconConfirmNew')"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-white/40 hover:text-white/80 transition-colors">
                            <span id="eyeIconConfirmNew" class="material-symbols-outlined text-xl">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-400"></span>
                </div>

                <button type="submit"
                        class="w-full h-11 bg-primary hover:bg-primary/90 text-white font-bold rounded-md shadow-md shadow-primary/30 transition-all active:scale-[.98] hover:-translate-y-0.5">
                    Đặt lại mật khẩu
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleResetPassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            icon.textContent = isHidden ? 'visibility_off' : 'visibility';
        }
    </script>
}
