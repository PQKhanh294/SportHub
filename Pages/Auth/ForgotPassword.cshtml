@page
@model SportHub.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_AuthLayout";
}

<div class="w-full max-w-[420px] mx-auto relative z-10">
    <div class="bg-slate-900/75 backdrop-blur-xl rounded-md shadow-2xl overflow-hidden border border-white/10">
        <div class="h-1 bg-gradient-to-r from-primary to-accent"></div>

        <div class="px-8 pt-8 pb-3 text-center">
            <h1 class="text-2xl font-extrabold tracking-tight text-white">Quên mật khẩu?</h1>
            <p class="mt-1.5 text-sm text-white/60">Nhập email để nhận liên kết đặt lại mật khẩu</p>
        </div>

        @if (Model.SubmittedOk)
        {
            <div class="px-8 pb-8 pt-4 text-center space-y-4">
                <div class="mx-auto w-14 h-14 rounded-full bg-primary/15 flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-3xl">mark_email_read</span>
                </div>
                <p class="text-sm text-white/70">
                    Nếu email <strong class="text-white">@Model.Input.Email</strong> có tài khoản đăng ký bằng mật khẩu,
                    chúng tôi đã gửi hướng dẫn đặt lại mật khẩu. Vui lòng kiểm tra hộp thư (kể cả mục Spam).
                </p>
                <a asp-page="/Auth/Login" class="inline-block mt-2 text-sm font-bold text-primary hover:underline">← Quay lại đăng nhập</a>
            </div>
        }
        else
        {
            <form method="post" class="px-8 pb-8 pt-4 space-y-4">
                <div asp-validation-summary="ModelOnly" class="text-sm text-red-400 bg-red-950/40 border border-red-500/30 rounded-md px-3 py-2 empty:hidden"></div>

                <div>
                    <label class="block text-sm font-semibold text-white/80 mb-1.5">Địa chỉ Email</label>
                    <input asp-for="Input.Email" type="email"
                           class="w-full h-11 px-4 rounded-md border border-white/15 bg-white/10 text-white placeholder:text-white/35 focus:outline-none focus:border-primary transition-colors"
                           placeholder="email@example.com" />
                    <span asp-validation-for="Input.Email" class="text-xs text-red-400"></span>
                </div>

                <button type="submit"
                        class="w-full h-11 bg-primary hover:bg-primary/90 text-white font-bold rounded-md shadow-md shadow-primary/30 transition-all active:scale-[.98] hover:-translate-y-0.5">
                    Gửi liên kết đặt lại
                </button>

                <p class="text-center text-sm text-white/50 pt-1">
                    <a asp-page="/Auth/Login" class="font-bold text-primary hover:text-primary/80 hover:underline">← Quay lại đăng nhập</a>
                </p>
            </form>
        }
    </div>
</div>
