@page
@model SportHub.Pages.Wallet.TopUpModel
@{
    ViewData["Title"] = "Nạp tiền vào ví";
}

<div class="max-w-lg mx-auto space-y-6 pb-10">

    <div>
        <a href="/Wallet" class="inline-flex items-center gap-1 text-sm text-primary font-semibold hover:underline mb-3">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Quay lại ví
        </a>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white">Nạp tiền vào ví</h1>
        <p class="text-slate-500 text-sm mt-1">Số dư hiện tại: <strong>@Model.Balance.ToString("N0") xu</strong></p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-md text-rose-700 dark:text-rose-400 font-medium text-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.PendingRequest == null)
    {
        <!-- Amount picker form -->
        <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
            <h2 class="font-bold text-slate-800 dark:text-white mb-4">Chọn số tiền muốn nạp</h2>

            <!-- Quick amounts -->
            <div class="grid grid-cols-3 gap-2 mb-4">
                @foreach (var amount in new[] { 20000, 50000, 100000, 200000, 500000, 1000000 })
                {
                    <button type="button" onclick="setAmount(@amount)"
                            class="quick-amount py-2 px-3 border border-slate-200 dark:border-slate-700 rounded-md text-sm font-semibold text-slate-700 dark:text-slate-300 hover:border-primary hover:text-primary transition-colors">
                        @amount.ToString("N0")
                    </button>
                }
            </div>

            <form method="post">
                <div class="relative mb-4">
                    <input type="number" id="amountInput" name="Amount" min="10000" max="50000000" step="1000"
                           placeholder="Hoặc nhập số tiền khác..."
                           class="w-full px-4 py-3 pr-16 border border-slate-200 dark:border-slate-700 rounded-md bg-white dark:bg-slate-900 text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-primary"
                           oninput="syncQuickBtns()" />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm font-medium">xu</span>
                </div>
                <p class="text-xs text-slate-400 mb-4">Tối thiểu 10.000 xu • Tối đa 50.000.000 xu</p>
                <button type="submit"
                        class="w-full py-3 bg-primary hover:bg-primary/90 text-white font-bold rounded-md transition-colors flex items-center justify-center gap-2 shadow-md">
                    <span class="material-symbols-outlined">qr_code_2</span>
                    Tạo mã QR nạp tiền
                </button>
            </form>
        </div>
    }
    else
    {
        var req = Model.PendingRequest;
        var expVn = req.ExpiresAt.ToLocalTime();
        var remaining = expVn - DateTime.Now;

        <!-- QR display -->
        <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 shadow-sm text-center">
            <div class="flex items-center justify-between mb-4">
                <h2 class="font-bold text-slate-800 dark:text-white">Quét mã để nạp tiền</h2>
                <span class="text-sm font-bold text-primary">@req.Amount.ToString("N0") xu</span>
            </div>

            <div class="flex justify-center mb-4">
                <div class="p-3 bg-white rounded-md shadow-md border border-slate-100">
                    <img src="@Model.QrUrl" alt="VietQR" class="w-56 h-56 object-contain" />
                </div>
            </div>

            <!-- Transfer info -->
            <div class="space-y-2 text-sm text-left">
                <div class="p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-md">
                    <p class="text-xs font-semibold text-amber-700 dark:text-amber-400 mb-1">⚠ Nội dung chuyển khoản (bắt buộc)</p>
                    <div class="flex items-center gap-2">
                        <span class="font-mono font-bold text-amber-800 dark:text-amber-300 text-sm flex-1" id="topupRef">@req.TransactionRef</span>
                        <button onclick="copyRef()" class="text-primary hover:text-primary/80 shrink-0">
                            <span class="material-symbols-outlined text-sm" id="copyIcon">content_copy</span>
                        </button>
                    </div>
                    <p class="text-xs text-amber-600 mt-1">Nhập chính xác nội dung này để hệ thống tự nhận tiền.</p>
                </div>

                <div class="p-3 bg-slate-50 dark:bg-slate-800 rounded-md flex items-center justify-between">
                    <span class="text-slate-500">Số tiền</span>
                    <span class="font-bold text-slate-900 dark:text-white">@req.Amount.ToString("N0") xu</span>
                </div>

                <div class="p-3 bg-slate-50 dark:bg-slate-800 rounded-md flex items-center justify-between">
                    <span class="text-slate-500">Hết hạn lúc</span>
                    <span class="font-bold @(remaining.TotalMinutes < 60 ? "text-rose-500" : "text-slate-900 dark:text-white")">
                        @expVn.ToString("HH:mm dd/MM/yyyy")
                    </span>
                </div>
            </div>

            <!-- Countdown -->
            <div id="countdown" class="mt-4 text-sm text-slate-500"></div>

            <!-- Polling status -->
            <div id="poll-status" class="mt-4 hidden">
                <div class="flex items-center justify-center gap-2 text-emerald-600 dark:text-emerald-400">
                    <span class="material-symbols-outlined animate-spin text-sm">refresh</span>
                    <span class="text-sm font-medium">Đang chờ xác nhận chuyển khoản...</span>
                </div>
            </div>

            <div class="mt-4 grid grid-cols-2 gap-2">
                <form method="post" asp-page-handler="Cancel">
                    <button type="submit"
                            class="w-full py-2.5 border border-rose-200 dark:border-rose-800 text-rose-600 dark:text-rose-400 font-semibold rounded-md hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors text-sm">
                        Hủy lệnh này
                    </button>
                </form>
                <form method="post">
                    <input type="hidden" name="Amount" value="@req.Amount" />
                    <button type="submit"
                            class="w-full py-2.5 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 font-semibold rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors text-sm">
                        Tạo lệnh mới
                    </button>
                </form>
            </div>
        </div>

        <!-- How it works -->
        <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-md p-4">
            <h3 class="font-bold text-blue-700 dark:text-blue-400 text-sm mb-2 flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">info</span>
                Cách hoạt động
            </h3>
            <ol class="text-xs text-blue-600 dark:text-blue-400 space-y-1 list-decimal list-inside">
                <li>Mở app ngân hàng và quét mã QR hoặc chuyển khoản thủ công</li>
                <li>Điền <strong>đúng nội dung</strong> chuyển khoản như ô màu vàng ở trên</li>
                <li>Hệ thống tự động xác nhận trong vài giây sau khi nhận được tiền</li>
                <li>Số dư ví được cộng ngay, có thể dùng thanh toán trận đấu</li>
            </ol>
        </div>
    }

</div>

@section Scripts {
<script>
    function setAmount(val) {
        document.getElementById('amountInput').value = val;
        document.querySelectorAll('.quick-amount').forEach(btn => {
            btn.classList.toggle('border-primary', btn.onclick.toString().includes(val));
            btn.classList.toggle('text-primary', btn.onclick.toString().includes(val));
        });
    }
    function syncQuickBtns() {
        const val = parseInt(document.getElementById('amountInput')?.value || 0);
        document.querySelectorAll('.quick-amount').forEach(btn => {
            const btnVal = parseInt(btn.getAttribute('onclick').replace(/\D/g, ''));
            btn.classList.toggle('border-primary', btnVal === val);
            btn.classList.toggle('text-primary', btnVal === val);
        });
    }
    function copyRef() {
        const ref = document.getElementById('topupRef').textContent.trim();
        navigator.clipboard.writeText(ref).then(() => {
            document.getElementById('copyIcon').textContent = 'check';
            setTimeout(() => document.getElementById('copyIcon').textContent = 'content_copy', 2000);
        });
    }

    // Countdown + polling
    const expAt = @(Model.PendingRequest != null ? $"new Date('{Model.PendingRequest.ExpiresAt:yyyy-MM-ddTHH:mm:ssZ}')" : "null");
    const txRef = '@(Model.PendingRequest?.TransactionRef ?? "")';

    let pollInterval = null;

    if (expAt && txRef) {
        document.getElementById('poll-status').classList.remove('hidden');

        // Countdown
        const countdownEl = document.getElementById('countdown');
        setInterval(() => {
            const diff = expAt - new Date();
            if (diff <= 0) { countdownEl.textContent = 'Đã hết hạn.'; return; }
            const h = Math.floor(diff / 3600000);
            const m = Math.floor((diff % 3600000) / 60000);
            const s = Math.floor((diff % 60000) / 1000);
            countdownEl.textContent = `Hết hạn sau: ${h ? h + 'g ' : ''}${m}p ${s}s`;
        }, 1000);

        // Poll every 5s for confirmation (backup nếu SignalR không kết nối được)
        pollInterval = setInterval(async () => {
            try {
                const res = await fetch(`/api/wallet/topup-status?ref=${encodeURIComponent(txRef)}`);
                if (!res.ok) return;
                const data = await res.json();
                if (data.status === 'Confirmed') {
                    _topupSuccess();
                }
            } catch {}
        }, 5000);
    }

    function _topupSuccess() {
        if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
        const el = document.getElementById('poll-status');
        if (el) el.innerHTML =
            '<div class="flex items-center justify-center gap-2 text-emerald-600 font-bold">' +
            '<span class="material-symbols-outlined">check_circle</span>' +
            'Nạp tiền thành công! Đang chuyển hướng...</div>';
        setTimeout(() => window.location.href = '/Wallet', 1500);
    }

    // Lắng nghe WalletCredited từ SignalR handler đã có trong _Layout (nhanh hơn polling)
    window.addEventListener('sporthub:wallet_credited', function () {
        _topupSuccess();
    });
</script>
}
