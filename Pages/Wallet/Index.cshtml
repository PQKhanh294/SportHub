@page
@model SportHub.Pages.Wallet.IndexModel
@{
    ViewData["Title"] = "Ví SportHub";
}

<div class="max-w-2xl mx-auto space-y-6 pb-10">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-xl text-emerald-700 dark:text-emerald-400 font-medium">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-xl text-rose-700 dark:text-rose-400 font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Balance card -->
    <div class="bg-gradient-to-br from-primary to-blue-700 rounded-2xl p-6 text-white shadow-lg">
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-white/80">account_balance_wallet</span>
                <span class="font-semibold text-white/80 text-sm">Ví SportHub</span>
            </div>
            <a href="/Wallet/TopUp"
               class="flex items-center gap-1 px-4 py-1.5 bg-white/20 hover:bg-white/30 rounded-full text-sm font-bold transition-colors">
                <span class="material-symbols-outlined text-sm">add</span>
                Nạp tiền
            </a>
        </div>
        <p class="text-xs text-white/60 mb-1">Số dư khả dụng</p>
        <p class="text-4xl font-black tracking-tight">@Model.Balance.ToString("N0") <span class="text-2xl font-semibold text-white/80">VND</span></p>
        <p class="text-xs text-white/50 mt-3">Dùng để thanh toán phí trận đấu ngay lập tức, không cần chờ admin duyệt.</p>
    </div>

    <!-- Quick actions -->
    <div class="grid grid-cols-2 gap-3">
        <a href="/Wallet/TopUp"
           class="flex flex-col items-center gap-2 p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl hover:border-primary hover:shadow-sm transition-all">
            <span class="material-symbols-outlined text-2xl text-primary">add_card</span>
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Nạp tiền</span>
        </a>
        <a href="/Matchmaking/Index"
           class="flex flex-col items-center gap-2 p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl hover:border-primary hover:shadow-sm transition-all">
            <span class="material-symbols-outlined text-2xl text-primary">sports_tennis</span>
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Tìm trận đấu</span>
        </a>
    </div>

    <!-- Pending top-up notice -->
    @{
        var pendingTopUp = Model.TopUpHistory.FirstOrDefault(t => t.Status == "Pending");
    }
    @if (pendingTopUp != null)
    {
        var expVn = pendingTopUp.ExpiresAt.ToLocalTime();
        <div class="p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl flex items-start gap-3">
            <span class="material-symbols-outlined text-amber-500 mt-0.5">pending</span>
            <div class="flex-1 min-w-0">
                <p class="font-bold text-amber-700 dark:text-amber-400 text-sm">Lệnh nạp tiền đang chờ</p>
                <p class="text-xs text-amber-600 dark:text-amber-500 mt-0.5">
                    @pendingTopUp.Amount.ToString("N0") VND — Mã: <strong class="font-mono">@pendingTopUp.TransactionRef</strong>
                </p>
                <p class="text-xs text-amber-500 mt-0.5">Hết hạn: @expVn.ToString("HH:mm dd/MM")</p>
            </div>
            <a href="/Wallet/TopUp" class="text-xs text-primary font-bold hover:underline shrink-0">Xem QR</a>
        </div>
    }

    <!-- Transaction history -->
    <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <h2 class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-sm">receipt_long</span>
                Lịch sử giao dịch
            </h2>
        </div>

        @if (!Model.Transactions.Any())
        {
            <div class="p-8 text-center">
                <span class="material-symbols-outlined text-4xl text-slate-300 block mb-2">history</span>
                <p class="text-slate-400 text-sm">Chưa có giao dịch nào.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var tx in Model.Transactions)
                {
                    var isCredit = tx.Amount > 0;
                    var (icon, color, bg) = tx.Type switch
                    {
                        "TopUp"        => ("add_card", "text-emerald-600 dark:text-emerald-400", "bg-emerald-50 dark:bg-emerald-900/20"),
                        "MatchPayment" => ("sports_tennis", "text-blue-600 dark:text-blue-400", "bg-blue-50 dark:bg-blue-900/20"),
                        "Refund"       => ("undo", "text-emerald-600 dark:text-emerald-400", "bg-emerald-50 dark:bg-emerald-900/20"),
                        "AdminCredit"  => ("admin_panel_settings", "text-purple-600 dark:text-purple-400", "bg-purple-50 dark:bg-purple-900/20"),
                        _              => ("remove", "text-rose-600 dark:text-rose-400", "bg-rose-50 dark:bg-rose-900/20")
                    };
                    <div class="flex items-center gap-3 px-5 py-3.5">
                        <div class="size-9 rounded-full @bg flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-sm @color">@icon</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 truncate">@tx.Description</p>
                            <p class="text-xs text-slate-400">@tx.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</p>
                        </div>
                        <span class="font-bold text-sm shrink-0 @(isCredit ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400")">
                            @(isCredit ? "+" : "")@tx.Amount.ToString("N0") VND
                        </span>
                    </div>
                }
            </div>
        }
    </div>

</div>
