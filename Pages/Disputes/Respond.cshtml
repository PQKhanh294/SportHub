@page
@model SportHub.Pages.Disputes.RespondModel
@{
    ViewData["Title"] = "Xác minh khiếu nại";
    var w = Model.WitnessRequest!;
    var alreadyResponded = w.RespondedAt != null;
}

<section class="max-w-2xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-black tracking-tight">Xác minh khiếu nại</h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">
            Bạn là người trong trận — phản hồi của bạn giúp admin xử lý công bằng. Thông tin được giữ kín với người khiếu nại.
        </p>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm p-6 space-y-4">
        <div class="flex items-start gap-3 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-md">
            <span class="material-symbols-outlined text-amber-500">gavel</span>
            <div class="text-sm">
                <p class="font-bold text-slate-800 dark:text-white">@Model.DisputeTypeDisplay</p>
                <p class="text-slate-600 dark:text-slate-300 mt-1">Trận: <strong>@Model.MatchTitle</strong> · @Model.MatchDateText</p>
                <p class="text-slate-600 dark:text-slate-300 mt-2 whitespace-pre-line">@w.Dispute.Description</p>
            </div>
        </div>

        @if (alreadyResponded)
        {
            <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-md text-sm text-emerald-700 dark:text-emerald-400">
                ✓ Bạn đã phản hồi (@(w.Stance switch { "Support" => "Đồng ý với khiếu nại", "Oppose" => "Phản đối khiếu nại", _ => "Trung lập" })) lúc @w.RespondedAt!.Value.AddHours(7).ToString("HH:mm dd/MM/yyyy"). Cảm ơn bạn!
            </div>
        }
        else
        {
            <form method="post" enctype="multipart/form-data" class="space-y-4">
                <input type="hidden" name="id" value="@w.DisputeId" />
                <div>
                    <label class="block text-sm font-semibold mb-2">Nội dung khiếu nại trên có đúng không? <span class="text-red-500">*</span></label>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <label class="flex items-center gap-2 p-3 rounded-md border border-slate-200 dark:border-slate-700 cursor-pointer hover:border-emerald-400 transition-colors">
                            <input type="radio" name="stance" value="Support" required style="accent-color:#10b981" />
                            <span class="text-sm font-semibold">✅ Đúng như vậy</span>
                        </label>
                        <label class="flex items-center gap-2 p-3 rounded-md border border-slate-200 dark:border-slate-700 cursor-pointer hover:border-rose-400 transition-colors">
                            <input type="radio" name="stance" value="Oppose" style="accent-color:#f43f5e" />
                            <span class="text-sm font-semibold">❌ Không đúng</span>
                        </label>
                        <label class="flex items-center gap-2 p-3 rounded-md border border-slate-200 dark:border-slate-700 cursor-pointer hover:border-slate-400 transition-colors">
                            <input type="radio" name="stance" value="Neutral" style="accent-color:#64748b" />
                            <span class="text-sm font-semibold">🤷 Không rõ</span>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-2">Bạn thấy gì trong trận đó? <span class="text-slate-400 font-normal">(tùy chọn)</span></label>
                    <textarea name="comment" rows="3" maxlength="1000"
                              class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm"
                              placeholder="Mô tả ngắn những gì bạn chứng kiến..."></textarea>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-2">Ảnh kèm theo <span class="text-slate-400 font-normal">(tùy chọn)</span></label>
                    <input type="file" name="evidenceFile" accept="image/jpeg,image/png,image/webp"
                           class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20" />
                </div>

                <div class="flex gap-3 pt-2">
                    <button type="submit" class="px-6 py-2.5 bg-primary text-white rounded-md font-bold hover:bg-primary/90">Gửi xác minh</button>
                    <a href="/" class="px-6 py-2.5 bg-slate-100 dark:bg-slate-800 rounded-md font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">Để sau</a>
                </div>
            </form>
        }
    </div>
</section>
