@page
@model SportHub.Pages.Profile.EditModel
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<section class="max-w-3xl mx-auto space-y-6">
    <div>
        <h1 class="text-3xl font-black tracking-tight">Chỉnh sửa hồ sơ</h1>
        <p class="text-slate-500 dark:text-slate-400">Cập nhật thông tin cá nhân của bạn.</p>
    </div>

    <form method="post" enctype="multipart/form-data" class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-6 space-y-5 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>

        <div>
            <label class="block text-sm font-semibold mb-2">Họ và tên</label>
            <input asp-for="Input.FullName" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary" />
            <span asp-validation-for="Input.FullName" class="text-xs text-red-500"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold mb-2">Số điện thoại</label>
                <input asp-for="Input.PhoneNumber" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary" placeholder="0901234567" />
                <span asp-validation-for="Input.PhoneNumber" class="text-xs text-red-500"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Zalo <span class="font-normal text-slate-400">(SĐT đăng ký Zalo)</span></label>
                <input asp-for="Input.ZaloContact" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary" placeholder="0901234567" />
                <span asp-validation-for="Input.ZaloContact" class="text-xs text-red-500"></span>
                <p class="text-xs text-slate-400 mt-1">Hiển thị cho người chơi cùng trận để liên hệ.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label class="block text-sm font-semibold mb-2">Tải ảnh đại diện</label>
                <input asp-for="AvatarFile" type="file" accept=".jpg,.jpeg,.png,.webp,image/*" class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20" />
                <span asp-validation-for="AvatarFile" class="text-xs text-red-500"></span>
                <p class="mt-1 text-[10px] text-slate-400">Định dạng: JPG, PNG, WEBP (tối đa 2MB).</p>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Link ảnh đại diện (tùy chọn)</label>
                <input asp-for="Input.AvatarUrl" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary" placeholder="https://..." />
                <span asp-validation-for="Input.AvatarUrl" class="text-xs text-red-500"></span>
            </div>
        </div>

        <div class="relative">
            <label class="block text-sm font-semibold mb-2">Địa chỉ mặc định</label>
            <input asp-for="Input.DefaultAddress" id="profileAddressInput" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary" placeholder="Ví dụ: 81 Lê Văn Hiến, Đà Nẵng" autocomplete="off" />
            <div id="profileLocationSuggestions" class="absolute top-full left-0 right-0 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md mt-1 max-h-40 overflow-y-auto hidden z-[1000] shadow-lg"></div>
            <input type="hidden" asp-for="Input.DefaultLatitude" id="profileLatitude" />
            <input type="hidden" asp-for="Input.DefaultLongitude" id="profileLongitude" />
            <div class="mt-2 flex items-center gap-2">
                <button type="button" id="geolocateBtn" onclick="useMyLocation()" class="flex items-center gap-1.5 rounded-md border border-primary/40 bg-primary/5 px-3 py-1.5 text-xs font-semibold text-primary hover:bg-primary/10 transition-colors">
                    <span class="material-symbols-outlined text-base">my_location</span>
                    Dùng vị trí hiện tại
                </button>
                <span id="geolocateStatus" class="text-[11px] text-slate-400 hidden">Đang xác định...</span>
            </div>
            <p class="mt-1 text-[11px] text-amber-700 dark:text-amber-400">Chọn gợi ý rồi <strong>kéo ghim</strong> đúng nhà/sân — dùng để tính khoảng cách khi không bật GPS.</p>
        </div>
        <div id="profileMapContainer" class="hidden">
            <label class="block text-sm font-semibold mb-2">Vị trí của bạn trên bản đồ</label>
            <div id="profileMap" class="h-56 w-full rounded-md border border-slate-200 dark:border-slate-800"></div>
        </div>

        @* --- Gender & DateOfBirth --- *@
        @{
            var hasDobGender = !string.IsNullOrEmpty(Model.Input.Gender) && Model.Input.DateOfBirth.HasValue;
        }
        @if (!hasDobGender)
        {
            <div class="flex items-start gap-3 p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-md">
                <span class="material-symbols-outlined text-amber-500 mt-0.5 text-sm">stars</span>
                <p class="text-xs text-amber-700 dark:text-amber-400">
                    Điền <strong>giới tính</strong> và <strong>ngày sinh</strong> để nhận thưởng sinh nhật, Ngày Quốc tế Phụ nữ 8/3, Ngày Đàn ông 19/11 và các chương trình khuyến mãi khác!
                </p>
            </div>
        }
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold mb-2">Giới tính</label>
                <select asp-for="Input.Gender" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary">
                    <option value="">Không khai báo</option>
                    <option value="F">Nữ</option>
                    <option value="M">Nam</option>
                    <option value="O">Khác</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-semibold mb-2">Ngày sinh</label>
                <input asp-for="Input.DateOfBirth" type="date"
                       max="@DateTime.Today.AddYears(-13).ToString("yyyy-MM-dd")"
                       min="1920-01-01"
                       class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary" />
                <p class="text-xs text-slate-400 mt-1">Dùng để nhận thưởng sinh nhật hàng năm.</p>
            </div>
        </div>

        @* --- Sport Skills Section --- *@
        <div>
            <label class="block text-sm font-semibold mb-3">Bộ môn & Trình độ</label>
            <div id="sport-skills-container" class="space-y-3">
                @for (int i = 0; i < Model.Input.SportSkills.Count; i++)
                {
                    <div class="flex gap-3 items-center sport-skill-row">
                        <select name="Input.SportSkills[@i].SportId"
                                class="flex-1 rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary">
                            <option value="0">-- Chọn môn thể thao --</option>
                            @foreach (var sport in Model.DbSports)
                            {
                                if (Model.Input.SportSkills[i].SportId == sport.SportID)
                                {
                                    <option value="@sport.SportID" selected>@sport.SportName</option>
                                }
                                else
                                {
                                    <option value="@sport.SportID">@sport.SportName</option>
                                }
                            }
                        </select>
                        <select name="Input.SportSkills[@i].SkillLevel"
                                class="flex-1 rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary">
                            <option value="">-- Chọn trình độ --</option>
                            @foreach (var skill in Model.SkillOptions)
                            {
                                if (Model.Input.SportSkills[i].SkillLevel == skill)
                                {
                                    <option value="@skill" selected>@skill</option>
                                }
                                else
                                {
                                    <option value="@skill">@skill</option>
                                }
                            }
                        </select>
                        <button type="button" onclick="this.closest('.sport-skill-row').remove()"
                                class="text-red-400 hover:text-red-600 font-bold text-lg px-2">✕</button>
                    </div>
                }
            </div>

            @* Template for adding a new row (hidden) *@
            <template id="sport-skill-template">
                <div class="flex gap-3 items-center sport-skill-row">
                    <select name="Input.SportSkills[__INDEX__].SportId"
                            class="flex-1 rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary">
                        <option value="0">-- Chọn môn thể thao --</option>
                        @foreach (var sport in Model.DbSports)
                        {
                            <option value="@sport.SportID">@sport.SportName</option>
                        }
                    </select>
                    <select name="Input.SportSkills[__INDEX__].SkillLevel"
                            class="flex-1 rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 focus:ring-primary focus:border-primary">
                        <option value="">-- Chọn trình độ --</option>
                        @foreach (var skill in Model.SkillOptions)
                        {
                            <option value="@skill">@skill</option>
                        }
                    </select>
                    <button type="button" onclick="this.closest('.sport-skill-row').remove()"
                            class="text-red-400 hover:text-red-600 font-bold text-lg px-2">✕</button>
                </div>
            </template>

            <button type="button" id="add-sport-btn"
                    class="mt-3 text-sm text-primary font-semibold hover:underline">
                + Thêm bộ môn
            </button>
        </div>

        @* --- Email notification setting --- *@
        <div class="py-4 border-t border-slate-100 dark:border-slate-800">
            <h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">notifications</span> Thông báo
            </h3>
            <label class="flex items-center gap-3 cursor-pointer">
                <input asp-for="Input.NotifyByEmail" type="checkbox" class="w-5 h-5 rounded accent-primary" />
                <span class="text-sm text-slate-700 dark:text-slate-300">
                    Nhận thông báo quan trọng qua email (trận được duyệt, bị hủy, khuyến mãi)
                </span>
            </label>
        </div>

        <div class="flex gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
            <button type="submit" class="px-8 py-3 bg-primary text-white rounded-md font-bold hover:bg-primary/90 shadow-lg shadow-primary/20 transition-all">Lưu thay đổi</button>
            <a asp-page="/Profile/Index" class="px-8 py-3 bg-slate-100 dark:bg-slate-800 rounded-md font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-all text-center">Quay lại</a>
        </div>
    </form>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/location-picker.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            SportHubLocationPicker.init({
                addressInputId: 'profileAddressInput',
                latInputId: 'profileLatitude',
                lonInputId: 'profileLongitude',
                suggestionsId: 'profileLocationSuggestions',
                mapContainerId: 'profileMapContainer',
                mapId: 'profileMap',
                searchUrl: '/geo/search'
            });
        });

        window.useMyLocation = function () {
            if (!navigator.geolocation) return;
            var btn = document.getElementById('geolocateBtn');
            var status = document.getElementById('geolocateStatus');
            btn.disabled = true;
            status.classList.remove('hidden');
            navigator.geolocation.getCurrentPosition(async function (pos) {
                var lat = pos.coords.latitude, lon = pos.coords.longitude;
                document.getElementById('profileLatitude').value = lat;
                document.getElementById('profileLongitude').value = lon;
                status.textContent = 'Đang tải địa chỉ...';
                try {
                    var res = await fetch('/geo/reverse?lat=' + lat + '&lon=' + lon);
                    var data = await res.json();
                    if (data && data.address) {
                        document.getElementById('profileAddressInput').value = data.address;
                    }
                } catch (e) {}
                status.textContent = 'Đã xác định vị trí';
                btn.disabled = false;
                setTimeout(function () { status.classList.add('hidden'); }, 3000);
            }, function () {
                status.textContent = 'Không thể lấy vị trí';
                btn.disabled = false;
            });
        };
    </script>
}

<script>
    document.getElementById('add-sport-btn').addEventListener('click', function () {
        const container = document.getElementById('sport-skills-container');
        const index = container.querySelectorAll('.sport-skill-row').length;
        const template = document.getElementById('sport-skill-template');
        const clone = template.content.cloneNode(true);

        // Replace __INDEX__ placeholders with actual index
        clone.querySelectorAll('[name]').forEach(el => {
            el.name = el.name.replace('__INDEX__', index);
        });

        container.appendChild(clone);
    });
</script>
