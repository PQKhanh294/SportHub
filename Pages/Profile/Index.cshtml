@page
@model SportHub.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Cá nhân";
    ViewData["ActivePage"] = "Profile";
    var p = Model.Profile;

    string planKey = ViewData["CurrentPlanKey"] as string ?? "Free";
}

<section class="space-y-6">

    <!-- Hero Card — Cover banner + Avatar overlap -->
    <div class="bg-white dark:bg-slate-900 rounded-md overflow-hidden border border-slate-200 dark:border-slate-800 shadow-sm">
        <!-- Teal cover banner -->
        <div class="h-28 bg-gradient-to-br from-primary/80 via-primary to-navy/90 relative">
            <!-- Edit button top-right -->
            <a asp-page="/Profile/Edit"
               class="absolute top-3 right-3 flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white/20 hover:bg-white/30 text-white text-xs font-semibold backdrop-blur-sm transition-all">
                <span class="material-symbols-outlined text-sm">edit</span>
                Chỉnh sửa
            </a>
        </div>

        <!-- Avatar + Info -->
        <div class="px-6 pb-6">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 -mt-12">
                <!-- Avatar -->
                <div class="relative inline-block">
                    <img class="size-24 rounded-full border-4 border-white dark:border-slate-900 shadow-lg object-cover ring-2 ring-primary/30"
                         src="@p.AvatarUrl"
                         onerror="this.onerror=null;this.src='/images/avatar-default.png';"
                         alt="@p.FullName" />
                    @if (Model.CurrentPlanKey == "Pro")
                    {
                        <span class="absolute -bottom-1 -right-1 bg-purple-600 text-white text-[9px] font-black px-1.5 py-0.5 rounded-md shadow">PRO</span>
                    }
                    else if (Model.CurrentPlanKey == "Club")
                    {
                        <span class="absolute -bottom-1 -right-1 bg-amber-500 text-white text-[9px] font-black px-1.5 py-0.5 rounded-md shadow">CLUB</span>
                    }
                    else if (Model.CurrentPlanKey == "Starter")
                    {
                        <span class="absolute -bottom-1 -right-1 bg-primary text-white text-[9px] font-black px-1.5 py-0.5 rounded-md shadow">S+</span>
                    }
                </div>

                <!-- Quick stats (desktop) -->
                <div class="hidden sm:flex items-center gap-6 pb-1">
                    <div class="text-center">
                        <p class="text-2xl font-black text-slate-900 dark:text-white">@p.MatchesPlayed</p>
                        <p class="text-xs text-slate-400 font-medium">Trận đã chơi</p>
                    </div>
                    <div class="w-px h-8 bg-slate-200 dark:bg-slate-700"></div>
                    <div class="text-center">
                        <p class="text-2xl font-black text-primary">@p.Wins</p>
                        <p class="text-xs text-slate-400 font-medium">Trận thắng</p>
                    </div>
                    <div class="w-px h-8 bg-slate-200 dark:bg-slate-700"></div>
                    <div class="text-center">
                        <p class="text-2xl font-black text-accent">@p.TotalBookings</p>
                        <p class="text-xs text-slate-400 font-medium">Lần đặt sân</p>
                    </div>
                </div>
            </div>

            <!-- Name & badges -->
            <div class="mt-3">
                <h1 class="text-2xl font-bold text-slate-900 dark:text-white">@p.FullName</h1>
                <p class="text-sm text-slate-400 mt-0.5">Thành viên từ @p.JoinedText</p>
                <div class="flex flex-wrap gap-2 mt-3">
                    <span class="inline-flex items-center gap-1 px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-md">
                        <span class="material-symbols-outlined text-xs">verified</span>
                        Người chơi xác thực
                    </span>
                    @if (Model.CurrentPlanKey != null && Model.CurrentPlanKey != "Free")
                    {
                        var (subBg, subText) = Model.CurrentPlanKey switch {
                            "Club"    => ("bg-amber-100 text-amber-700",  "Club"),
                            "Pro"     => ("bg-purple-100 text-purple-700","Pro"),
                            _         => ("bg-primary/10 text-primary",   "Starter"),
                        };
                        <a href="/Subscription" class="inline-flex items-center gap-1 px-3 py-1 @subBg text-xs font-bold rounded-md hover:opacity-80 transition-opacity">
                            <span class="material-symbols-outlined text-xs">workspace_premium</span>
                            @subText
                        </a>
                    }
                </div>
            </div>

            <!-- Quick stats mobile -->
            <div class="sm:hidden flex items-center gap-6 mt-4 pt-4 border-t border-slate-100 dark:border-slate-800">
                <div class="text-center flex-1">
                    <p class="text-xl font-black text-slate-900 dark:text-white">@p.MatchesPlayed</p>
                    <p class="text-[11px] text-slate-400">Trận đã chơi</p>
                </div>
                <div class="text-center flex-1">
                    <p class="text-xl font-black text-primary">@p.Wins</p>
                    <p class="text-[11px] text-slate-400">Trận thắng</p>
                </div>
                <div class="text-center flex-1">
                    <p class="text-xl font-black text-accent">@p.TotalBookings</p>
                    <p class="text-[11px] text-slate-400">Lần đặt sân</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Body Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Sidebar (4 col) -->
        <div class="lg:col-span-4 space-y-4">

            <!-- Thông tin cá nhân -->
            <div class="bg-white dark:bg-slate-900 rounded-md p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="font-bold mb-4 flex items-center gap-2 text-slate-900 dark:text-white">
                    <span class="material-symbols-outlined text-primary text-lg">person</span>
                    Thông tin cá nhân
                </h3>
                <div class="space-y-3 text-sm">
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-slate-400 text-base mt-0.5">mail</span>
                        <div>
                            <p class="text-slate-400 text-xs">Email</p>
                            <p class="font-semibold text-slate-800 dark:text-slate-200">@p.Email</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-slate-400 text-base mt-0.5">phone</span>
                        <div>
                            <p class="text-slate-400 text-xs">Số điện thoại</p>
                            <p class="font-semibold text-slate-800 dark:text-slate-200">@p.PhoneNumber</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-slate-400 text-base mt-0.5">location_on</span>
                        <div>
                            <p class="text-slate-400 text-xs">Địa chỉ mặc định</p>
                            <p class="font-semibold text-slate-800 dark:text-slate-200">@p.DefaultAddress</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-slate-400 text-base mt-0.5">calendar_today</span>
                        <div>
                            <p class="text-slate-400 text-xs">Tham gia từ</p>
                            <p class="font-semibold text-slate-800 dark:text-slate-200">@p.JoinedText</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ví SportHub -->
            <div class="bg-white dark:bg-slate-900 rounded-md p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-bold flex items-center gap-2 text-slate-900 dark:text-white">
                        <span class="material-symbols-outlined text-primary text-lg">account_balance_wallet</span>
                        Ví SportHub
                    </h3>
                    <span class="text-lg font-black @(Model.WalletBalance > 0 ? "text-primary" : "text-slate-400")">@Model.WalletBalance.ToString("N0") xu</span>
                </div>
                @if (Model.WalletHistory.Any())
                {
                    <div class="space-y-1.5">
                        @foreach (var tx in Model.WalletHistory)
                        {
                            var txColor = tx.Amount > 0 ? "text-primary" : "text-rose-600";
                            var txSign = tx.Amount > 0 ? "+" : "";
                            var txIcon = tx.Type switch {
                                "Refund"      => "undo",
                                "AdminCredit" => "redeem",
                                "Deduction"   => "remove_circle",
                                _             => "swap_horiz"
                            };
                            <div class="flex items-center gap-2.5 py-2 border-b border-slate-50 dark:border-slate-800 last:border-0">
                                <span class="material-symbols-outlined text-slate-300 text-sm">@txIcon</span>
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs text-slate-700 dark:text-slate-300 truncate">@tx.Description</p>
                                    <p class="text-[10px] text-slate-400">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yy HH:mm")</p>
                                </div>
                                <span class="text-xs font-bold @txColor">@txSign@tx.Amount.ToString("N0") xu</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-slate-400 text-center py-3">Chưa có giao dịch nào.</p>
                }
                <a href="/Wallet" class="mt-3 flex items-center justify-center gap-1 text-xs font-semibold text-primary hover:underline">
                    Xem lịch sử ví
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </div>

            <!-- Môn thể thao & Trình độ -->
            <div class="bg-white dark:bg-slate-900 rounded-md p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="font-bold mb-3 flex items-center gap-2 text-slate-900 dark:text-white">
                    <span class="material-symbols-outlined text-primary text-lg">sports</span>
                    Môn thể thao & Trình độ
                </h3>
                <div class="space-y-2">
                    @if (Model.SportProfiles.Any())
                    {
                        @foreach (var sp in Model.SportProfiles)
                        {
                            var sportEmoji = sp.SportName switch {
                                var n when n.Contains("Cầu lông", StringComparison.OrdinalIgnoreCase)
                                        || n.Contains("Badminton", StringComparison.OrdinalIgnoreCase) => "🏸",
                                var n when n.Contains("Bóng đá", StringComparison.OrdinalIgnoreCase)
                                        || n.Contains("Football", StringComparison.OrdinalIgnoreCase) => "⚽",
                                var n when n.Contains("Bóng bàn", StringComparison.OrdinalIgnoreCase)
                                        || n.Contains("Table Tennis", StringComparison.OrdinalIgnoreCase) => "🏓",
                                var n when n.Contains("Tennis", StringComparison.OrdinalIgnoreCase) => "🎾",
                                var n when n.Contains("Bóng rổ", StringComparison.OrdinalIgnoreCase)
                                        || n.Contains("Basketball", StringComparison.OrdinalIgnoreCase) => "🏀",
                                var n when n.Contains("Bơi", StringComparison.OrdinalIgnoreCase)
                                        || n.Contains("Swimming", StringComparison.OrdinalIgnoreCase) => "🏊",
                                _ => "🎯"
                            };
                            <div class="flex items-center justify-between px-3 py-2.5 bg-slate-50 dark:bg-slate-800/50 rounded-md">
                                <span class="font-semibold text-slate-800 dark:text-slate-200 text-sm flex items-center gap-1.5">
                                    <span>@sportEmoji</span>
                                    @sp.SportName
                                </span>
                                <span class="text-xs px-2.5 py-1 bg-primary/10 text-primary font-bold rounded-md">@sp.SkillLevel</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-6">
                            <span class="material-symbols-outlined text-slate-300 text-3xl">sports</span>
                            <p class="text-sm text-slate-400 mt-2">Chưa cập nhật môn thể thao.</p>
                            <a asp-page="/Profile/Edit" class="mt-2 inline-block text-xs font-semibold text-primary hover:underline">Thêm ngay</a>
                        </div>
                    }
                </div>
            </div>

            <!-- Mã của tôi -->
            @{
                var totalCodes = Model.SavedCodes.Count + Model.MyVouchers.Count;
                var validCodes = Model.SavedCodes.Count(c => c.IsValid) + Model.MyVouchers.Count(v => !v.IsUsed && (v.ExpiresAt == null || v.ExpiresAt > DateTime.UtcNow));
            }
            <div class="bg-white dark:bg-slate-900 rounded-md p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-bold flex items-center gap-2 text-slate-900 dark:text-white">
                        <span class="material-symbols-outlined text-primary text-lg">local_offer</span>
                        Mã của tôi
                    </h3>
                    @if (validCodes > 0)
                    {
                        <span class="text-[10px] font-bold px-2 py-0.5 bg-emerald-100 text-emerald-700 rounded-md">@validCodes khả dụng</span>
                    }
                </div>

                @if (totalCodes == 0)
                {
                    <div class="text-center py-4">
                        <span class="material-symbols-outlined text-slate-300 text-2xl">confirmation_number</span>
                        <p class="text-xs text-slate-400 mt-1">Chưa có mã nào được lưu.</p>
                        <a href="/Wallet" class="mt-1 inline-block text-xs font-semibold text-primary hover:underline">Nhập mã tại Ví</a>
                    </div>
                }
                else
                {
                    <div class="space-y-2" id="profile-codes-list">
                        @foreach (var c in Model.SavedCodes)
                        {
                            var isValid = c.IsValid;
                            var borderCls = isValid ? "border-primary/20 bg-primary/3" : "border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/30 opacity-60";
                            var expiryText = c.ExpiresAt.HasValue ? c.ExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy") : "Không hết hạn";
                            <div class="rounded-md border @borderCls p-3.5">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-1.5 mb-0.5">
                                            <span class="font-mono font-bold text-sm text-slate-800 dark:text-slate-200">@c.Code</span>
                                            <button onclick="copyCode('@c.Code')" title="Sao chép"
                                                    class="text-slate-300 hover:text-primary transition-colors">
                                                <span class="material-symbols-outlined text-[14px]">content_copy</span>
                                            </button>
                                        </div>
                                        @if (c.CampaignName != null)
                                        {
                                            <p class="text-[10px] text-slate-400 truncate">@c.CampaignName</p>
                                        }
                                        <div class="flex items-center gap-2 mt-1">
                                            @if (c.Amount.HasValue && isValid)
                                            {
                                                <span class="text-xs font-bold text-emerald-600">+@c.Amount.Value.ToString("N0")đ</span>
                                            }
                                            @if (c.StatusMessage != null)
                                            {
                                                <span class="text-[10px] text-rose-400 font-medium">@c.StatusMessage</span>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] text-slate-400" data-expires="@(c.ExpiresAt?.ToString("o"))">
                                                    HSD: @expiryText
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-end gap-1.5 shrink-0">
                                        @if (isValid)
                                        {
                                            <a href="/Wallet?code=@c.Code" class="text-[10px] font-bold px-2 py-1 rounded-md bg-primary text-white hover:bg-primary/90 transition-colors">
                                                Dùng ngay
                                            </a>
                                        }
                                        <button onclick="removeSavedCode('@c.Code', this)"
                                                class="text-[10px] text-slate-400 hover:text-rose-400 transition-colors">
                                            Bỏ lưu
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        @foreach (var v in Model.MyVouchers)
                        {
                            var isUsed = v.IsUsed;
                            var isExpired = v.ExpiresAt.HasValue && v.ExpiresAt < DateTime.UtcNow;
                            var vValid = !isUsed && !isExpired;
                            var vBorder = vValid ? "border-violet-200 bg-violet-50/50 dark:bg-violet-900/10" : "border-slate-100 dark:border-slate-800 opacity-60";
                            var vStatus = isUsed ? "Đã dùng" : isExpired ? "Hết hạn" : null;
                            var vExpiry = v.ExpiresAt.HasValue ? v.ExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy") : "Không hết hạn";
                            <div class="rounded-md border @vBorder p-3.5">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-1.5 mb-0.5">
                                            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-violet-100 text-violet-600 dark:bg-violet-900/30">VOUCHER</span>
                                            <span class="font-mono font-bold text-xs text-slate-700 dark:text-slate-300">@v.Code</span>
                                            <button onclick="copyCode('@v.Code')" title="Sao chép"
                                                    class="text-slate-300 hover:text-primary transition-colors">
                                                <span class="material-symbols-outlined text-[13px]">content_copy</span>
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrEmpty(v.Note))
                                        {
                                            <p class="text-[10px] text-slate-400 truncate">@v.Note</p>
                                        }
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="text-xs font-bold text-violet-600">+@v.Amount.ToString("N0")đ</span>
                                            @if (vStatus != null)
                                            {
                                                <span class="text-[10px] text-slate-400 font-medium">@vStatus</span>
                                            }
                                            else
                                            {
                                                <span class="text-[10px] text-slate-400">HSD: @vExpiry</span>
                                            }
                                        </div>
                                    </div>
                                    @if (vValid)
                                    {
                                        <a href="/Wallet?voucher=@v.Code" class="shrink-0 text-[10px] font-bold px-2 py-1 rounded-md bg-violet-600 text-white hover:bg-violet-700 transition-colors">
                                            Dùng ngay
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <a href="/Wallet" class="mt-3 flex items-center justify-center gap-1 text-xs font-semibold text-primary hover:underline">
                        Nhập thêm mã tại Ví
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                }
            </div>

            <!-- Huy hiệu -->
            <div class="bg-white dark:bg-slate-900 rounded-md p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="font-bold mb-3 flex items-center gap-2 text-slate-900 dark:text-white">
                    <span class="material-symbols-outlined text-primary text-lg">military_tech</span>
                    Huy hiệu SportHub
                </h3>
                <div class="space-y-2">
                    @foreach (var badge in Model.Badges)
                    {
                        <div class="p-3.5 rounded-md border @(badge.IsEarned ? "border-primary/25 bg-primary/5" : "border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30")">
                            <div class="flex items-start gap-2.5">
                                <span class="material-symbols-outlined text-lg @(badge.IsEarned ? "text-primary" : "text-slate-300 dark:text-slate-600")">@badge.Icon</span>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="font-bold text-xs text-slate-800 dark:text-slate-200">@badge.Name</p>
                                        <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-md @(badge.IsEarned ? "bg-primary text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-500")">@badge.Level</span>
                                    </div>
                                    <p class="text-[10px] text-slate-400 mt-0.5">@badge.Description</p>
                                    <div class="mt-1.5 h-1.5 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden">
                                        <div class="h-full bg-primary rounded-full transition-all" style="width:@badge.ProgressPercent%"></div>
                                    </div>
                                    <p class="text-[9px] text-slate-400 mt-0.5">@badge.ProgressValue / @badge.TargetValue</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Main content (8 col) -->
        <div class="lg:col-span-8 space-y-4">

            <!-- Rating Summary -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- As Host -->
                <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-5 shadow-sm">
                    <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-3 text-sm">
                        <span class="material-symbols-outlined text-primary text-base">diversity_3</span>
                        Khi là Host
                    </h3>
                    @if (!Model.HostRatingSummary.HasEnoughReviews)
                    {
                        <div class="text-center py-4">
                            <span class="material-symbols-outlined text-slate-300 text-2xl">star_border</span>
                            <p class="text-xs text-slate-400 mt-1">Chưa có đánh giá nào</p>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-3 mb-3">
                            <span class="text-3xl font-black text-amber-600 dark:text-amber-400">@Model.HostRatingSummary.OverallAverage.ToString("F1")</span>
                            <div>
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-sm @(i <= (int)Math.Round(Model.HostRatingSummary.OverallAverage) ? "text-amber-400" : "text-slate-200 dark:text-slate-600")"
                                              style="font-variation-settings:'FILL' 1">star</span>
                                    }
                                </div>
                                <p class="text-[11px] text-slate-400">@Model.HostRatingSummary.ReviewCount đánh giá</p>
                            </div>
                        </div>
                        <div class="space-y-1.5 text-xs text-slate-500">
                            @if (Model.HostRatingSummary.AvgOrganization.HasValue)
                            { <div class="flex justify-between"><span>Tổ chức</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.HostRatingSummary.AvgOrganization.Value.ToString("F1")</span></div> }
                            @if (Model.HostRatingSummary.AvgEquipment.HasValue)
                            { <div class="flex justify-between"><span>Thiết bị</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.HostRatingSummary.AvgEquipment.Value.ToString("F1")</span></div> }
                            @if (Model.HostRatingSummary.AvgAtmosphere.HasValue)
                            { <div class="flex justify-between"><span>Không khí</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.HostRatingSummary.AvgAtmosphere.Value.ToString("F1")</span></div> }
                            @if (Model.HostRatingSummary.AvgHost.HasValue)
                            { <div class="flex justify-between"><span>Host</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.HostRatingSummary.AvgHost.Value.ToString("F1")</span></div> }
                        </div>
                    }
                </div>

                <!-- As Player -->
                <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-5 shadow-sm">
                    <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-3 text-sm">
                        <span class="material-symbols-outlined text-primary text-base">sports_tennis</span>
                        Khi là Người chơi
                    </h3>
                    @if (!Model.PlayerRatingSummary.HasEnoughReviews)
                    {
                        <div class="text-center py-4">
                            <span class="material-symbols-outlined text-slate-300 text-2xl">star_border</span>
                            <p class="text-xs text-slate-400 mt-1">Chưa có đánh giá nào</p>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-3 mb-3">
                            <span class="text-3xl font-black text-amber-600 dark:text-amber-400">@Model.PlayerRatingSummary.OverallAverage.ToString("F1")</span>
                            <div>
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-sm @(i <= (int)Math.Round(Model.PlayerRatingSummary.OverallAverage) ? "text-amber-400" : "text-slate-200 dark:text-slate-600")"
                                              style="font-variation-settings:'FILL' 1">star</span>
                                    }
                                </div>
                                <p class="text-[11px] text-slate-400">@Model.PlayerRatingSummary.ReviewCount đánh giá</p>
                            </div>
                        </div>
                        <div class="space-y-1.5 text-xs text-slate-500">
                            @if (Model.PlayerRatingSummary.AvgPunctuality.HasValue)
                            { <div class="flex justify-between"><span>Đúng giờ</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.PlayerRatingSummary.AvgPunctuality.Value.ToString("F1")</span></div> }
                            @if (Model.PlayerRatingSummary.AvgSportsmanship.HasValue)
                            { <div class="flex justify-between"><span>Tinh thần</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.PlayerRatingSummary.AvgSportsmanship.Value.ToString("F1")</span></div> }
                            @if (Model.PlayerRatingSummary.AvgSkillAccuracy.HasValue)
                            { <div class="flex justify-between"><span>Trình độ</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.PlayerRatingSummary.AvgSkillAccuracy.Value.ToString("F1")</span></div> }
                        </div>
                    }
                </div>
            </div>

            <!-- Review History -->
            @if (Model.ReceivedReviews.Any())
            {
                <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-5 shadow-sm">
                    <h3 class="font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-base">rate_review</span>
                        Đánh giá nhận được
                        <span class="ml-auto text-xs font-normal text-slate-400">@Model.ReceivedReviews.Count đánh giá</span>
                    </h3>
                    <div class="space-y-4 max-h-96 overflow-y-auto pr-1">
                        @foreach (var review in Model.ReceivedReviews)
                        {
                            var typeLabel = review.ReviewType == "PlayerToMatch" ? "Người chơi → Host" : "Host → Người chơi";
                            var typeBg = review.ReviewType == "PlayerToMatch"
                                ? "bg-primary/10 text-primary"
                                : "bg-accent/10 text-accent";
                            <div class="flex gap-3 pb-4 border-b border-slate-50 dark:border-slate-800/60 last:border-0">
                                <img src="@(review.ReviewerAvatarUrl ?? "/images/avatar-default.png")"
                                     alt="" class="w-9 h-9 rounded-full object-cover flex-shrink-0 mt-0.5 ring-1 ring-slate-200" />
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-1 flex-wrap">
                                        <span class="font-semibold text-slate-800 dark:text-slate-200 text-sm">@review.ReviewerName</span>
                                        <span class="text-[9px] font-bold px-2 py-0.5 rounded-md @typeBg">@typeLabel</span>
                                        <span class="text-xs text-slate-400 ml-auto">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yy")</span>
                                    </div>
                                    <p class="text-[11px] text-slate-400 mb-1">@review.MatchTitle • @review.MatchDate.ToString("dd/MM/yyyy")</p>
                                    <div class="flex items-center gap-0.5 mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="material-symbols-outlined text-sm @(i <= (int)Math.Round(review.AverageScore) ? "text-amber-400" : "text-slate-200 dark:text-slate-700")"
                                                  style="font-variation-settings:'FILL' 1">star</span>
                                        }
                                        <span class="text-xs font-bold text-amber-700 dark:text-amber-400 ml-1">@review.AverageScore.ToString("F1")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                                    {
                                        <p class="text-sm text-slate-600 dark:text-slate-400 italic">"@review.Comment"</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-8 shadow-sm text-center">
                    <span class="material-symbols-outlined text-slate-300 text-4xl">rate_review</span>
                    <p class="text-sm text-slate-400 mt-3">Chưa có đánh giá nào.</p>
                    <p class="text-xs text-slate-300 mt-1">Tham gia trận đấu để nhận đánh giá từ người chơi khác.</p>
                    <a asp-page="/Matchmaking/Index" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline">
                        <span class="material-symbols-outlined text-sm">person_search</span>
                        Tìm trận ngay
                    </a>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
<script>
function copyCode(code) {
    navigator.clipboard.writeText(code).then(function () {
        showToast('Đã sao chép: ' + code);
    });
}

async function removeSavedCode(code, btn) {
    if (!confirm('Bỏ lưu mã ' + code + '?')) return;
    btn.disabled = true;
    try {
        await fetch('/api/wallet/unsave-code/' + encodeURIComponent(code), { method: 'DELETE' });
        var card = btn.closest('.rounded-md');
        if (card) card.remove();
        showToast('Đã bỏ lưu mã ' + code);
    } catch {
        btn.disabled = false;
    }
}

function showToast(msg) {
    var t = document.createElement('div');
    t.textContent = msg;
    t.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-[9999] px-4 py-2 rounded-full bg-slate-800 text-white text-xs font-semibold shadow-lg transition-all';
    document.body.appendChild(t);
    setTimeout(function () { t.remove(); }, 2500);
}

// Auto-fill code from URL param and switch to wallet page
(function () {
    var params = new URLSearchParams(location.search);
    var code = params.get('code') || params.get('voucher');
    if (code) {
        window.location.href = '/Wallet?prefill=' + encodeURIComponent(code);
    }
})();

// Collapsible sections — on mobile, sections can be toggled to save vertical space
(function () {
    var STORAGE_KEY = 'sporthub_profile_collapsed';
    var collapsed = {};
    try { collapsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch {}

    var COLLAPSIBLE_LABELS = ['Ví SportHub', 'Môn thể thao', 'Mã', 'Huy hiệu', 'Khi là Host', 'Khi là Người chơi', 'Đánh giá nhận được'];

    document.querySelectorAll('.bg-white.rounded-md, .dark\\:bg-slate-900.rounded-md').forEach(function (card) {
        var h3 = card.querySelector('h3');
        if (!h3) return;
        var text = h3.textContent.trim();
        var match = COLLAPSIBLE_LABELS.find(function (l) { return text.indexOf(l) !== -1; });
        if (!match) return;

        var key = match;
        // h3 may be inside a flex wrapper div — detect body correctly
        var body = h3.parentElement === card ? h3.nextElementSibling : h3.parentElement.nextElementSibling;
        if (!body) return;

        // Add toggle button into h3
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ml-auto text-slate-400 hover:text-primary transition-colors focus:outline-none';
        btn.innerHTML = '<span class="material-symbols-outlined text-sm" id="icon-' + key + '">' +
            (collapsed[key] ? 'expand_more' : 'expand_less') + '</span>';
        btn.setAttribute('aria-label', 'Thu gọn / Mở rộng');
        h3.style.cursor = 'pointer';
        h3.classList.add('flex', 'items-center', 'w-full');
        h3.appendChild(btn);

        // Apply initial state
        if (collapsed[key]) {
            body.style.display = 'none';
        }

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var isCollapsed = body.style.display === 'none';
            body.style.display = isCollapsed ? '' : 'none';
            document.getElementById('icon-' + key).textContent = isCollapsed ? 'expand_less' : 'expand_more';
            collapsed[key] = !isCollapsed;
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(collapsed)); } catch {}
        });

        h3.addEventListener('click', function () { btn.click(); });
    });
})();
</script>
}

