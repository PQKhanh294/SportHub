@page
@model SportHub.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Cá nhân";
    var p = Model.Profile;
}

<section class="space-y-8">
    <div class="bg-white dark:bg-slate-900 rounded-xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-5">
                <img class="size-28 rounded-full border-4 border-white dark:border-slate-800 shadow-lg object-cover"
                     src="@p.AvatarUrl"
                     onerror="this.onerror=null;this.src='/images/avatar-default.png';"
                     alt="User" />
                <div>
                    <h1 class="text-3xl font-bold">@p.FullName</h1>
                    <p class="text-slate-500 dark:text-slate-400">Thành viên từ @p.JoinedText</p>
                    <div class="flex gap-2 mt-2">
                        <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full">Người chơi xác thực</span>
                        <span class="px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full">Premium</span>
                    </div>
                </div>
            </div>
            <a asp-page="/Profile/Edit" class="px-5 py-2.5 rounded-lg bg-slate-100 dark:bg-slate-800 font-bold hover:bg-primary hover:text-white transition-colors">Chỉnh sửa hồ sơ</a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-4 space-y-6">
            <!-- Thông tin cá nhân -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="font-bold mb-4 text-lg">Thông tin cá nhân</h3>
                <div class="space-y-4 text-sm">
                    <div>
                        <span class="text-slate-400 block mb-1">Email</span>
                        <b class="text-slate-900 dark:text-white">@p.Email</b>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-1">Số điện thoại</span>
                        <b class="text-slate-900 dark:text-white">@p.PhoneNumber</b>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-1">Địa chỉ mặc định</span>
                        <b class="text-slate-900 dark:text-white">@p.DefaultAddress</b>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-1">Tham gia từ</span>
                        <b class="text-slate-900 dark:text-white">@p.JoinedText</b>
                    </div>
                </div>
            </div>

            <!-- Ví SportHub -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-bold text-lg flex items-center gap-2">
                        <span class="material-symbols-outlined text-emerald-600">account_balance_wallet</span>
                        Ví SportHub
                    </h3>
                    <span class="text-xl font-black @(Model.WalletBalance > 0 ? "text-emerald-600" : "text-slate-400")">@Model.WalletBalance.ToString("N0") ₫</span>
                </div>
                @if (Model.WalletHistory.Any())
                {
                    <div class="space-y-2">
                        @foreach (var tx in Model.WalletHistory)
                        {
                            var txColor = tx.Amount > 0 ? "text-emerald-600" : "text-rose-600";
                            var txSign = tx.Amount > 0 ? "+" : "";
                            var txIcon = tx.Type switch {
                                "Refund"      => "undo",
                                "AdminCredit" => "redeem",
                                "Deduction"   => "remove_circle",
                                _             => "swap_horiz"
                            };
                            <div class="flex items-center gap-3 py-2 border-b border-slate-100 dark:border-slate-800 last:border-0">
                                <span class="material-symbols-outlined text-slate-400 text-base">@txIcon</span>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm text-slate-700 dark:text-slate-300 truncate">@tx.Description</p>
                                    <p class="text-xs text-slate-400">@tx.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</p>
                                </div>
                                <span class="text-sm font-bold @txColor flex-shrink-0">@txSign@tx.Amount.ToString("N0") ₫</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-slate-400 text-center py-3">Chưa có giao dịch ví nào.</p>
                }
            </div>

            <!-- Môn thể thao & Trình độ -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="font-bold mb-4 text-lg">Môn thể thao & Trình độ</h3>
                <div class="space-y-3">
                    @if (Model.SportProfiles.Any())
                    {
                        @foreach (var sp in Model.SportProfiles)
                        {
                            <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
                                <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                                    @if (sp.SportName.Contains("Cầu lông", StringComparison.OrdinalIgnoreCase) || sp.SportName.Contains("Badminton", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span>🏸</span>
                                    }
                                    else if (sp.SportName.Contains("Bóng đá", StringComparison.OrdinalIgnoreCase) || sp.SportName.Contains("Football", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span>⚽</span>
                                    }
                                    else if (sp.SportName.Contains("Bóng bàn", StringComparison.OrdinalIgnoreCase) || sp.SportName.Contains("Table Tennis", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span>🏓</span>
                                    }
                                    else if (sp.SportName.Contains("Tennis", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span>🎾</span>
                                    }
                                    else
                                    {
                                        <span>🎯</span>
                                    }
                                    @sp.SportName
                                </span>
                                <span class="text-xs px-2.5 py-1 bg-primary/10 text-primary font-bold rounded-full">@sp.SkillLevel</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-sm text-slate-500 text-center py-4">Chưa cập nhật môn thể thao.</p>
                    }
                </div>
            </div>

            <div class="bg-white dark:bg-slate-900 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="font-bold mb-4 text-lg">Huy hiá»‡u SportHub</h3>
                <div class="space-y-3">
                    @foreach (var badge in Model.Badges)
                    {
                        <div class="p-3 rounded-xl border @(badge.IsEarned ? "border-primary/30 bg-primary/5" : "border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50")">
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined @(badge.IsEarned ? "text-primary" : "text-slate-400")">@badge.Icon</span>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="font-black text-sm">@badge.Name</p>
                                        <span class="text-[10px] font-bold px-2 py-1 rounded-full @(badge.IsEarned ? "bg-primary text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-500")">@badge.Level</span>
                                    </div>
                                    <p class="text-xs text-slate-500 mt-1">@badge.Description</p>
                                    <div class="mt-2 h-2 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden">
                                        <div class="h-full bg-primary" style="width:@badge.ProgressPercent%"></div>
                                    </div>
                                    <p class="text-[10px] text-slate-500 mt-1">@badge.ProgressValue / @badge.TargetValue</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                <p class="text-slate-400 text-xs font-bold uppercase tracking-wider">Trận đã chơi</p>
                <p class="text-4xl font-black mt-2">@p.MatchesPlayed</p>
            </div>
            <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                <p class="text-slate-400 text-xs font-bold uppercase tracking-wider">Trận thắng</p>
                <p class="text-4xl font-black mt-2 text-emerald-600">@p.Wins</p>
            </div>
            <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                <p class="text-slate-400 text-xs font-bold uppercase tracking-wider">Số lần đặt sân</p>
                <p class="text-4xl font-black mt-2 text-primary">@p.TotalBookings</p>
            </div>
        </div>
    </div>

    <!-- Rating Summary & Review History -->
    <div class="mt-8 space-y-6">
        <!-- Rating Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- As Host -->
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5">
                <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-3">
                    <span class="material-symbols-outlined text-primary">diversity_3</span>
                    Khi là Host
                </h3>
                @if (!Model.HostRatingSummary.HasEnoughReviews)
                {
                    <p class="text-sm text-slate-400">Chưa đủ đánh giá (cần ≥ 3)</p>
                }
                else
                {
                    <div class="flex items-center gap-3 mb-3">
                        <span class="text-4xl font-black text-amber-500">@Model.HostRatingSummary.OverallAverage.ToString("F1")</span>
                        <div>
                            <div class="flex items-center gap-0.5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="material-symbols-outlined text-base @(i <= (int)Math.Round(Model.HostRatingSummary.OverallAverage) ? "text-amber-400" : "text-slate-300")"
                                          style="font-variation-settings:'FILL' 1">star</span>
                                }
                            </div>
                            <p class="text-xs text-slate-400">@Model.HostRatingSummary.ReviewCount đánh giá</p>
                        </div>
                    </div>
                    <div class="space-y-1 text-xs text-slate-500">
                        @if (Model.HostRatingSummary.AvgOrganization.HasValue)
                        { <div class="flex justify-between"><span>Tổ chức</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.HostRatingSummary.AvgOrganization.Value.ToString("F1")</span></div> }
                        @if (Model.HostRatingSummary.AvgEquipment.HasValue)
                        { <div class="flex justify-between"><span>Thiết bị</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.HostRatingSummary.AvgEquipment.Value.ToString("F1")</span></div> }
                        @if (Model.HostRatingSummary.AvgAtmosphere.HasValue)
                        { <div class="flex justify-between"><span>Không khí</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.HostRatingSummary.AvgAtmosphere.Value.ToString("F1")</span></div> }
                        @if (Model.HostRatingSummary.AvgHost.HasValue)
                        { <div class="flex justify-between"><span>Host</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.HostRatingSummary.AvgHost.Value.ToString("F1")</span></div> }
                    </div>
                }
            </div>

            <!-- As Player -->
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5">
                <h3 class="font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-3">
                    <span class="material-symbols-outlined text-primary">sports_tennis</span>
                    Khi là Người chơi
                </h3>
                @if (!Model.PlayerRatingSummary.HasEnoughReviews)
                {
                    <p class="text-sm text-slate-400">Chưa đủ đánh giá (cần ≥ 3)</p>
                }
                else
                {
                    <div class="flex items-center gap-3 mb-3">
                        <span class="text-4xl font-black text-amber-500">@Model.PlayerRatingSummary.OverallAverage.ToString("F1")</span>
                        <div>
                            <div class="flex items-center gap-0.5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="material-symbols-outlined text-base @(i <= (int)Math.Round(Model.PlayerRatingSummary.OverallAverage) ? "text-amber-400" : "text-slate-300")"
                                          style="font-variation-settings:'FILL' 1">star</span>
                                }
                            </div>
                            <p class="text-xs text-slate-400">@Model.PlayerRatingSummary.ReviewCount đánh giá</p>
                        </div>
                    </div>
                    <div class="space-y-1 text-xs text-slate-500">
                        @if (Model.PlayerRatingSummary.AvgPunctuality.HasValue)
                        { <div class="flex justify-between"><span>Đúng giờ</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.PlayerRatingSummary.AvgPunctuality.Value.ToString("F1")</span></div> }
                        @if (Model.PlayerRatingSummary.AvgSportsmanship.HasValue)
                        { <div class="flex justify-between"><span>Tinh thần</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.PlayerRatingSummary.AvgSportsmanship.Value.ToString("F1")</span></div> }
                        @if (Model.PlayerRatingSummary.AvgSkillAccuracy.HasValue)
                        { <div class="flex justify-between"><span>Trình độ</span><span class="font-semibold text-slate-700 dark:text-slate-300">@Model.PlayerRatingSummary.AvgSkillAccuracy.Value.ToString("F1")</span></div> }
                    </div>
                }
            </div>
        </div>

        <!-- Review History -->
        @if (Model.ReceivedReviews.Any())
        {
            <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5">
                <h3 class="font-bold text-slate-900 dark:text-white mb-4">Lịch sử đánh giá nhận được</h3>
                <div class="space-y-4 max-h-96 overflow-y-auto pr-1">
                    @foreach (var review in Model.ReceivedReviews)
                    {
                        var typeLabel = review.ReviewType == "PlayerToMatch" ? "Người chơi → Host" : "Host → Người chơi";
                        var typeBg = review.ReviewType == "PlayerToMatch" ? "bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400" : "bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400";
                        <div class="flex gap-3 pb-4 border-b border-slate-100 dark:border-slate-800 last:border-0">
                            <img src="@(review.ReviewerAvatarUrl ?? "/images/avatar-default.png")"
                                 alt="" class="w-9 h-9 rounded-full object-cover flex-shrink-0 mt-0.5" />
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1 flex-wrap">
                                    <span class="font-semibold text-slate-800 dark:text-slate-200 text-sm">@review.ReviewerName</span>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full @typeBg">@typeLabel</span>
                                    <span class="text-xs text-slate-400">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yy")</span>
                                </div>
                                <p class="text-xs text-slate-500 mb-1">@review.MatchTitle • @review.MatchDate.ToString("dd/MM/yyyy")</p>
                                <div class="flex items-center gap-0.5 mb-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-sm @(i <= (int)Math.Round(review.AverageScore) ? "text-amber-400" : "text-slate-300")"
                                              style="font-variation-settings:'FILL' 1">star</span>
                                    }
                                    <span class="text-xs font-bold text-amber-500 ml-1">@review.AverageScore.ToString("F1")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <p class="text-sm text-slate-600 dark:text-slate-400 italic">"@review.Comment"</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
