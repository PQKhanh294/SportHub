@page
@model SportHub.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Cá nhân";
    var p = Model.Profile;
}

<section class="space-y-8">
    <div class="bg-white dark:bg-slate-900 rounded-xl p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-5">
                <img class="size-28 rounded-full border-4 border-white dark:border-slate-800 shadow-lg object-cover"
                     src="@p.AvatarUrl"
                     onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(p.FullName)&background=E2E8F0&color=1E293B';"
                     alt="User" />
                <div>
                    <h1 class="text-3xl font-bold">@p.FullName</h1>
                    <p class="text-slate-500 dark:text-slate-400">Thành viên từ @p.JoinedText</p>
                    <div class="flex gap-2 mt-2">
                        <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full">Người chơi xác thực</span>
                        <span class="px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full">Premium</span>
                    </div>
                </div>
            </div>
            <a asp-page="/Profile/Edit" class="px-5 py-2.5 rounded-lg bg-slate-100 dark:bg-slate-800 font-bold hover:bg-primary hover:text-white transition-colors">Chỉnh sửa hồ sơ</a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-4 space-y-6">
            <!-- Thông tin cá nhân -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="font-bold mb-4 text-lg">Thông tin cá nhân</h3>
                <div class="space-y-4 text-sm">
                    <div>
                        <span class="text-slate-400 block mb-1">Email</span>
                        <b class="text-slate-900 dark:text-white">@p.Email</b>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-1">Số điện thoại</span>
                        <b class="text-slate-900 dark:text-white">@p.PhoneNumber</b>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-1">Địa chỉ mặc định</span>
                        <b class="text-slate-900 dark:text-white">@p.DefaultAddress</b>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-1">Tham gia từ</span>
                        <b class="text-slate-900 dark:text-white">@p.JoinedText</b>
                    </div>
                </div>
            </div>

            <!-- Môn thể thao & Trình độ -->
            <div class="bg-white dark:bg-slate-900 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="font-bold mb-4 text-lg">Môn thể thao & Trình độ</h3>
                <div class="space-y-3">
                    @if (Model.SportProfiles.Any())
                    {
                        @foreach (var sp in Model.SportProfiles)
                        {
                            <div class="flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
                                <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                                    @if (sp.SportName.Contains("Cầu lông", StringComparison.OrdinalIgnoreCase) || sp.SportName.Contains("Badminton", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span>🏸</span>
                                    }
                                    else if (sp.SportName.Contains("Bóng đá", StringComparison.OrdinalIgnoreCase) || sp.SportName.Contains("Football", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span>⚽</span>
                                    }
                                    else if (sp.SportName.Contains("Bóng bàn", StringComparison.OrdinalIgnoreCase) || sp.SportName.Contains("Table Tennis", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span>🏓</span>
                                    }
                                    else if (sp.SportName.Contains("Tennis", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span>🎾</span>
                                    }
                                    else
                                    {
                                        <span>🎯</span>
                                    }
                                    @sp.SportName
                                </span>
                                <span class="text-xs px-2.5 py-1 bg-primary/10 text-primary font-bold rounded-full">@sp.SkillLevel</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-sm text-slate-500 text-center py-4">Chưa cập nhật môn thể thao.</p>
                    }
                </div>
            </div>

            <div class="bg-white dark:bg-slate-900 rounded-xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm">
                <h3 class="font-bold mb-4 text-lg">Huy hiá»‡u SportHub</h3>
                <div class="space-y-3">
                    @foreach (var badge in Model.Badges)
                    {
                        <div class="p-3 rounded-xl border @(badge.IsEarned ? "border-primary/30 bg-primary/5" : "border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50")">
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined @(badge.IsEarned ? "text-primary" : "text-slate-400")">@badge.Icon</span>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="font-black text-sm">@badge.Name</p>
                                        <span class="text-[10px] font-bold px-2 py-1 rounded-full @(badge.IsEarned ? "bg-primary text-white" : "bg-slate-200 dark:bg-slate-700 text-slate-500")">@badge.Level</span>
                                    </div>
                                    <p class="text-xs text-slate-500 mt-1">@badge.Description</p>
                                    <div class="mt-2 h-2 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden">
                                        <div class="h-full bg-primary" style="width:@badge.ProgressPercent%"></div>
                                    </div>
                                    <p class="text-[10px] text-slate-500 mt-1">@badge.ProgressValue / @badge.TargetValue</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                <p class="text-slate-400 text-xs font-bold uppercase tracking-wider">Trận đã chơi</p>
                <p class="text-4xl font-black mt-2">@p.MatchesPlayed</p>
            </div>
            <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                <p class="text-slate-400 text-xs font-bold uppercase tracking-wider">Trận thắng</p>
                <p class="text-4xl font-black mt-2 text-emerald-600">@p.Wins</p>
            </div>
            <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm text-center">
                <p class="text-slate-400 text-xs font-bold uppercase tracking-wider">Số lần đặt sân</p>
                <p class="text-4xl font-black mt-2 text-primary">@p.TotalBookings</p>
            </div>
        </div>
    </div>
</section>
