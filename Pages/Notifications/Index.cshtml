@page
@model SportHub.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications";
}

<section class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-4xl font-black tracking-tight">Thông báo</h1>
            <p class="text-slate-500 dark:text-slate-400">Cập nhật về đặt sân, thanh toán và trận đấu.</p>
        </div>
        <span id="notifications-unread-pill"
              class="px-3 py-1 bg-primary/10 text-primary font-bold rounded-full text-sm @(Model.UnreadCount > 0 ? "" : "hidden")">
            @Model.UnreadCount chưa đọc
        </span>
    </div>

    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
        @if (!Model.Notifications.Any())
        {
            <div id="notifications-empty" class="py-20 text-center text-slate-400">
                <span class="material-symbols-outlined text-5xl mb-3 block">notifications_none</span>
                <p class="font-semibold">Chưa có thông báo nào</p>
                <p class="text-sm mt-1">Các hoạt động sẽ hiện lên tại đây.</p>
            </div>
        }
        else
        {
            <div id="notifications-list" class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var n in Model.Notifications)
                {
                    var icon = n.Type switch {
                        "MatchJoin"         => ("person_add",    "text-amber-500"),
                        "MatchApprove"      => ("check_circle",  "text-emerald-500"),
                        "MatchReject"       => ("cancel",        "text-rose-500"),
                        "MatchJoinExpired"  => ("schedule",      "text-orange-500"),
                        "BookingConfirmed"  => ("calendar_today","text-primary"),
                        "BookingCancelled"  => ("event_busy",    "text-rose-400"),
                        _                   => ("notifications", "text-slate-400")
                    };
                    <article class="p-5 flex items-start gap-4 @(!n.IsRead ? "bg-primary/5 dark:bg-primary/10" : "")">
                        <span class="material-symbols-outlined @icon.Item2 mt-0.5 flex-shrink-0">@icon.Item1</span>
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-slate-900 dark:text-white">@n.Title</p>
                            <p class="text-sm text-slate-600 dark:text-slate-400 mt-0.5">@n.Message</p>
                            <p class="text-xs text-slate-400 mt-1">@n.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(n.LinkUrl))
                        {
                            <a href="@n.LinkUrl" class="shrink-0 text-xs font-bold text-primary hover:underline mt-1">Xem →</a>
                        }
                    </article>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const listEl = document.getElementById('notifications-list');
            const emptyEl = document.getElementById('notifications-empty');
            const unreadPill = document.getElementById('notifications-unread-pill');

            function iconFor(type) {
                switch (type) {
                    case 'MatchJoin': return { icon: 'person_add', cls: 'text-amber-500' };
                    case 'MatchApprove': return { icon: 'check_circle', cls: 'text-emerald-500' };
                    case 'MatchReject': return { icon: 'cancel', cls: 'text-rose-500' };
                    case 'MatchJoinExpired': return { icon: 'schedule', cls: 'text-orange-500' };
                    case 'BookingConfirmed': return { icon: 'calendar_today', cls: 'text-primary' };
                    case 'BookingCancelled': return { icon: 'event_busy', cls: 'text-rose-400' };
                    default: return { icon: 'notifications', cls: 'text-slate-400' };
                }
            }

            function formatDate(value) {
                const d = new Date(value);
                if (Number.isNaN(d.getTime())) return '';
                const dd = String(d.getDate()).padStart(2, '0');
                const mm = String(d.getMonth() + 1).padStart(2, '0');
                const yyyy = d.getFullYear();
                const hh = String(d.getHours()).padStart(2, '0');
                const min = String(d.getMinutes()).padStart(2, '0');
                return `${hh}:${min} ${dd}/${mm}/${yyyy}`;
            }

            function updateUnreadPill(unreadCount) {
                if (!unreadPill || unreadCount == null) return;
                const n = Number(unreadCount) || 0;
                if (n <= 0) {
                    unreadPill.classList.add('hidden');
                    unreadPill.textContent = '';
                } else {
                    unreadPill.classList.remove('hidden');
                    unreadPill.textContent = `${n} chưa đọc`;
                }
            }

            function prependNotification(payload) {
                if (!payload || !listEl) return;
                const icon = iconFor(payload.type);
                const article = document.createElement('article');
                article.className = 'p-5 flex items-start gap-4 bg-primary/5 dark:bg-primary/10';
                article.innerHTML = `
                    <span class="material-symbols-outlined ${icon.cls} mt-0.5 flex-shrink-0">${icon.icon}</span>
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-slate-900 dark:text-white">${payload.title || ''}</p>
                        <p class="text-sm text-slate-600 dark:text-slate-400 mt-0.5">${payload.message || ''}</p>
                        <p class="text-xs text-slate-400 mt-1">${formatDate(payload.createdAt)}</p>
                    </div>
                    ${payload.linkUrl ? `<a href="${payload.linkUrl}" class="shrink-0 text-xs font-bold text-primary hover:underline mt-1">Xem →</a>` : ''}
                `;
                listEl.prepend(article);
                if (emptyEl) emptyEl.classList.add('hidden');
            }

            window.addEventListener('sporthub:notification', function (ev) {
                const payload = ev.detail || {};
                prependNotification(payload);
                updateUnreadPill(payload.unreadCount);
            });
        })();
    </script>
}
