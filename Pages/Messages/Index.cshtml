@page
@model SportHub.Pages.Messages.IndexModel
@{
    ViewData["Title"] = "Tin nhắn";
}

<div class="max-w-6xl mx-auto h-[calc(100svh-140px)] md:h-[calc(100svh-140px)] min-h-[500px] flex bg-white dark:bg-slate-900 rounded-md overflow-hidden shadow-sm border border-slate-200 dark:border-slate-800 @(Model.ActiveChatUser != null ? "chat-mobile-fullscreen-wrap" : "")">

    <!-- Cột trái: Danh sách bạn bè -->
    <div class="w-full md:w-80 flex-shrink-0 border-r border-slate-200 dark:border-slate-800 flex flex-col @(Model.ActiveChatUser != null ? "hidden md:flex" : "flex")">
        <div class="p-4 border-b border-slate-200 dark:border-slate-800">
            <h2 class="text-xl font-black">Đoạn chat</h2>
            <div class="mt-4 relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>
                <input type="text" id="friend-search" placeholder="Tìm kiếm bạn bè..." class="w-full pl-10 pr-4 py-2 bg-slate-100 dark:bg-slate-800 rounded-md border-transparent focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" oninput="filterFriends(this.value)" />
            </div>
        </div>

        <div class="flex-1 overflow-y-auto p-2" id="friends-list">
            @if (!Model.Friends.Any())
            {
                <div class="text-center p-4 mt-4 text-slate-500">
                    <p class="mb-4">Bạn chưa có bạn bè nào.</p>
                    <a href="/Users/Index" class="inline-block px-4 py-2 bg-primary text-white font-bold rounded-md hover:bg-primary/90 transition-colors">Tìm bạn cộng đồng</a>
                </div>

                @if (Model.SuggestedFriends.Any())
                {
                    <div class="mt-8 px-4">
                        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Bạn bè đề cử</h3>
                        <div class="space-y-2">
                            @foreach (var suggestion in Model.SuggestedFriends)
                            {
                                <a href="/Users/Profile/@suggestion.UserID" class="flex items-center gap-3 p-2 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors border border-transparent hover:border-slate-200 dark:hover:border-slate-700 group">
                                    <img src="@(string.IsNullOrEmpty(suggestion.AvatarUrl) ? "/images/avatar-default.png" : suggestion.AvatarUrl)" class="w-10 h-10 rounded-full object-cover flex-shrink-0" />
                                    <div class="flex-1 min-w-0">
                                        <p class="font-bold text-sm text-slate-900 dark:text-white truncate group-hover:text-primary transition-colors">@suggestion.FullName</p>
                                        <p class="text-[10px] text-slate-500">Trình độ: @(suggestion.SkillLevel ?? "Chưa rõ")</p>
                                    </div>
                                    <span class="material-symbols-outlined text-[16px] text-slate-300 group-hover:text-primary transition-colors">person_add</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                @foreach (var friend in Model.Friends)
                {
                    var hasSummary = Model.ConversationSummaries.TryGetValue(friend.UserID, out var summary);
                    var lastMsg = hasSummary ? summary.LastMsg : null;
                    var unreadCount = hasSummary ? summary.UnreadCount : 0;
                    var isActive = Model.ActiveChatUser?.UserID == friend.UserID;

                    string previewText = "";
                    string statusLabel = "";
                    string statusClass = "";
                    if (lastMsg != null)
                    {
                        previewText = lastMsg.IsDeleted ? "Tin nhắn đã bị xóa"
                            : lastMsg.MessageType == "Image" ? "Đã gửi một ảnh"
                            : lastMsg.MessageType == "MatchCard" ? "Đã chia sẻ thẻ trận"
                            : (lastMsg.Content.Length > 35 ? lastMsg.Content[..35] + "…" : lastMsg.Content);

                        bool theySentLast = lastMsg.SenderID == friend.UserID;
                        bool iSentLast = lastMsg.SenderID == Model.CurrentUserId;

                        if (theySentLast && unreadCount > 0)
                        {
                            statusLabel = "· Chưa trả lời";
                            statusClass = "text-primary font-semibold";
                        }
                        else if (iSentLast && lastMsg.IsRead == false)
                        {
                            statusLabel = "· Chờ phản hồi";
                            statusClass = "text-slate-400";
                        }
                    }

                    <a href="/Messages?userId=@friend.UserID"
                       class="friend-row flex items-center gap-3 p-3 rounded-md transition-colors @(isActive ? "bg-primary/10" : "hover:bg-slate-50 dark:hover:bg-slate-800/50")"
                       data-name="@friend.FullName.ToLower()">
                        <div class="relative flex-shrink-0">
                            <div class="w-12 h-12 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden flex items-center justify-center font-bold text-slate-500">
                                @if (string.IsNullOrEmpty(friend.AvatarUrl))
                                {
                                    @friend.FullName[0]
                                }
                                else
                                {
                                    <img src="@friend.AvatarUrl" class="w-full h-full object-cover" />
                                }
                            </div>
                            @if (unreadCount > 0)
                            {
                                <span class="absolute -top-1 -right-1 w-5 h-5 bg-rose-500 text-white text-[9px] rounded-full flex items-center justify-center font-bold leading-none"
                                      id="unread-badge-@friend.UserID">
                                    @(unreadCount > 9 ? "9+" : unreadCount.ToString())
                                </span>
                            }
                            else
                            {
                                <span class="absolute -top-1 -right-1 w-5 h-5 bg-rose-500 text-white text-[9px] rounded-full items-center justify-center font-bold leading-none hidden"
                                      id="unread-badge-@friend.UserID">0</span>
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-slate-900 dark:text-white truncate">@friend.FullName</h4>
                            @if (!string.IsNullOrEmpty(previewText))
                            {
                                <div class="flex items-center gap-1 mt-0.5">
                                    <p class="text-xs text-slate-400 truncate" id="preview-@friend.UserID">@previewText</p>
                                    @if (!string.IsNullOrEmpty(statusLabel))
                                    {
                                        <span class="text-[10px] @statusClass shrink-0">@statusLabel</span>
                                    }
                                </div>
                            }
                        </div>
                        @if (lastMsg != null)
                        {
                            <span class="text-[10px] text-slate-400 shrink-0">
                                @(lastMsg.CreatedAt.Date == DateTime.Today
                                    ? lastMsg.CreatedAt.ToString("HH:mm")
                                    : lastMsg.CreatedAt.ToString("dd/MM"))
                            </span>
                        }
                    </a>
                }
            }
        </div>
    </div>

    <!-- Cột phải: Khung Chat -->
    <div class="flex-1 flex flex-col @(Model.ActiveChatUser == null ? "hidden md:flex" : "flex") @(Model.ActiveChatUser != null ? "chat-mobile-fullscreen" : "")">
        @if (Model.ActiveChatUser == null)
        {
            <div class="flex-1 flex flex-col items-center justify-center text-slate-400 bg-slate-50 dark:bg-slate-900/50">
                <span class="material-symbols-outlined text-7xl mb-4 opacity-50">chat_bubble</span>
                <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300">Tin nhắn của bạn</h3>
                <p>Chọn một người bạn để bắt đầu trò chuyện</p>
            </div>
        }
        else
        {
            <!-- Header chat -->
            <div class="h-16 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-4">
                <div class="flex items-center gap-3">
                    <a href="/Messages" class="md:hidden w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                        <span class="material-symbols-outlined">arrow_back</span>
                    </a>
                    <a href="/Users/Profile/@Model.ActiveChatUser.UserID" class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center font-bold text-primary overflow-hidden">
                            @if (string.IsNullOrEmpty(Model.ActiveChatUser.AvatarUrl))
                            {
                                @Model.ActiveChatUser.FullName[0]
                            }
                            else
                            {
                                <img src="@Model.ActiveChatUser.AvatarUrl" class="w-full h-full object-cover" />
                            }
                        </div>
                        <h3 class="font-bold text-lg">@Model.ActiveChatUser.FullName</h3>
                    </a>
                </div>
                <div class="flex items-center gap-1">
                    <button id="btn-search-conv" title="Tìm trong đoạn chat" onclick="toggleSearchPanel()"
                            class="w-9 h-9 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition-colors">
                        <span class="material-symbols-outlined text-[18px] text-slate-500">search</span>
                    </button>
                    <button id="btn-media-gallery" title="Ảnh đã chia sẻ" onclick="toggleMediaGallery()"
                            class="w-9 h-9 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition-colors">
                        <span class="material-symbols-outlined text-[18px] text-slate-500">photo_library</span>
                    </button>
                </div>
            </div>

            <!-- Pinned message banner -->
            <div id="pinned-banner" class="hidden px-4 py-2 bg-amber-50 dark:bg-amber-950 border-b border-amber-200 dark:border-amber-900 flex items-center gap-2 cursor-pointer"
                 onclick="scrollToPinnedMsg()">
                <span class="material-symbols-outlined text-amber-500 text-sm">push_pin</span>
                <p id="pinned-text" class="text-xs text-slate-700 dark:text-slate-200 truncate flex-1"></p>
                <button onclick="event.stopPropagation(); unpinMessage()" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-amber-200 dark:hover:bg-amber-800 transition-colors text-slate-500">
                    <span class="material-symbols-outlined text-[14px]">close</span>
                </button>
            </div>

            <!-- Search panel -->
            <div id="search-panel" class="hidden px-4 py-2 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <input id="conv-search-input" type="text" placeholder="Tìm tin nhắn..."
                           class="flex-1 bg-slate-100 dark:bg-slate-800 rounded-md px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary/50"
                           oninput="searchInConversation(this.value)" />
                    <button onclick="toggleSearchPanel()" class="text-slate-400 hover:text-slate-600">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                </div>
                <div id="search-results" class="mt-2 max-h-48 overflow-y-auto space-y-1"></div>
            </div>

            <!-- Media gallery panel -->
            <div id="media-gallery-panel" class="hidden border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <div class="px-4 py-2 flex items-center justify-between border-b border-slate-100 dark:border-slate-800">
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Ảnh đã chia sẻ</p>
                    <button onclick="toggleMediaGallery()" class="text-slate-400">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                </div>
                <div id="media-grid" class="grid grid-cols-4 gap-1 p-2 max-h-40 overflow-y-auto">
                    <div class="col-span-4 text-center text-xs text-slate-400 py-4" id="media-loading">Đang tải...</div>
                </div>
            </div>

            <!-- Booking proposal panel -->
            @if (Model.SharedMatchOptions.Any())
            {
                <div class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3">
                    <details class="group">
                        <summary class="cursor-pointer flex items-center justify-between gap-3 text-sm font-bold text-slate-700 dark:text-slate-200">
                            <span class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary">event_available</span>
                                Đề xuất đặt sân cho trận đã match
                            </span>
                            <span class="material-symbols-outlined group-open:rotate-180 transition-transform">expand_more</span>
                        </summary>
                        <form method="post" asp-page-handler="CreateProposal" class="mt-3 grid grid-cols-1 md:grid-cols-6 gap-2">
                            <input type="hidden" asp-for="ProposalInput.ReceiverId" value="@Model.ActiveChatUser.UserID" />
                            <select asp-for="ProposalInput.MatchId" asp-items="Model.SharedMatchOptions" class="md:col-span-2 rounded-md bg-slate-100 dark:bg-slate-800 border-none text-sm"></select>
                            <select asp-for="ProposalInput.CourtId" asp-items="Model.CourtOptions" class="md:col-span-2 rounded-md bg-slate-100 dark:bg-slate-800 border-none text-sm">
                                <option value="">Chưa chọn sân</option>
                            </select>
                            <input asp-for="ProposalInput.BookingDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="rounded-md bg-slate-100 dark:bg-slate-800 border-none text-sm" />
                            <input asp-for="ProposalInput.EstimatedCost" type="number" min="0" step="10000" placeholder="Giá dự kiến" class="rounded-md bg-slate-100 dark:bg-slate-800 border-none text-sm" />
                            <input asp-for="ProposalInput.StartTime" type="time" class="rounded-md bg-slate-100 dark:bg-slate-800 border-none text-sm" />
                            <input asp-for="ProposalInput.EndTime" type="time" class="rounded-md bg-slate-100 dark:bg-slate-800 border-none text-sm" />
                            <select asp-for="ProposalInput.SplitMode" class="rounded-md bg-slate-100 dark:bg-slate-800 border-none text-sm">
                                <option value="Equal">Chia đều</option>
                                <option value="HostPays">Host trả</option>
                            </select>
                            <input asp-for="ProposalInput.Note" placeholder="Ghi chú ngắn" class="md:col-span-2 rounded-md bg-slate-100 dark:bg-slate-800 border-none text-sm" />
                            <button type="submit" class="rounded-md bg-primary text-white font-bold text-sm px-4 py-2 hover:bg-primary/90 transition-colors flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-base">send</span>
                                Gửi
                            </button>
                        </form>
                    </details>
                </div>
            }

            @if (Model.BookingProposals.Any())
            {
                <div class="border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 px-4 py-3 overflow-x-auto">
                    <div class="flex gap-3 min-w-max">
                        @foreach (var proposal in Model.BookingProposals.Take(4))
                        {
                            var isReceiver = proposal.ReceiverID == Model.CurrentUserId;
                            <div class="w-72 rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 shadow-sm">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="font-black text-sm truncate">@(proposal.Match.Title ?? proposal.Match.MatchType)</p>
                                    <span class="text-[10px] font-bold px-2 py-1 rounded-md @(proposal.Status == "Accepted" ? "bg-emerald-100 text-emerald-700" : proposal.Status == "Rejected" ? "bg-rose-100 text-rose-700" : "bg-amber-100 text-amber-700")">@proposal.Status</span>
                                </div>
                                <p class="text-xs text-slate-500 mt-1">@proposal.BookingDate.ToString("dd/MM/yyyy") • @proposal.StartTime.ToString(@"hh\:mm") - @proposal.EndTime.ToString(@"hh\:mm")</p>
                                <p class="text-xs text-slate-500 truncate">@(proposal.Court?.Venue?.VenueName ?? "Chưa chọn sân")</p>
                                <p class="text-xs text-slate-500">@(proposal.EstimatedCost.HasValue ? $"{proposal.EstimatedCost.Value:N0} xu" : "Chưa có giá") • @(proposal.SplitMode == "HostPays" ? "Host trả" : "Chia đều")</p>
                                @if (isReceiver && proposal.Status == "Waiting")
                                {
                                    <div class="flex gap-2 mt-3">
                                        <form method="post" asp-page-handler="RespondProposal" asp-route-proposalId="@proposal.ProposalID" asp-route-userId="@proposal.SenderID" asp-route-status="Accepted" class="flex-1">
                                            <button type="submit" class="w-full rounded-md bg-emerald-500 text-white text-xs font-bold py-2">Đồng ý</button>
                                        </form>
                                        <form method="post" asp-page-handler="RespondProposal" asp-route-proposalId="@proposal.ProposalID" asp-route-userId="@proposal.SenderID" asp-route-status="Rejected" class="flex-1">
                                            <button type="submit" class="w-full rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-bold py-2">Từ chối</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Chat messages area with drag-drop support -->
            <div class="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50/50 dark:bg-slate-900/30" id="chat-messages"
                 ondragover="event.preventDefault(); this.classList.add('ring-2','ring-primary/40');"
                 ondragleave="this.classList.remove('ring-2','ring-primary/40');"
                 ondrop="handleMsgAreaDrop(event)">
                @foreach (var msg in Model.ChatHistory)
                {
                    bool isMine = msg.SenderID == Model.CurrentUserId;
                    string prevContent = msg.IsDeleted ? "Tin nhắn đã bị xóa" : (msg.Content.Length > 60 ? msg.Content[..60] + "…" : msg.Content);

                    <div class="flex @(isMine ? "justify-end" : "justify-start") items-end gap-1.5 group/msg" data-mid="@msg.MessageID">

                    @if (isMine)
                    {
                        @* ── ACTIONS bên TRÁI bubble của tôi ── *@
                        <div class="flex-shrink-0 relative self-center">
                            <div class="msg-actions opacity-0 group-hover/msg:opacity-100 transition-opacity flex items-center gap-0.5 bg-white dark:bg-slate-800 shadow-md rounded-full px-1.5 py-1">
                                <button class="w-7 h-7 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center react-btn" data-mid="@msg.MessageID" title="Cảm xúc">😊</button>
                                <button class="w-7 h-7 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center reply-btn" data-mid="@msg.MessageID" data-content="@prevContent" title="Trả lời">
                                    <span class="material-symbols-outlined text-[14px] text-slate-500">reply</span>
                                </button>
                                <button class="w-7 h-7 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center menu-btn" data-mid="@msg.MessageID" data-mine="true" title="Thêm">
                                    <span class="material-symbols-outlined text-[14px] text-slate-500">more_vert</span>
                                </button>
                            </div>
                            <div class="reaction-picker hidden absolute bottom-full mb-2 right-0 z-20 bg-white dark:bg-slate-800 shadow-xl rounded-full px-2 py-1.5 flex items-center gap-1" data-mid="@msg.MessageID">
                                @foreach (var (emoji, rtype) in new[] { ("❤️","Heart"),("😆","Laugh"),("😮","Wow"),("😢","Sad"),("😠","Angry"),("👍","Like") })
                                {
                                    <button class="w-8 h-8 text-lg hover:scale-125 transition-transform react-pick" data-mid="@msg.MessageID" data-type="@rtype">@emoji</button>
                                }
                            </div>
                            <div class="msg-menu hidden absolute bottom-full mb-2 right-0 z-20 bg-white dark:bg-slate-800 shadow-xl rounded-md py-1 w-44 border border-slate-100 dark:border-slate-700" data-mid="@msg.MessageID">
                                @if (!msg.IsDeleted)
                                {
                                    <button class="w-full px-4 py-2 text-left text-sm hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-2 pin-btn" data-mid="@msg.MessageID">
                                        <span class="material-symbols-outlined text-[14px]">push_pin</span> Ghim
                                    </button>
                                    <button class="w-full px-4 py-2 text-left text-sm hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-2 forward-btn" data-mid="@msg.MessageID" data-content="@System.Web.HttpUtility.HtmlAttributeEncode(prevContent)">
                                        <span class="material-symbols-outlined text-[14px]">forward</span> Chuyển tiếp
                                    </button>
                                    <button class="w-full px-4 py-2 text-left text-sm hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-2 text-rose-500 delete-btn" data-mid="@msg.MessageID">
                                        <span class="material-symbols-outlined text-[14px]">delete</span> Xóa
                                    </button>
                                }
                            </div>
                        </div>

                        @* ── BUBBLE COLUMN bên PHẢI ── *@
                        <div class="bubble-col flex flex-col items-end max-w-[65%]">
                            @if (msg.IsDeleted)
                            {
                                <div class="px-4 py-2 rounded-md bg-slate-100 dark:bg-slate-800 border border-dashed border-slate-300 dark:border-slate-600">
                                    <p class="text-sm text-slate-400 italic">Tin nhắn đã bị xóa</p>
                                    <p class="text-[10px] mt-1 opacity-50 text-right">@msg.CreatedAt.ToString("HH:mm")</p>
                                </div>
                            }
                            else if (msg.MessageType == "Image" && !string.IsNullOrEmpty(msg.ImageUrl))
                            {
                                <div>
                                    @if (msg.ReplyToMessage != null)
                                    {
                                        <div class="text-[10px] text-slate-400 bg-slate-100 dark:bg-slate-700 rounded-md px-2 py-1 mb-1 truncate border-l-2 border-primary">
                                            <span class="font-bold">↩ Trả lời:</span> @(msg.ReplyToMessage.Content.Length > 40 ? msg.ReplyToMessage.Content[..40] + "…" : msg.ReplyToMessage.Content)
                                        </div>
                                    }
                                    <img src="@msg.ImageUrl" class="rounded-md max-w-full shadow-sm cursor-pointer" onclick="window.open(this.src)" />
                                    <p class="text-[10px] mt-1 opacity-70 text-right">@msg.CreatedAt.ToString("HH:mm")</p>
                                </div>
                            }
                            else if (msg.MessageType == "MatchCard" && !string.IsNullOrEmpty(msg.MatchCardJson))
                            {
                                <div class="max-w-[280px]">
                                    @if (msg.ReplyToMessage != null)
                                    {
                                        <div class="text-[10px] text-slate-400 bg-slate-100 dark:bg-slate-700 rounded-md px-2 py-1 mb-1 truncate border-l-2 border-primary">
                                            <span class="font-bold">↩ Trả lời:</span> @(msg.ReplyToMessage.Content.Length > 40 ? msg.ReplyToMessage.Content[..40] + "…" : msg.ReplyToMessage.Content)
                                        </div>
                                    }
                                    @Html.Raw(RenderMatchCard(msg.MatchCardJson, isMine))
                                    <p class="text-[10px] mt-1 opacity-70 text-right">@msg.CreatedAt.ToString("HH:mm")</p>
                                </div>
                            }
                            else
                            {
                                <div class="bg-primary text-white px-4 py-2 rounded-md shadow-sm">
                                    @if (msg.ReplyToMessage != null)
                                    {
                                        var replyText = msg.ReplyToMessage.IsDeleted ? "Tin nhắn đã bị xóa" :
                                            (msg.ReplyToMessage.Content.Length > 50 ? msg.ReplyToMessage.Content[..50] + "…" : msg.ReplyToMessage.Content);
                                        <div class="text-[10px] text-white/80 bg-black/10 rounded-md px-2 py-1 mb-1.5 border-l-2 border-white/60 truncate">
                                            ↩ @replyText
                                        </div>
                                    }
                                    <p class="text-sm">@msg.Content</p>
                                    <p class="text-[10px] mt-1 text-right flex items-center justify-end gap-1 text-white/70">
                                        @msg.CreatedAt.ToString("HH:mm")
                                        <span class="read-receipt @(msg.IsRead ? "text-white" : "text-white/50")" data-mid="@msg.MessageID">@(msg.IsRead ? "✓✓" : "✓")</span>
                                    </p>
                                </div>
                            }
                            <div class="reactions-bar flex flex-wrap gap-1 mt-1 justify-end" data-mid="@msg.MessageID"></div>
                        </div>
                    }
                    else
                    {
                        @* ── BUBBLE COLUMN bên TRÁI ── *@
                        <div class="bubble-col flex flex-col items-start max-w-[65%]">
                            @if (msg.IsDeleted)
                            {
                                <div class="px-4 py-2 rounded-md bg-slate-100 dark:bg-slate-800 border border-dashed border-slate-300 dark:border-slate-600">
                                    <p class="text-sm text-slate-400 italic">Tin nhắn đã bị xóa</p>
                                    <p class="text-[10px] mt-1 opacity-50">@msg.CreatedAt.ToString("HH:mm")</p>
                                </div>
                            }
                            else if (msg.MessageType == "Image" && !string.IsNullOrEmpty(msg.ImageUrl))
                            {
                                <div>
                                    @if (msg.ReplyToMessage != null)
                                    {
                                        <div class="text-[10px] text-slate-400 bg-slate-100 dark:bg-slate-700 rounded-md px-2 py-1 mb-1 truncate border-l-2 border-primary">
                                            <span class="font-bold">↩ Trả lời:</span> @(msg.ReplyToMessage.Content.Length > 40 ? msg.ReplyToMessage.Content[..40] + "…" : msg.ReplyToMessage.Content)
                                        </div>
                                    }
                                    <img src="@msg.ImageUrl" class="rounded-md max-w-full shadow-sm cursor-pointer" onclick="window.open(this.src)" />
                                    <p class="text-[10px] mt-1 opacity-70">@msg.CreatedAt.ToString("HH:mm")</p>
                                </div>
                            }
                            else if (msg.MessageType == "MatchCard" && !string.IsNullOrEmpty(msg.MatchCardJson))
                            {
                                <div class="max-w-[280px]">
                                    @if (msg.ReplyToMessage != null)
                                    {
                                        <div class="text-[10px] text-slate-400 bg-slate-100 dark:bg-slate-700 rounded-md px-2 py-1 mb-1 truncate border-l-2 border-primary">
                                            <span class="font-bold">↩ Trả lời:</span> @(msg.ReplyToMessage.Content.Length > 40 ? msg.ReplyToMessage.Content[..40] + "…" : msg.ReplyToMessage.Content)
                                        </div>
                                    }
                                    @Html.Raw(RenderMatchCard(msg.MatchCardJson, isMine))
                                    <p class="text-[10px] mt-1 opacity-70">@msg.CreatedAt.ToString("HH:mm")</p>
                                </div>
                            }
                            else
                            {
                                <div class="bg-slate-200 dark:bg-slate-800 text-slate-900 dark:text-white px-4 py-2 rounded-md shadow-sm">
                                    @if (msg.ReplyToMessage != null)
                                    {
                                        var replyText2 = msg.ReplyToMessage.IsDeleted ? "Tin nhắn đã bị xóa" :
                                            (msg.ReplyToMessage.Content.Length > 50 ? msg.ReplyToMessage.Content[..50] + "…" : msg.ReplyToMessage.Content);
                                        <div class="text-[10px] text-slate-500 bg-black/10 rounded-md px-2 py-1 mb-1.5 border-l-2 border-primary truncate">
                                            ↩ @replyText2
                                        </div>
                                    }
                                    <p class="text-sm">@msg.Content</p>
                                    <p class="text-[10px] mt-1 opacity-70">@msg.CreatedAt.ToString("HH:mm")</p>
                                </div>
                            }
                            <div class="reactions-bar flex flex-wrap gap-1 mt-1" data-mid="@msg.MessageID"></div>
                        </div>

                        @* ── ACTIONS bên PHẢI bubble đối phương ── *@
                        <div class="flex-shrink-0 relative self-center">
                            <div class="msg-actions opacity-0 group-hover/msg:opacity-100 transition-opacity flex items-center gap-0.5 bg-white dark:bg-slate-800 shadow-md rounded-full px-1.5 py-1">
                                <button class="w-7 h-7 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center react-btn" data-mid="@msg.MessageID" title="Cảm xúc">😊</button>
                                <button class="w-7 h-7 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center reply-btn" data-mid="@msg.MessageID" data-content="@prevContent" title="Trả lời">
                                    <span class="material-symbols-outlined text-[14px] text-slate-500">reply</span>
                                </button>
                                <button class="w-7 h-7 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center menu-btn" data-mid="@msg.MessageID" data-mine="false" title="Thêm">
                                    <span class="material-symbols-outlined text-[14px] text-slate-500">more_vert</span>
                                </button>
                            </div>
                            <div class="reaction-picker hidden absolute bottom-full mb-2 left-0 z-20 bg-white dark:bg-slate-800 shadow-xl rounded-full px-2 py-1.5 flex items-center gap-1" data-mid="@msg.MessageID">
                                @foreach (var (emoji, rtype) in new[] { ("❤️","Heart"),("😆","Laugh"),("😮","Wow"),("😢","Sad"),("😠","Angry"),("👍","Like") })
