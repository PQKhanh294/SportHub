@section Scripts {
    <script>
        if (typeof setChatBadge === 'function') setChatBadge(0);
        var activeBadge = document.getElementById('unread-badge-@(Model.ActiveChatUser?.UserID ?? 0)');
        if (activeBadge) activeBadge.style.display = 'none';

        function filterFriends(q) {
            q = q.toLowerCase();
            document.querySelectorAll('.friend-row').forEach(function(row) {
                var name = row.getAttribute('data-name') || '';
                row.style.display = name.includes(q) ? '' : 'none';
            });
        }
    </script>
    @if (Model.ActiveChatUser != null)
    {
        <script>
            const chatMessages = document.getElementById("chat-messages");
            if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;

            // Mobile: giữ khung chat fullscreen đúng chiều cao viewport thật khi bàn phím ảo mở
            (function () {
                if (!window.visualViewport) return;
                var el = document.querySelector('.chat-mobile-fullscreen');
                if (!el) return;
                function adjust() {
                    if (window.innerWidth >= 768) { el.style.top = ''; el.style.height = ''; return; }
                    var vv = window.visualViewport;
                    el.style.top = vv.offsetTop + 'px';
                    el.style.height = vv.height + 'px';
                }
                window.visualViewport.addEventListener('resize', adjust);
                window.visualViewport.addEventListener('scroll', adjust);
                adjust();
            })();

            const chatConnection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/chat")
                .withAutomaticReconnect()
                .build();

            const currentUserId = @Model.CurrentUserId;
            const activeReceiverId = @Model.ActiveChatUser.UserID;

            var pendingMatchCard = null;
            var replyToMessageId = null;
            var pendingReportMsgId = null;
            var pendingForwardMsgId = null;
            var typingTimer = null;
            var isTyping = false;
            var openReactionPicker = null;
            var openMsgMenu = null;

            // ---- SignalR event handlers ----
            chatConnection.on("ReceiveMessage", function(msg) {
                if (msg.senderID === activeReceiverId) {
                    appendMessage(msg, false);
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                    // Auto mark as read via REST + SignalR (dual path)
                    fetch('/api/chat/mark-read?userId=' + activeReceiverId, { method: 'POST' })
                        .then(r => r.json()).then(d => { if (typeof setChatBadge === 'function') setChatBadge(d.count || 0); });
                    chatConnection.invoke('MarkMessagesRead', activeReceiverId).catch(()=>{});
                } else {
                    updateFriendPreview(msg.senderID, msg.content, msg.messageType);
                    incrementFriendBadge(msg.senderID);
                }
            });

            chatConnection.on("MessageSent", function(msg) {
                if (msg.receiverID === activeReceiverId) {
                    appendMessage(msg, true);
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }
            });

            // Read receipt: activeReceiverId read our messages
            chatConnection.on("MessagesRead", function(payload) {
                if (payload.readerId === activeReceiverId) {
                    document.querySelectorAll('.read-receipt').forEach(function(el) {
                        if (el.textContent === '✓') {
                            el.textContent = '✓✓';
                            el.classList.remove('text-white/50');
                            el.classList.add('text-white');
                        }
                    });
                }
            });

            chatConnection.on("UserTyping", function(senderId) {
                if (senderId === activeReceiverId) {
                    document.getElementById('typing-indicator').classList.remove('hidden');
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                }
            });

            chatConnection.on("UserStoppedTyping", function(senderId) {
                if (senderId === activeReceiverId)
                    document.getElementById('typing-indicator').classList.add('hidden');
            });

            chatConnection.on("ReactionUpdated", function(payload) {
                updateReactionsBar(payload.messageId, payload.reactions);
            });

            chatConnection.on("MessageDeleted", function(payload) {
                var row = document.querySelector('[data-mid="' + payload.messageId + '"]');
                if (!row) return;
                var bubbleCol = row.querySelector('.bubble-col');
                if (bubbleCol) {
                    var firstChild = bubbleCol.firstElementChild;
                    if (firstChild) firstChild.outerHTML = '<div class="px-4 py-2 rounded-md border border-dashed border-slate-300 dark:border-slate-600 bg-slate-100 dark:bg-slate-800"><p class="text-sm text-slate-400 italic">Tin nhắn đã bị xóa</p></div>';
                }
            });

            chatConnection.on("MessagePinned", function(payload) {
                var banner = document.getElementById('pinned-banner');
                var text = document.getElementById('pinned-text');
                if (payload.isPinned) {
                    text.textContent = payload.previewText;
                    banner.classList.remove('hidden');
                    banner.classList.add('flex');
                    banner.dataset.mid = payload.messageId;
                } else {
                    banner.classList.add('hidden');
                    banner.classList.remove('flex');
                }
            });


            chatConnection.on("ForwardError", function(payload) {
                showToast(payload.error || "Không thể chuyển tiếp tin nhắn này.", true);
                closeForwardModal();
            });

            chatConnection.start().then(function() {
                // Load pinned message
                fetch('/api/chat/pinned?userId=' + activeReceiverId)
                    .then(r => r.json()).then(d => {
                        if (d) {
                            var banner = document.getElementById('pinned-banner');
                            document.getElementById('pinned-text').textContent = d.content;
                            banner.dataset.mid = d.messageID;
                            banner.classList.remove('hidden');
                            banner.classList.add('flex');
                        }
                    }).catch(()=>{});

                // Mark messages from activeReceiverId as read via hub (real-time)
                chatConnection.invoke('MarkMessagesRead', activeReceiverId).catch(()=>{});
            }).catch(err => console.error(err.toString()));

            // ---- Typing indicator ----
            document.getElementById('chat-input').addEventListener('input', function() {
                if (!isTyping) {
                    isTyping = true;
                    chatConnection.invoke('TypingStart', activeReceiverId).catch(()=>{});
                }
                clearTimeout(typingTimer);
                typingTimer = setTimeout(function() {
                    isTyping = false;
                    chatConnection.invoke('TypingStop', activeReceiverId).catch(()=>{});
                }, 1500);
            });

            // ---- Form submit ----
            document.getElementById("chat-form").addEventListener("submit", async function(e) {
                e.preventDefault();
                const input = document.getElementById("chat-input");
                const content = input.value.trim();
                const receiverId = parseInt(document.getElementById("receiver-id").value);
                if (chatConnection.state !== signalR.HubConnectionState.Connected) return;

                if (isTyping) {
                    isTyping = false;
                    clearTimeout(typingTimer);
                    chatConnection.invoke('TypingStop', receiverId).catch(()=>{});
                }

                if (pendingMatchCard) {
                    await chatConnection.invoke("SendMatchCard", receiverId, pendingMatchCard.matchId).catch(()=>{});
                    clearMatchCard(); input.value = ""; input.focus(); return;
                }

                const fileInput = document.getElementById("chat-file");
                if (fileInput._pendingFile) {
                    await uploadAndSendImage(receiverId, fileInput._pendingFile);
                    fileInput._pendingFile = null; clearChatImage(); input.value = ""; input.focus(); return;
                }

                if (content) {
                    await chatConnection.invoke("SendMessage", receiverId, content, replyToMessageId || null).catch(()=>{});
                    cancelReply();
                    input.value = ""; input.focus();
                }
            });

            async function uploadAndSendImage(receiverId, file) {
                const formData = new FormData();
                formData.append("file", file);
                try {
                    const res = await fetch("/api/chat/upload-image", { method: "POST", body: formData });
                    if (!res.ok) { alert("Lỗi upload ảnh."); return; }
                    const data = await res.json();
                    await chatConnection.invoke("SendImage", receiverId, data.url).catch(()=>{});
                } catch (ex) { console.error(ex); }
            }

            // ---- Event delegation on chat messages ----
            document.getElementById('chat-messages').addEventListener('click', function(e) {
                var reactBtn = e.target.closest('.react-btn');
                var replyBtn = e.target.closest('.reply-btn');
                var menuBtn  = e.target.closest('.menu-btn');
                var reactPick = e.target.closest('.react-pick');
                var pinBtn   = e.target.closest('.pin-btn');
                var deleteBtn = e.target.closest('.delete-btn');
                var reportBtn = e.target.closest('.report-btn');
                var forwardBtn = e.target.closest('.forward-btn');

                // Close any open picker/menu first
                if (!e.target.closest('.reaction-picker') && !e.target.closest('.react-btn')) closeReactionPicker();
                if (!e.target.closest('.msg-menu') && !e.target.closest('.menu-btn')) closeMsgMenu();

                if (reactBtn) {
                    var mid = reactBtn.dataset.mid;
                    var picker = document.querySelector('.reaction-picker[data-mid="' + mid + '"]');
                    if (picker) {
                        var wasHidden = picker.classList.contains('hidden');
                        closeReactionPicker();
                        if (wasHidden) {
                            picker.classList.remove('hidden');
                            var r = reactBtn.getBoundingClientRect();
                            picker.style.cssText = 'position:fixed;z-index:9999;bottom:' + (window.innerHeight - r.top + 6) + 'px;right:' + (window.innerWidth - r.right) + 'px;left:auto;top:auto;';
                            openReactionPicker = picker;
                        }
                    }
                    return;
                }
                if (reactPick) {
                    var mid = reactPick.dataset.mid;
                    var rtype = reactPick.dataset.type;
                    chatConnection.invoke('ReactToMessage', parseInt(mid), activeReceiverId, rtype).catch(()=>{});
                    closeReactionPicker();
                    return;
                }
                if (replyBtn) {
                    replyToMessageId = parseInt(replyBtn.dataset.mid);
                    document.getElementById('reply-preview-text').textContent = replyBtn.dataset.content;
                    document.getElementById('reply-bar').classList.remove('hidden');
                    document.getElementById('reply-bar').classList.add('flex');
                    document.getElementById('chat-input').focus();
                    return;
                }
                if (menuBtn) {
                    var mid = menuBtn.dataset.mid;
                    var menu = document.querySelector('.msg-menu[data-mid="' + mid + '"]');
                    if (menu) {
                        var wasHidden = menu.classList.contains('hidden');
                        closeMsgMenu();
                        if (wasHidden) {
                            menu.classList.remove('hidden');
                            var r = menuBtn.getBoundingClientRect();
                            menu.style.cssText = 'position:fixed;z-index:9999;bottom:' + (window.innerHeight - r.top + 6) + 'px;right:' + (window.innerWidth - r.right) + 'px;left:auto;top:auto;';
                            openMsgMenu = menu;
                        }
                    }
                    return;
                }
                if (pinBtn) {
                    var mid = parseInt(pinBtn.dataset.mid);
                    chatConnection.invoke('PinMessage', mid, activeReceiverId).catch(()=>{});
                    closeMsgMenu();
                    return;
                }
                if (deleteBtn) {
                    var mid = parseInt(deleteBtn.dataset.mid);
                    openDeleteConfirm(mid);
                    closeMsgMenu();
                    return;
                }
                if (reportBtn) {
                    pendingReportMsgId = parseInt(reportBtn.dataset.mid);
                    document.getElementById('report-msg-preview').textContent = reportBtn.dataset.content || '';
                    document.getElementById('report-modal').classList.remove('hidden');
                    closeMsgMenu();
                    return;
                }
                if (forwardBtn) {
                    pendingForwardMsgId = parseInt(forwardBtn.dataset.mid);
                    document.getElementById('forward-preview').textContent = forwardBtn.dataset.content;
                    document.getElementById('forward-modal').classList.remove('hidden');
                    closeMsgMenu();
                    return;
                }
            });

            function closeReactionPicker() {
                if (openReactionPicker) { openReactionPicker.classList.add('hidden'); openReactionPicker.style.cssText = ''; openReactionPicker = null; }
            }
            function closeMsgMenu() {
                if (openMsgMenu) { openMsgMenu.classList.add('hidden'); openMsgMenu.style.cssText = ''; openMsgMenu = null; }
            }

            document.getElementById('chat-messages').addEventListener('scroll', function() {
                closeReactionPicker(); closeMsgMenu();
            }, { passive: true });

            // Forward friend selection
            document.querySelectorAll('.forward-friend-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var uid = parseInt(btn.dataset.uid);
                    if (!pendingForwardMsgId) return;
                    chatConnection.invoke('ForwardMessage', pendingForwardMsgId, uid).catch(()=>{});
                    closeForwardModal();
                    showToast('Đã chuyển tiếp tin nhắn!');
                });
            });

            window.closeForwardModal = function() {
                document.getElementById('forward-modal').classList.add('hidden');
                pendingForwardMsgId = null;
            };
            window.closeReportModal = function() {
                document.getElementById('report-modal').classList.add('hidden');
                pendingReportMsgId = null;
                document.getElementById('report-reason').value = '';
            };
            window.submitReport = async function() {
                if (!pendingReportMsgId) return;
                var reason = document.getElementById('report-reason').value.trim();
                try {
                    var r = await fetch('/api/chat/messages/' + pendingReportMsgId + '/report', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ reason })
                    });
                    if (r.ok) { showToast('Đã gửi báo cáo tới admin.'); }
                    else showToast('Không thể gửi báo cáo.', true);
                } catch { showToast('Lỗi kết nối.', true); }
                closeReportModal();
            };

            // Pin / unpin
            window.scrollToPinnedMsg = function() {
                var banner = document.getElementById('pinned-banner');
                var mid = banner.dataset.mid;
                if (!mid) return;
                var row = document.querySelector('[data-mid="' + mid + '"]');
                if (row) row.scrollIntoView({ behavior: 'smooth', block: 'center' });
            };
            window.unpinMessage = function() {
                var banner = document.getElementById('pinned-banner');
                var mid = parseInt(banner.dataset.mid || '0');
                if (!mid) return;
                chatConnection.invoke('PinMessage', mid, activeReceiverId).catch(()=>{});
            };

            // Search in conversation
            window.toggleSearchPanel = function() {
                var panel = document.getElementById('search-panel');
                panel.classList.toggle('hidden');
                if (!panel.classList.contains('hidden')) document.getElementById('conv-search-input').focus();
            };
            var searchDebounce = null;
            window.searchInConversation = function(q) {
                clearTimeout(searchDebounce);
                searchDebounce = setTimeout(async function() {
                    var resultsEl = document.getElementById('search-results');
                    if (!q.trim()) { resultsEl.innerHTML = ''; return; }
                    var r = await fetch('/api/chat/search?userId=' + activeReceiverId + '&q=' + encodeURIComponent(q));
                    var data = await r.json();
                    if (!data.length) { resultsEl.innerHTML = '<p class="text-xs text-slate-400 px-2">Không tìm thấy</p>'; return; }
                    resultsEl.innerHTML = data.map(function(m) {
                        var hl = m.content.replace(new RegExp('(' + escHtml(q) + ')', 'gi'), '<mark class="bg-yellow-200 dark:bg-yellow-800">$1</mark>');
                        return '<div class="px-2 py-1.5 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer text-xs" onclick="scrollToMsg(' + m.messageID + ')">' + hl + '</div>';
                    }).join('');
                }, 300);
            };
            window.scrollToMsg = function(mid) {
                var row = document.querySelector('[data-mid="' + mid + '"]');
                if (row) { row.scrollIntoView({ behavior: 'smooth', block: 'center' }); row.classList.add('ring-2', 'ring-primary/40'); setTimeout(()=>row.classList.remove('ring-2','ring-primary/40'), 1500); }
            };

            // Media gallery
            window.toggleMediaGallery = function() {
                var panel = document.getElementById('media-gallery-panel');
                panel.classList.toggle('hidden');
                if (!panel.classList.contains('hidden')) loadMediaGallery();
            };
            window.loadMediaGallery = async function() {
                var grid = document.getElementById('media-grid');
                grid.innerHTML = '<div class="col-span-4 text-center text-xs text-slate-400 py-4">Đang tải...</div>';
                try {
                    var r = await fetch('/api/chat/media?userId=' + activeReceiverId);
                    var data = await r.json();
                    if (!data.length) { grid.innerHTML = '<div class="col-span-4 text-center text-xs text-slate-400 py-4">Chưa có ảnh nào.</div>'; return; }
                    grid.innerHTML = data.map(function(m) {
                        return '<img src="' + escHtml(m.imageUrl) + '" class="w-full aspect-square object-cover rounded-md cursor-pointer hover:opacity-90 transition-opacity" onclick="window.open(\'' + escHtml(m.imageUrl) + '\')" />';
                    }).join('');
                } catch { grid.innerHTML = '<div class="col-span-4 text-center text-xs text-slate-400 py-4">Lỗi tải ảnh.</div>'; }
            };

            // Reactions bar update
            function updateReactionsBar(messageId, reactions) {
                var bar = document.querySelector('.reactions-bar[data-mid="' + messageId + '"]');
                if (!bar) return;
                bar.innerHTML = '';
                var emojiMap = { Heart:'❤️', Laugh:'😆', Wow:'😮', Sad:'😢', Angry:'😠', Like:'👍' };
                Object.entries(reactions).forEach(function([type, users]) {
                    if (!users.length) return;
                    var btn = document.createElement('button');
                    btn.className = 'flex items-center gap-0.5 px-1.5 py-0.5 bg-white dark:bg-slate-800 rounded-full text-xs shadow border border-slate-200 dark:border-slate-700 hover:scale-105 transition-transform';
                    btn.innerHTML = (emojiMap[type] || '?') + ' <span>' + users.length + '</span>';
                    btn.onclick = function() { chatConnection.invoke('ReactToMessage', messageId, activeReceiverId, type).catch(()=>{}); };
                    bar.appendChild(btn);
                });
            }

            // Reply
            window.cancelReply = function() {
                replyToMessageId = null;
                document.getElementById('reply-bar').classList.add('hidden');
                document.getElementById('reply-bar').classList.remove('flex');
            };

            // ---- File / drag helpers ----
            window.handleChatFile = function(input) {
                var file = input.files[0];
                if (!file) return;
                if (file.size > 5 * 1024 * 1024) { alert("Ảnh quá lớn. Tối đa 5MB."); input.value = ""; return; }
                input._pendingFile = file;
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById("chat-img-thumb").src = e.target.result;
                    document.getElementById("chat-img-name").textContent = file.name;
                    document.getElementById("chat-img-preview-bar").classList.remove("hidden");
                    document.getElementById("chat-img-preview-bar").classList.add("flex");
                    document.getElementById("chat-match-preview-bar").classList.add("hidden");
                    document.getElementById("chat-match-preview-bar").classList.remove("flex");
                };
                reader.readAsDataURL(file);
                input.value = "";
            };
            window.clearChatImage = function() {
                document.getElementById("chat-file")._pendingFile = null;
                document.getElementById("chat-img-preview-bar").classList.add("hidden");
                document.getElementById("chat-img-preview-bar").classList.remove("flex");
            };
            window.handleChatPaste = function(e) {
                var items = e.clipboardData && e.clipboardData.items;
                if (!items) return;
                for (var i = 0; i < items.length; i++) {
                    if (items[i].type.indexOf("image") !== -1) {
                        e.preventDefault();
                        var file = items[i].getAsFile();
                        if (file) {
                            document.getElementById("chat-file")._pendingFile = file;
                            var reader = new FileReader();
                            reader.onload = function(ev) {
                                document.getElementById("chat-img-thumb").src = ev.target.result;
                                document.getElementById("chat-img-name").textContent = "image_pasted.png";
                                document.getElementById("chat-img-preview-bar").classList.remove("hidden");
                                document.getElementById("chat-img-preview-bar").classList.add("flex");
                            };
                            reader.readAsDataURL(file);
                        }
                        break;
                    }
                }
            };
            window.handleMsgAreaDrop = function(e) {
                e.preventDefault();
                document.getElementById("chat-messages").classList.remove("ring-2", "ring-primary/40");
                var matchJson = e.dataTransfer.getData("application/match-card");
                if (matchJson) {
                    try {
                        var match = JSON.parse(matchJson);
                        pendingMatchCard = { matchId: match.id, title: match.title };
                        document.getElementById("chat-match-preview-title").textContent = match.title || match.type;
                        document.getElementById("chat-match-preview-bar").classList.remove("hidden");
                        document.getElementById("chat-match-preview-bar").classList.add("flex");
                        document.getElementById("chat-img-preview-bar").classList.add("hidden");
                        document.getElementById("chat-img-preview-bar").classList.remove("flex");
                    } catch(ex) {}
                    return;
                }
                var files = e.dataTransfer.files;
                if (files && files.length > 0) {
                    var file = files[0];
                    if (!file.type.startsWith("image/")) { alert("Chỉ hỗ trợ ảnh."); return; }
                    if (file.size > 5 * 1024 * 1024) { alert("Ảnh quá lớn. Tối đa 5MB."); return; }
                    document.getElementById("chat-file")._pendingFile = file;
                    var reader = new FileReader();
                    reader.onload = function(ev) {
                        document.getElementById("chat-img-thumb").src = ev.target.result;
                        document.getElementById("chat-img-name").textContent = file.name;
                        document.getElementById("chat-img-preview-bar").classList.remove("hidden");
                        document.getElementById("chat-img-preview-bar").classList.add("flex");
                    };
                    reader.readAsDataURL(file);
                }
            };
            window.clearMatchCard = function() {
                pendingMatchCard = null;
                document.getElementById("chat-match-preview-bar").classList.add("hidden");
                document.getElementById("chat-match-preview-bar").classList.remove("flex");
            };

            // ---- appendMessage ----
            function appendMessage(msg, isMine) {
                var mid = msg.messageID;
                var previewContent = msg.content ? (msg.content.length > 60 ? msg.content.substring(0,60)+'…' : msg.content) : '';

                var container = document.createElement("div");
                container.className = "flex " + (isMine ? "justify-end" : "justify-start") + " items-end gap-1.5 group/msg";
                container.dataset.mid = mid;

                // Build actions wrapper (picker/menu open upward)
                function buildActionsWrapper(pickerAlign) {
                    var wrap = document.createElement("div");
                    wrap.className = "flex-shrink-0 relative self-center";

                    var bar = document.createElement("div");
                    bar.className = "msg-actions opacity-0 group-hover/msg:opacity-100 transition-opacity flex items-center gap-0.5 bg-white dark:bg-slate-800 shadow-md rounded-full px-1.5 py-1";
                    bar.innerHTML = [
                        '<button class="w-7 h-7 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center react-btn" data-mid="'+mid+'">😊</button>',
                        '<button class="w-7 h-7 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center reply-btn" data-mid="'+mid+'" data-content="'+escHtml(previewContent)+'"><span class="material-symbols-outlined text-[14px] text-slate-500">reply</span></button>',
                        '<button class="w-7 h-7 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center menu-btn" data-mid="'+mid+'" data-mine="'+(isMine?'true':'false')+'"><span class="material-symbols-outlined text-[14px] text-slate-500">more_vert</span></button>'
                    ].join('');

                    var picker = document.createElement("div");
                    picker.className = "reaction-picker hidden absolute bottom-full mb-2 " + pickerAlign + " z-20 bg-white dark:bg-slate-800 shadow-xl rounded-full px-2 py-1.5 flex items-center gap-1";
                    picker.dataset.mid = mid;
                    picker.innerHTML = [['❤️','Heart'],['😆','Laugh'],['😮','Wow'],['😢','Sad'],['😠','Angry'],['👍','Like']]
                        .map(function(r){ return '<button class="w-8 h-8 text-lg hover:scale-125 transition-transform react-pick" data-mid="'+mid+'" data-type="'+r[1]+'">'+r[0]+'</button>'; }).join('');

                    var menu = document.createElement("div");
                    menu.className = "msg-menu hidden absolute bottom-full mb-2 " + pickerAlign + " z-20 bg-white dark:bg-slate-800 shadow-xl rounded-md py-1 w-44 border border-slate-100 dark:border-slate-700";
                    menu.dataset.mid = mid;
                    var items = [
                        '<button class="w-full px-4 py-2 text-left text-sm hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-2 pin-btn" data-mid="'+mid+'"><span class="material-symbols-outlined text-[14px]">push_pin</span> Ghim</button>',
                        '<button class="w-full px-4 py-2 text-left text-sm hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-2 forward-btn" data-mid="'+mid+'" data-content="'+escHtml(previewContent)+'"><span class="material-symbols-outlined text-[14px]">forward</span> Chuyển tiếp</button>'
                    ];
                    if (isMine) items.push('<button class="w-full px-4 py-2 text-left text-sm hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-2 text-rose-500 delete-btn" data-mid="'+mid+'"><span class="material-symbols-outlined text-[14px]">delete</span> Xóa</button>');
                    else items.push('<button class="w-full px-4 py-2 text-left text-sm hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-2 text-rose-500 report-btn" data-mid="'+mid+'" data-content="'+escHtml(previewContent)+'"><span class="material-symbols-outlined text-[14px]">flag</span> Báo cáo</button>');
                    menu.innerHTML = items.join('');

                    wrap.appendChild(bar);
                    wrap.appendChild(picker);
                    wrap.appendChild(menu);
                    return wrap;
                }

                // Build bubble column
                var bubbleCol = document.createElement("div");
                bubbleCol.className = "bubble-col flex flex-col " + (isMine ? "items-end" : "items-start") + " max-w-[65%]";

                if (msg.isDeleted || msg.messageType === "Deleted") {
                    var delBubble = document.createElement("div");
                    delBubble.className = "px-4 py-2 rounded-md bg-slate-100 dark:bg-slate-800 border border-dashed border-slate-300 dark:border-slate-600";
                    delBubble.innerHTML = '<p class="text-sm text-slate-400 italic">Tin nhắn đã bị xóa</p>' +
                        '<p class="text-[10px] mt-1 opacity-50 ' + (isMine ? "text-right" : "") + '">' + formatTime(msg.createdAt) + '</p>';
                    bubbleCol.appendChild(delBubble);
                    // No actions for deleted messages
                    if (isMine) { container.appendChild(bubbleCol); }
                    else { container.appendChild(bubbleCol); }
                    chatMessages.appendChild(container);
                    return;
                } else if (msg.messageType === "Image" && msg.imageUrl) {
                    var wrap = document.createElement("div");
                    if (msg.replyPreview) {
                        var rq = document.createElement("div");
                        rq.className = "text-[10px] text-slate-400 bg-slate-100 dark:bg-slate-700 rounded-md px-2 py-1 mb-1 truncate border-l-2 border-primary";
                        rq.textContent = '↩ ' + (msg.replyPreview.content || '');
                        wrap.appendChild(rq);
                    }
                    var img = document.createElement("img");
                    img.src = msg.imageUrl;
                    img.className = "rounded-md max-w-full shadow-sm cursor-pointer";
                    img.onclick = function() { window.open(img.src); };
                    var timeP = document.createElement("p");
                    timeP.className = "text-[10px] mt-1 opacity-70" + (isMine ? " text-right" : "");
                    timeP.textContent = formatTime(msg.createdAt);
                    wrap.appendChild(img); wrap.appendChild(timeP);
                    bubbleCol.appendChild(wrap);

                } else if (msg.messageType === "MatchCard" && msg.matchCardJson) {
                    var wrap = document.createElement("div");
                    wrap.className = "max-w-[280px]";
                    wrap.innerHTML = renderMatchCardHtml(msg.matchCardJson, isMine);
                    var timeP = document.createElement("p");
                    timeP.className = "text-[10px] mt-1 opacity-70" + (isMine ? " text-right" : "");
                    timeP.textContent = formatTime(msg.createdAt);
                    wrap.appendChild(timeP);
                    bubbleCol.appendChild(wrap);

                } else {
                    var bubble = document.createElement("div");
                    bubble.className = "px-4 py-2 rounded-md shadow-sm " +
                        (isMine ? "bg-primary text-white" : "bg-slate-200 dark:bg-slate-800 text-slate-900 dark:text-white");
                    if (msg.replyPreview) {
                        var rq = document.createElement("div");
                        rq.className = "text-[10px] " + (isMine ? "text-blue-100" : "text-slate-500") + " bg-black/10 rounded-md px-2 py-1 mb-1.5 border-l-2 " + (isMine ? "border-white/60" : "border-primary") + " truncate";
                        rq.textContent = '↩ ' + (msg.replyPreview.content || '');
                        bubble.appendChild(rq);
                    }
                    var contentP = document.createElement("p"); contentP.className = "text-sm"; contentP.textContent = msg.content;
                    var timeRow = document.createElement("p");
                    timeRow.className = "text-[10px] mt-1 flex items-center gap-1" + (isMine ? " justify-end text-right text-white/70" : " text-slate-400");
                    timeRow.textContent = formatTime(msg.createdAt);
                    if (isMine) {
                        var receipt = document.createElement("span");
                        receipt.className = "read-receipt text-white/50"; receipt.dataset.mid = mid; receipt.textContent = "✓";
                        timeRow.appendChild(receipt);
                    }
                    bubble.appendChild(contentP); bubble.appendChild(timeRow);
                    bubbleCol.appendChild(bubble);
                }

                var reactBar = document.createElement("div");
                reactBar.className = "reactions-bar flex flex-wrap gap-1 mt-1" + (isMine ? " justify-end" : "");
                reactBar.dataset.mid = mid;
                bubbleCol.appendChild(reactBar);

                // isMine: actions LEFT, bubble RIGHT; else bubble LEFT, actions RIGHT
                if (isMine) {
                    container.appendChild(buildActionsWrapper("right-0"));
                    container.appendChild(bubbleCol);
                } else {
                    container.appendChild(bubbleCol);
                    container.appendChild(buildActionsWrapper("left-0"));
                }
                chatMessages.appendChild(container);
            }

            function renderMatchCardHtml(jsonStr, isMine) {
                try {
                    var m = JSON.parse(jsonStr);
                    var border = isMine ? "border-primary/20 dark:border-primary/30" : "border-slate-200 dark:border-slate-700";
                    var bg = isMine ? "background:rgba(80,165,177,0.05)" : "";
                    var link = m.id ? `<a href="/Matchmaking/Details?id=${m.id}" style="display:block;text-align:center;background:#50A5B1;color:white;border-radius:8px;padding:4px;font-size:11px;font-weight:700;text-decoration:none;margin-top:6px">Xem chi tiết</a>` : "";
                    return `<div class="rounded-md border ${border} p-3 shadow-sm" style="${bg}">
                        <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px"><span class="material-symbols-outlined" style="font-size:14px;color:#50A5B1">sports</span>
                        <strong style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escHtml(m.title||m.type||"")}</strong></div>
                        <p style="font-size:11px;color:#64748b">📅 ${m.date||""} · ${m.time||""}</p>
                        ${m.venue?`<p style="font-size:11px;color:#64748b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">📍 ${escHtml(m.venue)}</p>`:""}
                        <p style="font-size:11px;color:#64748b">👥 ${m.participants||0}/${m.max||0}${m.skill?` · ${escHtml(m.skill)}`:""}</p>
                        ${m.price?`<p style="font-size:11px;color:#64748b">💰 ${escHtml(m.price)}</p>`:""}
                        ${link}</div>`;
                } catch(e) { return '<div style="font-size:11px;color:#94a3b8;padding:8px">Thẻ trận</div>'; }
            }

            function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
            function formatTime(isoStr) { var d = new Date(isoStr); return d.getHours().toString().padStart(2,'0')+':'+d.getMinutes().toString().padStart(2,'0'); }

            function updateFriendPreview(senderId, content, messageType) {
                var preview = document.getElementById("preview-" + senderId);
                if (!preview) return;
                var text = messageType === "Image" ? "Đã gửi một ảnh" : messageType === "MatchCard" ? "Đã chia sẻ thẻ trận" : (content.length > 35 ? content.substring(0,35)+"…" : content);
                preview.textContent = text;
            }
            function incrementFriendBadge(senderId) {
                var badge = document.getElementById("unread-badge-" + senderId);
                if (!badge) return;
                var current = parseInt(badge.textContent) || 0;
                badge.textContent = current >= 9 ? "9+" : String(current + 1);
                badge.style.display = "flex"; badge.classList.remove("hidden");
            }
            function showToast(msg, isErr) {
                var t = document.createElement('div');
                t.className = 'fixed bottom-24 left-1/2 -translate-x-1/2 z-[70] px-4 py-2 rounded-md text-sm font-semibold shadow-lg text-white ' + (isErr ? 'bg-rose-500' : 'bg-emerald-500');
                t.textContent = msg;
                document.body.appendChild(t);
                setTimeout(function() { t.remove(); }, 3000);
            }

            // Close menus on outside click
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.reaction-picker') && !e.target.closest('.react-btn')) closeReactionPicker();
                if (!e.target.closest('.msg-menu') && !e.target.closest('.menu-btn')) closeMsgMenu();
            });
            // Close modals on backdrop click
            document.getElementById('forward-modal').addEventListener('click', function(e) { if (e.target === this) closeForwardModal(); });
            document.getElementById('report-modal').addEventListener('click', function(e) { if (e.target === this) closeReportModal(); });

            function closeReactionPicker() { if (openReactionPicker) { openReactionPicker.classList.add('hidden'); openReactionPicker = null; } }
            function closeMsgMenu() { if (openMsgMenu) { openMsgMenu.classList.add('hidden'); openMsgMenu = null; } }
        </script>
    }
}

<script>
    var _pendingDeleteMid = null;
    function openDeleteConfirm(mid) {
        _pendingDeleteMid = mid;
        var modal = document.getElementById('delete-confirm-modal');
        var box = document.getElementById('delete-confirm-box');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        requestAnimationFrame(function() {
            box.classList.remove('scale-95', 'opacity-0');
            box.classList.add('scale-100', 'opacity-100');
        });
    }
    function closeDeleteConfirm() {
        var modal = document.getElementById('delete-confirm-modal');
        var box = document.getElementById('delete-confirm-box');
        box.classList.remove('scale-100', 'opacity-100');
        box.classList.add('scale-95', 'opacity-0');
        setTimeout(function() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            _pendingDeleteMid = null;
        }, 180);
    }
    function confirmDelete() {
        if (_pendingDeleteMid == null) return;
        var mid = _pendingDeleteMid;
        closeDeleteConfirm();
        if (typeof chatConnection !== 'undefined' && typeof activeReceiverId !== 'undefined') {
            chatConnection.invoke('DeleteMessage', mid, activeReceiverId).catch(function(){});
        }
    }
</script>
