@functions {
    string RenderMatchCard(string json, bool isMine)
    {
        try
        {
            var m = System.Text.Json.JsonDocument.Parse(json).RootElement;
            string title = m.TryGetProperty("title", out var t) ? t.GetString() ?? "" : "";
            string date  = m.TryGetProperty("date",  out var d) ? d.GetString() ?? "" : "";
            string time  = m.TryGetProperty("time",  out var ti) ? ti.GetString() ?? "" : "";
            string venue = m.TryGetProperty("venue", out var v) ? v.GetString() ?? "" : "";
            string price = m.TryGetProperty("price", out var p) ? p.GetString() ?? "" : "";
            int matchId  = m.TryGetProperty("id",    out var id) ? id.GetInt32() : 0;
            int parts    = m.TryGetProperty("participants", out var pa) ? pa.GetInt32() : 0;
            int max      = m.TryGetProperty("max",   out var mx) ? mx.GetInt32() : 0;
            string skill = m.TryGetProperty("skill", out var sk) ? sk.GetString() ?? "" : "";

            string border = isMine ? "border-blue-200 dark:border-blue-900" : "border-slate-200 dark:border-slate-700";
            string bg     = isMine ? "bg-blue-50 dark:bg-blue-950" : "bg-white dark:bg-slate-800";

            var sb = new System.Text.StringBuilder();
            sb.Append("<div class=\"rounded-md border ").Append(border).Append(" ").Append(bg).Append(" p-3 shadow-sm\">");
            sb.Append("<div class=\"flex items-center gap-2 mb-1\"><span class=\"material-symbols-outlined text-primary\" style=\"font-size:14px\">sports</span>");
            sb.Append("<p class=\"font-bold text-sm truncate\">").Append(System.Web.HttpUtility.HtmlEncode(title)).Append("</p></div>");
            sb.Append("<p class=\"text-xs text-slate-500\">📅 ").Append(date).Append(" · ").Append(time).Append("</p>");
            if (!string.IsNullOrEmpty(venue))
                sb.Append("<p class=\"text-xs text-slate-500 truncate\">📍 ").Append(System.Web.HttpUtility.HtmlEncode(venue)).Append("</p>");
            sb.Append("<p class=\"text-xs text-slate-500\">👥 ").Append(parts).Append("/").Append(max);
            if (!string.IsNullOrEmpty(skill)) sb.Append(" · ").Append(System.Web.HttpUtility.HtmlEncode(skill));
            sb.Append("</p>");
            if (!string.IsNullOrEmpty(price))
                sb.Append("<p class=\"text-xs text-slate-500\">💰 ").Append(System.Web.HttpUtility.HtmlEncode(price)).Append("</p>");
            if (matchId > 0)
                sb.Append("<a href=\"/Matchmaking/Details?id=").Append(matchId).Append("\" class=\"mt-2 block text-center bg-primary text-white text-xs font-bold rounded-md py-1.5 hover:bg-primary/90 transition-colors\">Xem chi tiết</a>");
            sb.Append("</div>");
            return sb.ToString();
        }
        catch { return "<div class=\"text-xs text-slate-400 p-2\">Thẻ trận</div>"; }
    }
}

