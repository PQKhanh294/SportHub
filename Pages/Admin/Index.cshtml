@page
@model SportHub.Pages.Admin.AdminIndexModel
@{
    ViewData["Title"] = "Admin — Dashboard";
    var s = Model.Stats;
    var dr = Model.DailyRevenue;
    var labels = string.Join(",", dr.Select(d => $"\"{d.Date:dd/MM}\""));
    var depositData = string.Join(",", dr.Select(d => d.HostDepositTotal));
    var feeData = string.Join(",", dr.Select(d => d.PlayerFeeTotal));
    var remainData = string.Join(",", dr.Select(d => d.HostRemainingTotal));
    var typeTotal = new[] {
        dr.Sum(d => d.HostDepositTotal),
        dr.Sum(d => d.PlayerFeeTotal),
        dr.Sum(d => d.HostRemainingTotal)
    };
}

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-black text-slate-900 dark:text-white">Admin Dashboard</h1>
        <p class="text-sm text-slate-500 mt-1">Tổng quan hệ thống SportHub</p>
    </div>

    @await Html.PartialAsync("_AdminNav")

    <!-- Revenue cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm">
            <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Tổng doanh thu</p>
            <p class="text-2xl font-black text-primary">@s.TotalRevenue.ToString("N0") ₫</p>
            <p class="text-xs text-slate-400 mt-1">@s.TotalConfirmedPayments giao dịch</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm">
            <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Hôm nay</p>
            <p class="text-2xl font-black text-emerald-600">@s.TodayRevenue.ToString("N0") ₫</p>
            <p class="text-xs text-slate-400 mt-1">Đã xác nhận</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm">
            <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Tháng này</p>
            <p class="text-2xl font-black text-blue-600">@s.ThisMonthRevenue.ToString("N0") ₫</p>
            <p class="text-xs text-slate-400 mt-1">@DateTime.Now.ToString("MM/yyyy")</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-amber-200 dark:border-amber-800 p-5 shadow-sm bg-amber-50 dark:bg-amber-900/10">
            <p class="text-xs text-amber-600 uppercase tracking-wider mb-1">Chờ xác nhận</p>
            <p class="text-2xl font-black text-amber-600">@s.PendingPaymentsCount</p>
            <a asp-page="/Admin/MatchPayments" class="text-xs text-amber-500 hover:underline mt-1 block">Xem ngay →</a>
        </div>
    </div>

    <!-- System stats -->
    <div class="grid grid-cols-2 gap-4">
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm flex items-center gap-4">
            <div class="size-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-primary">group</span>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-900 dark:text-white">@s.TotalUsers</p>
                <p class="text-sm text-slate-500">Người dùng</p>
            </div>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm flex items-center gap-4">
            <div class="size-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
                <span class="material-symbols-outlined text-emerald-600">sports</span>
            </div>
            <div>
                <p class="text-2xl font-black text-slate-900 dark:text-white">@s.ActiveMatchesCount</p>
                <p class="text-sm text-slate-500">Trận đang mở</p>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-2 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm">
            <h2 class="font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">show_chart</span>
                Doanh thu 7 ngày gần nhất
            </h2>
            <canvas id="revenueChart" height="120"></canvas>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm">
            <h2 class="font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">donut_large</span>
                Cơ cấu giao dịch
            </h2>
            <canvas id="typeChart" height="180"></canvas>
            <div class="mt-3 space-y-1 text-xs text-slate-600 dark:text-slate-400">
                <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span>Đặt cọc host: <b>@typeTotal[0].ToString("N0") ₫</b></div>
                <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>Phí player: <b>@typeTotal[1].ToString("N0") ₫</b></div>
                <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>Phí còn lại: <b>@typeTotal[2].ToString("N0") ₫</b></div>
            </div>
        </div>
    </div>

    <!-- AI Growth Suggestions -->
    <div class="bg-gradient-to-br from-primary/5 to-sky-50 dark:from-primary/10 dark:to-slate-900 rounded-xl border border-primary/20 p-5">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">auto_awesome</span>
                <h2 class="font-bold text-slate-900 dark:text-white text-sm">Gợi ý tăng trưởng AI</h2>
            </div>
            <button onclick="loadAiInsight('dashboard', '@s.TotalUsers', '@s.ActiveMatchesCount', '@s.TotalConfirmedPayments', '')" class="flex items-center gap-1.5 text-xs font-semibold text-primary hover:underline">
                <span class="material-symbols-outlined text-[14px]">refresh</span>
                Phân tích
            </button>
        </div>
        <div id="ai-insight-dashboard" class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            <span class="text-slate-400 italic">Nhấn "Phân tích" để AI đưa ra gợi ý tăng trưởng cho SportHub.</span>
        </div>
    </div>

    <!-- Unpaid remaining fees (debt tracking) -->
    @if (Model.UnpaidFees.Any())
    {
    <div class="bg-white dark:bg-slate-900 rounded-xl border border-rose-200 dark:border-rose-800 shadow-sm">
        <div class="flex items-center justify-between p-5 border-b border-rose-100 dark:border-rose-800 bg-rose-50 dark:bg-rose-900/10 rounded-t-xl">
            <h2 class="font-bold text-rose-700 dark:text-rose-400 flex items-center gap-2">
                <span class="material-symbols-outlined">warning</span>
                Nợ chưa thu — Phí còn lại
                <span class="ml-1 min-w-[22px] h-[22px] px-1.5 rounded-full bg-rose-500 text-white text-xs font-bold flex items-center justify-center">@Model.UnpaidFees.Count</span>
            </h2>
        </div>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
            @foreach (var debt in Model.UnpaidFees)
            {
                <div class="flex items-center gap-3 px-5 py-3">
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">@debt.MatchTitle</p>
                        <p class="text-xs text-slate-500">Host: @debt.HostName · Ngày trận: @debt.MatchDate.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="text-right flex-shrink-0">
                        <p class="text-sm font-bold text-rose-600">@debt.Amount.ToString("N0") ₫</p>
                        @if (debt.IsOverdue)
                        {
                            <span class="text-xs font-bold text-rose-500 bg-rose-50 dark:bg-rose-900/20 px-2 py-0.5 rounded-full">Quá hạn 48h</span>
                        }
                        else if (debt.PaymentCreatedAt.HasValue)
                        {
                            var hoursAgo = (int)(DateTime.UtcNow - debt.PaymentCreatedAt.Value).TotalHours;
                            <p class="text-xs text-slate-400">Đã nhắc @hoursAgo h trước</p>
                        }
                    </div>
                    <a asp-page="/Matchmaking/Details" asp-route-id="@debt.MatchId" class="ml-2 text-xs text-primary hover:underline flex-shrink-0">Chi tiết →</a>
                </div>
            }
        </div>
    </div>
    }

    <!-- Recent transactions -->
    <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex items-center justify-between p-5 border-b border-slate-100 dark:border-slate-800">
            <h2 class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">receipt_long</span>
                Giao dịch gần đây
            </h2>
            <a asp-page="/Admin/Transactions" class="text-sm text-primary hover:underline font-medium">Xem tất cả →</a>
        </div>
        @if (!s.RecentTransactions.Any())
        {
            <div class="p-10 text-center text-slate-400 text-sm">Chưa có giao dịch nào.</div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var tx in s.RecentTransactions)
                {
                    var typeColor = tx.PaymentType switch {
                        "HostDeposit"   => "bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400",
                        "PlayerFee"     => "bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400",
                        "HostRemaining" => "bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400",
                        _               => "bg-slate-50 dark:bg-slate-800 text-slate-600"
                    };
                    <div class="flex items-center gap-3 px-5 py-3">
                        <span class="px-2 py-0.5 rounded-full text-xs font-bold @typeColor flex-shrink-0">@tx.TypeLabel</span>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">@tx.MatchTitle</p>
                            <p class="text-xs text-slate-500">@tx.PayerName</p>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <p class="text-sm font-bold text-primary">+@tx.Amount.ToString("N0") ₫</p>
                            <p class="text-xs text-slate-400">@tx.ConfirmedAt.ToLocalTime().ToString("HH:mm dd/MM")</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    const isDark = document.documentElement.classList.contains('dark');
    const gridColor = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)';
    const textColor = isDark ? '#94a3b8' : '#64748b';

    // Line chart — 7-day revenue
    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels: [@Html.Raw(labels)],
            datasets: [
                { label: 'Đặt cọc host', data: [@depositData], borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', fill: true, tension: 0.4, pointRadius: 4 },
                { label: 'Phí player',    data: [@feeData],     borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.1)', fill: true, tension: 0.4, pointRadius: 4 },
                { label: 'Phí còn lại',  data: [@remainData],  borderColor: '#f59e0b', backgroundColor: 'rgba(245,158,11,0.1)',  fill: true, tension: 0.4, pointRadius: 4 }
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            plugins: { legend: { labels: { color: textColor, boxWidth: 12 } } },
            scales: {
                x: { grid: { color: gridColor }, ticks: { color: textColor } },
                y: { grid: { color: gridColor }, ticks: { color: textColor, callback: v => v.toLocaleString('vi-VN') + ' ₫' }, beginAtZero: true }
            }
        }
    });

    // Doughnut chart — payment type breakdown
    new Chart(document.getElementById('typeChart'), {
        type: 'doughnut',
        data: {
            labels: ['Đặt cọc host', 'Phí player', 'Phí còn lại'],
            datasets: [{ data: [@typeTotal[0], @typeTotal[1], @typeTotal[2]], backgroundColor: ['#3b82f6','#10b981','#f59e0b'], borderWidth: 0, hoverOffset: 6 }]
        },
        options: {
            responsive: true,
            cutout: '70%',
            plugins: { legend: { display: false } }
        }
    });
})();
</script>
}
