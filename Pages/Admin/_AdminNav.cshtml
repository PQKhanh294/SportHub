@using System.Globalization
@{
    var current = ViewData["AdminPage"]?.ToString();
    var navItemBase = "flex-shrink-0 flex items-center gap-1 px-2 py-1.5 rounded-md text-[11px] font-semibold transition-colors";
    var navActive = "bg-primary text-white shadow-sm";
    var navInactive = "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary hover:border-primary/40";
    var isEn = false; // Admin thuần tiếng Việt — công cụ nội bộ, không song ngữ
}
<!-- Mobile: horizontal scroll (hidden on lg+ because sidebar takes over) -->
<div class="relative lg:hidden mb-4">
<nav class="overflow-x-auto flex gap-2 pb-1 [&::-webkit-scrollbar]:hidden" id="admin-mobile-nav" style="-ms-overflow-style:none;scrollbar-width:none">
    <a asp-page="/Admin/Index" class="@navItemBase @(current == "Dashboard" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">dashboard</span>
        Dashboard
    </a>
    <a asp-page="/Admin/Transactions" class="@navItemBase @(current == "Transactions" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">receipt_long</span>
        @(isEn ? "Transactions" : "Giao dịch")
    </a>
    <a asp-page="/Admin/MatchPayments" class="@navItemBase @(current == "Payments" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">pending_actions</span>
        @(isEn ? "Pending Payments" : "Chờ thanh toán")
        <span id="admin-badge-payments" class="hidden min-w-[16px] h-4 px-1 rounded-full bg-rose-500 text-white text-[9px] font-bold flex items-center justify-center leading-none"></span>
    </a>
    <a asp-page="/Admin/Users" class="@navItemBase @(current == "Users" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">manage_accounts</span>
        @(isEn ? "Users" : "Người dùng")
    </a>
    <a asp-page="/Admin/Matches" class="@navItemBase @(current == "Matches" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">sports</span>
        @(isEn ? "Matches" : "Trận đấu")
    </a>
    <a asp-page="/Admin/Reviews" class="@navItemBase @(current == "Reviews" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">rate_review</span>
        @(isEn ? "Reviews" : "Đánh giá")
    </a>
    <a asp-page="/Admin/ReportedMessages" class="@navItemBase @(current == "ReportedMessages" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">flag</span>
        @(isEn ? "Reports" : "Báo cáo")
        <span id="admin-badge-reports" class="hidden min-w-[16px] h-4 px-1 rounded-full bg-rose-500 text-white text-[9px] font-bold flex items-center justify-center leading-none"></span>
    </a>
    <a asp-page="/Admin/Subscriptions" class="@navItemBase @(current == "Subscriptions" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">workspace_premium</span>
        @(isEn ? "Subscriptions" : "Gói dịch vụ")
    </a>
    <a asp-page="/Admin/Wallet" class="@navItemBase @(current == "Wallet" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">account_balance_wallet</span>
        @(isEn ? "Wallets" : "Ví tiền")
    </a>
    <a asp-page="/Admin/Promotions" class="@navItemBase @(current == "Promotions" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">local_offer</span>
        @(isEn ? "Promotions" : "Khuyến mãi")
    </a>
    <a asp-page="/Admin/Disputes" class="@navItemBase @(current == "Disputes" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">gavel</span>
        @(isEn ? "Disputes" : "Khiếu nại")
    </a>
    <a asp-page="/Admin/Emails" class="@navItemBase @(current == "Emails" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[15px]">mail</span>
        @(isEn ? "Emails" : "Email")
    </a>
</nav>
<!-- Gradient fade hint — more items to scroll -->
<div class="absolute right-0 top-0 h-full w-10 bg-gradient-to-l from-slate-100 dark:from-slate-950 to-transparent pointer-events-none"></div>
</div>
<script>
    (function () {
        function applyAdminCounts(data) {
            var badge = document.getElementById('admin-badge-payments');
            if (!badge) return;
            var n = (data && data.pendingPayments) || 0;
            if (n > 0) {
                badge.textContent = n > 99 ? '99+' : n;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        fetch('/Admin/MatchPayments?handler=Counts')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) { if (d) applyAdminCounts(d); })
            .catch(function () { });

        // Load report badge
        fetch('/Admin/ReportedMessages?handler=Counts')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
                if (!d) return;
                var badge = document.getElementById('admin-badge-reports');
                if (!badge) return;
                var n = d.pendingReports || 0;
                if (n > 0) { badge.textContent = n > 99 ? '99+' : n; badge.classList.remove('hidden'); }
                else badge.classList.add('hidden');
            })
            .catch(function () { });

        window.addEventListener('sporthub:admin_counts', function (e) {
            applyAdminCounts(e.detail);
        });

        // Auto-scroll active nav item into center view on mobile
        var mobileNav = document.getElementById('admin-mobile-nav');
        if (mobileNav) {
            var activeItem = mobileNav.querySelector('a[class*="bg-primary text-white"]');
            if (activeItem) activeItem.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' });
        }
    })();
</script>
