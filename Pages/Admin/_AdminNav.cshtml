@{
    var current = ViewData["AdminPage"]?.ToString();
    var navItemBase = "flex-shrink-0 flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold transition-colors";
    var navActive = "bg-primary text-white shadow-sm";
    var navInactive = "bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary hover:border-primary/40";
}
<!-- Mobile: horizontal scroll (hidden on lg+ because sidebar takes over) -->
<nav class="lg:hidden overflow-x-auto flex gap-2 mb-4 pb-1 [&::-webkit-scrollbar]:hidden" style="-ms-overflow-style:none;scrollbar-width:none">
    <a asp-page="/Admin/Index" class="@navItemBase @(current == "Dashboard" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[18px]">dashboard</span>
        Dashboard
    </a>
    <a asp-page="/Admin/Transactions" class="@navItemBase @(current == "Transactions" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[18px]">receipt_long</span>
        Lịch sử GD
    </a>
    <a asp-page="/Admin/MatchPayments" class="@navItemBase @(current == "Payments" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[18px]">pending_actions</span>
        Chờ xác nhận
        <span id="admin-badge-payments" class="hidden min-w-[16px] h-4 px-1 rounded-full bg-rose-500 text-white text-[9px] font-bold flex items-center justify-center leading-none"></span>
    </a>
    <a asp-page="/Admin/Users" class="@navItemBase @(current == "Users" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[18px]">manage_accounts</span>
        Người dùng
    </a>
    <a asp-page="/Admin/Matches" class="@navItemBase @(current == "Matches" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[18px]">sports</span>
        Trận đấu
    </a>
    <a asp-page="/Admin/Reviews" class="@navItemBase @(current == "Reviews" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[18px]">rate_review</span>
        Đánh giá
    </a>
    <a asp-page="/Admin/ReportedMessages" class="@navItemBase @(current == "ReportedMessages" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[18px]">flag</span>
        Báo cáo
        <span id="admin-badge-reports" class="hidden min-w-[16px] h-4 px-1 rounded-full bg-rose-500 text-white text-[9px] font-bold flex items-center justify-center leading-none"></span>
    </a>
    <a asp-page="/Admin/Subscriptions" class="@navItemBase @(current == "Subscriptions" ? navActive : navInactive)">
        <span class="material-symbols-outlined text-[18px]">workspace_premium</span>
        Gói đăng ký
    </a>
</nav>
<script>
    (function () {
        function applyAdminCounts(data) {
            var badge = document.getElementById('admin-badge-payments');
            if (!badge) return;
            var n = (data && data.pendingPayments) || 0;
            if (n > 0) {
                badge.textContent = n > 99 ? '99+' : n;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        fetch('/Admin/MatchPayments?handler=Counts')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) { if (d) applyAdminCounts(d); })
            .catch(function () { });

        // Load report badge
        fetch('/Admin/ReportedMessages?handler=Counts')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
                if (!d) return;
                var badge = document.getElementById('admin-badge-reports');
                if (!badge) return;
                var n = d.pendingReports || 0;
                if (n > 0) { badge.textContent = n > 99 ? '99+' : n; badge.classList.remove('hidden'); }
                else badge.classList.add('hidden');
            })
            .catch(function () { });

        window.addEventListener('sporthub:admin_counts', function (e) {
            applyAdminCounts(e.detail);
        });
    })();
</script>
