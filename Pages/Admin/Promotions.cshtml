@page
@model SportHub.Pages.Admin.PromotionsModel
@using System.Globalization
@{
    ViewData["Title"] = "Admin — Khuyến mãi";
    var isEn = false; // Admin thuần tiếng Việt — công cụ nội bộ, không song ngữ
}

<div class="space-y-5">
    <partial name="_AdminNav" />

    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white">@(isEn ? "Promotions" : "Khuyến mãi")</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">@(isEn ? "Create campaigns, share codes, and track reward history." : "Tạo chiến dịch, mã chia sẻ và theo dõi lịch sử phần thưởng.")</p>
        </div>
        <button type="button" onclick="document.getElementById('promoGuideModal').classList.remove('hidden')"
                class="flex-shrink-0 flex items-center gap-2 px-3 py-2 bg-primary/10 hover:bg-primary/20 text-primary font-semibold text-sm rounded-md transition-colors">
            <span class="material-symbols-outlined text-sm">help</span>
            @(isEn ? "Campaign guide" : "Hướng dẫn chiến dịch")
        </button>
    </div>

    <!-- Guide Modal -->
    <div id="promoGuideModal" class="hidden fixed inset-0 z-[1200] bg-black/50 flex items-center justify-center p-4" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white dark:bg-slate-900 rounded-md shadow-2xl max-w-lg w-full p-6 space-y-4 max-h-[85vh] overflow-y-auto">
            <div class="flex items-center justify-between">
                <h2 class="font-black text-slate-900 dark:text-white text-lg">Hướng dẫn tạo chiến dịch khuyến mãi</h2>
                <button onclick="document.getElementById('promoGuideModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="space-y-4 text-sm text-slate-700 dark:text-slate-300">
                <div class="p-3 bg-amber-50 dark:bg-amber-900/20 rounded-md border border-amber-200 dark:border-amber-800">
                    <p class="font-bold text-amber-700 dark:text-amber-400 mb-1">🎁 Thủ công (admin phát trực tiếp)</p>
                    <p>Admin bấm <strong>"Phát thưởng ngay"</strong> để tặng cho tất cả người dùng đủ điều kiện. Phù hợp cho sự kiện, kỷ niệm nền tảng, v.v.</p>
                </div>
                <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-md border border-blue-200 dark:border-blue-800">
                    <p class="font-bold text-blue-700 dark:text-blue-400 mb-1">🆕 Lần đầu đăng nhập</p>
                    <p>Tự động kích hoạt khi người dùng mới đăng ký. Chỉ được cấp một lần. Phù hợp làm quà chào mừng thành viên mới.</p>
                </div>
                <div class="p-3 bg-rose-50 dark:bg-rose-900/20 rounded-md border border-rose-200 dark:border-rose-800">
                    <p class="font-bold text-rose-700 dark:text-rose-400 mb-1">🎂 Sinh nhật</p>
                    <p>Tự động kích hoạt vào ngày sinh nhật người dùng. Yêu cầu người dùng đã cập nhật ngày sinh trong hồ sơ.</p>
                </div>
                <div class="p-3 bg-green-50 dark:bg-green-900/20 rounded-md border border-green-200 dark:border-green-800">
                    <p class="font-bold text-green-700 dark:text-green-400 mb-1">🎟 Mã chia sẻ</p>
                    <p>Tạo mã để người dùng tự nhập trong ví. Có thể giới hạn số lượt dùng và hạn sử dụng.</p>
                </div>
                <div class="border-t border-slate-200 dark:border-slate-700 pt-3 space-y-1 text-xs text-slate-500">
                    <p><strong>Phạm vi:</strong> "Tất cả" = mọi người dùng | "Chỉ Host" = người đã tạo ít nhất 1 trận | "Chỉ Player" = người đã tham gia ít nhất 1 trận</p>
                    <p><strong>Giới hạn:</strong> Để trống = không giới hạn tổng lượt dùng cho chiến dịch</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-md text-emerald-700 dark:text-emerald-400 font-medium text-sm">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-md text-rose-700 dark:text-rose-400 font-medium text-sm">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["DistributeResult"] != null)
    {
        <div class="p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-md text-amber-700 dark:text-amber-400 font-medium text-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">task_alt</span>@TempData["DistributeResult"]
        </div>
    }

    <!-- Tab Nav -->
    <div class="flex gap-2 border-b border-slate-200 dark:border-slate-700">
        <a asp-page="/Admin/Promotions" asp-route-ActiveTab="campaigns"
           class="pb-2 px-1 text-sm font-semibold border-b-2 transition-colors @(Model.ActiveTab == "campaigns" ? "border-primary text-primary" : "border-transparent text-slate-500 hover:text-slate-700 dark:hover:text-slate-300")">
            @(isEn ? "Campaigns" : "Chiến dịch") (@Model.Campaigns.Count)
        </a>
        <a asp-page="/Admin/Promotions" asp-route-ActiveTab="codes"
           class="pb-2 px-1 text-sm font-semibold border-b-2 transition-colors @(Model.ActiveTab == "codes" ? "border-primary text-primary" : "border-transparent text-slate-500 hover:text-slate-700 dark:hover:text-slate-300")">
            @(isEn ? "Share codes" : "Mã chia sẻ")
        </a>
        <a asp-page="/Admin/Promotions" asp-route-ActiveTab="history"
           class="pb-2 px-1 text-sm font-semibold border-b-2 transition-colors @(Model.ActiveTab == "history" ? "border-primary text-primary" : "border-transparent text-slate-500 hover:text-slate-700 dark:hover:text-slate-300")">
            @(isEn ? "Reward history" : "Lịch sử phần thưởng")
        </a>
    </div>

    @* ── Tab 1: Campaigns ─────────────────────────────────────────── *@
    @if (Model.ActiveTab == "campaigns")
    {
        <!-- Trigger type filter -->
        <div class="flex flex-wrap gap-2">
            <a asp-page="/Admin/Promotions" asp-route-activeTab="campaigns"
               class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(string.IsNullOrWhiteSpace(Model.FilterTrigger) ? "bg-primary text-white border-primary" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "All types" : "Tất cả") (@Model.Campaigns.Count)
            </a>
            @foreach (var (ttype, tcolor, tlabel) in new[] {
                ("Manual",     "amber",   isEn ? "Manual" : "Thủ công"),
                ("FirstLogin", "emerald", isEn ? "First login" : "Đăng ký mới"),
                ("Birthday",   "rose",    isEn ? "Birthday" : "Sinh nhật"),
                ("ShareCode",  "blue",    isEn ? "Share code" : "Mã chia sẻ")
            })
            {
                var tActive = Model.FilterTrigger == ttype;
                <a asp-page="/Admin/Promotions" asp-route-activeTab="campaigns" asp-route-filterTrigger="@(tActive ? null : ttype)"
                   class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(tActive ? $"bg-{tcolor}-500 text-white border-{tcolor}-500" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                    @tlabel
                </a>
            }
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <!-- Campaign list -->
            <div class="lg:col-span-2 space-y-3">
                @if (!Model.Campaigns.Any())
                {
                    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-10 text-center">
                        <span class="material-symbols-outlined text-4xl text-slate-300 block mb-2">campaign</span>
                        <p class="text-slate-400 text-sm">@(isEn ? "No campaigns yet. Create your first campaign on the right." : "Chưa có chiến dịch nào. Tạo chiến dịch đầu tiên ở bên phải.")</p>
                    </div>
                }
                @foreach (var c in Model.Campaigns)
                {
                    var triggerLabel = c.TriggerType switch {
                        "Manual" => "Thủ công",
                        "FirstLogin" => "Đăng nhập lần đầu",
                        "Birthday" => "Sinh nhật",
                        "WomensDay" => "8/3 Quốc tế Phụ nữ",
                        "MensDay" => "19/11 Ngày Đàn ông",
                        "PromoCode" => "Mã chia sẻ",
                        "PersonalVoucher" => "Voucher cá nhân",
                        _ => c.TriggerType
                    };
                    var scopeLabel = c.ApplicableScope switch {
                        "All" => "Tất cả người dùng",
                        "HostOnly" => "Chỉ Host",
                        "Gender:F" => "Nữ",
                        "Gender:M" => "Nam",
                        "NewUser" => "Người dùng mới",
                        _ => c.ApplicableScope
                    };
                    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h3 class="font-bold text-slate-800 dark:text-slate-200">@c.Name</h3>
                                    <span class="px-2 py-0.5 rounded-md text-xs font-semibold bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400">@triggerLabel</span>
                                    @if (c.IsActive)
                                    {
                                        <span class="px-2 py-0.5 rounded-md text-xs font-semibold bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">Đang chạy</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-md text-xs font-semibold bg-slate-100 dark:bg-slate-700 text-slate-500">Đã tắt</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(c.Description))
                                {
                                    <p class="text-xs text-slate-500 mt-0.5">@c.Description</p>
                                }
                                <div class="flex items-center gap-4 mt-2 text-xs text-slate-500 flex-wrap">
                                    <span class="font-bold text-emerald-600 dark:text-emerald-400">+@c.Amount.ToString("N0")đ</span>
                                    <span class="flex items-center gap-1">
                                        Phạm vi: @scopeLabel
                                        <span class="relative group cursor-help">
                                            <span class="material-symbols-outlined text-[13px] text-slate-400">info</span>
                                            <span class="absolute bottom-5 left-1/2 -translate-x-1/2 z-10 hidden group-hover:block bg-slate-800 text-white text-[11px] rounded-md px-3 py-2 w-56 shadow-xl leading-relaxed">
                                                <strong>Phạm vi:</strong> @scopeLabel<br/>
                                                <strong>Kích hoạt:</strong> @triggerLabel<br/>
                                                @(c.MaxRedemptions.HasValue ? $"Giới hạn: {c.MaxRedemptions} lượt" : "Không giới hạn lượt")
                                            </span>
                                        </span>
                                    </span>
                                    <span>Đã dùng: @c.RedemptionCount@(c.MaxRedemptions.HasValue ? $"/{c.MaxRedemptions}" : "") lượt</span>
                                    @if (c.EndDate.HasValue)
                                    {
                                        <span>Hết hạn: @c.EndDate.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                    }
                                </div>
                            </div>
                            <div class="flex gap-1 shrink-0">
                                @if (c.TriggerType == "PromoCode")
                                {
                                    <a asp-page="/Admin/Promotions" asp-route-ActiveTab="codes" asp-route-SelectedCampaignId="@c.CampaignID"
                                       class="px-2 py-1.5 rounded-md bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 text-xs font-semibold hover:border-primary hover:text-primary transition-colors">
                                        Xem mã
                                    </a>
                                }
                                @if (c.TriggerType == "Manual" && c.IsActive)
                                {
                                    <form id="dist-form-@c.CampaignID" method="post" asp-page-handler="DistributeCampaign" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="campaignId" value="@c.CampaignID" />
                                        <button type="button"
                                                onclick="previewDistribute(@c.CampaignID, '@c.Amount.ToString("N0")đ', '@c.Name.Replace("'", "\\'")')"
                                                class="px-2 py-1.5 rounded-md bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-400 text-xs font-semibold hover:opacity-80 transition-opacity flex items-center gap-1">
                                            <span class="material-symbols-outlined text-xs">send</span> @(isEn ? "Distribute now" : "Phát thưởng ngay")
                                        </button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="ToggleCampaign" class="inline">
                                    <input type="hidden" name="campaignId" value="@c.CampaignID" />
                                    <input type="hidden" name="active" value="@(!c.IsActive)" />
                                    <button type="submit"
                                            class="px-2 py-1.5 rounded-md @(c.IsActive ? "bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 text-rose-600 dark:text-rose-400" : "bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-400") text-xs font-semibold hover:opacity-80 transition-opacity">
                                        @(c.IsActive ? "Tắt" : "Bật")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Create campaign form -->
            <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm p-5 h-fit">
                <h3 class="font-bold text-slate-800 dark:text-slate-200 mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-sm">add_circle</span>
                    Tạo chiến dịch mới
                </h3>
                <form method="post" asp-page-handler="CreateCampaign" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Tên chiến dịch *</label>
                        <input type="text" name="name" required class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" placeholder="Thưởng sinh nhật 2026" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Mô tả</label>
                        <input type="text" name="description" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" placeholder="Mô tả ngắn..." />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Loại kích hoạt *</label>
                        <select name="triggerType" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm">
                            <option value="Manual">Thủ công (admin phát)</option>
                            <option value="FirstLogin">Đăng nhập lần đầu</option>
                            <option value="Birthday">Sinh nhật</option>
                            <option value="WomensDay">8/3 — Quốc tế Phụ nữ</option>
                            <option value="MensDay">19/11 — Ngày Đàn ông</option>
                            <option value="PromoCode">Mã chia sẻ (user tự nhập)</option>
                            <option value="PersonalVoucher">Voucher cá nhân (phát tay)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Số xu thưởng *</label>
                        <input type="number" name="amount" min="1000" step="1000" required class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" placeholder="50000" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Phạm vi áp dụng</label>
                        <select name="applicableScope" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm">
                            <option value="All">Tất cả người dùng</option>
                            <option value="HostOnly">Chỉ Host</option>
                            <option value="Gender:F">Giới tính: Nữ</option>
                            <option value="Gender:M">Giới tính: Nam</option>
                            <option value="NewUser">Người dùng mới (đăng nhập ≤ 1 lần)</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Ngày bắt đầu</label>
                            <input type="date" name="startDate" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Ngày kết thúc</label>
                            <input type="date" name="endDate" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Giới hạn tổng lượt (trống = ∞)</label>
                        <input type="number" name="maxRedemptions" min="1" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" placeholder="Không giới hạn" />
                    </div>
                    <button type="submit" class="w-full py-2.5 bg-primary text-white rounded-md text-sm font-bold hover:bg-primary/90 transition-colors">@(isEn ? "Create campaign" : "Tạo chiến dịch")</button>
                </form>
            </div>
        </div>
    }

    @* ── Tab 2: Promo Codes ───────────────────────────────────────── *@
    @if (Model.ActiveTab == "codes")
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <!-- Left: choose campaign + code list -->
            <div class="lg:col-span-2 space-y-4">
                <!-- Campaign selector -->
                <form method="get" class="flex gap-2 items-end">
                    <input type="hidden" name="ActiveTab" value="codes" />
                    <div class="flex-1">
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Chọn chiến dịch mã chia sẻ</label>
                        <select name="SelectedCampaignId" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm">
                            <option value="">-- Chọn chiến dịch --</option>
                            @foreach (var c in Model.Campaigns.Where(c => c.TriggerType == "PromoCode"))
                            {
                                <option value="@c.CampaignID" selected="@(Model.SelectedCampaignId == c.CampaignID)">@c.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="px-4 py-2 bg-primary text-white rounded-md text-sm font-semibold hover:bg-primary/90">Xem</button>
                </form>

                @if (Model.SelectedCampaign != null)
                {
                    <!-- Code table -->
                    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
                        <div class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">@Model.PromoCodes.Count mã — @Model.SelectedCampaign.Name</span>
                        </div>
                        @if (!Model.PromoCodes.Any())
                        {
                            <div class="p-8 text-center text-slate-400 text-sm">@(isEn ? "No codes yet. Create one on the right." : "Chưa có mã nào. Tạo mã ở bên phải.")</div>
                        }
                        else
                        {
                            <div class="divide-y divide-slate-100 dark:divide-slate-800">
                                @foreach (var p in Model.PromoCodes)
                                {
                                    var expired = p.ExpiresAt.HasValue && p.ExpiresAt < DateTime.UtcNow;
                                    var exhausted = p.MaxUses.HasValue && p.UseCount >= p.MaxUses;
                                    <div class="flex items-center gap-3 px-5 py-3 text-sm">
                                        <span class="font-mono font-bold text-slate-800 dark:text-slate-200 text-sm">@p.Code</span>
                                        <span class="flex-1 text-slate-400 text-xs">
                                            @p.UseCount@(p.MaxUses.HasValue ? $"/{p.MaxUses}" : "/∞") lượt
                                            @if (p.ExpiresAt.HasValue)
                                            { <text> · HSD @p.ExpiresAt.Value.ToLocalTime().ToString("dd/MM/yy")</text> }
                                        </span>
                                        @if (expired)
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 text-xs">Hết hạn</span>
                                        }
                                        else if (exhausted)
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 text-xs">Hết lượt</span>
                                        }
                                        else if (p.IsActive)
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 text-xs">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-700 text-slate-500 text-xs">Đã tắt</span>
                                        }
                                        <form method="post" asp-page-handler="ToggleCode" class="inline">
                                            <input type="hidden" name="promoCodeId" value="@p.PromoCodeID" />
                                            <input type="hidden" name="active" value="@(!p.IsActive)" />
                                            <input type="hidden" name="campaignId" value="@Model.SelectedCampaignId" />
                                            <button type="submit" class="text-xs text-slate-400 hover:text-primary font-semibold">@(p.IsActive ? "Tắt" : "Bật")</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Right: create code form -->
            @if (Model.SelectedCampaign != null)
            {
                <div class="space-y-4">
                    <!-- Single code -->
                    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm p-4">
                        <h3 class="font-bold text-slate-800 dark:text-slate-200 text-sm mb-3">Tạo mã đơn lẻ</h3>
                        <form method="post" asp-page-handler="CreateCode" class="space-y-3" id="createCodeForm">
                            <input type="hidden" name="campaignId" value="@Model.SelectedCampaignId" />
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Mã *</label>
                                <div class="flex gap-1.5">
                                    <input type="text" name="code" id="singleCodeInput" required maxlength="10"
                                           class="flex-1 rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm font-mono uppercase"
                                           placeholder="SUMMER26"
                                           oninput="this.value=this.value.toUpperCase().replace(/[^A-Z0-9]/g,'')" />
                                    <button type="button" onclick="genRandCode()"
                                            class="px-2 py-1.5 rounded-md bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 text-xs font-semibold hover:border-primary hover:text-primary transition-colors"
                                            title="Tạo mã ngẫu nhiên">
                                        <span class="material-symbols-outlined text-[14px]">shuffle</span>
                                    </button>
                                </div>
                                <p class="text-[10px] text-slate-400 mt-0.5">Tối đa 10 ký tự, chữ in hoa + số</p>
                            </div>

                            <!-- AI suggest -->
                            <div>
                                <button type="button" onclick="aiSuggestCodes()"
                                        class="w-full flex items-center justify-center gap-1.5 py-1.5 rounded-md border border-violet-200 dark:border-violet-800 bg-violet-50 dark:bg-violet-900/20 text-violet-700 dark:text-violet-400 text-xs font-semibold hover:bg-violet-100 dark:hover:bg-violet-900/40 transition-colors"
                                        id="aiSuggestBtn">
                                    <span class="material-symbols-outlined text-[14px]">auto_awesome</span>
                                    AI gợi ý mã
                                </button>
                                <div id="aiCodeSuggestions" class="hidden mt-2 space-y-1"></div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Giới hạn lượt dùng (trống = ∞)</label>
                                <input type="number" name="maxUses" min="1" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Ngày hết hạn</label>
                                <input type="date" name="expiresAt" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" />
                            </div>
                            <button type="submit" class="w-full py-2 bg-primary text-white rounded-md text-sm font-bold hover:bg-primary/90">Tạo mã</button>
                        </form>
                    </div>

                    <!-- Bulk generate -->
                    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm p-4">
                        <h3 class="font-bold text-slate-800 dark:text-slate-200 text-sm mb-3">Tạo hàng loạt</h3>
                        <form method="post" asp-page-handler="GenerateCodes" class="space-y-3">
                            <input type="hidden" name="campaignId" value="@Model.SelectedCampaignId" />
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Tiền tố *</label>
                                <input type="text" name="prefix" required class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" placeholder="SUMMER" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Số lượng (1–100) *</label>
                                <input type="number" name="count" min="1" max="100" required class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" placeholder="10" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Lượt dùng mỗi mã (trống = ∞)</label>
                                <input type="number" name="maxUses" min="1" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" placeholder="1" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Ngày hết hạn</label>
                                <input type="date" name="expiresAt" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" />
                            </div>
                            <button type="submit" class="w-full py-2 bg-slate-700 dark:bg-slate-600 text-white rounded-md text-sm font-bold hover:bg-slate-800 dark:hover:bg-slate-500">Tạo hàng loạt</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Tab 3: History ───────────────────────────────────────────── *@
    @if (Model.ActiveTab == "history")
    {
        <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
            <div class="px-5 py-3 border-b border-slate-100 dark:border-slate-800">
                <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">50 bản ghi gần nhất</span>
            </div>
            @if (!Model.Redemptions.Any())
            {
                <div class="p-10 text-center text-slate-400 text-sm">@(isEn ? "No reward history yet." : "Chưa có lịch sử phần thưởng.")</div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="bg-slate-50 dark:bg-slate-800/50 text-xs text-slate-500 uppercase">
                            <tr>
                                <th class="px-4 py-3 text-left">Người dùng</th>
                                <th class="px-4 py-3 text-left">Chiến dịch</th>
                                <th class="px-4 py-3 text-left">Loại</th>
                                <th class="px-4 py-3 text-right">Số xu</th>
                                <th class="px-4 py-3 text-right">Thời gian</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                            @foreach (var r in Model.Redemptions)
                            {
                                var redeemType = r.PromoCodeID.HasValue ? $"Mã: {r.PromoCode?.Code}"
                                    : r.VoucherID.HasValue ? $"Voucher: {r.Voucher?.Code}"
                                    : "Tự động / Thủ công";
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
                                    <td class="px-4 py-3">
                                        <p class="font-medium text-slate-800 dark:text-slate-200">@(r.User?.FullName ?? $"#{r.UserID}")</p>
                                        <p class="text-xs text-slate-400">@r.User?.Email</p>
                                    </td>
                                    <td class="px-4 py-3 text-slate-600 dark:text-slate-400">@(r.Campaign?.Name ?? "—")</td>
                                    <td class="px-4 py-3 text-slate-500 text-xs font-mono">@redeemType</td>
                                    <td class="px-4 py-3 text-right font-bold text-emerald-600 dark:text-emerald-400">+@r.AmountCredited.ToString("N0")đ</td>
                                    <td class="px-4 py-3 text-right text-xs text-slate-400">@r.RedeemedAt.ToLocalTime().ToString("HH:mm dd/MM/yy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<!-- Distribute confirm modal (replaces browser confirm) -->
<div id="distributeConfirmModal" class="hidden fixed inset-0 z-[1200] bg-black/50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-md shadow-2xl max-w-sm w-full p-6">
        <p id="distConfirmMsg" class="font-semibold text-slate-800 dark:text-white text-sm"></p>
        <p id="distConfirmSub" class="text-xs text-slate-500 mt-1 hidden"></p>
        <div class="flex gap-3 mt-5 justify-end">
            <button type="button" onclick="closeDistributeModal()"
                    class="px-4 py-2 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-sm">Hủy</button>
            <button id="distConfirmBtn" type="button"
                    class="px-4 py-2 rounded-md bg-amber-500 hover:bg-amber-600 text-white font-bold text-sm">Xác nhận</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
const CAMPAIGN_NAME = '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedCampaign?.Name ?? ""))';
const RAND_CHARS = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';

function genRandCode() {
    var len = 8;
    var code = '';
    for (var i = 0; i < len; i++)
        code += RAND_CHARS[Math.floor(Math.random() * RAND_CHARS.length)];
    var inp = document.getElementById('singleCodeInput');
    if (inp) inp.value = code;
}

async function aiSuggestCodes() {
    var btn = document.getElementById('aiSuggestBtn');
    var box = document.getElementById('aiCodeSuggestions');
    if (!btn || !box) return;
    var name = CAMPAIGN_NAME.replace(/^"|"$/g, '');
    if (!name) { typeof _showWalletToast !== 'undefined' ? _showWalletToast('Vui lòng chọn chiến dịch trước.', 'rose') : alert('Vui lòng chọn chiến dịch trước.'); return; }

    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined text-[14px] animate-spin">refresh</span> Đang tạo...';
    box.classList.add('hidden');

    try {
        var res = await fetch('/api/admin-insight/suggest-promo-codes?campaignName=' + encodeURIComponent(name) + '&count=5');
        var d = await res.json();
        var codes = d.codes || [];
        if (codes.length === 0) {
            box.innerHTML = '<p class="text-xs text-slate-400">AI không thể tạo mã. Thử lại hoặc nhập thủ công.</p>';
        } else {
            box.innerHTML = '<p class="text-[10px] text-slate-400 mb-1">Nhấn để chọn:</p>' +
                codes.map(function (c) {
                    return '<button type="button" onclick="selectAiCode(\'' + c + '\')" ' +
                        'class="block w-full text-left px-3 py-1.5 rounded-md bg-violet-50 dark:bg-violet-900/20 border border-violet-200 dark:border-violet-700 text-violet-700 dark:text-violet-400 text-xs font-mono font-bold hover:bg-violet-100 transition-colors">' +
                        c + '</button>';
                }).join('');
        }
        box.classList.remove('hidden');
    } catch {
        box.innerHTML = '<p class="text-xs text-rose-400">Lỗi kết nối AI.</p>';
        box.classList.remove('hidden');
    }
    btn.disabled = false;
    btn.innerHTML = '<span class="material-symbols-outlined text-[14px]">auto_awesome</span> AI gợi ý mã';
}

function selectAiCode(code) {
    var inp = document.getElementById('singleCodeInput');
    if (inp) inp.value = code;
    document.getElementById('aiCodeSuggestions').classList.add('hidden');
}

async function previewDistribute(campaignId, amountLabel, campaignName) {
    try {
        const res = await fetch('/api/admin-insight/campaign-eligible-count/' + campaignId);
        if (!res.ok) throw new Error();
        const data = await res.json();
        const count = data.count;
        if (count === 0) {
            _showDistributeModal('Không có người dùng nào đủ điều kiện cho chiến dịch này.', null, null);
            return;
        }
        _showDistributeModal(
            `Phát +${amountLabel} cho ${count} người dùng đủ điều kiện?`,
            'Hành động này không thể hoàn tác.',
            function() { document.getElementById('dist-form-' + campaignId).submit(); }
        );
    } catch {
        _showDistributeModal(
            `Không lấy được số lượng ước tính. Vẫn phát thưởng cho chiến dịch "${campaignName}"?`,
            null,
            function() { document.getElementById('dist-form-' + campaignId).submit(); }
        );
    }
}

function _showDistributeModal(msg, sub, onConfirm) {
    var modal = document.getElementById('distributeConfirmModal');
    document.getElementById('distConfirmMsg').textContent = msg;
    document.getElementById('distConfirmSub').textContent = sub || '';
    document.getElementById('distConfirmSub').classList.toggle('hidden', !sub);
    var btn = document.getElementById('distConfirmBtn');
    if (onConfirm) {
        btn.classList.remove('hidden');
        btn.onclick = function() { closeDistributeModal(); onConfirm(); };
    } else {
        btn.classList.add('hidden');
    }
    modal.classList.remove('hidden');
}
function closeDistributeModal() {
    document.getElementById('distributeConfirmModal').classList.add('hidden');
}
</script>
}
