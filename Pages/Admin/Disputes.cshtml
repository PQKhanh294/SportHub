@page
@model SportHub.Pages.Admin.DisputesModel
@using System.Globalization
@{
    ViewData["Title"] = "Admin — Khiếu nại";
    ViewData["AdminPage"] = "Disputes";
    var isEn = false; // Admin thuần tiếng Việt — công cụ nội bộ, không song ngữ
    string StatusBadge(string s) => s switch {
        "Pending"       => "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300",
        "UnderReview"   => "bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300",
        "AdminResolved" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300",
        "AutoResolved"  => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300",
        "Dismissed"     => "bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400",
        _ => ""
    };
    string StatusLabel(string s) => s switch {
        "Pending"       => "Đang chờ",
        "UnderReview"   => "Đang xem xét",
        "AdminResolved" => "Đã giải quyết",
        "AutoResolved"  => "Tự động đóng",
        "Dismissed"     => "Đã bác",
        _ => s
    };
    string TypeLabel(string t) => t switch {
        "HostNoShow"      => "Host vắng mặt",
        "PlayerNoShow"    => "Người chơi vắng mặt",
        "WrongVenue"      => "Sai địa điểm",
        "QualityIssue"    => "Vấn đề chất lượng",
        "PaymentDispute"  => "Tranh chấp thanh toán",
        "PlayerMisconduct"=> "Người chơi vi phạm",
        _ => t
    };
    // EvidenceUrl: record mới là JSON array, record cũ là URL đơn
    List<string> EvidenceUrls(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return new();
        if (!raw.TrimStart().StartsWith("[")) return new() { raw };
        try { return System.Text.Json.JsonSerializer.Deserialize<List<string>>(raw) ?? new(); }
        catch { return new() { raw }; }
    }
    (string Summary, string Suggested, List<string> KeyPoints) ParseAi(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return ("", "", new());
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            var summary = root.TryGetProperty("summary", out var s) ? s.GetString() ?? "" : "";
            var suggested = root.TryGetProperty("suggestedResolution", out var g) ? g.GetString() ?? "" : "";
            var points = new List<string>();
            if (root.TryGetProperty("keyPoints", out var kp) && kp.ValueKind == System.Text.Json.JsonValueKind.Array)
                foreach (var p in kp.EnumerateArray()) points.Add(p.GetString() ?? "");
            return (summary, suggested, points);
        }
        catch { return ("", "", new()); }
    }
    string StanceLabel(string s) => s switch {
        "Support" => "✅ Đồng ý", "Oppose" => "❌ Phản đối", "Neutral" => "🤷 Trung lập", _ => "⏳ Chưa phản hồi"
    };
}

<div class="space-y-6">
    <div>
        <h1 class="text-lg sm:text-2xl font-black text-slate-800 dark:text-white tracking-tight">@(isEn ? "Match Disputes" : "Khiếu nại trận đấu")</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@(isEn ? $"{Model.PendingCount} disputes awaiting review" : $"{Model.PendingCount} khiếu nại chờ xử lý")</p>
    </div>

    @await Html.PartialAsync("_AdminNav")

    <form method="get" class="space-y-2">
        <input type="hidden" name="tab" value="@Model.ActiveTab" />
        <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400 text-[18px]">search</span>
            <input type="text" name="search" value="@Model.Search"
                   placeholder="@(isEn ? "Search by reporter / match…" : "Tìm theo người báo cáo / trận…")"
                   class="w-full pl-9 pr-4 py-2 text-sm rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
        </div>
        <div class="flex flex-wrap gap-2">
            <a asp-page="Disputes" asp-route-tab="pending" asp-route-search="@Model.Search" asp-route-filterType="@Model.FilterType"
               class="px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-md border transition-colors whitespace-nowrap @(Model.ActiveTab == "pending" ? "bg-primary text-white border-primary" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "Pending" : "Đang chờ") (@Model.PendingCount)
            </a>
            <a asp-page="Disputes" asp-route-tab="all" asp-route-search="@Model.Search" asp-route-filterType="@Model.FilterType"
               class="px-3 py-1.5 text-xs sm:text-sm font-semibold rounded-md border transition-colors whitespace-nowrap @(Model.ActiveTab == "all" ? "bg-primary text-white border-primary" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "All" : "Tất cả")
            </a>
            <span class="w-px bg-slate-200 dark:bg-slate-700 self-stretch mx-1"></span>
            @foreach (var (dtype, dlabel) in new[] {
                ("HostNoShow", isEn ? "Host no-show" : "Host vắng"),
                ("PlayerNoShow", isEn ? "Player no-show" : "Player vắng"),
                ("WrongVenue", isEn ? "Wrong venue" : "Sai địa điểm"),
                ("QualityIssue", isEn ? "Quality" : "Chất lượng"),
                ("PaymentDispute", isEn ? "Payment" : "Thanh toán")
            })
            {
                <a asp-page="Disputes" asp-route-tab="@Model.ActiveTab" asp-route-search="@Model.Search" asp-route-filterType="@(Model.FilterType == dtype ? null : dtype)"
                   class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors whitespace-nowrap @(Model.FilterType == dtype ? "bg-slate-700 text-white border-slate-700" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                    @dlabel
                </a>
            }
        </div>
    </form>

    @if (TempData["Msg"] != null)
    {
        <div class="px-4 py-3 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 rounded-md text-sm font-semibold">
            @TempData["Msg"]
        </div>
    }

    @if (!Model.Disputes.Any())
    {
        <div class="text-center py-20 text-slate-400">
            <span class="material-symbols-outlined text-5xl mb-3 block">gavel</span>
            <p class="font-semibold">@(isEn ? "No disputes found" : "Không có khiếu nại nào")</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var d in Model.Disputes)
            {
                <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 overflow-hidden">
                    <div class="p-5">
                        <div class="flex items-start justify-between gap-4 flex-wrap">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap mb-2">
                                    <span class="text-xs font-bold px-2 py-0.5 rounded-md @StatusBadge(d.Status)">@StatusLabel(d.Status)</span>
                                    <span class="text-xs px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold">@TypeLabel(d.DisputeType)</span>
                                    <span class="text-xs text-slate-400">#@d.Id · @d.CreatedAt.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <p class="font-bold text-slate-800 dark:text-white truncate">
                                    <a asp-page="/Matchmaking/Details" asp-route-id="@d.MatchId" class="hover:text-primary transition-colors">
                                        @(d.Match?.Title ?? $"Trận #{d.MatchId}")
                                    </a>
                                </p>
                                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                                    @(isEn ? "Reporter" : "Người báo cáo"): <span class="font-semibold text-slate-700 dark:text-slate-300">@(d.Reporter?.FullName ?? "?")</span>
                                    · @(d.Reporter?.Email ?? "")
                                </p>
                                <p class="text-sm text-slate-700 dark:text-slate-300 mt-2">@d.Description</p>
                                @{
                                    var evidences = EvidenceUrls(d.EvidenceUrl);
                                }
                                @if (evidences.Any())
                                {
                                    <div class="mt-2">
                                        <div class="flex flex-wrap gap-2">
                                            @foreach (var url in evidences)
                                            {
                                                <a href="@url" target="_blank" class="inline-block">
                                                    <img src="@url" alt="Evidence" class="h-28 rounded-md object-cover border border-slate-200 dark:border-slate-700 hover:opacity-90 transition-opacity" />
                                                </a>
                                            }
                                        </div>
                                        <p class="text-xs text-slate-400 mt-0.5">@evidences.Count ảnh bằng chứng (nhấn để phóng to)</p>
                                    </div>
                                }

                                @* ── AI analysis card ── *@
                                @if (d.AiScore.HasValue)
                                {
                                    var ai = ParseAi(d.AiSummary);
                                    var scoreColor = d.AiScore >= 70 ? "text-emerald-600 bg-emerald-50 dark:bg-emerald-900/20 border-emerald-200 dark:border-emerald-800"
                                        : d.AiScore >= 40 ? "text-amber-600 bg-amber-50 dark:bg-amber-900/20 border-amber-200 dark:border-amber-800"
                                        : "text-rose-600 bg-rose-50 dark:bg-rose-900/20 border-rose-200 dark:border-rose-800";
                                    <div class="mt-3 p-3 rounded-md border @scoreColor">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="material-symbols-outlined text-base">psychology</span>
                                            <span class="text-sm font-black">AI: Độ tin cậy @d.AiScore/100</span>
                                            @if (!string.IsNullOrEmpty(ai.Suggested))
                                            {
                                                <span class="text-xs font-bold px-2 py-0.5 rounded bg-white/60 dark:bg-slate-900/40">Gợi ý: @ai.Suggested</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(ai.Summary))
                                        {
                                            <p class="text-xs mt-1.5">@ai.Summary</p>
                                        }
                                        @if (ai.KeyPoints.Any())
                                        {
                                            <ul class="text-xs mt-1 list-disc list-inside space-y-0.5">
                                                @foreach (var p in ai.KeyPoints) { <li>@p</li> }
                                            </ul>
                                        }
                                        <p class="text-[10px] mt-1.5 opacity-70">AI chỉ hỗ trợ tham khảo — quyết định cuối thuộc về admin.</p>
                                    </div>
                                }
                                else if (d.Status is "Pending" or "UnderReview")
                                {
                                    <form method="post" asp-page-handler="RunAi" class="mt-2 inline-block">
                                        <input type="hidden" name="disputeId" value="@d.Id" />
                                        <button type="submit" class="text-xs font-bold text-primary bg-primary/10 hover:bg-primary/20 rounded-md px-3 py-1.5 flex items-center gap-1">
                                            <span class="material-symbols-outlined text-sm">psychology</span> Chạy phân tích AI
                                        </button>
                                    </form>
                                }

                                @* ── Witness responses ── *@
                                @if (d.WitnessResponses.Any())
                                {
                                    var respondedCount = d.WitnessResponses.Count(w => w.RespondedAt != null);
                                    <details class="mt-3">
                                        <summary class="text-xs font-bold text-slate-500 cursor-pointer select-none">
                                            Nhân chứng: @respondedCount/@d.WitnessResponses.Count đã phản hồi
                                            (✅ @d.WitnessResponses.Count(w => w.Stance == "Support") ·
                                             ❌ @d.WitnessResponses.Count(w => w.Stance == "Oppose") ·
                                             🤷 @d.WitnessResponses.Count(w => w.Stance == "Neutral"))
                                        </summary>
                                        <div class="mt-2 space-y-1.5">
                                            @foreach (var w in d.WitnessResponses)
                                            {
                                                <div class="text-xs px-3 py-2 bg-slate-50 dark:bg-slate-800 rounded-md flex items-start gap-2 flex-wrap">
                                                    <span class="font-semibold">@(w.Witness?.FullName ?? $"User #{w.WitnessUserId}")</span>
                                                    <span>@StanceLabel(w.Stance)</span>
                                                    @if (!string.IsNullOrEmpty(w.Comment)) { <span class="text-slate-500 w-full">"@w.Comment"</span> }
                                                    @if (!string.IsNullOrEmpty(w.EvidenceUrl))
                                                    {
                                                        <a href="@w.EvidenceUrl" target="_blank" class="text-primary underline">Xem ảnh</a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </details>
                                }

                                @if (d.Resolution != null)
                                {
                                    <div class="mt-2 text-xs px-3 py-2 bg-slate-50 dark:bg-slate-800 rounded-md">
                                        <span class="font-semibold">@(isEn ? "Outcome" : "Kết quả"):</span> @d.Resolution
                                        @if (d.RefundAmount.HasValue && d.RefundAmount > 0)
                                        {
                                            <span class="ml-2 text-emerald-600 dark:text-emerald-400 font-semibold">· Đã hoàn @d.RefundAmount.Value.ToString("N0") xu</span>
                                        }
                                    </div>
                                }
                                @if (d.AdminNote != null)
                                {
                                    <p class="mt-1 text-xs text-slate-400 italic">@(isEn ? "Admin note" : "Ghi chú admin"): @d.AdminNote</p>
                                }
                            </div>

                            @if (d.Status == "Pending" || d.Status == "UnderReview")
                            {
                                <button onclick="openResolveModal(@d.Id, '@d.Match?.Title?.Replace("'", "\\'") ', @d.ReporterId)"
                                        class="px-4 py-2 bg-primary text-white rounded-md font-bold text-sm hover:bg-primary/90 transition-colors whitespace-nowrap">
                                    @(isEn ? "Resolve" : "Xử lý")
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.ActiveTab == "all")
        {
            <div class="flex justify-center gap-3">
                @if (Model.P > 1)
                {
                    <a asp-page="Disputes" asp-route-tab="all" asp-route-p="@(Model.P - 1)"
                       class="px-4 py-2 rounded-md bg-slate-100 dark:bg-slate-800 font-semibold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">← Trước</a>
                }
                @if (Model.Disputes.Count == 20)
                {
                    <a asp-page="Disputes" asp-route-tab="all" asp-route-p="@(Model.P + 1)"
                       class="px-4 py-2 rounded-md bg-slate-100 dark:bg-slate-800 font-semibold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">Sau →</a>
                }
            </div>
        }
    }
</div>

@* Resolve Modal *@
<div id="resolveModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/50 px-4">
    <div class="bg-white dark:bg-slate-900 rounded-md shadow-2xl w-full max-w-md p-6">
        <h2 class="text-lg font-black text-slate-800 dark:text-white mb-4">Xử lý khiếu nại</h2>
        <form id="resolveForm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="rDisputeId" name="disputeId" />
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1 text-slate-700 dark:text-slate-300">Ghi chú gửi người dùng</label>
                <textarea name="adminNote" rows="3" required
                          class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm focus:ring-primary focus:border-primary"></textarea>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold mb-1 text-slate-700 dark:text-slate-300">Kết quả xử lý</label>
                <select name="resolution" class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm">
                    <option value="FullRefund">Hoàn tiền toàn bộ</option>
                    <option value="PartialRefund">Hoàn tiền một phần</option>
                    <option value="NoRefund">Không hoàn tiền</option>
                    <option value="Warning">Cảnh cáo người dùng</option>
                </select>
            </div>
            <div class="mb-5">
                <label class="block text-sm font-semibold mb-1 text-slate-700 dark:text-slate-300">Số xu hoàn (nếu có)</label>
                <input type="number" name="refundAmount" min="0" step="1000"
                       class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" placeholder="0" />
            </div>
            <div class="flex gap-3">
                <button type="submit" formaction="/Admin/Disputes?handler=Resolve"
                        class="flex-1 py-2.5 bg-primary text-white rounded-md font-bold text-sm hover:bg-primary/90 transition-colors">
                    Giải quyết
                </button>
                <button type="submit" formaction="/Admin/Disputes?handler=Dismiss"
                        class="flex-1 py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md font-bold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                    Bác khiếu nại
                </button>
                <button type="button" onclick="closeResolveModal()"
                        class="px-4 py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-500 rounded-md font-bold text-sm hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                    Hủy
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openResolveModal(id, title, reporterId) {
    document.getElementById('rDisputeId').value = id;
    document.getElementById('resolveModal').classList.remove('hidden');
    document.getElementById('resolveModal').classList.add('flex');
}
function closeResolveModal() {
    document.getElementById('resolveModal').classList.add('hidden');
    document.getElementById('resolveModal').classList.remove('flex');
}
document.getElementById('resolveModal').addEventListener('click', function(e) {
    if (e.target === this) closeResolveModal();
});
</script>
