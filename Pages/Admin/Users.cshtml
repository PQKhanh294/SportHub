@page
@model SportHub.Pages.Admin.AdminUsersModel
@{
    ViewData["Title"] = "Admin — Người dùng";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-white">Người dùng</h1>
            <p class="text-sm text-slate-500 mt-1">@Model.Users.Count tài khoản</p>
        </div>
    </div>

    @await Html.PartialAsync("_AdminNav")

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-xl text-emerald-700 dark:text-emerald-400 font-medium">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-xl text-rose-700 dark:text-rose-400 font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Search -->
    <form method="get" class="flex gap-2">
        <input name="search" value="@Model.Search" placeholder="Tìm theo tên hoặc email..."
               class="flex-1 rounded-lg border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 text-sm" />
        <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-semibold">Tìm</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-page="/Admin/Users" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-lg text-sm font-semibold">Xóa lọc</a>
        }
    </form>

    <!-- Users table -->
    <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 dark:bg-slate-800 text-xs text-slate-500 uppercase tracking-wider">
                    <tr>
                        <th class="px-4 py-3 text-left">Người dùng</th>
                        <th class="px-4 py-3 text-left">Email</th>
                        <th class="px-4 py-3 text-left">Vai trò</th>
                        <th class="px-4 py-3 text-right">Số dư ví</th>
                        <th class="px-4 py-3 text-left">Ngày tham gia</th>
                        <th class="px-4 py-3 text-center">Trạng thái</th>
                        <th class="px-4 py-3 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var user in Model.Users)
                    {
                        var roles = user.UserRoles.Select(ur => ur.Role?.RoleName).Where(r => r != null);
                        var avatarUrl = string.IsNullOrWhiteSpace(user.AvatarUrl)
                            ? "/images/avatar-default.png"
                            : user.AvatarUrl;
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <img src="@avatarUrl" class="size-8 rounded-full object-cover flex-shrink-0" alt="@user.FullName" />
                                    <div>
                                        <p class="font-semibold text-slate-900 dark:text-white">@user.FullName</p>
                                        <p class="text-xs text-slate-400">#@user.UserID</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-600 dark:text-slate-400">@user.Email</td>
                            <td class="px-4 py-3">
                                @foreach (var role in roles)
                                {
                                    var roleColor = role switch {
                                        "Admin"      => "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400",
                                        "CourtOwner" => "bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400",
                                        _            => "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400"
                                    };
                                    <span class="px-2 py-0.5 rounded-full text-xs font-bold @roleColor">@role</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-right">
                                <span class="text-sm font-bold @(user.WalletBalance > 0 ? "text-emerald-600" : "text-slate-400")">@user.WalletBalance.ToString("N0") ₫</span>
                            </td>
                            <td class="px-4 py-3 text-slate-500 text-xs">@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 text-center">
                                @if (user.IsActive)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-rose-50 dark:bg-rose-900/20 text-rose-700 dark:text-rose-400">Đã khóa</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <div class="flex items-center justify-center gap-2 flex-wrap">
                                    <form method="post" asp-page-handler="ToggleActive" class="inline">
                                        <input type="hidden" name="userId" value="@user.UserID" />
                                        <input type="hidden" name="currentActive" value="@user.IsActive.ToString().ToLower()" />
                                        <button type="submit"
                                                class="px-3 py-1 text-xs font-semibold rounded-lg transition-colors @(user.IsActive ? "bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-100 text-rose-600" : "bg-emerald-50 dark:bg-emerald-900/20 hover:bg-emerald-100 text-emerald-600")">
                                            @(user.IsActive ? "Khóa" : "Mở khóa")
                                        </button>
                                    </form>
                                    <button type="button" onclick="openCreditModal(@user.UserID, '@user.FullName.Replace("'","\\'")')"
                                            class="px-3 py-1 text-xs font-semibold rounded-lg bg-emerald-50 dark:bg-emerald-900/20 hover:bg-emerald-100 text-emerald-700 transition-colors">
                                        + Ví
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Credit Wallet Modal -->
<div id="creditModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-xl w-full max-w-sm mx-4 p-6">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Cộng tiền vào ví</h3>
        <p id="creditModalName" class="text-sm text-slate-500 mb-4"></p>
        <form method="post" asp-page-handler="CreditWallet">
            <input type="hidden" name="userId" id="creditUserId" />
            <div class="space-y-3">
                <div>
                    <label class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1 block">Số tiền (VND)</label>
                    <input type="number" name="amount" min="1000" step="1000" required placeholder="vd: 10000"
                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1 block">Lý do</label>
                    <input type="text" name="description" placeholder="vd: Hoàn tiền cọc trận #5"
                           class="w-full rounded-lg border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 text-sm" />
                </div>
            </div>
            <div class="flex gap-2 mt-4">
                <button type="submit" class="flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-semibold transition-colors">Xác nhận</button>
                <button type="button" onclick="document.getElementById('creditModal').classList.add('hidden')"
                        class="flex-1 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-sm font-semibold">Hủy</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function openCreditModal(userId, name) {
    document.getElementById('creditUserId').value = userId;
    document.getElementById('creditModalName').textContent = name + ' (#' + userId + ')';
    document.getElementById('creditModal').classList.remove('hidden');
}
</script>
}
