@page
@model SportHub.Pages.Admin.AdminUsersModel
@using System.Globalization
@{
    ViewData["Title"] = "Admin — Người dùng";
    var isEn = false; // Admin thuần tiếng Việt — công cụ nội bộ, không song ngữ
    var activeCount   = Model.Users.Count(u => u.IsActive);
    var inactiveCount = Model.Users.Count(u => !u.IsActive);
    var joinedByMonth = Model.Users
        .GroupBy(u => u.CreatedAt.ToString("MM/yy"))
        .OrderBy(g => g.Key)
        .TakeLast(6)
        .ToList();
    var monthLabels = string.Join(",", joinedByMonth.Select(g => $"\"{g.Key}\""));
    var monthCounts = string.Join(",", joinedByMonth.Select(g => g.Count()));
    string RoleLabel(string r) => r switch
    {
        "Admin" => "Admin",
        "CourtOwner" => "Chủ sân",
        "Player" => "Người chơi",
        _ => r
    };
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white">@(isEn ? "Users" : "Người dùng")</h1>
            <p class="text-sm text-slate-500 mt-1">@Model.TotalCount @(isEn ? "accounts" : "tài khoản") — @(isEn ? "page" : "trang") @Model.PageNumber/@(Math.Max(1,Model.TotalPages))</p>
        </div>
    </div>

    @await Html.PartialAsync("_AdminNav")

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-md text-emerald-700 dark:text-emerald-400 font-medium">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-md text-rose-700 dark:text-rose-400 font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Search + filter -->
    <form method="get" class="space-y-2">
        <input type="hidden" name="filterRole" value="@Model.FilterRole" />
        <input type="hidden" name="filterStatus" value="@Model.FilterStatus" />
        <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400 text-[18px]">search</span>
            <input name="search" value="@Model.Search" placeholder="@(isEn ? "Search by name or email..." : "Tìm theo tên hoặc email...")"
                   class="w-full pl-9 pr-4 py-2 text-sm rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
        </div>
        <div class="flex flex-wrap gap-2">
            <a asp-page="/Admin/Users" asp-route-search="@Model.Search" asp-route-filterStatus="@Model.FilterStatus"
               class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(string.IsNullOrWhiteSpace(Model.FilterRole) ? "bg-primary text-white border-primary" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "All roles" : "Tất cả")
            </a>
            @* Chỉ 3 role thật sự tồn tại trong bảng Roles: Admin, CourtOwner, Player.
               (trước đây có tab "Host"/"User" không khớp RoleName nào — lọc luôn ra rỗng) *@
            @foreach (var (role, color, label) in new[] {
                ("Admin","rose", "Admin"),
                ("CourtOwner","purple", "Chủ sân"),
                ("Player","slate", "Người chơi")
            })
            {
                var active = Model.FilterRole == role;
                <a asp-page="/Admin/Users" asp-route-search="@Model.Search" asp-route-filterRole="@role" asp-route-filterStatus="@Model.FilterStatus"
                   class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(active ? $"bg-{color}-500 text-white border-{color}-500" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                    @label
                </a>
            }
            <span class="w-px bg-slate-200 dark:bg-slate-700 mx-1"></span>
            <a asp-page="/Admin/Users" asp-route-search="@Model.Search" asp-route-filterRole="@Model.FilterRole"
               class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(string.IsNullOrWhiteSpace(Model.FilterStatus) ? "bg-slate-700 text-white border-slate-700" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "All status" : "Tất cả trạng thái")
            </a>
            <a asp-page="/Admin/Users" asp-route-search="@Model.Search" asp-route-filterRole="@Model.FilterRole" asp-route-filterStatus="active"
               class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(Model.FilterStatus == "active" ? "bg-emerald-500 text-white border-emerald-500" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "Active" : "Hoạt động")
            </a>
            <a asp-page="/Admin/Users" asp-route-search="@Model.Search" asp-route-filterRole="@Model.FilterRole" asp-route-filterStatus="banned"
               class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(Model.FilterStatus == "banned" ? "bg-rose-500 text-white border-rose-500" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "Banned" : "Bị khóa")
            </a>
        </div>
    </form>

    <!-- Users card list — mobile only -->
    <div class="sm:hidden space-y-2">
        @foreach (var user in Model.Users)
        {
            var mobileRoles = user.UserRoles.Select(ur => ur.Role?.RoleName).Where(r => r != null).Select(r => r!).ToList();
            var mobileAvatar = string.IsNullOrWhiteSpace(user.AvatarUrl) ? "/images/avatar-default.png" : user.AvatarUrl;
            var mobileRolesJson = System.Text.Json.JsonSerializer.Serialize(mobileRoles);
            var mobileNameJs = user.FullName.Replace("\\", "\\\\").Replace("'", "\\'");
            <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-3 shadow-sm">
                <div class="flex items-center gap-3">
                    <img src="@mobileAvatar" class="size-10 rounded-full object-cover flex-shrink-0" alt="@user.FullName" />
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="font-semibold text-slate-900 dark:text-white text-sm truncate flex items-center gap-1">
                                @user.FullName
                                @if (user.IsVerified)
                                {
                                    <span class="material-symbols-outlined text-blue-500 text-[13px]" style="font-variation-settings:'FILL' 1">verified</span>
                                }
                            </span>
                            @foreach (var role in mobileRoles)
                            {
                                var mrc = role switch {
                                    "Admin"      => "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400",
                                    "CourtOwner" => "bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400",
                                    _            => "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400"
                                };
                                <span class="px-1.5 py-0.5 rounded-md text-[10px] font-bold @mrc">@RoleLabel(role)</span>
                            }
                        </div>
                        <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                            <span class="text-xs text-slate-400">#@user.UserID</span>
                            @if (user.IsActive)
                            {
                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400">Hoạt động</span>
                            }
                            else
                            {
                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-rose-50 dark:bg-rose-900/20 text-rose-700 dark:text-rose-400">Đã khóa</span>
                            }
                            <span class="text-xs font-bold @(user.WalletBalance > 0 ? "text-emerald-600" : "text-slate-400")">@user.WalletBalance.ToString("N0") xu</span>
                            @if (user.EmailConfirmed)
                            {
                                <span class="text-[10px] font-bold text-emerald-600">Email đã xác thực</span>
                            }
                            else
                            {
                                <span class="text-[10px] font-bold text-amber-600">Email chưa xác thực</span>
                            }
                        </div>
                    </div>
                </div>
                <!-- Hàng nút ngang — thay cột dọc cũ vốn kéo card cao gấp 3 lần nội dung -->
                <div class="flex flex-wrap gap-1.5 mt-2">
                    <form method="post" asp-page-handler="ToggleActive" class="inline">
                        <input type="hidden" name="userId" value="@user.UserID" />
                        <input type="hidden" name="currentActive" value="@user.IsActive.ToString().ToLower()" />
                        <button type="submit" class="px-2.5 py-1 text-xs font-semibold rounded-md transition-colors @(user.IsActive ? "bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-100 text-rose-600" : "bg-emerald-50 dark:bg-emerald-900/20 hover:bg-emerald-100 text-emerald-600")">
                            @(user.IsActive ? "Khóa" : "Mở khóa")
                        </button>
                    </form>
                    <button type="button" onclick='openRoleModal(@user.UserID, "@mobileNameJs", @Html.Raw(mobileRolesJson))'
                            class="px-2.5 py-1 text-xs font-semibold rounded-md bg-blue-50 dark:bg-blue-900/20 hover:bg-blue-100 text-blue-700 transition-colors">
                        Vai trò
                    </button>
                    <form method="post" asp-page-handler="ToggleVerified" class="inline">
                        <input type="hidden" name="userId" value="@user.UserID" />
                        <input type="hidden" name="currentVerified" value="@user.IsVerified.ToString().ToLower()" />
                        <button type="submit" class="px-2.5 py-1 text-xs font-semibold rounded-md transition-colors @(user.IsVerified ? "bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-500" : "bg-sky-50 dark:bg-sky-900/20 hover:bg-sky-100 text-sky-700")">
                            @(user.IsVerified ? "Bỏ xác thực" : "Xác thực")
                        </button>
                    </form>
                    <button type="button" onclick="openCreditModal(@user.UserID, '@mobileNameJs')"
                            class="px-2.5 py-1 text-xs font-semibold rounded-md bg-emerald-50 dark:bg-emerald-900/20 hover:bg-emerald-100 text-emerald-700 transition-colors">
                        + Xu
                    </button>
                    <button type="button" onclick="openDebitModal(@user.UserID, '@mobileNameJs')"
                            class="px-2.5 py-1 text-xs font-semibold rounded-md bg-amber-50 dark:bg-amber-900/20 hover:bg-amber-100 text-amber-700 transition-colors">
                        − Xu
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Users table — desktop only -->
    <div class="hidden sm:block bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 dark:bg-slate-800 text-xs text-slate-500 uppercase tracking-wider">
                    <tr>
                        <th class="px-4 py-3 text-left">@(isEn ? "User" : "Người dùng")</th>
                        <th class="px-4 py-3 text-left">Email</th>
                        <th class="px-4 py-3 text-left">@(isEn ? "Role" : "Vai trò")</th>
                        <th class="px-4 py-3 text-right">@(isEn ? "Wallet Balance" : "Số dư ví")</th>
                        <th class="px-4 py-3 text-left">@(isEn ? "Joined" : "Ngày tham gia")</th>
                        <th class="px-4 py-3 text-center">@(isEn ? "Status" : "Trạng thái")</th>
                        <th class="px-4 py-3 text-center">@(isEn ? "Actions" : "Thao tác")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var user in Model.Users)
                    {
                        var roles = user.UserRoles.Select(ur => ur.Role?.RoleName).Where(r => r != null).Select(r => r!).ToList();
                        var avatarUrl = string.IsNullOrWhiteSpace(user.AvatarUrl)
                            ? "/images/avatar-default.png"
                            : user.AvatarUrl;
                        var rolesJson = System.Text.Json.JsonSerializer.Serialize(roles);
                        var nameJs = user.FullName.Replace("\\", "\\\\").Replace("'", "\\'");
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-3 min-w-0">
                                    <img src="@avatarUrl" class="size-8 rounded-full object-cover flex-shrink-0" alt="@user.FullName" />
                                    <div class="min-w-0">
                                        <p class="font-semibold text-slate-900 dark:text-white truncate flex items-center gap-1">
                                            @user.FullName
                                            @if (user.IsVerified)
                                            {
                                                <span class="material-symbols-outlined text-blue-500 text-[15px]" title="Đã xác thực" style="font-variation-settings:'FILL' 1">verified</span>
                                            }
                                        </p>
                                        <p class="text-xs text-slate-400">#@user.UserID</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-600 dark:text-slate-400">
                                @user.Email
                                @if (user.EmailConfirmed)
                                {
                                    <span class="block text-[10px] font-bold text-emerald-600">Email đã xác thực</span>
                                }
                                else
                                {
                                    <span class="block text-[10px] font-bold text-amber-600">Email chưa xác thực</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                @foreach (var role in roles)
                                {
                                    var roleColor = role switch {
                                        "Admin"      => "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400",
                                        "CourtOwner" => "bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400",
                                        _            => "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400"
                                    };
                                    <span class="px-2 py-0.5 rounded-md text-xs font-bold @roleColor">@RoleLabel(role)</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-right">
                                <span class="text-sm font-bold @(user.WalletBalance > 0 ? "text-emerald-600" : "text-slate-400")">@user.WalletBalance.ToString("N0") xu</span>
                            </td>
                            <td class="px-4 py-3 text-slate-500 text-xs">@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 text-center">
                                @if (user.IsActive)
                                {
                                    <span class="px-2 py-0.5 rounded-md text-xs font-bold bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400">@(isEn ? "Active" : "Hoạt động")</span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-md text-xs font-bold bg-rose-50 dark:bg-rose-900/20 text-rose-700 dark:text-rose-400">@(isEn ? "Suspended" : "Bị khóa")</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <div class="flex items-center justify-center gap-1.5 flex-wrap max-w-[220px] mx-auto">
                                    <form method="post" asp-page-handler="ToggleActive" class="inline">
                                        <input type="hidden" name="userId" value="@user.UserID" />
                                        <input type="hidden" name="currentActive" value="@user.IsActive.ToString().ToLower()" />
                                        <button type="submit"
                                                class="px-2.5 py-1 text-xs font-semibold rounded-md transition-colors @(user.IsActive ? "bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-100 text-rose-600" : "bg-emerald-50 dark:bg-emerald-900/20 hover:bg-emerald-100 text-emerald-600")">
                                            @(user.IsActive ? "Khóa" : "Mở khóa")
                                        </button>
                                    </form>
                                    <button type="button" onclick='openRoleModal(@user.UserID, "@nameJs", @Html.Raw(rolesJson))'
                                            class="px-2.5 py-1 text-xs font-semibold rounded-md bg-blue-50 dark:bg-blue-900/20 hover:bg-blue-100 text-blue-700 transition-colors">
                                        Vai trò
                                    </button>
                                    <form method="post" asp-page-handler="ToggleVerified" class="inline">
                                        <input type="hidden" name="userId" value="@user.UserID" />
                                        <input type="hidden" name="currentVerified" value="@user.IsVerified.ToString().ToLower()" />
                                        <button type="submit"
                                                class="px-2.5 py-1 text-xs font-semibold rounded-md transition-colors @(user.IsVerified ? "bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 text-slate-500" : "bg-sky-50 dark:bg-sky-900/20 hover:bg-sky-100 text-sky-700")">
                                            @(user.IsVerified ? "Bỏ xác thực" : "Xác thực")
                                        </button>
                                    </form>
                                    <button type="button" onclick="openCreditModal(@user.UserID, '@nameJs')"
                                            class="px-2.5 py-1 text-xs font-semibold rounded-md bg-emerald-50 dark:bg-emerald-900/20 hover:bg-emerald-100 text-emerald-700 transition-colors">
                                        + Xu
                                    </button>
                                    <button type="button" onclick="openDebitModal(@user.UserID, '@nameJs')"
                                            class="px-2.5 py-1 text-xs font-semibold rounded-md bg-amber-50 dark:bg-amber-900/20 hover:bg-amber-100 text-amber-700 transition-colors">
                                        − Xu
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-1">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                var isActive = i == Model.PageNumber;
                <a asp-page="/Admin/Users" asp-route-search="@Model.Search" asp-route-PageNumber="@i"
                   class="@(isActive ? "bg-primary text-white" : "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:border-primary hover:text-primary") w-9 h-9 rounded-md text-sm font-semibold flex items-center justify-center transition-colors">
                    @i
                </a>
            }
        </div>
    }
</div>

<!-- Credit Wallet Modal -->
<div id="creditModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-md shadow-xl w-full max-w-sm mx-4 p-6">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Cộng xu vào ví</h3>
        <p id="creditModalName" class="text-sm text-slate-500 mb-4"></p>
        <form method="post" asp-page-handler="CreditWallet">
            <input type="hidden" name="userId" id="creditUserId" />
            <div class="space-y-3">
                <div>
                    <label class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1 block">Số xu</label>
                    <input type="number" name="amount" min="1000" step="1000" required placeholder="VD: 10000"
                           class="w-full rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1 block">Lý do</label>
                    <input type="text" name="description" placeholder="VD: Hoàn tiền trận #5"
                           class="w-full rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 text-sm" />
                </div>
            </div>
            <div class="flex gap-2 mt-4">
                <button type="submit" class="flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-md text-sm font-semibold transition-colors">Xác nhận</button>
                <button type="button" onclick="document.getElementById('creditModal').classList.add('hidden')"
                        class="flex-1 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md text-sm font-semibold">Hủy</button>
            </div>
        </form>
    </div>
</div>

<!-- Debit Wallet Modal -->
<div id="debitModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-md shadow-xl w-full max-w-sm mx-4 p-6">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Trừ xu khỏi ví</h3>
        <p id="debitModalName" class="text-sm text-slate-500 mb-4"></p>
        <form method="post" asp-page-handler="DebitWallet">
            <input type="hidden" name="userId" id="debitUserId" />
            <div class="space-y-3">
                <div>
                    <label class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1 block">Số xu</label>
                    <input type="number" name="amount" min="1000" step="1000" required placeholder="VD: 10000"
                           class="w-full rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1 block">Lý do</label>
                    <input type="text" name="description" placeholder="VD: Sửa nhầm cộng xu #12"
                           class="w-full rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 text-sm" />
                </div>
                <p class="text-xs text-amber-600 dark:text-amber-400">⚠ Trừ sẽ thất bại nếu số dư người dùng không đủ.</p>
            </div>
            <div class="flex gap-2 mt-4">
                <button type="submit" class="flex-1 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-md text-sm font-semibold transition-colors">Xác nhận</button>
                <button type="button" onclick="document.getElementById('debitModal').classList.add('hidden')"
                        class="flex-1 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md text-sm font-semibold">Hủy</button>
            </div>
        </form>
    </div>
</div>

<!-- Set Role Modal -->
<div id="roleModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-900 rounded-md shadow-xl w-full max-w-sm mx-4 p-6">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Đổi vai trò</h3>
        <p id="roleModalName" class="text-sm text-slate-500 mb-4"></p>
        <form method="post" asp-page-handler="SetRoles">
            <input type="hidden" name="userId" id="roleUserId" />
            <div class="space-y-2">
                @foreach (var r in SportHub.Pages.Admin.AdminUsersModel.AllRoles)
                {
                    <label class="flex items-center gap-2.5 text-sm cursor-pointer p-2 rounded-md hover:bg-slate-50 dark:hover:bg-slate-800">
                        <input type="checkbox" name="roles" value="@r" class="role-checkbox w-4 h-4 rounded" data-role="@r" style="accent-color:#50A5B1" />
                        <span class="text-slate-700 dark:text-slate-300">@RoleLabel(r)</span>
                    </label>
                }
            </div>
            <div class="flex gap-2 mt-4">
                <button type="submit" class="flex-1 py-2 bg-primary hover:bg-primary/90 text-white rounded-md text-sm font-semibold transition-colors">Lưu</button>
                <button type="button" onclick="document.getElementById('roleModal').classList.add('hidden')"
                        class="flex-1 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md text-sm font-semibold">Hủy</button>
            </div>
        </form>
    </div>
</div>

<!-- Users chart section -->
<div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
    <button onclick="toggleAdminChart('users-chart-section', this)" class="w-full flex items-center justify-between px-5 py-3.5 text-left hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
        <div class="flex items-center gap-2 text-sm font-semibold text-slate-700 dark:text-slate-300">
            <span class="material-symbols-outlined text-primary text-[18px]">bar_chart</span>
            Biểu đồ người dùng
        </div>
        <span class="material-symbols-outlined text-slate-400 text-[18px] chart-chevron">expand_more</span>
    </button>
    <div id="users-chart-section" class="hidden px-5 pb-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-start">
            <div>
                <p class="text-xs text-slate-500 mb-3 font-semibold uppercase">@(isEn ? "Account status" : "Trạng thái tài khoản")</p>
                <div style="height:180px;position:relative">
                    <canvas id="usersStatusChart"></canvas>
                </div>
            </div>
            <div>
                <p class="text-xs text-slate-500 mb-3 font-semibold uppercase">@(isEn ? "Signups — last 6 months" : "Đăng ký — 6 tháng qua")</p>
                <div style="height:180px;position:relative">
                    <canvas id="usersJoinChart"></canvas>
                </div>
            </div>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800">
            <button onclick="loadAiInsight('users', '@Model.Users.Count', '@activeCount', '@inactiveCount', '')" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-primary border border-primary/30 bg-primary/5 hover:bg-primary/10 rounded-md transition-colors">
                <span class="material-symbols-outlined text-[15px]">auto_awesome</span>
                Phân tích AI
            </button>
            <div id="ai-insight-users" class="hidden mt-3 p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md text-xs text-slate-600 dark:text-slate-400 leading-relaxed"></div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
function toggleAdminChart(sectionId, btn) {
    var section = document.getElementById(sectionId);
    var chevron = btn.querySelector('.chart-chevron');
    if (!section) return;
    if (section.classList.contains('hidden')) {
        section.classList.remove('hidden');
        if (chevron) chevron.style.transform = 'rotate(180deg)';
        initUsersCharts();
    } else {
        section.classList.add('hidden');
        if (chevron) chevron.style.transform = '';
    }
}
var _usersChartsInited = false;
function initUsersCharts() {
    if (_usersChartsInited) return;
    _usersChartsInited = true;
    var ctx1 = document.getElementById('usersStatusChart');
    if (ctx1) new Chart(ctx1, {
        type: 'doughnut',
        data: { labels: ['Hoạt động', 'Đã khóa'], datasets: [{ data: [@activeCount, @inactiveCount], backgroundColor: ['#10b981','#ef4444'], borderWidth: 0 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } }, cutout: '55%' }
    });
    var ctx2 = document.getElementById('usersJoinChart');
    if (ctx2) new Chart(ctx2, {
        type: 'bar',
        data: { labels: [@Html.Raw(monthLabels)], datasets: [{ label: 'Đăng ký mới', data: [@Html.Raw(monthCounts)], backgroundColor: '#50A5B1', borderRadius: 6 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } } } }
    });
}
function openCreditModal(userId, name) {
    document.getElementById('creditUserId').value = userId;
    document.getElementById('creditModalName').textContent = name + ' (#' + userId + ')';
    document.getElementById('creditModal').classList.remove('hidden');
}
function openDebitModal(userId, name) {
    document.getElementById('debitUserId').value = userId;
    document.getElementById('debitModalName').textContent = name + ' (#' + userId + ')';
    document.getElementById('debitModal').classList.remove('hidden');
}
function openRoleModal(userId, name, currentRoles) {
    document.getElementById('roleUserId').value = userId;
    document.getElementById('roleModalName').textContent = name + ' (#' + userId + ')';
    document.querySelectorAll('.role-checkbox').forEach(function (cb) {
        cb.checked = currentRoles.indexOf(cb.dataset.role) !== -1;
    });
    document.getElementById('roleModal').classList.remove('hidden');
}
</script>
}
