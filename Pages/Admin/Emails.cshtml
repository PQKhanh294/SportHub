@page
@model SportHub.Pages.Admin.EmailsModel
@{
    ViewData["Title"] = "Admin — Emails";
}

<div class="space-y-5">
    <partial name="_AdminNav" />

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
            <h1 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white">Quản lý gửi mail</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">Kiểm tra cấu hình Resend và xem các loại email hệ thống đang gửi tự động.</p>
        </div>
    </div>

    <!-- Gửi email test -->
    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm p-4 sm:p-5">
        <h2 class="font-bold text-slate-800 dark:text-slate-200 mb-1 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">forward_to_inbox</span>
            Gửi email test
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Dùng để kiểm tra API key Resend còn hoạt động và địa chỉ gửi (From) đã xác thực domain chưa. Để trống sẽ gửi tới email của chính bạn.</p>

        <div class="flex flex-col sm:flex-row gap-2">
            <input id="testEmailTo" type="email" placeholder="vd: user@example.com (để trống = email của bạn)"
                   class="flex-1 rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 text-sm" />
            <button type="button" id="testEmailBtn" onclick="sendTestEmail()"
                    class="px-4 py-2 bg-primary text-white rounded-md text-sm font-semibold hover:bg-primary/90 flex items-center justify-center gap-1.5 shrink-0">
                <span class="material-symbols-outlined text-base">send</span>
                Gửi email test
            </button>
        </div>

        <div id="testEmailResult" class="hidden mt-3 p-3 rounded-md text-sm font-medium"></div>
    </div>

    <!-- Danh sách email tự động -->
    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="px-5 py-3 border-b border-slate-100 dark:border-slate-800">
            <h2 class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">mail</span>
                Email hệ thống đang gửi tự động
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Qua Resend — chỉ gửi khi người dùng bật "Nhận thông báo qua email" và có email hợp lệ.</p>
        </div>

        <div class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50">
            <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide">Nhóm bảo mật tài khoản</p>
        </div>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
            <div class="px-5 py-3 flex items-start gap-3">
                <span class="material-symbols-outlined text-slate-400 text-lg mt-0.5">password</span>
                <div>
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Mã OTP xác thực</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Gửi khi đăng ký tài khoản mới hoặc đăng nhập cần xác thực OTP.</p>
                </div>
            </div>
            <div class="px-5 py-3 flex items-start gap-3">
                <span class="material-symbols-outlined text-slate-400 text-lg mt-0.5">lock_reset</span>
                <div>
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Quên mật khẩu</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Gửi link đặt lại mật khẩu khi người dùng yêu cầu ở trang đăng nhập.</p>
                </div>
            </div>
        </div>

        <div class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50">
            <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide">Nhóm ví & khuyến mãi</p>
        </div>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
            <div class="px-5 py-3 flex items-start gap-3">
                <span class="material-symbols-outlined text-slate-400 text-lg mt-0.5">account_balance_wallet</span>
                <div>
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Ví được cộng tiền</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Gửi khi nạp ví thành công hoặc admin cộng xu thủ công. <strong>Không gửi</strong> khi hoàn tiền do hủy trận (đã gộp vào email "Trận đấu đã bị hủy" bên dưới để tránh trùng lặp).</p>
                </div>
            </div>
            <div class="px-5 py-3 flex items-start gap-3">
                <span class="material-symbols-outlined text-slate-400 text-lg mt-0.5">local_offer</span>
                <div>
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Mã khuyến mãi được tặng</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Gửi khi người dùng nhận được mã promo/voucher từ một campaign khuyến mãi.</p>
                </div>
            </div>
        </div>

        <div class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50">
            <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide">Nhóm hoạt động trận đấu</p>
        </div>
        <div class="divide-y divide-slate-100 dark:divide-slate-800">
            <div class="px-5 py-3 flex items-start gap-3">
                <span class="material-symbols-outlined text-slate-400 text-lg mt-0.5">how_to_reg</span>
                <div>
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Yêu cầu tham gia được duyệt</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Gửi khi chủ trận duyệt yêu cầu tham gia của người chơi.</p>
                </div>
            </div>
            <div class="px-5 py-3 flex items-start gap-3">
                <span class="material-symbols-outlined text-slate-400 text-lg mt-0.5">event_busy</span>
                <div>
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Trận đấu đã bị hủy</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Gửi cho người tham gia khi chủ trận hủy trận — kèm luôn lý do hủy và số tiền hoàn (nếu có).</p>
                </div>
            </div>
            <div class="px-5 py-3 flex items-start gap-3">
                <span class="material-symbols-outlined text-slate-400 text-lg mt-0.5">alarm</span>
                <div>
                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">Nhắc lịch trận đấu</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Gửi tự động khoảng 2 giờ trước giờ thi đấu cho người tham gia đã được xác nhận.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function sendTestEmail() {
            const btn = document.getElementById('testEmailBtn');
            const box = document.getElementById('testEmailResult');
            const to = document.getElementById('testEmailTo').value.trim();

            btn.disabled = true;
            box.className = 'mt-3 p-3 rounded-md text-sm font-medium bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400';
            box.textContent = 'Đang gửi...';
            box.classList.remove('hidden');

            try {
                const url = '/api/admin/test-email' + (to ? ('?to=' + encodeURIComponent(to)) : '');
                const res = await fetch(url, { method: 'POST' });
                const data = await res.json();

                if (data.success) {
                    box.className = 'mt-3 p-3 rounded-md text-sm font-medium bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800';
                    box.textContent = 'Đã gửi tới ' + data.to + '. ' + (data.detail || '');
                } else {
                    box.className = 'mt-3 p-3 rounded-md text-sm font-medium bg-rose-50 dark:bg-rose-900/20 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-800';
                    box.textContent = 'Gửi thất bại: ' + (data.detail || 'Không rõ nguyên nhân.');
                }
            } catch (ex) {
                box.className = 'mt-3 p-3 rounded-md text-sm font-medium bg-rose-50 dark:bg-rose-900/20 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-800';
                box.textContent = 'Lỗi kết nối: ' + ex.message;
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}
