@page
@model SportHub.Pages.Admin.ReviewsModel
@{
    ViewData["Title"] = "Admin — Reviews";
    ViewData["AdminPage"] = "Reviews";
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);
    var starCounts = new int[5];
    foreach (var r in Model.Reviews) {
        int s = (int)Math.Round((double)r.AverageScore);
        if (s >= 1 && s <= 5) starCounts[s - 1]++;
    }
    var avgAll = Model.Reviews.Count > 0 ? Model.Reviews.Average(r => (double)r.AverageScore) : 0.0;
}

<div class="space-y-6">
    <div>
        <h1 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white">@(isEn ? "User reviews" : "Đánh giá người dùng")</h1>
        <p class="text-sm text-slate-500 mt-1">@(isEn ? $"Total: {Model.Reviews.Count} reviews" : $"Tổng: {Model.Reviews.Count} đánh giá")</p>
    </div>

    @await Html.PartialAsync("_AdminNav")

    <!-- Search + filter -->
    <form method="get" class="space-y-2">
        <input type="hidden" name="filterType" value="@Model.FilterType" />
        <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400 text-[18px]">search</span>
            <input type="text" name="search" value="@Model.Search"
                   placeholder="@(isEn ? "Search by name…" : "Tìm theo tên…")"
                   class="w-full pl-9 pr-4 py-2 text-sm rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
        </div>
        <div class="flex flex-wrap gap-2">
            <a asp-page="/Admin/Reviews" asp-route-search="@Model.Search" class="px-2.5 py-1 sm:px-3 sm:py-1.5 text-xs sm:text-sm font-semibold rounded-md border transition-colors whitespace-nowrap flex items-center justify-center @(string.IsNullOrEmpty(Model.FilterType) ? "bg-primary text-white border-primary" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">@(isEn ? "All" : "Tất cả")</a>
            <a asp-page="/Admin/Reviews" asp-route-filterType="PlayerToMatch" asp-route-search="@Model.Search" class="px-2.5 py-1 sm:px-3 sm:py-1.5 text-xs sm:text-sm font-semibold rounded-md border transition-colors whitespace-nowrap flex items-center justify-center @(Model.FilterType == "PlayerToMatch" ? "bg-primary text-white border-primary" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">@(isEn ? "Player → Host" : "Người chơi → Chủ kèo")</a>
            <a asp-page="/Admin/Reviews" asp-route-filterType="HostToPlayer" asp-route-search="@Model.Search" class="px-2.5 py-1 sm:px-3 sm:py-1.5 text-xs sm:text-sm font-semibold rounded-md border transition-colors whitespace-nowrap flex items-center justify-center @(Model.FilterType == "HostToPlayer" ? "bg-primary text-white border-primary" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">@(isEn ? "Host → Player" : "Chủ kèo → Người chơi")</a>
        </div>
    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-md text-emerald-700 dark:text-emerald-400 font-medium">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-md text-rose-700 dark:text-rose-400 font-medium">@TempData["ErrorMessage"]</div>
    }

    <!-- Rating chart toggle -->
    @if (Model.Reviews.Any())
    {
    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <button onclick="toggleReviewChart(this)" class="w-full flex items-center justify-between px-5 py-3.5 text-left hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
            <div class="flex items-center gap-2 text-sm font-semibold text-slate-700 dark:text-slate-300">
                <span class="material-symbols-outlined text-amber-500 text-[18px]">star</span>
                Rating distribution — Avg: <strong class="text-amber-700 dark:text-amber-400">@avgAll.ToString("F1") ★</strong>
            </div>
            <span class="material-symbols-outlined text-slate-400 text-[18px] chart-chevron">expand_more</span>
        </button>
        <div id="reviews-chart-section" class="hidden px-5 pb-5">
            <div class="flex flex-col lg:flex-row gap-6 items-start">
                <!-- Bar chart — fixed size container -->
                <div class="w-full lg:w-80 flex-shrink-0" style="height:220px;position:relative">
                    <canvas id="reviewsBarChart"></canvas>
                </div>
                <!-- Star breakdown -->
                <div class="flex-1 space-y-2 pt-2">
                    @{ var maxStarCount = starCounts.Max(); }
                    @for (int star = 5; star >= 1; star--)
                    {
                        var cnt = starCounts[star - 1];
                        var pct = maxStarCount > 0 ? (cnt * 100.0 / maxStarCount) : 0;
                        <div class="flex items-center gap-3 text-sm">
                            <span class="w-8 text-right text-amber-700 dark:text-amber-400 font-bold flex-shrink-0">@star★</span>
                            <div class="flex-1 bg-slate-100 dark:bg-slate-800 rounded-md h-3.5 overflow-hidden">
                                <div class="h-3.5 bg-amber-400 rounded-md transition-all duration-500" style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <span class="w-6 text-slate-500 text-xs text-right flex-shrink-0">@cnt</span>
                        </div>
                    }
                    <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                        <button onclick="loadAiInsight('reviews', '@Model.Reviews.Count', '@avgAll.ToString("F1")', '@starCounts[4]', '@starCounts[3]')" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-primary border border-primary/30 bg-primary/5 hover:bg-primary/10 rounded-md transition-colors">
                            <span class="material-symbols-outlined text-[15px]">auto_awesome</span>
                            Phân tích AI
                        </button>
                        <div id="ai-insight-reviews" class="hidden mt-3 p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md text-xs text-slate-600 dark:text-slate-400 leading-relaxed"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }

    @if (!Model.Reviews.Any())
    {
        <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-10 text-center">
            <span class="material-symbols-outlined text-5xl text-slate-300 mb-3 block">rate_review</span>
            <p class="text-slate-500 font-semibold">@(isEn ? "No reviews yet." : "Chưa có đánh giá nào.")</p>
        </div>
    }
    else
    {
        @* ── MOBILE: card list ── *@
        <div class="sm:hidden space-y-3">
            @foreach (var r in Model.Reviews)
            {
                var typeLabel = r.ReviewType == "PlayerToMatch"
                    ? (isEn ? "Player→Host" : "Người chơi→Chủ kèo")
                    : (isEn ? "Host→Player" : "Chủ kèo→Người chơi");
                var typeCss = r.ReviewType == "PlayerToMatch"
                    ? "bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400"
                    : "bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400";
                <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-4 shadow-sm @(!r.IsVisible ? "opacity-50" : "")">
                    <div class="flex items-start justify-between gap-2 mb-2">
                        <div class="flex items-center gap-2 min-w-0">
                            <img src="@(r.ReviewerAvatarUrl ?? "/images/avatar-default.png")"
                                 class="w-8 h-8 rounded-full object-cover shrink-0" alt="" />
                            <div class="min-w-0">
                                <p class="text-sm font-bold text-slate-900 dark:text-white truncate">@r.ReviewerName</p>
                                <p class="text-xs text-slate-500 truncate">→ @r.ReviewedName</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-md whitespace-nowrap shrink-0 @typeCss">@typeLabel</span>
                    </div>
                    <div class="flex items-center gap-0.5 mb-1">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="material-symbols-outlined text-sm @(i <= (int)Math.Round(r.AverageScore) ? "text-amber-400" : "text-slate-300")"
                                  style="font-variation-settings:'FILL' 1">star</span>
                        }
                        <span class="text-xs font-bold text-amber-700 dark:text-amber-400 ml-1">@r.AverageScore.ToString("F1")</span>
                    </div>
                    <a asp-page="/Matchmaking/Details" asp-route-id="@r.MatchId"
                       class="text-xs text-primary hover:underline line-clamp-1">@r.MatchTitle</a>
                    @if (!string.IsNullOrWhiteSpace(r.Comment))
                    {
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">@r.Comment</p>
                    }
                    <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <span class="text-xs font-semibold @(r.IsVisible ? "text-emerald-600" : "text-slate-400")">
                            @(r.IsVisible ? (isEn ? "Visible" : "Hiển thị") : (isEn ? "Hidden" : "Đã ẩn"))
                        </span>
                        <form method="post" asp-page-handler="ToggleVisibility">
                            <input type="hidden" name="reviewId" value="@r.ReviewId" />
                            <input type="hidden" name="isVisible" value="@(!r.IsVisible).ToString().ToLower()" />
                            <button type="submit"
                                    class="text-xs px-3 py-1.5 rounded-md border @(r.IsVisible ? "border-rose-200 text-rose-500 hover:bg-rose-50" : "border-emerald-200 text-emerald-600 hover:bg-emerald-50") font-semibold transition-colors">
                                @(r.IsVisible ? (isEn ? "Hide" : "Ẩn") : (isEn ? "Show" : "Hiện"))
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        @* ── DESKTOP: table ── *@
        <div class="hidden sm:block bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">#</th>
                        <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">@(isEn ? "Reviewer" : "Người đánh giá")</th>
                        <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">@(isEn ? "Reviewed" : "Đối tượng")</th>
                        <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">@(isEn ? "Match" : "Trận")</th>
                        <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">@(isEn ? "Type" : "Loại")</th>
                        <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">@(isEn ? "Score" : "Điểm")</th>
                        <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">@(isEn ? "Comment" : "Nhận xét")</th>
                        <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">@(isEn ? "Status" : "Trạng thái")</th>
                        <th class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400">@(isEn ? "Actions" : "Thao tác")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var r in Model.Reviews)
                    {
                        var typeLabel = r.ReviewType == "PlayerToMatch"
                            ? (isEn ? "Player→Host" : "Người chơi→Chủ kèo")
                            : (isEn ? "Host→Player" : "Chủ kèo→Người chơi");
                        var typeCss = r.ReviewType == "PlayerToMatch"
                            ? "bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400"
                            : "bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400";
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 @(!r.IsVisible ? "opacity-50" : "")">
                            <td class="px-4 py-3 text-slate-400 text-xs">@r.ReviewId</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <img src="@(r.ReviewerAvatarUrl ?? "/images/avatar-default.png")"
                                         class="w-7 h-7 rounded-full object-cover" alt="" />
                                    <span class="font-medium text-slate-800 dark:text-slate-200">@r.ReviewerName</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-700 dark:text-slate-300 font-medium">@r.ReviewedName</td>
                            <td class="px-4 py-3">
                                <a asp-page="/Matchmaking/Details" asp-route-id="@r.MatchId"
                                   class="text-primary hover:underline text-xs">
                                    @r.MatchTitle
                                </a>
                                <div class="text-xs text-slate-400">@r.MatchDate.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class="px-4 py-3">
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-md whitespace-nowrap @typeCss">@typeLabel</span>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="material-symbols-outlined text-sm @(i <= (int)Math.Round(r.AverageScore) ? "text-amber-400" : "text-slate-300")"
                                              style="font-variation-settings:'FILL' 1">star</span>
                                    }
                                    <span class="text-xs font-bold text-amber-700 dark:text-amber-400 ml-1">@r.AverageScore.ToString("F1")</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 max-w-xs">
                                @if (!string.IsNullOrWhiteSpace(r.Comment))
                                {
                                    <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2">@r.Comment</p>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-300">—</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                @if (r.IsVisible)
                                {
                                    <span class="text-xs font-semibold text-emerald-600">@(isEn ? "Visible" : "Hiển thị")</span>
                                }
                                else
                                {
                                    <span class="text-xs font-semibold text-slate-400">@(isEn ? "Hidden" : "Đã ẩn")</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <form method="post" asp-page-handler="ToggleVisibility">
                                    <input type="hidden" name="reviewId" value="@r.ReviewId" />
                                    <input type="hidden" name="isVisible" value="@(!r.IsVisible).ToString().ToLower()" />
                                    <button type="submit"
                                            class="text-xs px-3 py-1 rounded-md border @(r.IsVisible ? "border-rose-200 text-rose-500 hover:bg-rose-50" : "border-emerald-200 text-emerald-600 hover:bg-emerald-50") font-semibold transition-colors">
                                        @(r.IsVisible ? (isEn ? "Hide" : "Ẩn") : (isEn ? "Show" : "Hiện"))
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    var _reviewChartInited = false;
    function toggleReviewChart(btn) {
        var section = document.getElementById('reviews-chart-section');
        var chevron = btn.querySelector('.chart-chevron');
        if (!section) return;
        if (section.classList.contains('hidden')) {
            section.classList.remove('hidden');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
            if (!_reviewChartInited) {
                _reviewChartInited = true;
                var ctx = document.getElementById('reviewsBarChart');
                if (ctx) new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['1★','2★','3★','4★','5★'],
                        datasets: [{ label: 'Reviews', data: [@starCounts[0],@starCounts[1],@starCounts[2],@starCounts[3],@starCounts[4]], backgroundColor: ['#ef4444','#f97316','#eab308','#84cc16','#22c55e'], borderRadius: 6 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } } }
                    }
                });
            }
        } else {
            section.classList.add('hidden');
            if (chevron) chevron.style.transform = '';
        }
    }
</script>
}
