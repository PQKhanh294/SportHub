@page
@model SportHub.Pages.Admin.WalletModel
@using System.Globalization
@{
    ViewData["Title"] = "Admin — Wallets";
    var isEn = false; // Admin thuần tiếng Việt — công cụ nội bộ, không song ngữ
}

<div class="space-y-5">
    <partial name="_AdminNav" />

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
            <h1 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white">@(isEn ? "Wallet management" : "Quản lý ví tiền")</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">@(isEn ? "Manually credit users and issue vouchers." : "Nạp tiền thủ công và cấp voucher cho người dùng.")</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-md text-emerald-700 dark:text-emerald-400 font-medium text-sm">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-md text-rose-700 dark:text-rose-400 font-medium text-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Search -->
    <form method="get" class="flex gap-2">
        <input name="Search" value="@Model.Search" placeholder="@(isEn ? "Search by name or email..." : "Tìm theo tên hoặc email...")"
               class="flex-1 rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 text-sm" />
        <button type="submit" class="px-4 py-2 bg-primary text-white rounded-md text-sm font-semibold hover:bg-primary/90">@(isEn ? "Search" : "Tìm kiếm")</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a asp-page="/Admin/Wallet" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-md text-sm font-semibold hover:bg-slate-200 dark:hover:bg-slate-700">@(isEn ? "Clear" : "Xóa")</a>
        }
    </form>

    <!-- User List -->
    <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="px-5 py-3 border-b border-slate-100 dark:border-slate-800 text-xs text-slate-500">
            @Model.TotalCount users
            @if (!string.IsNullOrEmpty(Model.Search)) { <text> — results for "@Model.Search"</text> }
        </div>

        @if (!Model.Users.Any())
        {
            <div class="p-10 text-center">
                <span class="material-symbols-outlined text-4xl text-slate-300 block mb-2">manage_search</span>
                <p class="text-slate-400 text-sm">Không tìm thấy người dùng.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var user in Model.Users)
                {
                    <div class="flex items-center gap-3 px-3 sm:px-5 py-3 sm:py-4">
                        <!-- Avatar -->
                        <div class="size-9 sm:size-10 rounded-full bg-primary/10 flex items-center justify-center overflow-hidden shrink-0">
                            <span class="text-primary font-bold text-sm">@user.FullName[..1].ToUpper()</span>
                        </div>

                        <!-- Info -->
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-slate-800 dark:text-slate-200 truncate text-sm">@user.FullName</p>
                            <p class="text-xs text-slate-400 truncate">@user.Email</p>
                        </div>

                        <!-- Balance (desktop only) -->
                        <div class="text-right shrink-0 hidden sm:block">
                            <p class="font-bold text-sm text-emerald-600 dark:text-emerald-400">@user.WalletBalance.ToString("N0") đ</p>
                            <p class="text-xs text-slate-400">wallet balance</p>
                        </div>

                        <!-- Actions -->
                        <div class="flex flex-col items-end gap-1 shrink-0">
                            <p class="text-xs font-bold text-emerald-600 dark:text-emerald-400 sm:hidden whitespace-nowrap">@user.WalletBalance.ToString("N0")đ</p>
                            <div class="flex gap-1.5 sm:gap-2">
                                <button type="button"
                                        onclick="openCreditModal(@user.UserID, '@user.FullName.Replace("'","\\'")')"
                                        class="px-2 sm:px-3 py-1.5 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 rounded-md text-xs font-semibold hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-colors flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">add_circle</span>
                                    <span class="hidden sm:inline">Cộng xu</span>
                                </button>
                                <button type="button"
                                        onclick="openVoucherModal(@user.UserID, '@user.FullName.Replace("'","\\'")')"
                                        class="px-2 sm:px-3 py-1.5 bg-purple-50 dark:bg-purple-900/20 text-purple-700 dark:text-purple-400 border border-purple-200 dark:border-purple-800 rounded-md text-xs font-semibold hover:bg-purple-100 dark:hover:bg-purple-900/30 transition-colors flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">redeem</span>
                                    <span class="hidden sm:inline">Voucher</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-1">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                var isActive = i == Model.PageNumber;
                <a asp-page="/Admin/Wallet" asp-route-Search="@Model.Search" asp-route-PageNumber="@i"
                   class="@(isActive ? "bg-primary text-white" : "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:border-primary hover:text-primary") w-9 h-9 rounded-md text-sm font-semibold flex items-center justify-center transition-colors">
                    @i
                </a>
            }
        </div>
    }
</div>

<!-- Modal: Credit wallet -->
<div id="creditModal" class="hidden fixed inset-0 z-[1200]">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-[1px]" onclick="closeCreditModal()"></div>
    <div class="relative mx-auto mt-20 w-[92%] max-w-md rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-2xl p-6">
        <h3 class="text-lg font-black text-slate-900 dark:text-white mb-1">@(isEn ? "Add wallet credit" : "Nạp tiền ví")</h3>
        <p id="creditUserName" class="text-sm text-slate-500 mb-5"></p>

        <form method="post" asp-page-handler="Credit">
            <input type="hidden" id="creditUserId" name="userId" value="" />

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Amount (xu)</label>
                    <input type="number" name="amount" min="1000" step="1000" placeholder="50000"
                           class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" required />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Notification message <span class="text-rose-500">*</span></label>
                    <input type="text" name="note" maxlength="200" placeholder="e.g. Trial reward June"
                           class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" required />
                    <p class="text-xs text-slate-400 mt-1">Người dùng sẽ nhận được thông báo kèm nội dung này.</p>
                </div>
            </div>

            <div class="mt-5 flex justify-end gap-2">
                <button type="button" onclick="closeCreditModal()"
                        class="px-4 py-2 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-sm">Hủy</button>
                <button type="submit"
                        class="px-5 py-2 rounded-md bg-emerald-600 text-white font-bold text-sm hover:bg-emerald-700">Cộng xu</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Issue voucher -->
<div id="voucherModal" class="hidden fixed inset-0 z-[1200]">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-[1px]" onclick="closeVoucherModal()"></div>
    <div class="relative mx-auto mt-20 w-[92%] max-w-md rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-2xl p-6">
        <h3 class="text-lg font-black text-slate-900 dark:text-white mb-1">@(isEn ? "Issue personal voucher" : "Cấp voucher cá nhân")</h3>
        <p id="voucherUserName" class="text-sm text-slate-500 mb-5"></p>

        <form method="post" asp-page-handler="IssueVoucher">
            <input type="hidden" id="voucherUserId" name="userId" value="" />

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Giá trị voucher (xu)</label>
                    <input type="number" name="voucherAmount" min="1000" step="1000" placeholder="30000"
                           class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" required />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Ngày hết hạn (trống = không giới hạn)</label>
                    <input type="date" name="voucherExpiry"
                           class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Ghi chú</label>
                    <input type="text" name="voucherNote" maxlength="200" placeholder="e.g. VIP reward June"
                           class="w-full rounded-md border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm" />
                </div>
            </div>

            <div class="mt-5 flex justify-end gap-2">
                <button type="button" onclick="closeVoucherModal()"
                        class="px-4 py-2 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-sm">Hủy</button>
                <button type="submit"
                        class="px-5 py-2 rounded-md bg-purple-600 text-white font-bold text-sm hover:bg-purple-700">Phát voucher</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openCreditModal(userId, name) {
            document.getElementById('creditUserId').value = userId;
            document.getElementById('creditUserName').textContent = 'Recipient: ' + name;
            document.getElementById('creditModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
        function closeCreditModal() {
            document.getElementById('creditModal').classList.add('hidden');
            document.body.style.overflow = '';
        }
        function openVoucherModal(userId, name) {
            document.getElementById('voucherUserId').value = userId;
            document.getElementById('voucherUserName').textContent = 'Recipient: ' + name;
            document.getElementById('voucherModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
        function closeVoucherModal() {
            document.getElementById('voucherModal').classList.add('hidden');
            document.body.style.overflow = '';
        }
    </script>
}
