@page
@model SportHub.Pages.Admin.AdminMatchesModel
@{
    ViewData["Title"] = "Admin — Trận đấu";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-slate-900 dark:text-white">Trận đấu</h1>
            <p class="text-sm text-slate-500 mt-1">@Model.Matches.Count trận (tối đa 100)</p>
        </div>
    </div>

    @await Html.PartialAsync("_AdminNav")

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-xl text-emerald-700 dark:text-emerald-400 font-medium">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-xl text-rose-700 dark:text-rose-400 font-medium">@TempData["ErrorMessage"]</div>
    }

    <!-- Filters -->
    <form method="get" class="flex flex-wrap gap-2">
        <input name="search" value="@Model.Search" placeholder="Tìm theo tiêu đề, host..."
               class="flex-1 min-w-48 rounded-lg border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 text-sm" />
        <select name="filterStatus" class="rounded-lg border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 text-sm">
            <option value="">Tất cả trạng thái</option>
            <option value="Open" selected="@(Model.FilterStatus == "Open")">Open</option>
            <option value="Full" selected="@(Model.FilterStatus == "Full")">Full</option>
            <option value="PendingDeposit" selected="@(Model.FilterStatus == "PendingDeposit")">Chờ đặt cọc</option>
            <option value="Cancelled" selected="@(Model.FilterStatus == "Cancelled")">Đã hủy</option>
            <option value="Completed" selected="@(Model.FilterStatus == "Completed")">Hoàn thành</option>
        </select>
        <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-semibold">Lọc</button>
    </form>

    <!-- Matches table -->
    <div class="bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        @if (!Model.Matches.Any())
        {
            <div class="p-10 text-center">
                <span class="material-symbols-outlined text-5xl text-slate-300 mb-3 block">sports</span>
                <p class="text-slate-500 font-semibold">Không tìm thấy trận đấu nào.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 dark:bg-slate-800 text-xs text-slate-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-4 py-3 text-left">Trận đấu</th>
                            <th class="px-4 py-3 text-left">Host</th>
                            <th class="px-4 py-3 text-left">Môn</th>
                            <th class="px-4 py-3 text-left">Ngày</th>
                            <th class="px-4 py-3 text-center">Người tham gia</th>
                            <th class="px-4 py-3 text-center">Trạng thái</th>
                            <th class="px-4 py-3 text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var match in Model.Matches)
                        {
                            var statusColor = match.Status switch {
                                "Open"           => "bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400",
                                "Full"           => "bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400",
                                "PendingDeposit" => "bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400",
                                "Cancelled"      => "bg-rose-50 dark:bg-rose-900/20 text-rose-700 dark:text-rose-400",
                                "Completed"      => "bg-slate-100 dark:bg-slate-700 text-slate-600",
                                _                => "bg-slate-100 text-slate-600"
                            };
                            var accepted = match.Participants.Count(p => p.JoinStatus == "Accepted");
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                <td class="px-4 py-3">
                                    <a asp-page="/Matchmaking/Details" asp-route-id="@match.MatchID"
                                       class="font-semibold text-slate-900 dark:text-white hover:text-primary transition-colors">
                                        @(match.Title ?? match.MatchType)
                                    </a>
                                    <p class="text-xs text-slate-400">#@match.MatchID</p>
                                </td>
                                <td class="px-4 py-3 text-slate-600 dark:text-slate-400">@match.CreatedByUser?.FullName</td>
                                <td class="px-4 py-3 text-slate-500">@match.Sport?.SportName</td>
                                <td class="px-4 py-3 text-slate-500 text-xs">@match.MatchDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-4 py-3 text-center text-slate-600">@accepted/@match.MaxParticipants</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="px-2 py-0.5 rounded-full text-xs font-bold @statusColor">@match.Status</span>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <form method="post" asp-page-handler="Delete"
                                          onsubmit="return confirm('Xóa trận này? Hành động không thể hoàn tác.')">
                                        <input type="hidden" name="matchId" value="@match.MatchID" />
                                        <button type="submit"
                                                class="px-3 py-1 text-xs font-semibold rounded-lg bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-100 text-rose-600 transition-colors">
                                            Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
