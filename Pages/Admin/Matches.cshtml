@page
@model SportHub.Pages.Admin.AdminMatchesModel
@using System.Globalization
@{
    ViewData["Title"] = "Admin — Trận đấu";
    ViewData["AdminPage"] = "Matches";
    var isEn = false; // Admin thuần tiếng Việt — công cụ nội bộ, không song ngữ
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white">@(isEn ? "Matches" : "Trận đấu")</h1>
            <p class="text-sm text-slate-500 mt-1">@Model.TotalCount @(isEn ? "matches" : "trận đấu") — @(isEn ? "page" : "trang") @Model.PageNumber / @(Math.Max(1,Model.TotalPages))</p>
        </div>
    </div>

    @await Html.PartialAsync("_AdminNav")

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-md text-emerald-700 dark:text-emerald-400 font-medium">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-md text-rose-700 dark:text-rose-400 font-medium">@TempData["ErrorMessage"]</div>
    }

    <!-- Filters -->
    <form method="get" class="space-y-2">
        <input name="search" value="@Model.Search" placeholder="@(isEn ? "Search by title, host..." : "Tìm theo tiêu đề, chủ kèo...")"
               class="w-full rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 text-sm" />
        <div class="flex flex-wrap gap-2">
            <select name="filterStatus" class="flex-1 min-w-[140px] rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 text-sm">
                <option value="">@(isEn ? "All statuses" : "Tất cả trạng thái")</option>
                <option value="Open" selected="@(Model.FilterStatus == "Open")">@(isEn ? "Open" : "Đang mở")</option>
                <option value="Full" selected="@(Model.FilterStatus == "Full")">@(isEn ? "Full" : "Đã đầy")</option>
                <option value="PendingDeposit" selected="@(Model.FilterStatus == "PendingDeposit")">@(isEn ? "Pending deposit" : "Chờ đặt cọc")</option>
                <option value="Cancelled" selected="@(Model.FilterStatus == "Cancelled")">@(isEn ? "Cancelled" : "Đã hủy")</option>
                <option value="Completed" selected="@(Model.FilterStatus == "Completed")">@(isEn ? "Completed" : "Hoàn thành")</option>
            </select>
            <select name="filterSport" class="flex-1 min-w-[140px] rounded-md border border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-3 py-2 text-sm">
                <option value="">@(isEn ? "All sports" : "Tất cả môn")</option>
                @foreach (var sport in Model.Sports)
                {
                    <option value="@sport.SportID" selected="@(Model.FilterSport == sport.SportID)">@sport.SportName</option>
                }
            </select>
            <button type="submit" class="px-4 py-2 bg-primary text-white rounded-md text-sm font-semibold shrink-0">@(isEn ? "Filter" : "Lọc")</button>
        </div>
    </form>

    @if (!Model.Matches.Any())
    {
        <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-10 text-center">
            <span class="material-symbols-outlined text-5xl text-slate-300 mb-3 block">sports</span>
            <p class="text-slate-500 font-semibold">@(isEn ? "No matches found." : "Không tìm thấy trận đấu nào.")</p>
        </div>
    }
    else
    {
        @* ── MOBILE: card list ── *@
        <div class="sm:hidden space-y-3">
            @foreach (var match in Model.Matches)
            {
                var statusColor = match.Status switch {
                    "Open"           => "bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400",
                    "Full"           => "bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400",
                    "PendingDeposit" => "bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400",
                    "Cancelled"      => "bg-rose-50 dark:bg-rose-900/20 text-rose-700 dark:text-rose-400",
                    "Completed"      => "bg-slate-100 dark:bg-slate-700 text-slate-600",
                    _                => "bg-slate-100 text-slate-600"
                };
                var statusLabel = match.Status switch {
                    "Open"           => isEn ? "Open" : "Đang mở",
                    "Full"           => isEn ? "Full" : "Đã đầy",
                    "PendingDeposit" => isEn ? "Pending deposit" : "Chờ đặt cọc",
                    "Cancelled"      => isEn ? "Cancelled" : "Đã hủy",
                    "Completed"      => isEn ? "Completed" : "Hoàn thành",
                    _                => match.Status
                };
                var accepted = match.Participants.Count(p => p.JoinStatus == "Accepted");
                <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-4 shadow-sm">
                    <div class="flex items-start justify-between gap-2 mb-2">
                        <div class="min-w-0">
                            <a asp-page="/Matchmaking/Details" asp-route-id="@match.MatchID"
                               class="font-bold text-slate-900 dark:text-white hover:text-primary transition-colors line-clamp-2 text-sm">
                                @(match.Title ?? match.MatchType)
                            </a>
                            <p class="text-xs text-slate-400 mt-0.5">#@match.MatchID</p>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <span class="px-2 py-0.5 rounded-md text-xs font-bold @statusColor">@statusLabel</span>
                            <form method="post" asp-page-handler="Delete" class="inline"
                                  onsubmit="return confirm('@(isEn ? "Delete this match?" : "Xóa trận đấu này?")')">
                                <input type="hidden" name="matchId" value="@match.MatchID" />
                                <button type="submit" class="px-2.5 py-0.5 text-xs font-semibold rounded-md bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-100 text-rose-600 transition-colors">
                                    @(isEn ? "Delete" : "Xóa")
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="text-xs text-slate-500 space-y-1">
                        <div class="flex items-center gap-1">
                            <span class="material-symbols-outlined text-[13px]">person</span>
                            <span class="truncate">@(match.CreatedByUser?.FullName ?? "—")</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[13px]">sports</span>@(match.Sport?.SportName ?? "—")</span>
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[13px]">calendar_today</span>@match.MatchDate.ToString("dd/MM/yy")</span>
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[13px]">group</span>@accepted/@match.MaxParticipants</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── DESKTOP: table ── *@
        <div class="hidden sm:block bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 dark:bg-slate-800 text-xs text-slate-500 uppercase tracking-wider">
                        <tr>
                            <th class="px-4 py-3 text-left">@(isEn ? "Match" : "Trận đấu")</th>
                            <th class="px-4 py-3 text-left">@(isEn ? "Host" : "Chủ kèo")</th>
                            <th class="px-4 py-3 text-left">@(isEn ? "Sport" : "Môn")</th>
                            <th class="px-4 py-3 text-left">@(isEn ? "Date" : "Ngày")</th>
                            <th class="px-4 py-3 text-center">@(isEn ? "Players" : "Người chơi")</th>
                            <th class="px-4 py-3 text-center">@(isEn ? "Status" : "Trạng thái")</th>
                            <th class="px-4 py-3 text-center">@(isEn ? "Actions" : "Thao tác")</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var match in Model.Matches)
                        {
                            var statusColor = match.Status switch {
                                "Open"           => "bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400",
                                "Full"           => "bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400",
                                "PendingDeposit" => "bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400",
                                "Cancelled"      => "bg-rose-50 dark:bg-rose-900/20 text-rose-700 dark:text-rose-400",
                                "Completed"      => "bg-slate-100 dark:bg-slate-700 text-slate-600",
                                _                => "bg-slate-100 text-slate-600"
                            };
                            var statusLabel = match.Status switch {
                                "Open"           => isEn ? "Open" : "Đang mở",
                                "Full"           => isEn ? "Full" : "Đã đầy",
                                "PendingDeposit" => isEn ? "Pending deposit" : "Chờ đặt cọc",
                                "Cancelled"      => isEn ? "Cancelled" : "Đã hủy",
                                "Completed"      => isEn ? "Completed" : "Hoàn thành",
                                _                => match.Status
                            };
                            var accepted = match.Participants.Count(p => p.JoinStatus == "Accepted");
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                <td class="px-4 py-3">
                                    <a asp-page="/Matchmaking/Details" asp-route-id="@match.MatchID"
                                       class="font-semibold text-slate-900 dark:text-white hover:text-primary transition-colors">
                                        @(match.Title ?? match.MatchType)
                                    </a>
                                    <p class="text-xs text-slate-400">#@match.MatchID</p>
                                </td>
                                <td class="px-4 py-3 text-slate-600 dark:text-slate-400 max-w-[140px]"><span class="block truncate whitespace-nowrap" title="@match.CreatedByUser?.FullName">@match.CreatedByUser?.FullName</span></td>
                                <td class="px-4 py-3 text-slate-500">@match.Sport?.SportName</td>
                                <td class="px-4 py-3 text-slate-500 text-xs">@match.MatchDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-4 py-3 text-center text-slate-600">@accepted/@match.MaxParticipants</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="px-2 py-0.5 rounded-md text-xs font-bold @statusColor">@statusLabel</span>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <form method="post" asp-page-handler="Delete"
                                          onsubmit="return confirm('@(isEn ? "Delete this match?" : "Xóa trận đấu này?")')">
                                        <input type="hidden" name="matchId" value="@match.MatchID" />
                                        <button type="submit" class="px-3 py-1 text-xs font-semibold rounded-md bg-rose-50 dark:bg-rose-900/20 hover:bg-rose-100 text-rose-600 transition-colors">
                                            @(isEn ? "Delete" : "Xóa")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-1">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                var isActive = i == Model.PageNumber;
                <a asp-page="/Admin/Matches" asp-route-Search="@Model.Search" asp-route-FilterStatus="@Model.FilterStatus" asp-route-FilterSport="@Model.FilterSport" asp-route-PageNumber="@i"
                   class="@(isActive ? "bg-primary text-white" : "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:border-primary hover:text-primary") w-9 h-9 rounded-md text-sm font-semibold flex items-center justify-center transition-colors">
                    @i
                </a>
            }
        </div>
    }
</div>
