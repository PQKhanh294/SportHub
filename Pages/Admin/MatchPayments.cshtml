@page
@model SportHub.Pages.Admin.MatchPaymentsModel
@{
    ViewData["Title"] = "Admin — Thanh toán chờ xử lý";
    ViewData["AdminPage"] = "Payments";
    var isEn = false; // Admin thuần tiếng Việt — công cụ nội bộ, không song ngữ
    var hostDepositCount = Model.Payments.Count(p => p.PaymentType == "HostDeposit");
    var playerFeeCount   = Model.Payments.Count(p => p.PaymentType == "PlayerFee");
    var hostRemainCount  = Model.Payments.Count(p => p.PaymentType == "HostRemaining");
    var totalAmountPending = Model.Payments.Sum(p => p.Amount);
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-lg sm:text-2xl font-black text-slate-900 dark:text-white">@(isEn ? "Pending Payments" : "Thanh toán chờ xử lý")</h1>
            <p class="text-sm text-slate-500 mt-1">@(isEn ? "Transactions awaiting receipt confirmation" : "Giao dịch chờ xác nhận biên lai")</p>
        </div>
        <span class="px-3 py-1 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-sm font-bold rounded-md">
            @Model.TotalPendingCount đang chờ
        </span>
    </div>

    @await Html.PartialAsync("_AdminNav")

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-md text-emerald-700 dark:text-emerald-400 font-medium">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800 rounded-md text-rose-700 dark:text-rose-400 font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Search + filter -->
    <form method="get" class="space-y-2">
        <input type="hidden" name="filterType" value="@Model.FilterType" />
        <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-400 text-[18px]">search</span>
            <input type="text" name="search" value="@Model.Search"
                   placeholder="@(isEn ? "Search by match / payer…" : "Tìm theo trận / người thanh toán…")"
                   class="w-full pl-9 pr-4 py-2 text-sm rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary" />
        </div>
        <div class="flex flex-wrap gap-2">
            <a asp-page="/Admin/MatchPayments" asp-route-search="@Model.Search"
               class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(string.IsNullOrWhiteSpace(Model.FilterType) ? "bg-primary text-white border-primary" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "All" : "Tất cả") (@Model.TotalPendingCount)
            </a>
            <a asp-page="/Admin/MatchPayments" asp-route-filterType="HostDeposit" asp-route-search="@Model.Search"
               class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(Model.FilterType == "HostDeposit" ? "bg-blue-500 text-white border-blue-500" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "Host deposit" : "Đặt cọc chủ trận")
            </a>
            <a asp-page="/Admin/MatchPayments" asp-route-filterType="PlayerFee" asp-route-search="@Model.Search"
               class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(Model.FilterType == "PlayerFee" ? "bg-emerald-500 text-white border-emerald-500" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "Player fee" : "Phí người chơi")
            </a>
            <a asp-page="/Admin/MatchPayments" asp-route-filterType="HostRemaining" asp-route-search="@Model.Search"
               class="px-3 py-1.5 text-xs font-semibold rounded-md border transition-colors @(Model.FilterType == "HostRemaining" ? "bg-amber-500 text-white border-amber-500" : "border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-primary")">
                @(isEn ? "Host remainder" : "Phí còn lại")
            </a>
        </div>
    </form>

    @if (!Model.Payments.Any())
    {
        <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-10 text-center">
            <span class="material-symbols-outlined text-5xl text-slate-300 mb-3 block">task_alt</span>
            <p class="text-slate-500 font-semibold">@(isEn ? "No transactions awaiting confirmation." : "Không có giao dịch nào đang chờ xác nhận.")</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var p in Model.Payments)
            {
                var typeColor = p.PaymentType switch
                {
                    "HostDeposit" => "bg-blue-50 dark:bg-blue-900/20 border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-400",
                    "PlayerFee" => "bg-emerald-50 dark:bg-emerald-900/20 border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400",
                    "HostRemaining" => "bg-amber-50 dark:bg-amber-900/20 border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-400",
                    _ => "bg-slate-50 dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300"
                };
                var typeLabel = p.PaymentType switch
                {
                    "HostDeposit" => isEn ? "Host deposit" : "Đặt cọc chủ trận",
                    "PlayerFee" => isEn ? "Player fee" : "Phí người chơi",
                    "HostRemaining" => isEn ? "Host remainder" : "Phí còn lại",
                    _ => p.PaymentType
                };

                <div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 p-5 shadow-sm">
                    <div class="flex flex-col sm:flex-row items-start gap-4">
                        <!-- Payment info -->
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="px-2 py-0.5 rounded-md text-xs font-bold border @typeColor">@typeLabel</span>
                                <span class="text-xs text-slate-400">#@p.PaymentId</span>
                            </div>
                            <p class="font-bold text-slate-900 dark:text-white">@p.MatchTitle</p>
                            <p class="text-sm text-slate-500">@(isEn ? "Payer" : "Người thanh toán"): <span class="font-semibold text-slate-700 dark:text-slate-300">@p.PayerName</span></p>
                            <p class="text-sm text-slate-500 mt-1">
                                Số tiền: <span class="font-bold text-primary">@p.Amount.ToString("N0") xu</span>
                                <span class="ml-2 text-xs">• Gửi lúc @p.CreatedAt.ToVietnamTime().ToString("HH:mm dd/MM")</span>
                                @if (p.ExpiresAt.HasValue)
                                {
                                    <span class="ml-2 text-xs text-amber-700 dark:text-amber-400">• Hết hạn lúc @p.ExpiresAt.Value.ToVietnamTime().ToString("HH:mm dd/MM")</span>
                                }
                            </p>
                        </div>

                        <!-- Receipt preview -->
                        @if (p.HasReceipt)
                        {
                            <a href="@p.ReceiptUrl" target="_blank"
                               class="block w-full sm:w-20 h-28 sm:h-20 rounded-md overflow-hidden border border-slate-200 dark:border-slate-700 hover:opacity-80 transition-opacity flex-shrink-0">
                                @if (p.ReceiptUrl!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="w-full h-full bg-slate-100 dark:bg-slate-800 flex flex-col items-center justify-center gap-1">
                                        <span class="material-symbols-outlined text-2xl text-slate-400">picture_as_pdf</span>
                                        <span class="text-xs text-slate-400">PDF</span>
                                    </div>
                                }
                                else
                                {
                                    <img src="@p.ReceiptUrl" alt="Receipt" class="w-full h-full object-cover" />
                                }
                            </a>
                        }
                    </div>

                    <!-- Action buttons -->
                    <div class="mt-4 flex gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                        <a asp-page="/Matchmaking/Details" asp-route-id="@p.MatchId"
                           class="px-3 py-1.5 text-sm text-slate-600 dark:text-slate-400 hover:text-primary border border-slate-200 dark:border-slate-700 rounded-md font-medium transition-colors">
                            Xem trận đấu
                        </a>
                        <div class="flex-1"></div>
                        <form method="post" asp-page-handler="Reject">
                            <input type="hidden" name="paymentId" value="@p.PaymentId" />
                            <button type="submit"
                                    class="px-4 py-1.5 text-sm bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-900/20 text-slate-600 dark:text-slate-400 hover:text-rose-500 font-semibold rounded-md transition-colors">
                                Từ chối
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Confirm">
                            <input type="hidden" name="paymentId" value="@p.PaymentId" />
                            <button type="submit"
                                    class="px-4 py-1.5 text-sm bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-md transition-colors flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">check</span>
                                Xác nhận
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Chart toggle section -->
<div class="bg-white dark:bg-slate-900 rounded-md border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
    <button onclick="toggleAdminChart('payments-chart-section', this)" class="w-full flex items-center justify-between px-5 py-3.5 text-left hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
        <div class="flex items-center gap-2 text-sm font-semibold text-slate-700 dark:text-slate-300">
            <span class="material-symbols-outlined text-primary text-[18px]">donut_large</span>
            Phân bổ thanh toán đang chờ
        </div>
        <span class="material-symbols-outlined text-slate-400 text-[18px] chart-chevron">expand_more</span>
    </button>
    <div id="payments-chart-section" class="hidden px-5 pb-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
            <canvas id="paymentsDonut" style="max-height:220px"></canvas>
            <div class="space-y-3 text-sm">
                <div class="flex items-center justify-between p-3 bg-blue-50 dark:bg-blue-900/20 rounded-md">
                    <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span>@(isEn ? "Host deposit" : "Đặt cọc chủ trận")</span>
                    <strong>@hostDepositCount</strong>
                </div>
                <div class="flex items-center justify-between p-3 bg-emerald-50 dark:bg-emerald-900/20 rounded-md">
                    <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>@(isEn ? "Player fee" : "Phí người chơi")</span>
                    <strong>@playerFeeCount</strong>
                </div>
                <div class="flex items-center justify-between p-3 bg-amber-50 dark:bg-amber-900/20 rounded-md">
                    <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>@(isEn ? "Host remainder" : "Phí còn lại")</span>
                    <strong>@hostRemainCount</strong>
                </div>
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800 text-slate-500">
                    Tổng đang chờ: <strong class="text-rose-600">@totalAmountPending.ToString("N0") xu</strong>
                </div>
                <div class="pt-2">
                    <button onclick="loadAiInsight('payments', '@Model.Payments.Count', '@totalAmountPending', '@hostDepositCount', '@playerFeeCount')" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-primary border border-primary/30 bg-primary/5 hover:bg-primary/10 rounded-md transition-colors">
                        <span class="material-symbols-outlined text-[15px]">auto_awesome</span>
                        Phân tích AI
                    </button>
                    <div id="ai-insight-payments" class="hidden mt-3 p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-md text-xs text-slate-600 dark:text-slate-400 leading-relaxed"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        function toggleAdminChart(sectionId, btn) {
            var section = document.getElementById(sectionId);
            var chevron = btn.querySelector('.chart-chevron');
            if (!section) return;
            if (section.classList.contains('hidden')) {
                section.classList.remove('hidden');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
                initChart(sectionId);
            } else {
                section.classList.add('hidden');
                if (chevron) chevron.style.transform = '';
            }
        }
        var _chartsInited = {};
        function initChart(sectionId) {
            if (_chartsInited[sectionId]) return;
            _chartsInited[sectionId] = true;
            if (sectionId === 'payments-chart-section') {
                var ctx = document.getElementById('paymentsDonut');
                if (!ctx) return;
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Đặt cọc chủ trận', 'Phí người chơi', 'Phí còn lại'],
                        datasets: [{ data: [@hostDepositCount, @playerFeeCount, @hostRemainCount], backgroundColor: ['#3b82f6','#10b981','#f59e0b'], borderWidth: 0 }]
                    },
                    options: { plugins: { legend: { display: false } }, cutout: '60%' }
                });
            }
        }
        window.addEventListener('sporthub:admin_counts', function () { window.location.reload(); });
    </script>
}
