@page
@model IndexModel
@using System.Globalization
@{
    var isEn = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isEn ? "Find Your Ideal Teammates" : "Tìm đồng đội lý tưởng";
}

<!-- HERO BANNER -->
<section class="relative rounded-xl lg:rounded-xl overflow-hidden mb-12">
    <!-- Overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900/80 via-slate-900/40 to-transparent z-10"></div>
    <video class="absolute inset-0 w-full h-full object-cover"
           autoplay
           muted
           loop
           playsinline
           preload="auto">
        <source src="~/videos/SPORTHUB_EXE201.mp4" type="video/mp4" />
    </video>
    
    <!-- Hero Content -->
    <div class="relative z-20 px-6 sm:px-8 py-12 sm:py-20 md:py-32 lg:px-16 max-w-2xl">
        <div class="w-16 h-1 bg-accent rounded-full mb-4"></div>
        <h1 class="font-sport text-3xl sm:text-5xl lg:text-6xl font-black text-white leading-tight mb-4 uppercase tracking-wide">
            @(isEn ? "Find Your Ideal Teammates" : "Tìm đồng đội lý tưởng")
        </h1>
        <p class="text-base sm:text-lg text-slate-200 mb-8 max-w-lg">
            @(isEn ? "Join the largest sports community. Connect with players at your level and find the right match in minutes." : "Tham gia cộng đồng thể thao lớn nhất. Kết nối với người chơi cùng trình độ và tìm trận đấu phù hợp chỉ trong vài phút.")
        </p>
        <div class="flex flex-wrap gap-4">
            <a asp-page="/Matchmaking/Index" class="bg-primary hover:bg-primary/90 text-white font-bold py-3 px-8 rounded-xl transition-all shadow-lg shadow-primary/30 flex items-center gap-2">
                <span class="material-symbols-outlined">person_search</span>
                @(isEn ? "Find Players" : "Tìm đồng đội")
            </a>
            <a asp-page="/Matchmaking/Create" class="bg-accent hover:bg-accent/90 text-white font-bold py-3 px-8 rounded-xl transition-all shadow-lg shadow-accent/30 flex items-center gap-2">
                <span class="material-symbols-outlined">bolt</span>
                @(isEn ? "Create Match" : "Tạo trận đấu")
            </a>
        </div>
    </div>
</section>

<!-- STATS BAR -->
<div class="bg-primary text-white rounded-xl mb-8 px-6 py-5 flex flex-wrap justify-around gap-4">
    @if (Model.TotalUsers > 0)
    {
        <div class="text-center">
            <div class="stat-number">@Model.TotalUsers.ToString("N0")</div>
            <div class="text-xs text-white/70 mt-1 uppercase tracking-wider font-semibold">@(isEn ? "Players" : "Người chơi")</div>
        </div>
        <div class="w-px bg-white/20 hidden sm:block self-stretch"></div>
    }
    @if (Model.MatchesThisWeek > 0)
    {
        <div class="text-center">
            <div class="stat-number">@Model.MatchesThisWeek</div>
            <div class="text-xs text-white/70 mt-1 uppercase tracking-wider font-semibold">@(isEn ? "Matches / This Week" : "Trận / tuần này")</div>
        </div>
        <div class="w-px bg-white/20 hidden sm:block self-stretch"></div>
    }
    @if (Model.TotalVenues > 0)
    {
        <div class="text-center">
            <div class="stat-number">@Model.TotalVenues</div>
            <div class="text-xs text-white/70 mt-1 uppercase tracking-wider font-semibold">@(isEn ? "Sports Courts" : "Sân thể thao")</div>
        </div>
        <div class="w-px bg-white/20 hidden sm:block self-stretch"></div>
    }
    <div class="text-center">
        @if (Model.AvgRating.HasValue)
        {
            <div class="stat-number">@Model.AvgRating.Value.ToString("F1") <span class="text-accent text-xl">★</span></div>
            <div class="text-xs text-white/70 mt-1 uppercase tracking-wider font-semibold">@(isEn ? "Rating" : "Đánh giá")</div>
        }
        else
        {
            <div class="stat-number text-2xl">@(isEn ? "Just launched ✨" : "Mới ra mắt ✨")</div>
            <div class="text-xs text-white/70 mt-1 uppercase tracking-wider font-semibold">@(isEn ? "Sports Community" : "Cộng đồng thể thao")</div>
        }
    </div>
</div>

<!-- QUICK ACTIONS -->
<section class="mb-6 sm:mb-12">
    <div class="rounded-xl border border-slate-200 bg-white p-3 sm:p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <p class="text-[10px] sm:text-xs font-black uppercase tracking-wider text-primary">@(isEn ? "Quick start" : "Bắt đầu nhanh")</p>
                <h2 class="mt-0.5 sm:mt-1 text-base sm:text-2xl font-black text-slate-900 dark:text-white">@(isEn ? "What do you want to do today?" : "Hôm nay bạn muốn làm gì?")</h2>
            </div>
            <div class="grid grid-cols-2 gap-2 sm:gap-3 lg:min-w-[460px]">
                <a asp-page="/Matchmaking/Index" class="group flex items-center gap-2 sm:gap-3 rounded-xl border border-primary/20 bg-primary/5 p-2.5 sm:p-4 transition-all hover:-translate-y-0.5 hover:bg-primary hover:text-white hover:shadow-lg hover:shadow-primary/20">
                    <span class="material-symbols-outlined rounded-lg bg-primary text-white p-1.5 sm:p-2 text-[18px] sm:text-[24px] group-hover:bg-white group-hover:text-primary">person_search</span>
                    <span>
                        <span class="block text-xs sm:text-sm font-black">@(isEn ? "Find players" : "Tìm người chơi")</span>
                        <span class="block text-[10px] sm:text-xs text-slate-500 group-hover:text-white/80 leading-tight">@(isEn ? "Match by skill level and free time" : "Ghép theo trình độ và giờ rảnh")</span>
                    </span>
                </a>
                <a asp-page="/Matchmaking/Create" class="group flex items-center gap-2 sm:gap-3 rounded-xl border border-slate-200 bg-slate-50 p-2.5 sm:p-4 transition-all hover:-translate-y-0.5 hover:border-primary/30 hover:bg-white hover:shadow-md dark:border-slate-800 dark:bg-slate-800/60 dark:hover:bg-slate-800">
                    <span class="material-symbols-outlined rounded-lg bg-amber-500 text-white p-1.5 sm:p-2 text-[18px] sm:text-[24px]">bolt</span>
                    <span>
                        <span class="block text-xs sm:text-sm font-black">@(isEn ? "Create match" : "Tạo trận đấu")</span>
                        <span class="block text-[10px] sm:text-xs text-slate-500 leading-tight">@(isEn ? "Need players? Create a match" : "Thiếu người thì tạo trận")</span>
                    </span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- RECOMMENDED MATCHES -->
<section class="mb-8 sm:mb-12">
    <div class="flex items-center justify-between mb-3 sm:mb-5">
        <h2 class="text-lg sm:text-2xl font-bold text-slate-900 dark:text-white sport-section-heading">@(isEn ? "Suggested Matches" : "Trận đấu gợi ý")</h2>
        <a asp-page="/Matchmaking/Index" class="text-primary font-semibold text-sm hover:underline">@(isEn ? "View all" : "Xem tất cả")</a>
    </div>

    <div class="flex gap-3 sm:gap-5 overflow-x-auto pb-3 hide-scrollbar">
        @foreach (var match in Model.RecommendedMatches)
        {
            <div class="min-w-[220px] sm:min-w-[280px] bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="relative h-28 sm:h-36">
                    <img class="w-full h-full object-cover" src="@match.CourtImageUrl" alt="@match.Title" />
                    <div class="absolute top-2 right-2 text-white text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-full @match.BadgeCssClass">
                        @match.MatchCategory
                    </div>
                    @if (match.SportName.Contains("Cầu lông", StringComparison.OrdinalIgnoreCase) || match.SportName.Contains("Badminton", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="absolute top-2 left-2 text-white text-[9px] sm:text-[10px] font-black uppercase px-2 py-0.5 rounded-full badge-badminton shadow-sm flex items-center gap-0.5">
                            <span class="material-symbols-outlined" style="font-size:10px;font-variation-settings:'FILL' 1">sports_tennis</span>
                            <span class="hidden sm:inline">Cầu lông</span>
                        </div>
                    }
                </div>
                <div class="p-3 sm:p-4">
                    <h3 class="font-bold text-sm sm:text-base mb-1 truncate">@match.Title</h3>
                    <div class="flex items-center text-slate-500 dark:text-slate-400 text-xs gap-1.5 mb-2 sm:mb-3 truncate">
                        <span class="material-symbols-outlined text-[13px]">schedule</span>
                        @match.DateTimeDisplay
                        <span>•</span>
                        <span class="material-symbols-outlined text-[13px]">location_on</span>
                        <span class="truncate">@match.VenueName</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex -space-x-1.5">
                            @foreach (var avatar in match.ParticipantAvatars.Take(3))
                            {
                                <img class="size-7 sm:size-8 rounded-full border-2 border-white dark:border-slate-900" src="@avatar" alt="Player" />
                            }
                            @if (match.CurrentParticipants > 3)
                            {
                                <div class="size-7 sm:size-8 rounded-full border-2 border-white dark:border-slate-900 bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-[9px] font-bold">
                                    +@(match.CurrentParticipants - 3)
                                </div>
                            }
                        </div>
                        <a asp-page="/Matchmaking/Details" asp-route-id="@match.MatchID" class="bg-primary/10 hover:bg-primary/20 text-primary font-bold px-2.5 sm:px-4 py-1 sm:py-2 rounded-lg text-xs sm:text-sm transition-colors whitespace-nowrap">
                            @(isEn ? "Join" : "Tham gia")
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
    <!-- SUGGESTED PLAYERS -->
    <div class="lg:col-span-3">
        <div class="flex items-center justify-between mb-3 sm:mb-5">
            <h2 class="text-lg sm:text-2xl font-bold text-slate-900 dark:text-white sport-section-heading">@(isEn ? "Suggested Players" : "Người chơi gợi ý")</h2>
            <a asp-page="/Players/Index" class="text-primary font-semibold text-sm hover:underline">@(isEn ? "See more" : "Xem thêm")</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 sm:gap-4">
            @foreach (var player in Model.SuggestedPlayers)
            {
                <div class="flex items-center p-3 sm:p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl hover:shadow-sm transition-shadow">
                    <img class="size-12 sm:size-14 rounded-full object-cover flex-shrink-0" src="@player.AvatarUrl" alt="@player.FullName" />
                    <div class="ml-3 sm:ml-4 flex-1 min-w-0">
                        <h4 class="font-bold text-sm sm:text-base text-slate-900 dark:text-white truncate">@player.FullName</h4>
                        <p class="text-slate-500 text-xs sm:text-sm truncate">@player.FavoriteSport • @player.SkillLevel</p>
                        <div class="flex items-center mt-0.5">
                            <span class="material-symbols-outlined text-amber-400 text-xs">star</span>
                            <span class="text-xs font-bold ml-1">@player.AverageRating.ToString("F1")</span>
                            <span class="text-slate-400 text-xs ml-1">(@player.TotalMatches @(isEn ? "matches" : "trận"))</span>
                        </div>
                    </div>
                    <a asp-page="/Players/Index" class="p-1.5 sm:p-2 text-primary bg-primary/10 rounded-full hover:bg-primary/20 transition-colors flex-shrink-0" title="Kết nối">
                        <span class="material-symbols-outlined text-[18px] sm:text-[24px]">person_add</span>
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- NEARBY COURTS -->
    <div class="hidden">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Sân gần đây</h2>
            <a asp-page="/Courts/Map" class="text-primary font-semibold text-sm hover:underline">Bản đồ</a>
        </div>
        <div class="space-y-4">
            @foreach (var court in Model.NearbyCourts)
            {
                <a asp-page="/Courts/Details" asp-route-id="@court.CourtID" class="flex gap-4 group cursor-pointer bg-white dark:bg-slate-900 p-2 rounded-xl hover:shadow-md transition-shadow">
                    <div class="size-20 shrink-0 rounded-lg overflow-hidden bg-slate-200">
                        <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" src="@court.MainImageUrl" alt="@court.VenueName" />
                    </div>
                    <div class="flex-1">
                        <h4 class="font-bold text-slate-900 dark:text-white group-hover:text-primary transition-colors">@court.VenueName</h4>
                        <p class="text-slate-500 text-xs mb-1">@court.DistanceKm.ToString() km • @court.TotalCourts sân</p>
                        
                        @if (court.Availability == CourtCardViewModel.AvailabilityStatus.Available)
                        {
                            <span class="text-emerald-500 text-xs font-bold flex items-center">
                                <span class="size-2 bg-emerald-500 rounded-full mr-1.5 animate-pulse"></span>Còn sân
                            </span>
                        }
                        else if (court.Availability == CourtCardViewModel.AvailabilityStatus.Limited)
                        {
                            <span class="text-amber-500 text-xs font-bold flex items-center">
                                <span class="size-2 bg-amber-500 rounded-full mr-1.5"></span>Sắp hết chỗ
                            </span>
                        }
                        else
                        {
                            <span class="text-red-500 text-xs font-bold flex items-center">
                                <span class="size-2 bg-red-500 rounded-full mr-1.5"></span>Hết sân
                            </span>
                        }
                        
                        <p class="text-primary font-bold text-sm mt-1">@court.MinPricePerHour.ToString("N0") VNĐ/h</p>
                    </div>
                </a>
            }
        </div>

        <!-- Map Container -->
        <div class="mt-6 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 h-56 relative">
            <div id="homeNearbyMap" class="w-full h-full" style="z-index: 10;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var centerLat = 16.0471;
            var centerLon = 108.2068;
            var map = L.map('homeNearbyMap').setView([centerLat, centerLon], 13);
            
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            var courtsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NearbyCourts.Where(c => c.Latitude.HasValue && c.Longitude.HasValue).Select(c => new {
                name = c.VenueName,
                sport = c.SportName,
                lat = (double)c.Latitude!.Value,
                lon = (double)c.Longitude!.Value,
                url = $"/Courts/Details?id={c.CourtID}"
            })));

            var bounds = [];
            courtsData.forEach(function(court) {
                var marker = L.marker([court.lat, court.lon]).addTo(map);
                marker.bindPopup(`
                    <div class="p-1">
                        <h4 class="font-bold text-sm mb-1 text-slate-800">${court.name}</h4>
                        <p class="text-xs text-slate-500 mb-2">${court.sport}</p>
                        <a href="${court.url}" class="text-xs text-primary font-bold hover:underline">Chi tiết</a>
                    </div>
                `);
                bounds.push([court.lat, court.lon]);
            });

            if (bounds.length > 0) {
                map.fitBounds(bounds, { padding: [30, 30] });
            }
        });
    </script>
}

